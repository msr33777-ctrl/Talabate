&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/customer/FoodCustomizationModal.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000040516&#65533;15267721203&#65533;021736&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import React, { useState, useEffect } from 'react';
import { X, Plus, Minus, Check, AlertCircle, ShoppingBag } from 'lucide-react';
import { Product, ProductOptionGroup, ProductOptionItem } from '../../types';

interface FoodCustomizationModalProps {
  product: Product;
  isOpen: boolean;
  onClose: () =&gt; void;
  onAddToCart: (
    product: Product,
    quantity: number,
    selectedOptionGroups: {
      groupTitle: string;
      selectedItems: { name: string; price: number }[];
    }[],
    notes: string
  ) =&gt; void;
}

export const FoodCustomizationModal: React.FC&lt;FoodCustomizationModalProps&gt; = ({
  product,
  isOpen,
  onClose,
  onAddToCart,
}) =&gt; {
  // Selected option map: { [groupId]: Set of optionIds }
  const [selectedOptions, setSelectedOptions] = useState&lt;{ [groupId: string]: string[] }&gt;({});
  const [quantity, setQuantity] = useState&lt;number&gt;(1);
  const [notes, setNotes] = useState&lt;string&gt;('');
  const [validationError, setValidationError] = useState&lt;string | null&gt;(null);

  // Initialize defaults on open or product change
  useEffect(() =&gt; {
    if (!isOpen || !product) return;
    setQuantity(1);
    setNotes('');
    setValidationError(null);

    const initialSelections: { [groupId: string]: string[] } = {};

    if (product.optionGroups &amp;&amp; product.optionGroups.length &gt; 0) {
      product.optionGroups.forEach((grp) =&gt; {
        // Find default or first if required
        const defaultOpt = grp.options.find((o) =&gt; o.isDefault);
        if (defaultOpt) {
          initialSelections[grp.id] = [defaultOpt.id];
        } else if (grp.isRequired &amp;&amp; grp.options.length &gt; 0) {
          initialSelections[grp.id] = [grp.options[0].id];
        } else {
          initialSelections[grp.id] = [];
        }
      });
    } else if (product.options &amp;&amp; product.options.length &gt; 0) {
      // Legacy simple options fallback
      initialSelections['legacy'] = [];
    }

    setSelectedOptions(initialSelections);
  }, [isOpen, product]);

  if (!isOpen || !product) return null;

  // Toggle or select option
  const handleSelectOption = (group: ProductOptionGroup, option: ProductOptionItem) =&gt; {
    setSelectedOptions((prev) =&gt; {
      const current = prev[group.id] || [];
      const isRadio = group.maxSelect === 1;

      if (isRadio) {
        return {
          ...prev,
          [group.id]: [option.id],
        };
      }

      // Checkbox multi-select
      const isAlreadySelected = current.includes(option.id);
      if (isAlreadySelected) {
        return {
          ...prev,
          [group.id]: current.filter((id) =&gt; id !== option.id),
        };
      }

      // Check max limit
      const maxAllowed = group.maxSelect || 99;
      if (current.length &gt;= maxAllowed) {
        return prev;
      }

      return {
        ...prev,
        [group.id]: [...current, option.id],
      };
    });
    setValidationError(null);
  };

  // Toggle legacy options
  const handleToggleLegacyOption = (optionId: string) =&gt; {
    setSelectedOptions((prev) =&gt; {
      const current = prev['legacy'] || [];
      return {
        ...prev,
        legacy: current.includes(optionId)
          ? current.filter((id) =&gt; id !== optionId)
          : [...current, optionId],
      };
    });
  };

  // Calculate extra price from selections
  let extraPrice = 0;
  if (product.optionGroups &amp;&amp; product.optionGroups.length &gt; 0) {
    product.optionGroups.forEach((grp) =&gt; {
      const selectedIds = selectedOptions[grp.id] || [];
      selectedIds.forEach((optId) =&gt; {
        const item = grp.options.find((o) =&gt; o.id === optId);
        if (item) extraPrice += item.price;
      });
    });
  } else if (product.options &amp;&amp; product.options.length &gt; 0) {
    const legacySelected = selectedOptions['legacy'] || [];
    legacySelected.forEach((optId) =&gt; {
      const item = product.options?.find((o) =&gt; o.id === optId);
      if (item) extraPrice += item.price;
    });
  }

  const unitPrice = product.price + extraPrice;
  const totalPrice = unitPrice * quantity;

  // Handle final add
  const handleConfirm = () =&gt; {
    // Validate required groups
    if (product.optionGroups &amp;&amp; product.optionGroups.length &gt; 0) {
      for (const grp of product.optionGroups) {
        const selected = selectedOptions[grp.id] || [];
        if (grp.isRequired &amp;&amp; selected.length === 0) {
          setValidationError(`يرجى تحديد اختيار لمجموعة: ${grp.title}`);
          return;
        }
        if (grp.minSelect &amp;&amp; selected.length &lt; grp.minSelect) {
          setValidationError(`يرجى اختيار ما لا يقل عن ${grp.minSelect} في: ${grp.title}`);
          return;
        }
      }
    }

    // Format selected groups
    const formattedGroups: {
      groupTitle: string;
      selectedItems: { name: string; price: number }[];
    }[] = [];

    if (product.optionGroups &amp;&amp; product.optionGroups.length &gt; 0) {
      product.optionGroups.forEach((grp) =&gt; {
        const selectedIds = selectedOptions[grp.id] || [];
        if (selectedIds.length &gt; 0) {
          const items = grp.options
            .filter((o) =&gt; selectedIds.includes(o.id))
            .map((o) =&gt; ({ name: o.name, price: o.price }));
          formattedGroups.push({
            groupTitle: grp.title,
            selectedItems: items,
          });
        }
      });
    } else if (product.options &amp;&amp; product.options.length &gt; 0) {
      const legacySelected = selectedOptions['legacy'] || [];
      if (legacySelected.length &gt; 0) {
        const items = product.options
          .filter((o) =&gt; legacySelected.includes(o.id))
          .map((o) =&gt; ({ name: o.name, price: o.price }));
        formattedGroups.push({
          groupTitle: 'إضافات مفضلة',
          selectedItems: items,
        });
      }
    }

    onAddToCart(product, quantity, formattedGroups, notes);
    onClose();
  };

  return (
    &lt;div className="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/60 backdrop-blur-xs animate-fadeIn"&gt;
      &lt;div 
        className="w-full sm:max-w-md bg-white rounded-t-3xl sm:rounded-2xl max-h-[90vh] flex flex-col shadow-2xl overflow-hidden border border-slate-100"
        dir="rtl"
      &gt;
        {/* Header Cover / Close */}
        &lt;div className="relative"&gt;
          &lt;div className="h-44 w-full bg-slate-100 overflow-hidden relative"&gt;
            &lt;img
              src={product.imageUrl}
              alt={product.name}
              className="w-full h-full object-cover"
              onError={(e) =&gt; {
                (e.target as HTMLImageElement).src = 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=500&amp;auto=format&amp;fit=crop&amp;q=80';
              }}
            /&gt;
            &lt;div className="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent" /&gt;
            
            &lt;button
              onClick={onClose}
              className="absolute top-3 left-3 w-9 h-9 rounded-full bg-white/90 hover:bg-white text-slate-700 flex items-center justify-center shadow-md transition-all active:scale-95"
              aria-label="إغلاق"
            &gt;
              &lt;X className="w-5 h-5" /&gt;
            &lt;/button&gt;

            &lt;div className="absolute bottom-3 right-4 left-4 text-white"&gt;
              &lt;span className="text-xs bg-[#F47721] text-white px-2 py-0.5 rounded-full font-medium mb-1 inline-block"&gt;
                {product.category}
              &lt;/span&gt;
              &lt;h3 className="text-lg font-bold text-white drop-shadow-sm leading-tight"&gt;
                {product.name}
              &lt;/h3&gt;
              &lt;p className="text-xs text-white/90 font-medium"&gt;
                يبدأ من {product.price.toLocaleString()} د.ع
              &lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Scrollable Options Content */}
        &lt;div className="flex-1 overflow-y-auto p-4 space-y-4"&gt;
          {product.description &amp;&amp; (
            &lt;p className="text-xs text-slate-500 leading-relaxed bg-slate-50 p-2.5 rounded-xl border border-slate-100"&gt;
              {product.description}
            &lt;/p&gt;
          )}

          {/* Validation Error Alert */}
          {validationError &amp;&amp; (
            &lt;div className="p-3 bg-red-50 border border-red-200 rounded-xl flex items-center gap-2 text-red-700 text-xs"&gt;
              &lt;AlertCircle className="w-4 h-4 shrink-0" /&gt;
              &lt;span&gt;{validationError}&lt;/span&gt;
            &lt;/div&gt;
          )}

          {/* Option Groups */}
          {product.optionGroups &amp;&amp; product.optionGroups.length &gt; 0 ? (
            product.optionGroups.map((grp) =&gt; {
              const selectedIds = selectedOptions[grp.id] || [];
              const isRadio = grp.maxSelect === 1;

              return (
                &lt;div key={grp.id} className="bg-slate-50/70 p-3.5 rounded-2xl border border-slate-100"&gt;
                  &lt;div className="flex items-center justify-between mb-2"&gt;
                    &lt;div&gt;
                      &lt;h4 className="font-bold text-slate-800 text-sm"&gt;{grp.title}&lt;/h4&gt;
                      &lt;p className="text-[11px] text-slate-400"&gt;
                        {isRadio ? 'اختر خياراً واحداً' : grp.maxSelect ? `اختر حتى ${grp.maxSelect}` : 'اختياري'}
                      &lt;/p&gt;
                    &lt;/div&gt;
                    {grp.isRequired ? (
                      &lt;span className="text-[10px] bg-amber-100 text-amber-800 font-bold px-2 py-0.5 rounded-full"&gt;
                        مطلوب
                      &lt;/span&gt;
                    ) : (
                      &lt;span className="text-[10px] bg-slate-200/70 text-slate-600 font-medium px-2 py-0.5 rounded-full"&gt;
                        اختياري
                      &lt;/span&gt;
                    )}
                  &lt;/div&gt;

                  &lt;div className="space-y-1.5"&gt;
                    {grp.options.map((opt) =&gt; {
                      const isSelected = selectedIds.includes(opt.id);

                      return (
                        &lt;button
                          key={opt.id}
                          type="button"
                          onClick={() =&gt; handleSelectOption(grp, opt)}
                          className={`w-full flex items-center justify-between p-2.5 rounded-xl text-xs transition-all border ${
                            isSelected
                              ? 'bg-orange-50 border-[#F47721] text-slate-900 shadow-xs'
                              : 'bg-white border-slate-200 hover:border-slate-300 text-slate-700'
                          }`}
                        &gt;
                          &lt;div className="flex items-center gap-2.5"&gt;
                            &lt;div
                              className={`w-4 h-4 rounded-full flex items-center justify-center border transition-all ${
                                isSelected
                                  ? 'bg-[#F47721] border-[#F47721] text-white'
                                  : 'border-slate-300 bg-white'
                              }`}
                            &gt;
                              {isSelected &amp;&amp; &lt;Check className="w-2.5 h-2.5 stroke-[3]" /&gt;}
                            &lt;/div&gt;
                            &lt;span className="font-medium text-right"&gt;{opt.name}&lt;/span&gt;
                          &lt;/div&gt;

                          &lt;span className={`font-semibold ${opt.price &gt; 0 ? 'text-[#F47721]' : 'text-slate-400'}`}&gt;
                            {opt.price &gt; 0 ? `+${opt.price.toLocaleString()} د.ع` : 'مجاناً'}
                          &lt;/span&gt;
                        &lt;/button&gt;
                      );
                    })}
                  &lt;/div&gt;
                &lt;/div&gt;
              );
            })
          ) : product.options &amp;&amp; product.options.length &gt; 0 ? (
            /* Legacy Options List */
            &lt;div className="bg-slate-50/70 p-3.5 rounded-2xl border border-slate-100"&gt;
              &lt;div className="flex items-center justify-between mb-2"&gt;
                &lt;h4 className="font-bold text-slate-800 text-sm"&gt;إضافات وتفضيلات الوجبة&lt;/h4&gt;
                &lt;span className="text-[10px] bg-slate-200/70 text-slate-600 font-medium px-2 py-0.5 rounded-full"&gt;
                  اختياري
                &lt;/span&gt;
              &lt;/div&gt;
              &lt;div className="space-y-1.5"&gt;
                {product.options.map((opt) =&gt; {
                  const isSelected = (selectedOptions['legacy'] || []).includes(opt.id);
                  return (
                    &lt;button
                      key={opt.id}
                      type="button"
                      onClick={() =&gt; handleToggleLegacyOption(opt.id)}
                      className={`w-full flex items-center justify-between p-2.5 rounded-xl text-xs transition-all border ${
                        isSelected
                          ? 'bg-orange-50 border-[#F47721] text-slate-900 shadow-xs'
                          : 'bg-white border-slate-200 hover:border-slate-300 text-slate-700'
                      }`}
                    &gt;
                      &lt;div className="flex items-center gap-2.5"&gt;
                        &lt;div
                          className={`w-4 h-4 rounded flex items-center justify-center border transition-all ${
                            isSelected
                              ? 'bg-[#F47721] border-[#F47721] text-white'
                              : 'border-slate-300 bg-white'
                          }`}
                        &gt;
                          {isSelected &amp;&amp; &lt;Check className="w-2.5 h-2.5 stroke-[3]" /&gt;}
                        &lt;/div&gt;
                        &lt;span className="font-medium text-right"&gt;{opt.name}&lt;/span&gt;
                      &lt;/div&gt;
                      &lt;span className="font-semibold text-[#F47721]"&gt;
                        +{opt.price.toLocaleString()} د.ع
                      &lt;/span&gt;
                    &lt;/button&gt;
                  );
                })}
              &lt;/div&gt;
            &lt;/div&gt;
          ) : null}

          {/* Notes for Chef / Store */}
          &lt;div&gt;
            &lt;label className="block text-xs font-semibold text-slate-700 mb-1"&gt;
              ملاحظات أو طلبات خاصة للمطبخ
            &lt;/label&gt;
            &lt;input
              type="text"
              value={notes}
              onChange={(e) =&gt; setNotes(e.target.value)}
              placeholder="مثال: بدون بصل، صوص زيادة ع الجانب..."
              className="w-full text-xs p-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-[#F47721] text-slate-800"
            /&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Bottom Actions Bar */}
        &lt;div className="p-4 border-t border-slate-100 bg-white space-y-3"&gt;
          &lt;div className="flex items-center justify-between"&gt;
            {/* Quantity Stepper */}
            &lt;div className="flex items-center gap-3 bg-slate-100 px-3 py-1.5 rounded-xl"&gt;
              &lt;button
                type="button"
                onClick={() =&gt; setQuantity((q) =&gt; Math.max(1, q - 1))}
                className="w-7 h-7 rounded-lg bg-white text-slate-700 flex items-center justify-center shadow-xs active:scale-95 disabled:opacity-40"
                disabled={quantity &lt;= 1}
              &gt;
                &lt;Minus className="w-3.5 h-3.5" /&gt;
              &lt;/button&gt;
              &lt;span className="font-bold text-sm text-slate-800 w-5 text-center"&gt;
                {quantity}
              &lt;/span&gt;
              &lt;button
                type="button"
                onClick={() =&gt; setQuantity((q) =&gt; q + 1)}
                className="w-7 h-7 rounded-lg bg-white text-slate-700 flex items-center justify-center shadow-xs active:scale-95"
              &gt;
                &lt;Plus className="w-3.5 h-3.5" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            {/* Price Preview */}
            &lt;div className="text-left"&gt;
              &lt;span className="text-[10px] text-slate-400 block"&gt;المجموع الإجمالي&lt;/span&gt;
              &lt;span className="font-extrabold text-base text-[#172554]"&gt;
                {totalPrice.toLocaleString()} د.ع
              &lt;/span&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          {/* Add to Cart Button */}
          &lt;button
            type="button"
            onClick={handleConfirm}
            className="w-full py-3 bg-[#F47721] hover:bg-[#e06816] active:scale-[0.99] text-white font-bold text-sm rounded-xl shadow-md shadow-orange-500/20 flex items-center justify-center gap-2 transition-all"
          &gt;
            &lt;ShoppingBag className="w-4 h-4" /&gt;
            &lt;span&gt;إضافة إلى السلة ({totalPrice.toLocaleString()} د.ع)&lt;/span&gt;
          &lt;/button&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
};
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/common/&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000755&#65533;0000000&#65533;0000000&#65533;00000000000&#65533;15267721203&#65533;014162&#65533; 5&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/common/PhoneAuthModal.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000047575&#65533;15267721203&#65533;017614&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import React, { useState, useEffect, useRef } from 'react';
import { useApp } from '../../context/AppContext';
import {
  auth,
  RecaptchaVerifier,
  signInWithPhoneNumber,
  ConfirmationResult,
} from '../../firebase';
import {
  Phone,
  ShieldCheck,
  X,
  Clock,
  AlertCircle,
  CheckCircle2,
  Lock,
  RotateCcw,
  Sparkles,
  Info,
} from 'lucide-react';

interface PhoneAuthModalProps {
  isOpen: boolean;
  onClose: () =&gt; void;
  onVerifiedSuccess?: (phone: string) =&gt; void;
  title?: string;
  subtitle?: string;
  requireForCod?: boolean;
}

export const PhoneAuthModal: React.FC&lt;PhoneAuthModalProps&gt; = ({
  isOpen,
  onClose,
  onVerifiedSuccess,
  title = 'تسجيل الدخول والتحقق برقم الهاتف',
  subtitle = 'للحد من الطلبات الوهمية، يتم التحقق برمز OTP عبر رسالة نصية قصيرة',
  requireForCod = false,
}) =&gt; {
  const { currentUser, switchUser, users, addNotification, addAuditLog } = useApp();

  const [step, setStep] = useState&lt;'input_phone' | 'input_otp'&gt;('input_phone');
  const [phoneNumber, setPhoneNumber] = useState('');
  const [otpCode, setOtpCode] = useState(['', '', '', '', '', '']);
  const [countdown, setCountdown] = useState(60);
  const [canResend, setCanResend] = useState(false);
  const [attemptsRemaining, setAttemptsRemaining] = useState(3);
  const [isLocked, setIsLocked] = useState(false);
  const [lockTimer, setLockTimer] = useState(0);
  const [isLoading, setIsLoading] = useState(false);
  const [errorMessage, setErrorMessage] = useState&lt;string | null&gt;(null);
  const [confirmationResult, setConfirmationResult] = useState&lt;ConfirmationResult | null&gt;(null);
  const [isTestMode, setIsTestMode] = useState(false);
  const [expectedTestOtp, setExpectedTestOtp] = useState('123456');

  const recaptchaVerifierRef = useRef&lt;RecaptchaVerifier | null&gt;(null);
  const otpInputRefs = useRef&lt;(HTMLInputElement | null)[]&gt;([]);

  // Format Iraqi Phone Number
  const cleanIraqiPhone = (input: string) =&gt; {
    let cleaned = input.replace(/\D/g, '');
    if (cleaned.startsWith('964')) {
      cleaned = cleaned.substring(3);
    }
    if (cleaned.startsWith('0')) {
      cleaned = cleaned.substring(1);
    }
    return cleaned;
  };

  const getFullE164Phone = () =&gt; {
    const raw = cleanIraqiPhone(phoneNumber);
    return `+964${raw}`;
  };

  const validatePhone = () =&gt; {
    const raw = cleanIraqiPhone(phoneNumber);
    // Iraqi mobile numbers start with 7 and are 10 digits total without country code (e.g., 7701234567)
    return /^7[3-9]\d{8}$/.test(raw);
  };

  // Timer countdown for resending OTP
  useEffect(() =&gt; {
    let timer: NodeJS.Timeout;
    if (step === 'input_otp' &amp;&amp; countdown &gt; 0) {
      timer = setInterval(() =&gt; setCountdown((c) =&gt; c - 1), 1000);
    } else if (countdown === 0) {
      setCanResend(true);
    }
    return () =&gt; clearInterval(timer);
  }, [step, countdown]);

  // Lockout timer if attempts exceed 3
  useEffect(() =&gt; {
    let timer: NodeJS.Timeout;
    if (isLocked &amp;&amp; lockTimer &gt; 0) {
      timer = setInterval(() =&gt; setLockTimer((t) =&gt; t - 1), 1000);
    } else if (lockTimer === 0 &amp;&amp; isLocked) {
      setIsLocked(false);
      setAttemptsRemaining(3);
      setErrorMessage(null);
    }
    return () =&gt; clearInterval(timer);
  }, [isLocked, lockTimer]);

  // Initialize RecaptchaVerifier
  const setupRecaptcha = () =&gt; {
    if (recaptchaVerifierRef.current) return;
    try {
      recaptchaVerifierRef.current = new RecaptchaVerifier(auth, 'phone-recaptcha-container', {
        size: 'invisible',
        callback: () =&gt; {
          // reCAPTCHA solved
        },
        'expired-callback': () =&gt; {
          setErrorMessage('انتهت صلاحية reCAPTCHA، يرجى المحاولة ثانية.');
        },
      });
    } catch {
      // Container not found or already initialized
    }
  };

  const handleSendOtp = async (forceTestMode = false) =&gt; {
    if (!validatePhone()) {
      setErrorMessage('يرجى إدخال رقم هاتف عراقي صحيح يتكون من 10 أرقام ويبدأ بـ 7 (مثال: 7701234567)');
      return;
    }

    setIsLoading(true);
    setErrorMessage(null);
    const fullPhone = getFullE164Phone();

    // Check if test phone number or forced test mode
    if (forceTestMode || fullPhone === '+9647700000000' || fullPhone === '+9647800000000') {
      setIsTestMode(true);
      const generatedOtp = '123456';
      setExpectedTestOtp(generatedOtp);
      setTimeout(() =&gt; {
        setIsLoading(false);
        setStep('input_otp');
        setCountdown(60);
        setCanResend(false);
        addNotification('رمز التحقق التجريبي', `رمز OTP التجريبي لرقم ${fullPhone} هو: ${generatedOtp}`, 'info');
      }, 700);
      return;
    }

    try {
      setupRecaptcha();
      if (!recaptchaVerifierRef.current) {
        throw new Error('تعذر تهيئة reCAPTCHA');
      }

      const result = await signInWithPhoneNumber(auth, fullPhone, recaptchaVerifierRef.current);
      setConfirmationResult(result);
      setIsTestMode(false);
      setIsLoading(false);
      setStep('input_otp');
      setCountdown(60);
      setCanResend(false);
      addNotification('تم إرسال رمز التحقق', `تم إرسال رمز OTP إلى ${fullPhone}`, 'info');
    } catch (err: any) {
      console.warn('Firebase Phone Auth send error:', err);
      setIsLoading(false);
      // If Firebase Phone Auth is not yet toggled on in Firebase Console or blocked
      if (
        err?.code === 'auth/operation-not-allowed' ||
        err?.code === 'auth/missing-app-credential' ||
        err?.code === 'auth/invalid-app-credential' ||
        err?.code === 'auth/quota-exceeded' ||
        err?.message?.includes('not-allowed')
      ) {
        // Offer graceful test fallback
        setIsTestMode(true);
        setExpectedTestOtp('123456');
        setStep('input_otp');
        setCountdown(60);
        setCanResend(false);
        setErrorMessage('ملاحظة: خدمة Phone Auth تتطلب التفعيل في Firebase Console. تم تفعيل الوضع التجريبي التلقائي (رمز OTP هو 123456).');
      } else {
        setErrorMessage(err?.message || 'تعذر إرسال رمز التحقق. يرجى التأكد من الرقم أو استخدام الوضع التجريبي.');
      }
    }
  };

  const handleOtpDigitChange = (index: number, val: string) =&gt; {
    if (val.length &gt; 1) {
      // User pasted multiple digits
      const digits = val.replace(/\D/g, '').split('').slice(0, 6);
      const newOtp = [...otpCode];
      digits.forEach((d, i) =&gt; {
        newOtp[i] = d;
      });
      setOtpCode(newOtp);
      if (digits.length === 6) {
        otpInputRefs.current[5]?.focus();
      }
      return;
    }

    const newOtp = [...otpCode];
    newOtp[index] = val;
    setOtpCode(newOtp);

    // Auto-advance
    if (val &amp;&amp; index &lt; 5) {
      otpInputRefs.current[index + 1]?.focus();
    }
  };

  const handleKeyDown = (index: number, e: React.KeyboardEvent&lt;HTMLInputElement&gt;) =&gt; {
    if (e.key === 'Backspace' &amp;&amp; !otpCode[index] &amp;&amp; index &gt; 0) {
      otpInputRefs.current[index - 1]?.focus();
    }
  };

  const handleVerifyOtp = async () =&gt; {
    if (isLocked) {
      setErrorMessage(`تم قفل المحاولات مؤقتاً. يرجى الانتظار ${lockTimer} ثانية.`);
      return;
    }

    const code = otpCode.join('');
    if (code.length !== 6) {
      setErrorMessage('يرجى إدخال رمز التحقق كاملاً المكون من 6 أرقام');
      return;
    }

    setIsLoading(true);
    setErrorMessage(null);
    const fullPhone = getFullE164Phone();

    // Verify in Test Mode
    if (isTestMode || !confirmationResult) {
      if (code === expectedTestOtp || code === '123456') {
        completeVerification(fullPhone);
      } else {
        handleFailedAttempt();
      }
      setIsLoading(false);
      return;
    }

    // Verify via Firebase confirmationResult
    try {
      const userCredential = await confirmationResult.confirm(code);
      const user = userCredential.user;
      completeVerification(user.phoneNumber || fullPhone);
    } catch (err: any) {
      console.warn('Firebase confirm error:', err);
      handleFailedAttempt();
    } finally {
      setIsLoading(false);
    }
  };

  const handleFailedAttempt = () =&gt; {
    const nextAttempts = attemptsRemaining - 1;
    setAttemptsRemaining(nextAttempts);

    if (nextAttempts &lt;= 0) {
      setIsLocked(true);
      setLockTimer(120); // 2 minutes lock
      setErrorMessage('استنفدت الحد الأقصى للمحاولات (3 محاولات). تم تجميد التحقق لمدة دقيقتين لمنع التلاعب.');
      addAuditLog(
        'PHONE_VERIFICATION_LOCKED',
        'user',
        getFullE164Phone(),
        'محاولات إدخال رمز OTP خاطئة متكررة - تم قفل الحساب مؤقتاً',
        'warning'
      );
    } else {
      setErrorMessage(`رمز التحقق غير صحيح! متبقي لديك ${nextAttempts} محاولات قبل القفل المؤقت.`);
    }
  };

  const completeVerification = (verifiedPhone: string) =&gt; {
    addAuditLog(
      'PHONE_VERIFIED',
      'user',
      currentUser.id,
      `تم التحقق بنجاح من رقم الهاتف العراقي ${verifiedPhone}`,
      'info'
    );
    addNotification('تم التحقق بنجاح', `تم توثيق رقم الهاتف ${verifiedPhone} وتأمينه`, 'success');

    // Strict role check: Phone auth ALWAYS assigns 'customer' role.
    // It NEVER auto-escalates to admin, courier, or merchant!
    currentUser.phone = verifiedPhone;
    (currentUser as any).phoneVerified = true;

    if (onVerifiedSuccess) {
      onVerifiedSuccess(verifiedPhone);
    }
    onClose();
  };

  if (!isOpen) return null;

  return (
    &lt;div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in text-slate-800"&gt;
      &lt;div className="bg-white rounded-3xl w-full max-w-md p-6 shadow-2xl border border-slate-100 space-y-5"&gt;
        {/* Header */}
        &lt;div className="flex items-center justify-between border-b border-slate-100 pb-3"&gt;
          &lt;div className="flex items-center gap-2"&gt;
            &lt;div className="w-10 h-10 rounded-2xl bg-orange-50 text-orange-600 flex items-center justify-center font-bold"&gt;
              &lt;Phone className="w-5 h-5" /&gt;
            &lt;/div&gt;
            &lt;div&gt;
              &lt;h3 className="font-extrabold text-base text-[#172554]"&gt;{title}&lt;/h3&gt;
              &lt;p className="text-[11px] text-slate-400"&gt;توثيق الحساب بالرقم العراقي +964&lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;
          &lt;button
            onClick={onClose}
            className="w-8 h-8 rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 flex items-center justify-center transition-colors"
          &gt;
            &lt;X className="w-4 h-4" /&gt;
          &lt;/button&gt;
        &lt;/div&gt;

        {/* Info Banner */}
        &lt;div className="bg-amber-50/70 border border-amber-200 rounded-2xl p-3 text-xs text-amber-900 flex items-start gap-2"&gt;
          &lt;ShieldCheck className="w-4 h-4 text-orange-500 shrink-0 mt-0.5" /&gt;
          &lt;div&gt;
            &lt;p className="font-bold"&gt;{subtitle}&lt;/p&gt;
            &lt;p className="text-[10px] text-slate-600 mt-0.5"&gt;
              يدعم شبكات زين العراق، آسياسيل، وكورك. لا يُمنح أي حساب صلاحيات مدير أو مندوب بمجرد توثيق الهاتف.
            &lt;/p&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Step 1: Input Phone */}
        {step === 'input_phone' &amp;&amp; (
          &lt;div className="space-y-4"&gt;
            &lt;div&gt;
              &lt;label className="block text-xs font-bold text-slate-700 mb-1.5"&gt;
                أدخل رقم هاتفك العراقي
              &lt;/label&gt;
              &lt;div className="flex items-center border-2 border-slate-200 focus-within:border-orange-500 rounded-2xl p-1 bg-white transition-all shadow-xs" dir="ltr"&gt;
                &lt;span className="px-3 py-2 bg-slate-100 rounded-xl text-slate-700 font-extrabold text-sm flex items-center gap-1.5 border border-slate-200 select-none"&gt;
                  &lt;span&gt;🇮🇶&lt;/span&gt;
                  &lt;span&gt;+964&lt;/span&gt;
                &lt;/span&gt;
                &lt;input
                  type="tel"
                  dir="ltr"
                  value={phoneNumber}
                  onChange={(e) =&gt; setPhoneNumber(e.target.value)}
                  placeholder="770 123 4567"
                  className="w-full px-3 py-2 text-base font-bold text-slate-900 outline-none bg-transparent"
                  autoFocus
                /&gt;
              &lt;/div&gt;
              &lt;p className="text-[10px] text-slate-400 mt-1" dir="rtl"&gt;
                اكتب الرقم مع أو بدون صفر البداية (مثلاً: 0770xxxxxxx أو 780xxxxxxx).
              &lt;/p&gt;
            &lt;/div&gt;

            {/* Test number helper */}
            &lt;div className="bg-slate-50 p-2.5 rounded-xl border border-slate-200 text-xs flex items-center justify-between"&gt;
              &lt;div&gt;
                &lt;span className="font-bold text-slate-700 block"&gt;رقم الاختبار السريع:&lt;/span&gt;
                &lt;span className="text-[11px] font-mono text-slate-500" dir="ltr"&gt;+964 770 000 0000&lt;/span&gt;
              &lt;/div&gt;
              &lt;button
                type="button"
                onClick={() =&gt; {
                  setPhoneNumber('7700000000');
                  handleSendOtp(true);
                }}
                className="px-2.5 py-1 bg-orange-100 hover:bg-orange-200 text-orange-700 rounded-lg text-[11px] font-bold transition-colors"
              &gt;
                تعبئة واختبار فوري
              &lt;/button&gt;
            &lt;/div&gt;

            {/* Error Message */}
            {errorMessage &amp;&amp; (
              &lt;div className="p-3 bg-rose-50 border border-rose-200 rounded-xl text-xs text-rose-700 flex items-center gap-2"&gt;
                &lt;AlertCircle className="w-4 h-4 shrink-0" /&gt;
                &lt;span&gt;{errorMessage}&lt;/span&gt;
              &lt;/div&gt;
            )}

            {/* Hidden container for Firebase Recaptcha */}
            &lt;div id="phone-recaptcha-container"&gt;&lt;/div&gt;

            &lt;button
              disabled={isLoading}
              onClick={() =&gt; handleSendOtp(false)}
              className="w-full py-3.5 bg-[#F47721] hover:bg-orange-600 text-white rounded-2xl font-black text-sm shadow-md transition-all flex items-center justify-center gap-2 disabled:opacity-50"
            &gt;
              {isLoading ? (
                &lt;span&gt;جاري إرسال رمز التحقق...&lt;/span&gt;
              ) : (
                &lt;&gt;
                  &lt;ShieldCheck className="w-4 h-4" /&gt;
                  &lt;span&gt;إرسال رمز التحقق (OTP)&lt;/span&gt;
                &lt;/&gt;
              )}
            &lt;/button&gt;
          &lt;/div&gt;
        )}

        {/* Step 2: Input OTP */}
        {step === 'input_otp' &amp;&amp; (
          &lt;div className="space-y-4"&gt;
            &lt;div className="text-center space-y-1"&gt;
              &lt;span className="text-xs text-slate-500"&gt;تم إرسال رمز التحقق إلى:&lt;/span&gt;
              &lt;p className="font-black text-slate-900 text-sm font-mono" dir="ltr"&gt;{getFullE164Phone()}&lt;/p&gt;
              &lt;button
                onClick={() =&gt; {
                  setStep('input_phone');
                  setOtpCode(['', '', '', '', '', '']);
                  setErrorMessage(null);
                }}
                className="text-[11px] text-orange-600 font-bold hover:underline"
              &gt;
                تغيير رقم الهاتف
              &lt;/button&gt;
            &lt;/div&gt;

            {/* OTP Digits Inputs */}
            &lt;div&gt;
              &lt;label className="block text-center text-xs font-bold text-slate-700 mb-2"&gt;
                أدخل رمز التأكيد (6 أرقام)
              &lt;/label&gt;
              &lt;div className="flex items-center justify-center gap-2" dir="ltr"&gt;
                {otpCode.map((digit, idx) =&gt; (
                  &lt;input
                    key={idx}
                    ref={(el) =&gt; { otpInputRefs.current[idx] = el; }}
                    type="text"
                    inputMode="numeric"
                    maxLength={1}
                    value={digit}
                    disabled={isLocked || isLoading}
                    onChange={(e) =&gt; handleOtpDigitChange(idx, e.target.value)}
                    onKeyDown={(e) =&gt; handleKeyDown(idx, e)}
                    className="w-11 h-13 text-center text-xl font-black rounded-xl border-2 border-slate-200 focus:border-orange-500 bg-slate-50 focus:bg-white outline-none transition-all"
                  /&gt;
                ))}
              &lt;/div&gt;
            &lt;/div&gt;

            {/* Expiry countdown and Resend button */}
            &lt;div className="flex items-center justify-between text-xs text-slate-500 pt-1"&gt;
              &lt;div className="flex items-center gap-1"&gt;
                &lt;Clock className="w-3.5 h-3.5 text-slate-400" /&gt;
                &lt;span&gt;
                  {countdown &gt; 0 ? (
                    &lt;&gt;إعادة الإرسال بعد: &lt;strong className="text-slate-800"&gt;{countdown} ثانية&lt;/strong&gt;&lt;/&gt;
                  ) : (
                    &lt;span className="text-emerald-600 font-bold"&gt;يمكنك إعادة إرسال الرمز الآن&lt;/span&gt;
                  )}
                &lt;/span&gt;
              &lt;/div&gt;
              &lt;button
                disabled={!canResend || isLocked || isLoading}
                onClick={() =&gt; handleSendOtp(isTestMode)}
                className="text-orange-600 font-bold hover:underline disabled:opacity-40 disabled:hover:no-underline flex items-center gap-1"
              &gt;
                &lt;RotateCcw className="w-3 h-3" /&gt;
                &lt;span&gt;إعادة إرسال&lt;/span&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            {/* Lockout Notice */}
            {isLocked ? (
              &lt;div className="p-3 bg-rose-50 border border-rose-300 rounded-xl text-xs text-rose-800 flex items-center gap-2"&gt;
                &lt;Lock className="w-4 h-4 text-rose-600 shrink-0" /&gt;
                &lt;span&gt;تم إيقاف المحاولات للحماية من التخمين. يرجى الانتظار {lockTimer} ثانية.&lt;/span&gt;
              &lt;/div&gt;
            ) : (
              &lt;div className="text-[11px] text-slate-400 flex items-center justify-between"&gt;
                &lt;span&gt;المحاولات المتبقية: &lt;strong className="text-slate-700"&gt;{attemptsRemaining}&lt;/strong&gt; من 3&lt;/span&gt;
                &lt;span&gt;صلاحية الرمز: دقيقتان&lt;/span&gt;
              &lt;/div&gt;
            )}

            {/* Error Message */}
            {errorMessage &amp;&amp; (
              &lt;div className="p-2.5 bg-rose-50 border border-rose-200 rounded-xl text-xs text-rose-700 flex items-center gap-2"&gt;
                &lt;AlertCircle className="w-4 h-4 shrink-0" /&gt;
                &lt;span&gt;{errorMessage}&lt;/span&gt;
              &lt;/div&gt;
            )}

            {/* Verify Button */}
            &lt;button
              disabled={isLoading || isLocked || otpCode.join('').length !== 6}
              onClick={handleVerifyOtp}
              className="w-full py-3.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl font-black text-sm shadow-md transition-all flex items-center justify-center gap-2 disabled:opacity-50"
            &gt;
              {isLoading ? (
                &lt;span&gt;جاري التحقق من الرمز...&lt;/span&gt;
              ) : (
                &lt;&gt;
                  &lt;CheckCircle2 className="w-4 h-4" /&gt;
                  &lt;span&gt;تأكيد الرمز وتوثيق الحساب&lt;/span&gt;
                &lt;/&gt;
              )}
            &lt;/button&gt;
          &lt;/div&gt;
        )}

        {/* Security &amp; Firebase Instructions footnote */}
        &lt;div className="pt-2 border-t border-slate-100 text-[10px] text-slate-400 space-y-1"&gt;
          &lt;p className="flex items-center gap-1"&gt;
            &lt;Info className="w-3 h-3 text-slate-400 shrink-0" /&gt;
            &lt;span&gt;نظام أمان Firebase Authentication يحمي حسابك من الطلبات الوهمية والتكرار.&lt;/span&gt;
          &lt;/p&gt;
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
};
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/common/RealInteractiveMap.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000037506&#65533;15267721203&#65533;020454&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import React, { useState, useEffect } from 'react';
import { OrderStatus, LocationCoordinates } from '../../types';
import {
  MapPin,
  Store,
  Navigation,
  Compass,
  AlertTriangle,
  CheckCircle2,
  Crosshair,
  ShieldAlert,
  Info,
  Clock,
  ExternalLink,
} from 'lucide-react';

interface RealInteractiveMapProps {
  status?: OrderStatus;
  storeName?: string;
  storeAddress?: string;
  customerAddress?: string;
  customerCoordinates?: LocationCoordinates;
  destinationCoords?: LocationCoordinates;
  courierName?: string;
  courierLocation?: {
    lat: number;
    lng: number;
    accuracy?: number;
    updatedAt: string;
    isSharingEnabled: boolean;
  };
  onCoordinatesChange?: (coords: LocationCoordinates) =&gt; void;
  onCoordinateSelect?: (coords: LocationCoordinates) =&gt; void;
  isInteractivePicker?: boolean; // For customer or merchant to pick or adjust location
}

// Baghdad default coordinates (Al-Mansour area)
const DEFAULT_BAGHDAD = { lat: 33.3130, lng: 44.3512, name: 'بغداد - المنصور' };

// Iraq Bounding Box for Fraud / Geofencing Check
const IRAQ_BOUNDS = {
  minLat: 29.0,
  maxLat: 38.0,
  minLng: 38.5,
  maxLng: 49.0,
};

export const RealInteractiveMap: React.FC&lt;RealInteractiveMapProps&gt; = ({
  status,
  storeName = 'موقع المتجر',
  storeAddress = 'بغداد - المنصور',
  customerAddress = 'عنوان الموقع المحدد',
  customerCoordinates,
  destinationCoords,
  courierName,
  courierLocation,
  onCoordinatesChange,
  onCoordinateSelect,
  isInteractivePicker = false,
}) =&gt; {
  const effectiveCoords = destinationCoords || customerCoordinates;
  const [currentCoords, setCurrentCoords] = useState&lt;LocationCoordinates&gt;(
    effectiveCoords || {
      lat: DEFAULT_BAGHDAD.lat,
      lng: DEFAULT_BAGHDAD.lng,
      accuracy: 25,
      isManualPin: true,
      verifiedAt: new Date().toLocaleTimeString('ar-IQ'),
    }
  );

  const [gpsStatus, setGpsStatus] = useState&lt;
    'idle' | 'requesting' | 'acquired' | 'denied' | 'weak' | 'out_of_bounds'
  &gt;('idle');
  const [accuracyNotice, setAccuracyNotice] = useState&lt;string | null&gt;(null);
  const [mapZoom, setMapZoom] = useState(14);

  // Check Iraq bounds
  const isInsideIraq = (lat: number, lng: number) =&gt; {
    return (
      lat &gt;= IRAQ_BOUNDS.minLat &amp;&amp;
      lat &lt;= IRAQ_BOUNDS.maxLat &amp;&amp;
      lng &gt;= IRAQ_BOUNDS.minLng &amp;&amp;
      lng &lt;= IRAQ_BOUNDS.maxLng
    );
  };

  // Real Geolocation API request
  const requestRealLocation = () =&gt; {
    if (!navigator.geolocation) {
      setGpsStatus('denied');
      setAccuracyNotice('متصفحك لا يدعم خدمة تحديد المواقع الجغرافية (Geolocation API).');
      return;
    }

    setGpsStatus('requesting');
    setAccuracyNotice('جاري طلب إذن الموقع الحقيقي من جهازك...');

    navigator.geolocation.getCurrentPosition(
      (pos) =&gt; {
        const { latitude, longitude, accuracy, altitude, speed } = pos.coords;

        // Check if inside Iraq
        if (!isInsideIraq(latitude, longitude)) {
          setGpsStatus('out_of_bounds');
          setAccuracyNotice(
            `تحذير: إحداثياتك (${latitude.toFixed(4)}, ${longitude.toFixed(4)}) تقع خارج جمهورية العراق. قد يكون سبب ذلك تشغيل تطبيق VPN أو أداة تغيير موقع.`
          );
        } else if (accuracy &gt; 800) {
          setGpsStatus('weak');
          setAccuracyNotice(
            `دقة إشارة GPS منخفضة (±${Math.round(accuracy)} متر). نوصي بتحديد مكانك بدقة على الخريطة وكتابة أقرب نقطة دالة.`
          );
        } else {
          setGpsStatus('acquired');
          setAccuracyNotice(`تم تحديد موقعك الحقيقي بنجاح بدقة ±${Math.round(accuracy)} متر.`);
        }

        // Mock check indicators (Zero accuracy, impossible speed/altitude combination)
        const mockSuspected = accuracy === 0 || (altitude === 0 &amp;&amp; speed === 0 &amp;&amp; accuracy &lt; 2);

        const newCoords: LocationCoordinates = {
          lat: latitude,
          lng: longitude,
          accuracy: Math.round(accuracy),
          isManualPin: false,
          mockSuspected,
          verifiedAt: new Date().toLocaleTimeString('ar-IQ'),
        };

        setCurrentCoords(newCoords);
        if (onCoordinatesChange) {
          onCoordinatesChange(newCoords);
        }
      },
      (err) =&gt; {
        setGpsStatus('denied');
        if (err.code === err.PERMISSION_DENIED) {
          setAccuracyNotice('تم رفض إذن الوصول للموقع. يمكنك سحب وتثبيت الدبوس يدوياً على الخريطة لتحديد عنوانك.');
        } else if (err.code === err.POSITION_UNAVAILABLE) {
          setAccuracyNotice('إشارة GPS غير متوفرة حالياً في موقعك. تم اعتماد التحديد اليدوي.');
        } else {
          setAccuracyNotice('انتهت مهلة طلب الموقع. يرجى التأكد من تشغيل الموقع في هاتفك.');
        }
      },
      {
        enableHighAccuracy: true,
        timeout: 12000,
        maximumAge: 0,
      }
    );
  };

  // Adjust pin slightly on map click (interactive picker)
  const handleMapClick = (e: React.MouseEvent&lt;HTMLDivElement&gt;) =&gt; {
    if (!isInteractivePicker) return;
    const rect = e.currentTarget.getBoundingClientRect();
    const x = e.clientX - rect.left;
    const y = e.clientY - rect.top;

    // Relative delta from center
    const deltaX = (x / rect.width - 0.5) * 0.02;
    const deltaY = (0.5 - y / rect.height) * 0.02;

    const newLat = Number((currentCoords.lat + deltaY).toFixed(5));
    const newLng = Number((currentCoords.lng + deltaX).toFixed(5));

    const updated: LocationCoordinates = {
      ...currentCoords,
      lat: newLat,
      lng: newLng,
      isManualPin: true,
      verifiedAt: new Date().toLocaleTimeString('ar-IQ'),
    };
    setCurrentCoords(updated);
    if (onCoordinatesChange) {
      onCoordinatesChange(updated);
    }
    if (onCoordinateSelect) {
      onCoordinateSelect(updated);
    }
  };

  // Open in real Google Maps or OpenStreetMap
  const openExternalMap = () =&gt; {
    const url = `https://www.google.com/maps/search/?api=1&amp;query=${currentCoords.lat},${currentCoords.lng}`;
    window.open(url, '_blank');
  };

  return (
    &lt;div className="w-full bg-slate-900 rounded-3xl overflow-hidden border border-slate-800 shadow-md flex flex-col text-white"&gt;
      {/* Top Map Bar with GPS Status &amp; Tools */}
      &lt;div className="px-4 py-3 bg-slate-950/90 border-b border-slate-800 flex flex-wrap items-center justify-between gap-2"&gt;
        &lt;div className="flex items-center gap-2"&gt;
          &lt;div className="w-8 h-8 rounded-xl bg-orange-500/20 text-orange-400 flex items-center justify-center"&gt;
            &lt;Compass className="w-4 h-4" /&gt;
          &lt;/div&gt;
          &lt;div&gt;
            &lt;span className="font-extrabold text-xs block text-slate-200"&gt;التحقق الجغرافي الحقيقي&lt;/span&gt;
            &lt;span className="text-[10px] text-slate-400"&gt;
              {currentCoords.lat.toFixed(4)}° N, {currentCoords.lng.toFixed(4)}° E
            &lt;/span&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Real Geolocation trigger button */}
        &lt;div className="flex items-center gap-2"&gt;
          {isInteractivePicker &amp;&amp; (
            &lt;button
              onClick={requestRealLocation}
              disabled={gpsStatus === 'requesting'}
              className="px-3 py-1.5 bg-[#F47721] hover:bg-orange-600 text-white rounded-xl text-xs font-bold transition-all flex items-center gap-1.5 shadow-sm disabled:opacity-50"
            &gt;
              &lt;Crosshair className={`w-3.5 h-3.5 ${gpsStatus === 'requesting' ? 'animate-spin' : ''}`} /&gt;
              &lt;span&gt;{gpsStatus === 'requesting' ? 'جاري الفحص...' : 'تحديد موقعي الفعلي'}&lt;/span&gt;
            &lt;/button&gt;
          )}

          &lt;button
            onClick={openExternalMap}
            className="p-1.5 bg-slate-800 hover:bg-slate-700 text-slate-300 rounded-xl text-xs transition-colors"
            title="فتح الإحداثيات في خرائط Google للتحقق الخارجي"
          &gt;
            &lt;ExternalLink className="w-4 h-4" /&gt;
          &lt;/button&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      {/* Accuracy Status Banner */}
      {accuracyNotice &amp;&amp; (
        &lt;div
          className={`px-4 py-2 text-xs flex items-center gap-2 border-b ${
            gpsStatus === 'acquired'
              ? 'bg-emerald-950/60 text-emerald-300 border-emerald-900/60'
              : gpsStatus === 'out_of_bounds'
              ? 'bg-rose-950/80 text-rose-300 border-rose-900/60'
              : 'bg-amber-950/60 text-amber-300 border-amber-900/60'
          }`}
        &gt;
          {gpsStatus === 'acquired' ? (
            &lt;CheckCircle2 className="w-4 h-4 shrink-0 text-emerald-400" /&gt;
          ) : gpsStatus === 'out_of_bounds' ? (
            &lt;ShieldAlert className="w-4 h-4 shrink-0 text-rose-400" /&gt;
          ) : (
            &lt;AlertTriangle className="w-4 h-4 shrink-0 text-amber-400" /&gt;
          )}
          &lt;span className="font-medium text-[11px] leading-tight"&gt;{accuracyNotice}&lt;/span&gt;
        &lt;/div&gt;
      )}

      {/* Interactive Map Visual Area */}
      &lt;div
        className="relative w-full h-64 bg-slate-900 overflow-hidden cursor-crosshair select-none"
        onClick={handleMapClick}
      &gt;
        {/* OpenStreetMap Real Static/Dynamic Tile Background */}
        &lt;div
          className="absolute inset-0 bg-cover bg-center opacity-80"
          style={{
            backgroundImage: `url('https://tile.openstreetmap.org/14/${Math.floor(
              ((currentCoords.lng + 180) / 360) * Math.pow(2, 14)
            )}/${Math.floor(
              ((1 -
                Math.log(
                  Math.tan((currentCoords.lat * Math.PI) / 180) +
                    1 / Math.cos((currentCoords.lat * Math.PI) / 180)
                ) /
                  Math.PI) /
                2) *
                Math.pow(2, 14)
            )}.png')`,
            filter: 'contrast(1.05) brightness(0.9)',
          }}
        /&gt;

        {/* Baghdad Cartographic Context Grid (Vector streets &amp; landmarks overlay) */}
        &lt;svg className="absolute inset-0 w-full h-full pointer-events-none opacity-40"&gt;
          &lt;line x1="0" y1="90" x2="600" y2="90" stroke="#0ea5e9" strokeWidth="18" strokeOpacity="0.3" /&gt;
          &lt;line x1="140" y1="0" x2="140" y2="300" stroke="#f59e0b" strokeWidth="4" /&gt;
          &lt;line x1="320" y1="0" x2="320" y2="300" stroke="#64748b" strokeWidth="4" /&gt;
          &lt;circle cx="200" cy="130" r="30" stroke="#f43f5e" strokeWidth="2" strokeDasharray="4 4" fill="none" /&gt;
        &lt;/svg&gt;

        {/* Store Location Pin */}
        &lt;div className="absolute top-12 left-14 z-10 flex flex-col items-center pointer-events-none transform -translate-x-1/2"&gt;
          &lt;div className="bg-[#172554] text-white text-[10px] font-bold px-2 py-0.5 rounded-full border border-slate-700 shadow-md mb-1 whitespace-nowrap flex items-center gap-1"&gt;
            &lt;Store className="w-3 h-3 text-orange-400" /&gt;
            &lt;span&gt;{storeName}&lt;/span&gt;
          &lt;/div&gt;
          &lt;div className="w-7 h-7 rounded-full bg-orange-600 text-white flex items-center justify-center shadow-lg border-2 border-white"&gt;
            &lt;Store className="w-3.5 h-3.5" /&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Customer Location Pin (Center / Dynamic) */}
        &lt;div className="absolute top-1/2 left-1/2 z-20 flex flex-col items-center pointer-events-none transform -translate-x-1/2 -translate-y-1/2"&gt;
          &lt;div className="bg-emerald-700 text-white text-[10px] font-black px-2.5 py-0.5 rounded-full border border-emerald-400 shadow-lg mb-1 whitespace-nowrap flex items-center gap-1"&gt;
            &lt;MapPin className="w-3 h-3 text-emerald-200" /&gt;
            &lt;span&gt;موقع التوصيل المحدد&lt;/span&gt;
          &lt;/div&gt;

          &lt;div className="relative"&gt;
            &lt;div className="w-9 h-9 rounded-full bg-emerald-500 text-white flex items-center justify-center shadow-2xl border-2 border-white animate-bounce"&gt;
              &lt;MapPin className="w-5 h-5 fill-white" /&gt;
            &lt;/div&gt;
            {/* Accuracy circle representation */}
            &lt;div
              className="absolute -inset-4 rounded-full border border-emerald-400/50 bg-emerald-500/10 animate-ping pointer-events-none"
              style={{ animationDuration: '3s' }}
            /&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Real Courier Location Marker (Displayed ONLY if courier explicitly consented &amp; shared) */}
        {courierLocation &amp;&amp; courierLocation.isSharingEnabled ? (
          &lt;div className="absolute bottom-12 right-16 z-20 flex flex-col items-center pointer-events-none"&gt;
            &lt;div className="bg-[#172554] text-white text-[10px] font-bold px-2 py-0.5 rounded-full border border-orange-400 shadow mb-1 flex items-center gap-1"&gt;
              &lt;Navigation className="w-3 h-3 text-orange-400" /&gt;
              &lt;span&gt;{courierName || 'الكابتن'} (موقع GPS حقيقي)&lt;/span&gt;
            &lt;/div&gt;
            &lt;div className="w-8 h-8 rounded-full bg-[#172554] border-2 border-orange-400 text-orange-400 flex items-center justify-center shadow-xl"&gt;
              &lt;Navigation className="w-4 h-4 animate-pulse" /&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        ) : null}

        {/* Interactive Notice on canvas */}
        {isInteractivePicker &amp;&amp; (
          &lt;div className="absolute bottom-2 left-2 right-2 bg-slate-950/80 backdrop-blur-xs px-3 py-1.5 rounded-xl border border-slate-800 text-[10px] text-slate-300 flex items-center justify-between pointer-events-none"&gt;
            &lt;span&gt;اضغط في أي مكان على الخريطة لتعديل وتثبيت الدبوس بدقة&lt;/span&gt;
            &lt;span className="text-orange-400 font-bold"&gt;دبوس يدوي دقيق&lt;/span&gt;
          &lt;/div&gt;
        )}
      &lt;/div&gt;

      {/* Courier Sharing Status Footer */}
      &lt;div className="p-3 bg-slate-950 text-xs border-t border-slate-800 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-2"&gt;
        &lt;div className="flex items-center gap-2"&gt;
          &lt;div className="w-2 h-2 rounded-full bg-emerald-500"&gt;&lt;/div&gt;
          &lt;span className="text-slate-300"&gt;
            العنوان: &lt;strong className="text-white"&gt;{customerAddress}&lt;/strong&gt;
          &lt;/span&gt;
        &lt;/div&gt;

        &lt;div className="text-[11px] text-slate-400 flex items-center gap-1.5"&gt;
          {courierLocation?.isSharingEnabled ? (
            &lt;span className="text-emerald-400 font-bold flex items-center gap-1"&gt;
              &lt;CheckCircle2 className="w-3.5 h-3.5" /&gt;
              موقع الكابتن مباشر وموثق (آخر إشارة: {courierLocation.updatedAt})
            &lt;/span&gt;
          ) : (
            &lt;span className="text-slate-400 flex items-center gap-1"&gt;
              &lt;Clock className="w-3.5 h-3.5" /&gt;
              {status === 'courier_assigned' || status === 'picked_up'
                ? 'المندوب لم يفعل مشاركة موقعه المباشر بعد'
                : 'يتم تفعيل موقع المندوب بعد الاستلام والتحرك'}
            &lt;/span&gt;
          )}
        &lt;/div&gt;
      &lt;/div&gt;

      {/* Technical Disclaimer on Verification Limits */}
      &lt;div className="px-4 py-2 bg-slate-900 border-t border-slate-800 text-[10px] text-slate-400 flex items-start gap-1.5"&gt;
        &lt;Info className="w-3.5 h-3.5 text-slate-500 shrink-0 mt-0.5" /&gt;
        &lt;p&gt;
          &lt;strong&gt;ضمان الشفافية وحدود التحقق:&lt;/strong&gt; يتحقق التطبيق من النطاق الجغرافي داخل العراق ودقة إشارة
          المستشعر. نظراً لأن أدوات تزييف المواقع العميقة (Mock Location Providers) على بعض الأجهزة قد تحاكي نظام
          GPS، فإننا نلزم بتأكيد العنوان كتابياً ونقطة دالة معروفة لضمان وصول الطلب بنجاح.
        &lt;/p&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
};

export default RealInteractiveMap;

&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/common/SimulatedMap.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000002262&#65533;15267721203&#65533;017311&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import React from 'react';
import { OrderStatus, LocationCoordinates } from '../../types';
import { RealInteractiveMap } from './RealInteractiveMap';

interface SimulatedMapProps {
  status: OrderStatus;
  storeName: string;
  storeAddress: string;
  customerAddress: string;
  courierName?: string;
  courierVehicle?: string;
  customerCoordinates?: LocationCoordinates;
  courierLocation?: {
    lat: number;
    lng: number;
    accuracy?: number;
    updatedAt: string;
    isSharingEnabled: boolean;
  };
}

/**
 * Clean replacement for SimulatedMap that eliminates fake trails and displays real coordinates,
 * geofence boundaries in Iraq, and explicit courier GPS consent status.
 */
export const SimulatedMap: React.FC&lt;SimulatedMapProps&gt; = ({
  status,
  storeName,
  storeAddress,
  customerAddress,
  courierName,
  customerCoordinates,
  courierLocation,
}) =&gt; {
  return (
    &lt;RealInteractiveMap
      status={status}
      storeName={storeName}
      storeAddress={storeAddress}
      customerAddress={customerAddress}
      courierName={courierName}
      customerCoordinates={customerCoordinates}
      courierLocation={courierLocation}
      isInteractivePicker={false}
    /&gt;
  );
};
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/common/InAppSupportChatModal.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000012223&#65533;15267721203&#65533;021103&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import React, { useState } from 'react';
import { useApp } from '../../context/AppContext';
import {
  X,
  Send,
  Headphones,
  HelpCircle,
  AlertCircle,
  MessageSquare,
  Sparkles,
} from 'lucide-react';

interface InAppSupportChatModalProps {
  isOpen: boolean;
  onClose: () =&gt; void;
  relatedOrderId?: string;
}

export const InAppSupportChatModal: React.FC&lt;InAppSupportChatModalProps&gt; = ({
  isOpen,
  onClose,
  relatedOrderId,
}) =&gt; {
  const {
    conversations,
    currentUser,
    startSupportConversation,
    sendSupportMessage,
  } = useApp();

  const [inputMessage, setInputMessage] = useState('');
  const [subjectInput, setSubjectInput] = useState(
    relatedOrderId ? `استفسار حول الطلب #${relatedOrderId}` : 'استفسار أو شكوى عامة'
  );

  if (!isOpen) return null;

  // Find existing conversation for this user and order, or latest
  const userConv = conversations.find(
    (c) =&gt;
      c.userId === currentUser.id &amp;&amp;
      (relatedOrderId ? c.relatedOrderId === relatedOrderId : true)
  ) || conversations.find((c) =&gt; c.userId === currentUser.id);

  const handleSend = (e: React.FormEvent) =&gt; {
    e.preventDefault();
    if (!inputMessage.trim()) return;

    if (userConv) {
      sendSupportMessage(userConv.id, inputMessage.trim());
    } else {
      const newId = startSupportConversation(subjectInput, relatedOrderId);
      sendSupportMessage(newId, inputMessage.trim());
    }
    setInputMessage('');
  };

  return (
    &lt;div className="fixed inset-0 z-50 flex items-center justify-center p-3 bg-black/60 backdrop-blur-sm animate-in fade-in text-slate-800"&gt;
      &lt;div className="bg-white rounded-3xl w-full max-w-md shadow-2xl border border-slate-100 flex flex-col max-h-[85vh] overflow-hidden"&gt;
        {/* Header */}
        &lt;div className="p-4 bg-[#172554] text-white flex items-center justify-between"&gt;
          &lt;div className="flex items-center gap-2.5"&gt;
            &lt;div className="w-8 h-8 rounded-xl bg-orange-500 flex items-center justify-center text-white"&gt;
              &lt;Headphones className="w-4 h-4" /&gt;
            &lt;/div&gt;
            &lt;div&gt;
              &lt;h3 className="font-extrabold text-xs"&gt;الدعم الفني والشكاوى المباشر&lt;/h3&gt;
              &lt;p className="text-[10px] text-slate-300"&gt;
                {relatedOrderId ? `بخصوص الطلب #${relatedOrderId}` : 'فريق خدمة عملاء طلبي متاح لمساعدتك'}
              &lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;
          &lt;button
            onClick={onClose}
            className="w-7 h-7 rounded-full bg-slate-800 text-slate-300 hover:text-white flex items-center justify-center text-xs"
          &gt;
            ✕
          &lt;/button&gt;
        &lt;/div&gt;

        {/* Messages Body */}
        &lt;div className="flex-1 p-4 overflow-y-auto space-y-3 bg-[#f8fafc]"&gt;
          {!userConv ? (
            &lt;div className="text-center py-6 space-y-3"&gt;
              &lt;MessageSquare className="w-10 h-10 text-orange-400 mx-auto" /&gt;
              &lt;p className="text-xs font-bold text-slate-700"&gt;مرحباً بك في خدمة عملاء طلبي!&lt;/p&gt;
              &lt;p className="text-[11px] text-slate-500 max-w-xs mx-auto"&gt;
                اكتب استفسارك أو مشكلتك وسيجيب عليك أحد موظفي الدعم فوراً.
              &lt;/p&gt;
            &lt;/div&gt;
          ) : (
            userConv.messages.map((m) =&gt; {
              const isStaff = m.isAgent;
              return (
                &lt;div
                  key={m.id}
                  className={`flex flex-col max-w-[85%] ${
                    isStaff ? 'mr-auto items-end' : 'ml-auto items-start'
                  }`}
                &gt;
                  &lt;div
                    className={`p-3 rounded-2xl text-xs leading-relaxed shadow-xs ${
                      isStaff
                        ? 'bg-[#172554] text-white rounded-tr-xs'
                        : 'bg-white text-slate-800 border border-slate-200 rounded-tl-xs'
                    }`}
                  &gt;
                    &lt;p&gt;{m.text}&lt;/p&gt;
                  &lt;/div&gt;
                  &lt;span className="text-[10px] text-slate-400 mt-0.5 px-1"&gt;
                    {m.senderName} • {m.timestamp}
                  &lt;/span&gt;
                &lt;/div&gt;
              );
            })
          )}
        &lt;/div&gt;

        {/* Input */}
        &lt;form onSubmit={handleSend} className="p-3 bg-white border-t border-slate-200 flex items-center gap-2"&gt;
          &lt;input
            type="text"
            placeholder="اكتب رسالتك أو تفاصيل الشكوى هنا..."
            value={inputMessage}
            onChange={(e) =&gt; setInputMessage(e.target.value)}
            className="flex-1 p-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:border-orange-500"
          /&gt;
          &lt;button
            type="submit"
            disabled={!inputMessage.trim()}
            className="px-4 py-2.5 bg-[#F47721] hover:bg-orange-600 disabled:opacity-50 text-white rounded-xl font-bold text-xs shadow flex items-center gap-1 transition-colors"
          &gt;
            &lt;Send className="w-3.5 h-3.5" /&gt;
            &lt;span&gt;إرسال&lt;/span&gt;
          &lt;/button&gt;
        &lt;/form&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
};
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/common/NotificationsToast.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000005652&#65533;15267721203&#65533;020556&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import React from 'react';
import { useApp } from '../../context/AppContext';
import { CheckCircle2, AlertTriangle, AlertCircle, Info, X } from 'lucide-react';

export const NotificationsToast: React.FC = () =&gt; {
  const { notifications, dismissNotification, setActiveTrackedOrderId, setRole } = useApp();

  if (notifications.length === 0) return null;

  return (
    &lt;div className="fixed top-4 left-4 z-50 flex flex-col gap-2 max-w-sm w-full pointer-events-none"&gt;
      {notifications.map((n) =&gt; {
        const getIcon = () =&gt; {
          switch (n.type) {
            case 'success':
              return &lt;CheckCircle2 className="w-5 h-5 text-emerald-500 shrink-0" /&gt;;
            case 'warning':
              return &lt;AlertTriangle className="w-5 h-5 text-amber-500 shrink-0" /&gt;;
            case 'error':
              return &lt;AlertCircle className="w-5 h-5 text-rose-500 shrink-0" /&gt;;
            default:
              return &lt;Info className="w-5 h-5 text-sky-500 shrink-0" /&gt;;
          }
        };

        const getBorder = () =&gt; {
          switch (n.type) {
            case 'success':
              return 'border-emerald-500/30 bg-emerald-950/80 text-emerald-100';
            case 'warning':
              return 'border-amber-500/30 bg-amber-950/80 text-amber-100';
            case 'error':
              return 'border-rose-500/30 bg-rose-950/80 text-rose-100';
            default:
              return 'border-sky-500/30 bg-slate-900/95 text-slate-100';
          }
        };

        return (
          &lt;div
            key={n.id}
            className={`pointer-events-auto p-3.5 rounded-xl border shadow-2xl backdrop-blur-md flex items-start gap-3 transition-all duration-300 animate-in slide-in-from-top-2 ${getBorder()}`}
          &gt;
            {getIcon()}
            &lt;div className="flex-1 min-w-0"&gt;
              &lt;div className="flex items-center justify-between gap-1"&gt;
                &lt;h4 className="text-xs font-bold leading-tight"&gt;{n.title}&lt;/h4&gt;
                &lt;span className="text-[10px] opacity-60"&gt;{n.timestamp}&lt;/span&gt;
              &lt;/div&gt;
              &lt;p className="text-xs mt-0.5 opacity-90 leading-relaxed break-words"&gt;{n.message}&lt;/p&gt;
              {n.orderId &amp;&amp; (
                &lt;button
                  onClick={() =&gt; {
                    setActiveTrackedOrderId(n.orderId!);
                    setRole('customer');
                    dismissNotification(n.id);
                  }}
                  className="mt-2 text-[11px] font-bold text-orange-400 hover:text-orange-300 underline"
                &gt;
                  عرض تفاصيل الطلب #{n.orderId}
                &lt;/button&gt;
              )}
            &lt;/div&gt;
            &lt;button
              onClick={() =&gt; dismissNotification(n.id)}
              className="text-slate-400 hover:text-white p-0.5 rounded-lg transition-colors"
            &gt;
              &lt;X className="w-4 h-4" /&gt;
            &lt;/button&gt;
          &lt;/div&gt;
        );
      })}
    &lt;/div&gt;
  );
};
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/support/&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000755&#65533;0000000&#65533;0000000&#65533;00000000000&#65533;15267721203&#65533;014406&#65533; 5&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/support/SupportDeskView.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000036272&#65533;15267721203&#65533;020276&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import React, { useState } from 'react';
import { useApp } from '../../context/AppContext';
import { CANNED_SUPPORT_RESPONSES } from '../../data/initialData';
import {
  Headphones,
  Search,
  Send,
  User,
  Bike,
  CheckCircle2,
  Clock,
  Sparkles,
  Phone,
  MessageSquare,
  AlertCircle,
  ExternalLink,
} from 'lucide-react';

export const SupportDeskView: React.FC = () =&gt; {
  const {
    conversations,
    activeConversationId,
    setActiveConversationId,
    sendSupportMessage,
    updateConversationStatus,
    setActiveTrackedOrderId,
    setRole,
  } = useApp();

  const [filterType, setFilterType] = useState&lt;'all' | 'customer' | 'courier' | 'open'&gt;('all');
  const [searchQuery, setSearchQuery] = useState('');
  const [inputText, setInputText] = useState('');

  const currentConv = conversations.find((c) =&gt; c.id === activeConversationId) || conversations[0];

  const filteredConversations = conversations.filter((c) =&gt; {
    const matchesSearch =
      c.userName.toLowerCase().includes(searchQuery.toLowerCase()) ||
      c.subject.toLowerCase().includes(searchQuery.toLowerCase()) ||
      (c.relatedOrderId &amp;&amp; c.relatedOrderId.includes(searchQuery));
    if (!matchesSearch) return false;

    if (filterType === 'customer') return c.userRole === 'customer';
    if (filterType === 'courier') return c.userRole === 'courier';
    if (filterType === 'open') return c.status === 'open';
    return true;
  });

  const handleSendMessage = (e: React.FormEvent) =&gt; {
    e.preventDefault();
    if (!inputText.trim() || !currentConv) return;
    sendSupportMessage(currentConv.id, inputText.trim());
    setInputText('');
  };

  const handleUseCanned = (phrase: string) =&gt; {
    if (!currentConv) return;
    sendSupportMessage(currentConv.id, phrase);
  };

  return (
    &lt;div className="max-w-6xl mx-auto px-4 py-6 text-slate-800"&gt;
      {/* Top Banner */}
      &lt;div className="bg-gradient-to-r from-[#172554] to-slate-900 text-white rounded-3xl p-5 mb-5 shadow-lg flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"&gt;
        &lt;div className="flex items-center gap-3"&gt;
          &lt;div className="w-12 h-12 rounded-2xl bg-orange-500/20 border border-orange-500/40 flex items-center justify-center text-orange-400"&gt;
            &lt;Headphones className="w-6 h-6" /&gt;
          &lt;/div&gt;
          &lt;div&gt;
            &lt;h2 className="font-black text-lg text-white"&gt;مركز خدمة العملاء والدعم الفني المباشر&lt;/h2&gt;
            &lt;p className="text-xs text-slate-300"&gt;محادثات الدعم الفوري للزبائن ومناديب التوصيل في العراق&lt;/p&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        &lt;div className="flex items-center gap-2"&gt;
          &lt;span className="text-xs bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-3 py-1 rounded-full font-bold"&gt;
            النظام يعمل بكفاءة 100%
          &lt;/span&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      {/* Main Support Grid */}
      &lt;div className="bg-white rounded-3xl border border-slate-200 shadow-sm overflow-hidden grid grid-cols-1 md:grid-cols-12 min-h-[580px]"&gt;
        {/* Left / Inbox Column (5 cols) */}
        &lt;div className="md:col-span-5 border-l border-slate-200 flex flex-col bg-slate-50/60"&gt;
          {/* Search &amp; Filter */}
          &lt;div className="p-3.5 border-b border-slate-200 space-y-2 bg-white"&gt;
            &lt;div className="relative"&gt;
              &lt;Search className="w-4 h-4 text-slate-400 absolute right-3 top-3 pointer-events-none" /&gt;
              &lt;input
                type="text"
                placeholder="بحث بالاسم، الموضوع، أو رقم الطلب..."
                value={searchQuery}
                onChange={(e) =&gt; setSearchQuery(e.target.value)}
                className="w-full pr-9 pl-3 py-2 text-xs rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:outline-none focus:border-orange-500"
              /&gt;
            &lt;/div&gt;

            &lt;div className="flex items-center gap-1.5 overflow-x-auto text-[11px] font-bold"&gt;
              &lt;button
                onClick={() =&gt; setFilterType('all')}
                className={`px-2.5 py-1 rounded-lg transition-colors whitespace-nowrap ${
                  filterType === 'all' ? 'bg-[#172554] text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
                }`}
              &gt;
                الكل ({conversations.length})
              &lt;/button&gt;
              &lt;button
                onClick={() =&gt; setFilterType('open')}
                className={`px-2.5 py-1 rounded-lg transition-colors whitespace-nowrap ${
                  filterType === 'open' ? 'bg-[#172554] text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
                }`}
              &gt;
                مفتوحة ({conversations.filter((c) =&gt; c.status === 'open').length})
              &lt;/button&gt;
              &lt;button
                onClick={() =&gt; setFilterType('customer')}
                className={`px-2.5 py-1 rounded-lg transition-colors whitespace-nowrap ${
                  filterType === 'customer' ? 'bg-[#172554] text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
                }`}
              &gt;
                الزبائن
              &lt;/button&gt;
              &lt;button
                onClick={() =&gt; setFilterType('courier')}
                className={`px-2.5 py-1 rounded-lg transition-colors whitespace-nowrap ${
                  filterType === 'courier' ? 'bg-[#172554] text-white' : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
                }`}
              &gt;
                المناديب
              &lt;/button&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          {/* Conversations list */}
          &lt;div className="flex-1 overflow-y-auto divide-y divide-slate-100"&gt;
            {filteredConversations.length === 0 ? (
              &lt;p className="p-6 text-center text-xs text-slate-400"&gt;لا توجد محادثات تطابق البحث&lt;/p&gt;
            ) : (
              filteredConversations.map((c) =&gt; {
                const isSelected = currentConv?.id === c.id;
                return (
                  &lt;div
                    key={c.id}
                    onClick={() =&gt; setActiveConversationId(c.id)}
                    className={`p-3.5 cursor-pointer transition-all ${
                      isSelected
                        ? 'bg-orange-50/80 border-r-4 border-r-orange-500'
                        : 'hover:bg-slate-100/70'
                    }`}
                  &gt;
                    &lt;div className="flex items-start justify-between gap-2"&gt;
                      &lt;div className="flex items-center gap-2"&gt;
                        &lt;div
                          className={`w-7 h-7 rounded-full flex items-center justify-center text-xs font-bold ${
                            c.userRole === 'courier'
                              ? 'bg-orange-100 text-orange-800'
                              : 'bg-sky-100 text-sky-800'
                          }`}
                        &gt;
                          {c.userRole === 'courier' ? &lt;Bike className="w-3.5 h-3.5" /&gt; : &lt;User className="w-3.5 h-3.5" /&gt;}
                        &lt;/div&gt;
                        &lt;div&gt;
                          &lt;h4 className="text-xs font-bold text-slate-900"&gt;{c.userName}&lt;/h4&gt;
                          &lt;span className="text-[10px] text-slate-400"&gt;{c.userPhone}&lt;/span&gt;
                        &lt;/div&gt;
                      &lt;/div&gt;
                      &lt;span className="text-[10px] text-slate-400"&gt;{c.lastUpdated}&lt;/span&gt;
                    &lt;/div&gt;

                    &lt;p className="text-xs font-semibold text-slate-700 mt-1 line-clamp-1"&gt;
                      {c.subject}
                    &lt;/p&gt;
                    &lt;p className="text-[11px] text-slate-500 mt-0.5 line-clamp-1"&gt;
                      {c.lastMessage}
                    &lt;/p&gt;

                    &lt;div className="flex items-center justify-between mt-2 pt-1"&gt;
                      {c.relatedOrderId ? (
                        &lt;span className="text-[10px] font-bold text-orange-600 bg-orange-100/60 px-1.5 py-0.2 rounded"&gt;
                          طلب #{c.relatedOrderId}
                        &lt;/span&gt;
                      ) : (
                        &lt;span&gt;&lt;/span&gt;
                      )}
                      &lt;span
                        className={`text-[10px] font-bold px-2 py-0.2 rounded-full ${
                          c.status === 'open'
                            ? 'bg-amber-100 text-amber-800'
                            : c.status === 'pending'
                            ? 'bg-sky-100 text-sky-800'
                            : 'bg-emerald-100 text-emerald-800'
                        }`}
                      &gt;
                        {c.status === 'open' ? 'تذكرة مفتوحة' : c.status === 'pending' ? 'قيد المتابعة' : 'تم الحل'}
                      &lt;/span&gt;
                    &lt;/div&gt;
                  &lt;/div&gt;
                );
              })
            )}
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Right / Chat Thread Column (7 cols) */}
        {currentConv ? (
          &lt;div className="md:col-span-7 flex flex-col bg-white"&gt;
            {/* Chat Header */}
            &lt;div className="p-3.5 border-b border-slate-200 flex items-center justify-between bg-slate-50"&gt;
              &lt;div className="flex items-center gap-2.5"&gt;
                &lt;div
                  className={`w-9 h-9 rounded-full flex items-center justify-center font-bold text-sm ${
                    currentConv.userRole === 'courier'
                      ? 'bg-orange-100 text-orange-800'
                      : 'bg-sky-100 text-sky-800'
                  }`}
                &gt;
                  {currentConv.userRole === 'courier' ? &lt;Bike className="w-5 h-5" /&gt; : &lt;User className="w-5 h-5" /&gt;}
                &lt;/div&gt;
                &lt;div&gt;
                  &lt;div className="flex items-center gap-1.5"&gt;
                    &lt;h3 className="font-extrabold text-xs text-slate-900"&gt;{currentConv.userName}&lt;/h3&gt;
                    &lt;span className="text-[10px] bg-slate-200 text-slate-700 px-1.5 rounded font-semibold"&gt;
                      {currentConv.userRole === 'courier' ? 'مندوب' : 'زبون'}
                    &lt;/span&gt;
                  &lt;/div&gt;
                  &lt;p className="text-[11px] text-slate-500"&gt;{currentConv.subject}&lt;/p&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Action buttons: Resolve / View Order */}
              &lt;div className="flex items-center gap-2"&gt;
                {currentConv.relatedOrderId &amp;&amp; (
                  &lt;button
                    onClick={() =&gt; {
                      setActiveTrackedOrderId(currentConv.relatedOrderId!);
                      setRole('customer');
                    }}
                    className="p-1.5 text-xs text-orange-600 hover:bg-orange-50 rounded-lg flex items-center gap-1 font-bold border border-orange-200"
                    title="معاينة الطلب المتعلق بالتذكرة"
                  &gt;
                    &lt;ExternalLink className="w-3.5 h-3.5" /&gt;
                    &lt;span&gt;الطلب #{currentConv.relatedOrderId}&lt;/span&gt;
                  &lt;/button&gt;
                )}

                &lt;button
                  onClick={() =&gt;
                    updateConversationStatus(
                      currentConv.id,
                      currentConv.status === 'resolved' ? 'open' : 'resolved'
                    )
                  }
                  className={`text-xs font-bold px-3 py-1.5 rounded-xl border flex items-center gap-1 transition-colors ${
                    currentConv.status === 'resolved'
                      ? 'bg-slate-100 text-slate-700 border-slate-300'
                      : 'bg-emerald-50 text-emerald-700 border-emerald-300 hover:bg-emerald-100'
                  }`}
                &gt;
                  &lt;CheckCircle2 className="w-3.5 h-3.5" /&gt;
                  &lt;span&gt;{currentConv.status === 'resolved' ? 'إعادة فتح' : 'إغلاق وحل المشكلة'}&lt;/span&gt;
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            {/* Messages body */}
            &lt;div className="flex-1 p-4 overflow-y-auto space-y-3 bg-[#f8fafc]/50"&gt;
              {currentConv.messages.map((m) =&gt; {
                const isStaff = m.isAgent;
                return (
                  &lt;div
                    key={m.id}
                    className={`flex flex-col max-w-[80%] ${
                      isStaff ? 'mr-auto items-end' : 'ml-auto items-start'
                    }`}
                  &gt;
                    &lt;div
                      className={`p-3 rounded-2xl text-xs leading-relaxed shadow-xs ${
                        isStaff
                          ? 'bg-[#172554] text-white rounded-tr-xs'
                          : 'bg-white text-slate-800 border border-slate-200 rounded-tl-xs'
                      }`}
                    &gt;
                      &lt;p&gt;{m.text}&lt;/p&gt;
                    &lt;/div&gt;
                    &lt;div className="flex items-center gap-1 mt-1 text-[10px] text-slate-400"&gt;
                      &lt;span&gt;{m.senderName}&lt;/span&gt;
                      &lt;span&gt;•&lt;/span&gt;
                      &lt;span&gt;{m.timestamp}&lt;/span&gt;
                    &lt;/div&gt;
                  &lt;/div&gt;
                );
              })}
            &lt;/div&gt;

            {/* Canned Quick Responses */}
            &lt;div className="px-4 py-2 border-t border-slate-100 bg-white"&gt;
              &lt;div className="flex items-center gap-1.5 overflow-x-auto text-[11px] pb-1 scrollbar-none"&gt;
                &lt;span className="text-slate-400 font-bold shrink-0 flex items-center gap-1"&gt;
                  &lt;Sparkles className="w-3 h-3 text-orange-500" /&gt;
                  ردود جاهزة:
                &lt;/span&gt;
                {CANNED_SUPPORT_RESPONSES.map((resp, i) =&gt; (
                  &lt;button
                    key={i}
                    onClick={() =&gt; handleUseCanned(resp)}
                    className="bg-slate-100 hover:bg-orange-50 hover:text-orange-900 border border-slate-200 text-slate-700 px-2.5 py-1 rounded-full whitespace-nowrap text-[10px] font-medium transition-colors"
                  &gt;
                    {resp}
                  &lt;/button&gt;
                ))}
              &lt;/div&gt;
            &lt;/div&gt;

            {/* Chat Input */}
            &lt;form onSubmit={handleSendMessage} className="p-3 border-t border-slate-200 bg-white flex items-center gap-2"&gt;
              &lt;input
                type="text"
                placeholder="اكتب ردك للعميل أو الكابتن هنا..."
                value={inputText}
                onChange={(e) =&gt; setInputText(e.target.value)}
                className="flex-1 p-2.5 rounded-xl border border-slate-200 text-xs focus:outline-none focus:border-orange-500"
              /&gt;
              &lt;button
                type="submit"
                disabled={!inputText.trim()}
                className="px-4 py-2.5 bg-[#F47721] hover:bg-orange-600 disabled:opacity-50 text-white rounded-xl font-bold text-xs shadow flex items-center gap-1 transition-colors"
              &gt;
                &lt;Send className="w-3.5 h-3.5" /&gt;
                &lt;span&gt;إرسال&lt;/span&gt;
              &lt;/button&gt;
            &lt;/form&gt;
          &lt;/div&gt;
        ) : (
          &lt;div className="md:col-span-7 flex items-center justify-center text-slate-400 text-xs p-8"&gt;
            اختر محادثة لعرض التفاصيل
          &lt;/div&gt;
        )}
      &lt;/div&gt;
    &lt;/div&gt;
  );
};
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/merchant/&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000755&#65533;0000000&#65533;0000000&#65533;00000000000&#65533;15267721203&#65533;014473&#65533; 5&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/merchant/MerchantView.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000213046&#65533;15267761734&#65533;017652&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import React, { useState, useRef } from 'react';
import { useApp } from '../../context/AppContext';
import { OrderStatus, Product, ProductOptionGroup, ProductOptionItem, Store as StoreType } from '../../types';
import {
  Store,
  CheckCircle2,
  XCircle,
  Clock,
  Utensils,
  Plus,
  Edit2,
  Trash2,
  Power,
  Volume2,
  VolumeX,
  PackageCheck,
  Bike,
  AlertCircle,
  Check,
  ChevronDown,
  Star,
  MessageSquare,
  ShieldCheck,
  Image as ImageIcon,
  Upload,
  Settings,
  ListPlus,
  Layers,
  Save,
  Phone,
  MapPin,
  DollarSign,
  Eye,
  RefreshCw,
  X,
} from 'lucide-react';

export const MerchantView: React.FC = () =&gt; {
  const {
    stores,
    products,
    orders,
    toggleStoreOpen,
    toggleProductAvailability,
    updateProductPrice,
    addProduct,
    updateProduct,
    deleteProduct,
    updateStore,
    uploadImageFile,
    updateOrderStatus,
    cancelOrder,
    getStoreRatings,
    pricingSettings,
  } = useApp();

  // Active Store Selection
  const [activeStoreId, setActiveStoreId] = useState&lt;string&gt;(stores[0]?.id || 'store_1');

  // Main Tabs: 6 dedicated sections
  const [activeTab, setActiveTab] = useState&lt;'orders' | 'menu' | 'options' | 'media' | 'settings' | 'reviews'&gt;('orders');

  // Order status filter in orders tab
  const [orderFilter, setOrderFilter] = useState&lt;'all' | 'created' | 'preparing' | 'ready' | 'picked_up' | 'delivered'&gt;('all');
  const [soundEnabled, setSoundEnabled] = useState(true);
  const [reviewStarFilter, setReviewStarFilter] = useState&lt;number | null&gt;(null);

  // Active Store &amp; Data
  const currentStore = stores.find((s) =&gt; s.id === activeStoreId) || stores[0];
  const storeOrders = orders.filter((o) =&gt; o.storeId === activeStoreId);
  const storeProducts = products.filter((p) =&gt; p.storeId === activeStoreId);
  const storeRatings = getStoreRatings(activeStoreId);

  // Store Settings Form State
  const [settingsForm, setSettingsForm] = useState({
    name: currentStore.name,
    description: currentStore.description,
    address: currentStore.address,
    neighborhood: currentStore.neighborhood,
    phone: currentStore.phone || '07801234567',
    openingHours: currentStore.openingHours || '11:00 ص - 12:00 منتصف الليل',
    deliveryFee: currentStore.deliveryFee,
    minimumOrder: currentStore.minimumOrder,
    banner: currentStore.banner,
    logo: currentStore.logo,
  });
  const [isSavingSettings, setIsSavingSettings] = useState(false);
  const [settingsSuccessMessage, setSettingsSuccessMessage] = useState&lt;string | null&gt;(null);

  // Sync settings form when activeStoreId changes
  React.useEffect(() =&gt; {
    if (currentStore) {
      setSettingsForm({
        name: currentStore.name,
        description: currentStore.description,
        address: currentStore.address,
        neighborhood: currentStore.neighborhood,
        phone: currentStore.phone || '07801234567',
        openingHours: currentStore.openingHours || '11:00 ص - 12:00 منتصف الليل',
        deliveryFee: currentStore.deliveryFee,
        minimumOrder: currentStore.minimumOrder,
        banner: currentStore.banner,
        logo: currentStore.logo,
      });
    }
  }, [activeStoreId, currentStore]);

  // Product Add / Edit Modal State
  const [isProductModalOpen, setIsProductModalOpen] = useState(false);
  const [editingProductId, setEditingProductId] = useState&lt;string | null&gt;(null);
  const [prodForm, setProdForm] = useState&lt;{
    name: string;
    description: string;
    price: number;
    category: string;
    imageUrl: string;
    preparationTimeMinutes: number;
    optionGroups: ProductOptionGroup[];
  }&gt;({
    name: '',
    description: '',
    price: 8000,
    category: 'أطباق رئيسية',
    imageUrl: 'https://images.unsplash.com/photo-1544025162-d76694265947?w=500&amp;auto=format&amp;fit=crop&amp;q=80',
    preparationTimeMinutes: 20,
    optionGroups: [],
  });
  const [isUploadingProdImg, setIsUploadingProdImg] = useState(false);

  // Option Group Builder Modal State (Inside product or standalone)
  const [isGroupBuilderOpen, setIsGroupBuilderOpen] = useState(false);
  const [groupBuilderTargetProduct, setGroupBuilderTargetProduct] = useState&lt;Product | null&gt;(null);
  const [newGroupTitle, setNewGroupTitle] = useState('');
  const [newGroupRequired, setNewGroupRequired] = useState(true);
  const [newGroupMaxSelect, setNewGroupMaxSelect] = useState(1);
  const [newGroupItems, setNewGroupItems] = useState&lt;{ id: string; name: string; price: number }[]&gt;([
    { id: 'item_1', name: 'عادي / وسط', price: 0 },
    { id: 'item_2', name: 'كبير / دبل', price: 2500 },
  ]);

  // Media Tab File Upload Ref
  const bannerInputRef = useRef&lt;HTMLInputElement&gt;(null);
  const logoInputRef = useRef&lt;HTMLInputElement&gt;(null);
  const prodImgInputRef = useRef&lt;HTMLInputElement&gt;(null);
  const [isUploadingMedia, setIsUploadingMedia] = useState(false);

  // Open Edit Product Modal
  const handleOpenEditProduct = (prod: Product) =&gt; {
    setEditingProductId(prod.id);
    setProdForm({
      name: prod.name,
      description: prod.description,
      price: prod.price,
      category: prod.category,
      imageUrl: prod.imageUrl,
      preparationTimeMinutes: prod.preparationTimeMinutes || 15,
      optionGroups: prod.optionGroups ? JSON.parse(JSON.stringify(prod.optionGroups)) : [],
    });
    setIsProductModalOpen(true);
  };

  // Open New Product Modal
  const handleOpenNewProduct = () =&gt; {
    setEditingProductId(null);
    setProdForm({
      name: '',
      description: '',
      price: 8000,
      category: 'مشاوي رئيسية',
      imageUrl: 'https://images.unsplash.com/photo-1555939594-58d7cb561ad1?w=500&amp;auto=format&amp;fit=crop&amp;q=80',
      preparationTimeMinutes: 20,
      optionGroups: [],
    });
    setIsProductModalOpen(true);
  };

  // Save Product (Add or Edit)
  const handleSaveProduct = async (e: React.FormEvent) =&gt; {
    e.preventDefault();
    if (!prodForm.name.trim()) return;

    if (editingProductId) {
      await updateProduct(editingProductId, {
        name: prodForm.name.trim(),
        description: prodForm.description.trim(),
        price: Number(prodForm.price) || 1000,
        category: prodForm.category,
        imageUrl: prodForm.imageUrl,
        preparationTimeMinutes: Number(prodForm.preparationTimeMinutes) || 15,
        optionGroups: prodForm.optionGroups,
      });
    } else {
      await addProduct({
        storeId: activeStoreId,
        name: prodForm.name.trim(),
        description: prodForm.description.trim() || 'صنف طازج يجهز خصيصاً عند الطلب',
        price: Number(prodForm.price) || 5000,
        category: prodForm.category,
        imageUrl: prodForm.imageUrl,
        isAvailable: true,
        preparationTimeMinutes: Number(prodForm.preparationTimeMinutes) || 15,
        optionGroups: prodForm.optionGroups,
      });
    }

    setIsProductModalOpen(false);
    setEditingProductId(null);
  };

  // Delete product with confirm
  const handleDeleteProduct = async (productId: string, name: string) =&gt; {
    if (confirm(`هل أنت متأكد من حذف الصنف (${name}) نهائياً من قائمة المطعم؟`)) {
      await deleteProduct(productId);
    }
  };

  // Handle Image File Upload for Product
  const handleProdImageUpload = async (e: React.ChangeEvent&lt;HTMLInputElement&gt;) =&gt; {
    const file = e.target.files?.[0];
    if (!file) return;
    try {
      setIsUploadingProdImg(true);
      const dataUrl = await uploadImageFile(file);
      setProdForm((prev) =&gt; ({ ...prev, imageUrl: dataUrl }));
    } catch (err) {
      console.error(err);
      alert('تعذر قراءة أو تحميل الصورة، يرجى اختيار صورة أخرى');
    } finally {
      setIsUploadingProdImg(false);
    }
  };

  // Handle Banner Image File Upload
  const handleBannerUpload = async (e: React.ChangeEvent&lt;HTMLInputElement&gt;) =&gt; {
    const file = e.target.files?.[0];
    if (!file) return;
    try {
      setIsUploadingMedia(true);
      const dataUrl = await uploadImageFile(file);
      setSettingsForm((prev) =&gt; ({ ...prev, banner: dataUrl }));
      await updateStore(activeStoreId, { banner: dataUrl });
    } catch (err) {
      console.error(err);
    } finally {
      setIsUploadingMedia(false);
    }
  };

  // Handle Logo Image File Upload
  const handleLogoUpload = async (e: React.ChangeEvent&lt;HTMLInputElement&gt;) =&gt; {
    const file = e.target.files?.[0];
    if (!file) return;
    try {
      setIsUploadingMedia(true);
      const dataUrl = await uploadImageFile(file);
      setSettingsForm((prev) =&gt; ({ ...prev, logo: dataUrl }));
      await updateStore(activeStoreId, { logo: dataUrl });
    } catch (err) {
      console.error(err);
    } finally {
      setIsUploadingMedia(false);
    }
  };

  // Save Store Settings
  const handleSaveStoreSettings = async (e: React.FormEvent) =&gt; {
    e.preventDefault();
    setIsSavingSettings(true);
    setSettingsSuccessMessage(null);
    try {
      await updateStore(activeStoreId, {
        name: settingsForm.name,
        description: settingsForm.description,
        address: settingsForm.address,
        neighborhood: settingsForm.neighborhood,
        phone: settingsForm.phone,
        openingHours: settingsForm.openingHours,
        deliveryFee: Number(settingsForm.deliveryFee),
        minimumOrder: Number(settingsForm.minimumOrder),
        banner: settingsForm.banner,
        logo: settingsForm.logo,
      });
      setSettingsSuccessMessage('تم حفظ وتحديث بيانات المتجر بنجاح في قاعدة البيانات.');
      setTimeout(() =&gt; setSettingsSuccessMessage(null), 4000);
    } finally {
      setIsSavingSettings(false);
    }
  };

  // Add Option Group in Builder
  const handleSaveOptionGroup = async () =&gt; {
    if (!newGroupTitle.trim() || newGroupItems.length === 0) {
      alert('يرجى إدخال اسم المجموعة وخيار واحد على الأقل');
      return;
    }

    const newGroup: ProductOptionGroup = {
      id: 'grp_' + Date.now(),
      title: newGroupTitle.trim(),
      isRequired: newGroupRequired,
      minSelect: newGroupRequired ? 1 : 0,
      maxSelect: Number(newGroupMaxSelect) || 1,
      options: newGroupItems.map((item) =&gt; ({
        id: item.id,
        name: item.name.trim(),
        price: Number(item.price) || 0,
      })),
    };

    if (isProductModalOpen) {
      // Adding directly into currently editing product form
      setProdForm((prev) =&gt; ({
        ...prev,
        optionGroups: [...prev.optionGroups, newGroup],
      }));
    } else if (groupBuilderTargetProduct) {
      // Updating target product
      const updatedGroups = [...(groupBuilderTargetProduct.optionGroups || []), newGroup];
      await updateProduct(groupBuilderTargetProduct.id, { optionGroups: updatedGroups });
    }

    setIsGroupBuilderOpen(false);
    setNewGroupTitle('');
    setNewGroupItems([
      { id: 'item_1', name: 'عادي / وسط', price: 0 },
      { id: 'item_2', name: 'كبير / دبل', price: 2500 },
    ]);
  };

  // Filter Orders for Live Orders Tab
  const filteredOrders = storeOrders.filter((o) =&gt; {
    if (orderFilter === 'all') return true;
    if (orderFilter === 'created') return o.status === 'created';
    if (orderFilter === 'preparing') return o.status === 'merchant_accepted' || o.status === 'preparing';
    if (orderFilter === 'ready') return o.status === 'ready_for_pickup' || o.status === 'courier_assigned';
    if (orderFilter === 'picked_up') return o.status === 'picked_up';
    if (orderFilter === 'delivered') return o.status === 'delivered';
    return true;
  });

  return (
    &lt;div className="max-w-6xl mx-auto px-4 py-5 space-y-5 text-slate-800" dir="rtl"&gt;
      {/* 1. TOP HEADER &amp; STORE SWITCHER */}
      &lt;div className="bg-white rounded-3xl border border-slate-200 p-4 shadow-sm flex flex-col md:flex-row items-start md:items-center justify-between gap-4"&gt;
        &lt;div className="flex items-center gap-3"&gt;
          &lt;div className="relative"&gt;
            &lt;img
              src={currentStore.logo}
              alt={currentStore.name}
              className="w-14 h-14 rounded-2xl object-cover border-2 border-orange-200 bg-slate-50"
              onError={(e) =&gt; {
                (e.target as HTMLImageElement).src = 'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=100&amp;auto=format&amp;fit=crop&amp;q=80';
              }}
            /&gt;
          &lt;/div&gt;

          &lt;div&gt;
            &lt;div className="flex items-center gap-2"&gt;
              &lt;span className="text-xs text-slate-400 font-bold"&gt;إدارة متجر:&lt;/span&gt;
              &lt;div className="relative inline-block"&gt;
                &lt;select
                  value={activeStoreId}
                  onChange={(e) =&gt; setActiveStoreId(e.target.value)}
                  className="font-black text-base sm:text-lg text-[#172554] bg-transparent outline-none cursor-pointer pr-1 pl-6 focus:ring-1 focus:ring-orange-400 rounded-lg"
                &gt;
                  {stores.map((s) =&gt; (
                    &lt;option key={s.id} value={s.id}&gt;
                      {s.name}
                    &lt;/option&gt;
                  ))}
                &lt;/select&gt;
                &lt;ChevronDown className="w-4 h-4 text-slate-400 absolute left-0 top-1.5 pointer-events-none" /&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;div className="flex flex-wrap items-center gap-2 mt-1"&gt;
              &lt;span
                className={`text-[11px] font-bold px-2.5 py-0.5 rounded-full ${
                  currentStore.approvalStatus &amp;&amp; currentStore.approvalStatus !== 'approved'
                    ? currentStore.approvalStatus === 'pending'
                      ? 'bg-amber-100 text-amber-800 border border-amber-300'
                      : 'bg-orange-100 text-orange-800 border border-orange-300'
                    : currentStore.isOpen
                    ? 'bg-emerald-100 text-emerald-800 border border-emerald-300'
                    : 'bg-rose-100 text-rose-800 border border-rose-300'
                }`}
              &gt;
                {currentStore.approvalStatus &amp;&amp; currentStore.approvalStatus !== 'approved'
                  ? currentStore.approvalStatus === 'pending'
                    ? 'بانتظار موافقة المدير'
                    : 'حساب متجر معلق'
                  : currentStore.isOpen
                  ? 'المتجر يستقبل الطلبات'
                  : 'المتجر مغلق'}
              &lt;/span&gt;

              &lt;button
                onClick={() =&gt; setActiveTab('reviews')}
                className="flex items-center gap-1 font-bold text-amber-700 bg-amber-50 hover:bg-amber-100 px-2.5 py-0.5 rounded-full border border-amber-200 text-[11px] transition-colors"
              &gt;
                &lt;Star className="w-3.5 h-3.5 fill-amber-500 text-amber-500" /&gt;
                &lt;span&gt;{(Number(currentStore.rating) || 5.0).toFixed(1)} ({currentStore.ratingCount || 1} تقييم)&lt;/span&gt;
              &lt;/button&gt;

              &lt;span className="text-[11px] text-slate-500 flex items-center gap-1"&gt;
                &lt;MapPin className="w-3 h-3 text-[#F47721]" /&gt;
                &lt;span&gt;{currentStore.neighborhood}&lt;/span&gt;
              &lt;/span&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Action Controls */}
        &lt;div className="flex items-center gap-2 w-full md:w-auto justify-end"&gt;
          &lt;button
            onClick={() =&gt; setSoundEnabled(!soundEnabled)}
            className={`p-2.5 rounded-xl border text-xs font-bold flex items-center gap-1.5 transition-colors ${
              soundEnabled
                ? 'bg-orange-50 border-orange-300 text-[#F47721]'
                : 'bg-slate-100 border-slate-200 text-slate-500'
            }`}
            title="تنبيهات صوت الطلبات الجديدة"
          &gt;
            {soundEnabled ? &lt;Volume2 className="w-4 h-4" /&gt; : &lt;VolumeX className="w-4 h-4" /&gt;}
            &lt;span className="text-[11px]"&gt;{soundEnabled ? 'الجرس مفعل' : 'صامت'}&lt;/span&gt;
          &lt;/button&gt;

          &lt;button
            onClick={() =&gt; toggleStoreOpen(currentStore.id)}
            disabled={Boolean(currentStore.approvalStatus &amp;&amp; currentStore.approvalStatus !== 'approved')}
            className={`px-4 py-2.5 rounded-xl font-bold text-xs flex items-center gap-1.5 shadow-sm transition-all active:scale-95 ${
              currentStore.approvalStatus &amp;&amp; currentStore.approvalStatus !== 'approved'
                ? 'bg-slate-200 text-slate-400 cursor-not-allowed'
                : currentStore.isOpen
                ? 'bg-rose-600 hover:bg-rose-700 text-white'
                : 'bg-emerald-600 hover:bg-emerald-700 text-white'
            }`}
          &gt;
            &lt;Power className="w-4 h-4" /&gt;
            &lt;span&gt;
              {currentStore.approvalStatus === 'pending'
                ? 'بانتظار الموافقة'
                : currentStore.approvalStatus === 'suspended'
                ? 'معلق مؤقتاً'
                : currentStore.isOpen
                ? 'إغلاق المتجر مؤقتاً'
                : 'فتح استقبال الطلبات'}
            &lt;/span&gt;
          &lt;/button&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      {/* Approval Status Alert Banner */}
      {currentStore.approvalStatus &amp;&amp; currentStore.approvalStatus !== 'approved' &amp;&amp; (
        &lt;div className="bg-amber-50 border border-amber-300 rounded-3xl p-4 flex items-start gap-3 shadow-xs"&gt;
          &lt;Clock className="w-5 h-5 text-amber-600 shrink-0 mt-0.5 animate-pulse" /&gt;
          &lt;div className="space-y-1 text-xs text-amber-900 flex-1"&gt;
            &lt;span className="font-bold text-sm block"&gt;
              {currentStore.approvalStatus === 'pending'
                ? 'المتجر بانتظار موافقة واعتماد إدارة المنصة'
                : currentStore.approvalStatus === 'suspended'
                ? 'حساب المتجر معلق مؤقتاً من قِبل الإدارة'
                : 'طلب تسجيل المتجر مرفوض'}
            &lt;/span&gt;
            &lt;p className="text-amber-800 leading-relaxed"&gt;
              {currentStore.approvalStatus === 'pending'
                ? 'تم تسجيل بيانات المتجر وموقعه بنجاح وهو الآن قيد التدقيق الإداري. لا يمكن تفعيل استقبال الطلبات للزبائن أو تعديل الأسعار المالية حتى تصدر موافقة المدير الرسمية.'
                : 'يرجى مراجعة إدارة منصة طلبي لمزيد من التفاصيل حول حالة الحساب والامتثال.'}
            &lt;/p&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* 2. DEDICATED NAVIGATION TABS (6 TABS) */}
      &lt;div className="bg-white p-1.5 rounded-2xl border border-slate-200 shadow-xs flex items-center gap-1 overflow-x-auto scrollbar-none"&gt;
        &lt;button
          onClick={() =&gt; setActiveTab('orders')}
          className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs whitespace-nowrap transition-all ${
            activeTab === 'orders'
              ? 'bg-[#172554] text-white shadow-xs'
              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
          }`}
        &gt;
          &lt;Utensils className="w-4 h-4 text-orange-400" /&gt;
          &lt;span&gt;الطلبات الحية ({storeOrders.filter((o) =&gt; o.status !== 'delivered' &amp;&amp; o.status !== 'cancelled').length})&lt;/span&gt;
        &lt;/button&gt;

        &lt;button
          onClick={() =&gt; setActiveTab('menu')}
          className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs whitespace-nowrap transition-all ${
            activeTab === 'menu'
              ? 'bg-[#172554] text-white shadow-xs'
              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
          }`}
        &gt;
          &lt;ListPlus className="w-4 h-4 text-orange-400" /&gt;
          &lt;span&gt;القائمة والأصناف ({storeProducts.length})&lt;/span&gt;
        &lt;/button&gt;

        &lt;button
          onClick={() =&gt; setActiveTab('options')}
          className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs whitespace-nowrap transition-all ${
            activeTab === 'options'
              ? 'bg-[#172554] text-white shadow-xs'
              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
          }`}
        &gt;
          &lt;Layers className="w-4 h-4 text-orange-400" /&gt;
          &lt;span&gt;مجموعات الخيارات&lt;/span&gt;
        &lt;/button&gt;

        &lt;button
          onClick={() =&gt; setActiveTab('media')}
          className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs whitespace-nowrap transition-all ${
            activeTab === 'media'
              ? 'bg-[#172554] text-white shadow-xs'
              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
          }`}
        &gt;
          &lt;ImageIcon className="w-4 h-4 text-orange-400" /&gt;
          &lt;span&gt;الوسائط والصور&lt;/span&gt;
        &lt;/button&gt;

        &lt;button
          onClick={() =&gt; setActiveTab('settings')}
          className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs whitespace-nowrap transition-all ${
            activeTab === 'settings'
              ? 'bg-[#172554] text-white shadow-xs'
              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
          }`}
        &gt;
          &lt;Settings className="w-4 h-4 text-orange-400" /&gt;
          &lt;span&gt;إعدادات المتجر&lt;/span&gt;
        &lt;/button&gt;

        &lt;button
          onClick={() =&gt; setActiveTab('reviews')}
          className={`flex items-center gap-2 px-4 py-2.5 rounded-xl font-bold text-xs whitespace-nowrap transition-all ${
            activeTab === 'reviews'
              ? 'bg-[#172554] text-white shadow-xs'
              : 'text-slate-600 hover:text-slate-900 hover:bg-slate-100'
          }`}
        &gt;
          &lt;Star className="w-4 h-4 text-amber-400" /&gt;
          &lt;span&gt;التقييمات ({storeRatings.length})&lt;/span&gt;
        &lt;/button&gt;
      &lt;/div&gt;

      {/* 3. TAB CONTENT */}

      {/* ================= TAB 1: LIVE ORDERS ================= */}
      {activeTab === 'orders' &amp;&amp; (
        &lt;div className="space-y-4 animate-fadeIn"&gt;
          {/* Order Status Filters */}
          &lt;div className="flex flex-wrap items-center gap-2 bg-slate-100/70 p-2 rounded-2xl border border-slate-200"&gt;
            &lt;button
              onClick={() =&gt; setOrderFilter('all')}
              className={`px-3 py-1.5 rounded-xl font-bold text-xs transition-colors ${
                orderFilter === 'all' ? 'bg-[#F47721] text-white shadow-xs' : 'text-slate-600 hover:bg-white'
              }`}
            &gt;
              الكل ({storeOrders.length})
            &lt;/button&gt;
            &lt;button
              onClick={() =&gt; setOrderFilter('created')}
              className={`px-3 py-1.5 rounded-xl font-bold text-xs transition-colors ${
                orderFilter === 'created' ? 'bg-[#F47721] text-white shadow-xs' : 'text-slate-600 hover:bg-white'
              }`}
            &gt;
              طلبات جديدة ({storeOrders.filter((o) =&gt; o.status === 'created').length})
            &lt;/button&gt;
            &lt;button
              onClick={() =&gt; setOrderFilter('preparing')}
              className={`px-3 py-1.5 rounded-xl font-bold text-xs transition-colors ${
                orderFilter === 'preparing' ? 'bg-[#F47721] text-white shadow-xs' : 'text-slate-600 hover:bg-white'
              }`}
            &gt;
              قيد التحضير ({storeOrders.filter((o) =&gt; o.status === 'merchant_accepted' || o.status === 'preparing').length})
            &lt;/button&gt;
            &lt;button
              onClick={() =&gt; setOrderFilter('ready')}
              className={`px-3 py-1.5 rounded-xl font-bold text-xs transition-colors ${
                orderFilter === 'ready' ? 'bg-[#F47721] text-white shadow-xs' : 'text-slate-600 hover:bg-white'
              }`}
            &gt;
              جاهزة للاستلام ({storeOrders.filter((o) =&gt; o.status === 'ready_for_pickup' || o.status === 'courier_assigned').length})
            &lt;/button&gt;
            &lt;button
              onClick={() =&gt; setOrderFilter('picked_up')}
              className={`px-3 py-1.5 rounded-xl font-bold text-xs transition-colors ${
                orderFilter === 'picked_up' ? 'bg-[#F47721] text-white shadow-xs' : 'text-slate-600 hover:bg-white'
              }`}
            &gt;
              مع المندوب في الطريق ({storeOrders.filter((o) =&gt; o.status === 'picked_up').length})
            &lt;/button&gt;
            &lt;button
              onClick={() =&gt; setOrderFilter('delivered')}
              className={`px-3 py-1.5 rounded-xl font-bold text-xs transition-colors ${
                orderFilter === 'delivered' ? 'bg-[#F47721] text-white shadow-xs' : 'text-slate-600 hover:bg-white'
              }`}
            &gt;
              مكتملة ({storeOrders.filter((o) =&gt; o.status === 'delivered').length})
            &lt;/button&gt;
          &lt;/div&gt;

          {/* Orders List */}
          &lt;div className="space-y-3"&gt;
            {filteredOrders.map((ord) =&gt; (
              &lt;div
                key={ord.id}
                className="bg-white rounded-2xl p-4 border border-slate-200 shadow-xs hover:border-orange-300 transition-all space-y-3"
              &gt;
                &lt;div className="flex flex-wrap items-center justify-between gap-2 border-b border-slate-100 pb-2.5"&gt;
                  &lt;div className="flex items-center gap-2"&gt;
                    &lt;span className="font-black text-sm text-[#172554] font-mono"&gt;
                      #{ord.id.slice(-6)}
                    &lt;/span&gt;
                    &lt;span className="text-xs text-slate-400"&gt;
                      {new Date(ord.createdAt).toLocaleTimeString('ar-IQ', { hour: '2-digit', minute: '2-digit' })}
                    &lt;/span&gt;
                    &lt;span className="text-xs bg-slate-100 text-slate-700 px-2 py-0.5 rounded-md font-bold"&gt;
                      {ord.customer?.name || 'زبون طلبي'} ({ord.customer?.phone || '0770xxxxxxx'})
                    &lt;/span&gt;
                  &lt;/div&gt;

                  {/* Status Badge */}
                  &lt;span
                    className={`text-xs px-2.5 py-1 rounded-full font-bold ${
                      ord.status === 'created'
                        ? 'bg-amber-100 text-amber-800 animate-pulse'
                        : ord.status === 'preparing'
                        ? 'bg-blue-100 text-blue-800'
                        : ord.status === 'ready_for_pickup'
                        ? 'bg-purple-100 text-purple-800'
                        : ord.status === 'picked_up'
                        ? 'bg-orange-100 text-[#F47721]'
                        : ord.status === 'delivered'
                        ? 'bg-emerald-100 text-emerald-800'
                        : 'bg-rose-100 text-rose-800'
                    }`}
                  &gt;
                    {ord.status === 'created'
                      ? 'طلب جديد وبانتظار الموافقة'
                      : ord.status === 'merchant_accepted' || ord.status === 'preparing'
                      ? 'جاري التحضير في المطبخ'
                      : ord.status === 'ready_for_pickup'
                      ? 'جاهز للاستلام والتسليم للمندوب'
                      : ord.status === 'courier_assigned'
                      ? 'تم تعيين المندوب'
                      : ord.status === 'picked_up'
                      ? 'تم الاستلام وبطريقه للزبون'
                      : ord.status === 'delivered'
                      ? 'تم التوصيل بنجاح'
                      : 'ملغي'}
                  &lt;/span&gt;
                &lt;/div&gt;

                {/* Items &amp; Options detail */}
                &lt;div className="space-y-1.5 text-xs text-slate-700 bg-slate-50 p-3 rounded-xl border border-slate-100"&gt;
                  {ord.items.map((item, idx) =&gt; (
                    &lt;div key={idx} className="flex flex-col sm:flex-row sm:items-center justify-between gap-1 border-b border-slate-100 last:border-0 pb-1.5 last:pb-0"&gt;
                      &lt;div&gt;
                        &lt;span className="font-bold text-slate-900"&gt;{item.quantity}x {item.name}&lt;/span&gt;
                        {item.selectedOptionGroups &amp;&amp; item.selectedOptionGroups.length &gt; 0 &amp;&amp; (
                          &lt;div className="text-[11px] text-slate-500 pr-3"&gt;
                            {item.selectedOptionGroups.map((g, gi) =&gt; (
                              &lt;span key={gi} className="ml-2 inline-block"&gt;
                                &lt;span className="text-slate-400"&gt;{g.groupTitle}:&lt;/span&gt; {g.selectedItems.map((s) =&gt; s.name).join(', ')}
                              &lt;/span&gt;
                            ))}
                          &lt;/div&gt;
                        )}
                        {item.notes &amp;&amp; (
                          &lt;span className="text-[11px] text-orange-600 block pr-3 font-medium"&gt;ملاحظات: {item.notes}&lt;/span&gt;
                        )}
                      &lt;/div&gt;
                      &lt;span className="font-extrabold text-[#172554] text-left"&gt;
                        {(item.price * item.quantity).toLocaleString()} د.ع
                      &lt;/span&gt;
                    &lt;/div&gt;
                  ))}
                &lt;/div&gt;

                {/* Delivery &amp; Payout Info */}
                &lt;div className="flex flex-wrap items-center justify-between gap-2 text-xs pt-1"&gt;
                  &lt;div className="flex items-center gap-3 text-slate-600"&gt;
                    &lt;span&gt;العنوان: {ord.customer?.neighborhood || 'بغداد'} - {ord.customer?.address || 'العنوان المسجل'}&lt;/span&gt;
                    &lt;span className="font-bold text-emerald-700"&gt;
                      صافي المطعم: {(ord.financials?.storeNetPayout ?? ord.subtotal).toLocaleString()} د.ع
                    &lt;/span&gt;
                  &lt;/div&gt;

                  {/* Merchant Action Buttons */}
                  &lt;div className="flex items-center gap-2"&gt;
                    {ord.status === 'created' &amp;&amp; (
                      &lt;&gt;
                        &lt;button
                          onClick={() =&gt; updateOrderStatus(ord.id, 'preparing', 'المطعم باشر بالتحضير')}
                          className="px-3.5 py-1.5 bg-[#F47721] hover:bg-[#e06816] text-white rounded-xl font-bold text-xs shadow-xs transition-all flex items-center gap-1"
                        &gt;
                          &lt;Check className="w-3.5 h-3.5" /&gt;
                          &lt;span&gt;قبول وبدء التحضير&lt;/span&gt;
                        &lt;/button&gt;
                        &lt;button
                          onClick={() =&gt; cancelOrder(ord.id, 'اعتذار المطعم عن الطلب')}
                          className="px-3 py-1.5 bg-rose-50 text-rose-700 hover:bg-rose-100 rounded-xl font-bold text-xs transition-all"
                        &gt;
                          رفض الطلب
                        &lt;/button&gt;
                      &lt;/&gt;
                    )}

                    {(ord.status === 'merchant_accepted' || ord.status === 'preparing') &amp;&amp; (
                      &lt;button
                        onClick={() =&gt; updateOrderStatus(ord.id, 'ready_for_pickup', 'الطلب جاهز للاستلام')}
                        className="px-3.5 py-1.5 bg-purple-600 hover:bg-purple-700 text-white rounded-xl font-bold text-xs shadow-xs transition-all flex items-center gap-1"
                      &gt;
                        &lt;PackageCheck className="w-3.5 h-3.5" /&gt;
                        &lt;span&gt;جاهز للاستلام (إشعار المندوب)&lt;/span&gt;
                      &lt;/button&gt;
                    )}
                  &lt;/div&gt;
                &lt;/div&gt;
              &lt;/div&gt;
            ))}

            {filteredOrders.length === 0 &amp;&amp; (
              &lt;div className="text-center py-12 bg-white rounded-2xl border border-slate-200"&gt;
                &lt;Utensils className="w-8 h-8 text-slate-300 mx-auto mb-2" /&gt;
                &lt;p className="text-xs text-slate-400"&gt;لا توجد طلبات في هذا القسم حالياً.&lt;/p&gt;
              &lt;/div&gt;
            )}
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ================= TAB 2: MENU &amp; ITEMS ================= */}
      {activeTab === 'menu' &amp;&amp; (
        &lt;div className="space-y-4 animate-fadeIn"&gt;
          {/* Action Header */}
          &lt;div className="flex items-center justify-between bg-white p-4 rounded-2xl border border-slate-200"&gt;
            &lt;div&gt;
              &lt;h3 className="font-bold text-sm text-[#172554]"&gt;قائمة الأكلات والمنتجات ({storeProducts.length})&lt;/h3&gt;
              &lt;p className="text-[11px] text-slate-400"&gt;أضف وجباتك، حدد الأسعار، وقت التجهيز وحالة التوفر&lt;/p&gt;
            &lt;/div&gt;
            &lt;button
              onClick={handleOpenNewProduct}
              className="px-4 py-2.5 bg-[#F47721] hover:bg-[#e06816] text-white rounded-xl font-bold text-xs shadow-sm flex items-center gap-1.5 transition-all"
            &gt;
              &lt;Plus className="w-4 h-4" /&gt;
              &lt;span&gt;إضافة أكلة / منتج جديد&lt;/span&gt;
            &lt;/button&gt;
          &lt;/div&gt;

          {/* Dishes Grid */}
          &lt;div className="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3"&gt;
            {storeProducts.map((prod) =&gt; (
              &lt;div
                key={prod.id}
                className="bg-white rounded-2xl p-3 border border-slate-200 shadow-xs hover:border-orange-300 transition-all flex flex-col justify-between"
              &gt;
                &lt;div&gt;
                  {/* Photo &amp; Availability Badge */}
                  &lt;div className="h-36 w-full rounded-xl overflow-hidden bg-slate-100 relative mb-2.5"&gt;
                    &lt;img
                      src={prod.imageUrl}
                      alt={prod.name}
                      className="w-full h-full object-cover"
                      onError={(e) =&gt; {
                        (e.target as HTMLImageElement).src = 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400&amp;auto=format&amp;fit=crop&amp;q=80';
                      }}
                    /&gt;
                    &lt;div className="absolute top-2 right-2"&gt;
                      &lt;span className="text-[10px] bg-black/60 backdrop-blur-md text-white px-2 py-0.5 rounded-md font-semibold"&gt;
                        {prod.category}
                      &lt;/span&gt;
                    &lt;/div&gt;

                    &lt;div className="absolute top-2 left-2"&gt;
                      &lt;button
                        onClick={() =&gt; toggleProductAvailability(prod.id)}
                        className={`text-[10px] font-bold px-2 py-0.5 rounded-md backdrop-blur-md transition-colors ${
                          prod.isAvailable
                            ? 'bg-emerald-500 text-white'
                            : 'bg-rose-500 text-white'
                        }`}
                      &gt;
                        {prod.isAvailable ? 'متوفر' : 'غير متوفر'}
                      &lt;/button&gt;
                    &lt;/div&gt;

                    &lt;div className="absolute bottom-2 right-2 bg-black/60 backdrop-blur-md text-white text-[10px] px-2 py-0.5 rounded-md flex items-center gap-1"&gt;
                      &lt;Clock className="w-3 h-3 text-orange-400" /&gt;
                      &lt;span&gt;{prod.preparationTimeMinutes || 15} دقيقة&lt;/span&gt;
                    &lt;/div&gt;
                  &lt;/div&gt;

                  &lt;h4 className="font-bold text-xs sm:text-sm text-slate-900 leading-snug"&gt;{prod.name}&lt;/h4&gt;
                  &lt;p className="text-[11px] text-slate-400 line-clamp-2 mt-1"&gt;{prod.description}&lt;/p&gt;
                &lt;/div&gt;

                &lt;div className="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between"&gt;
                  &lt;span className="font-extrabold text-sm text-[#F47721]"&gt;
                    {prod.price.toLocaleString()} د.ع
                  &lt;/span&gt;

                  &lt;div className="flex items-center gap-1.5"&gt;
                    &lt;button
                      onClick={() =&gt; handleOpenEditProduct(prod)}
                      className="p-1.5 rounded-lg bg-slate-100 hover:bg-orange-50 hover:text-[#F47721] text-slate-600 transition-colors"
                      title="تعديل الأكلة والخيارات"
                    &gt;
                      &lt;Edit2 className="w-3.5 h-3.5" /&gt;
                    &lt;/button&gt;
                    &lt;button
                      onClick={() =&gt; handleDeleteProduct(prod.id, prod.name)}
                      className="p-1.5 rounded-lg bg-rose-50 hover:bg-rose-100 text-rose-600 transition-colors"
                      title="حذف من القائمة"
                    &gt;
                      &lt;Trash2 className="w-3.5 h-3.5" /&gt;
                    &lt;/button&gt;
                  &lt;/div&gt;
                &lt;/div&gt;
              &lt;/div&gt;
            ))}
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ================= TAB 3: OPTION GROUPS BUILDER ================= */}
      {activeTab === 'options' &amp;&amp; (
        &lt;div className="space-y-4 animate-fadeIn"&gt;
          &lt;div className="bg-white p-4 rounded-2xl border border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3"&gt;
            &lt;div&gt;
              &lt;h3 className="font-bold text-sm text-[#172554]"&gt;مجموعات الخيارات والإضافات (Option Groups)&lt;/h3&gt;
              &lt;p className="text-[11px] text-slate-400"&gt;
                إدارة أحجام الوجبات (صغير، وسط، كبير) والإضافات (جبن، صوصات، مقبلات) مع شروط الإلزامية والحدود
              &lt;/p&gt;
            &lt;/div&gt;
            &lt;button
              onClick={() =&gt; {
                setGroupBuilderTargetProduct(null);
                setIsGroupBuilderOpen(true);
              }}
              className="px-4 py-2 bg-[#F47721] hover:bg-[#e06816] text-white rounded-xl font-bold text-xs flex items-center gap-1.5 shadow-sm transition-all"
            &gt;
              &lt;Plus className="w-4 h-4" /&gt;
              &lt;span&gt;إنشاء مجموعة خيارات جديدة&lt;/span&gt;
            &lt;/button&gt;
          &lt;/div&gt;

          {/* List of Option Groups configured across store products */}
          &lt;div className="grid grid-cols-1 sm:grid-cols-2 gap-3"&gt;
            {storeProducts.filter((p) =&gt; p.optionGroups &amp;&amp; p.optionGroups.length &gt; 0).map((prod) =&gt; (
              &lt;div key={prod.id} className="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs space-y-3"&gt;
                &lt;div className="flex items-center justify-between border-b border-slate-100 pb-2"&gt;
                  &lt;div className="flex items-center gap-2"&gt;
                    &lt;img src={prod.imageUrl} alt={prod.name} className="w-8 h-8 rounded-lg object-cover" /&gt;
                    &lt;span className="font-bold text-xs text-slate-900"&gt;{prod.name}&lt;/span&gt;
                  &lt;/div&gt;
                  &lt;button
                    onClick={() =&gt; handleOpenEditProduct(prod)}
                    className="text-[11px] text-[#F47721] font-bold hover:underline"
                  &gt;
                    تعديل الخيارات
                  &lt;/button&gt;
                &lt;/div&gt;

                &lt;div className="space-y-2"&gt;
                  {prod.optionGroups?.map((grp) =&gt; (
                    &lt;div key={grp.id} className="bg-slate-50 p-2.5 rounded-xl border border-slate-100 text-xs"&gt;
                      &lt;div className="flex items-center justify-between font-bold text-slate-800 mb-1"&gt;
                        &lt;span&gt;{grp.title}&lt;/span&gt;
                        &lt;span className={`text-[10px] px-1.5 py-0.5 rounded-md ${grp.isRequired ? 'bg-amber-100 text-amber-800' : 'bg-slate-200 text-slate-600'}`}&gt;
                          {grp.isRequired ? 'إلزامي' : 'اختياري'} • {grp.maxSelect === 1 ? 'خيار واحد' : `حتى ${grp.maxSelect}`}
                        &lt;/span&gt;
                      &lt;/div&gt;
                      &lt;div className="flex flex-wrap gap-1 mt-1"&gt;
                        {grp.options.map((opt) =&gt; (
                          &lt;span key={opt.id} className="text-[10px] bg-white border border-slate-200 px-2 py-0.5 rounded-md text-slate-700"&gt;
                            {opt.name} {opt.price &gt; 0 ? `(+${opt.price.toLocaleString()} د.ع)` : '(مجاناً)'}
                          &lt;/span&gt;
                        ))}
                      &lt;/div&gt;
                    &lt;/div&gt;
                  ))}
                &lt;/div&gt;
              &lt;/div&gt;
            ))}
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ================= TAB 4: MEDIA &amp; PHOTO UPLOADS ================= */}
      {activeTab === 'media' &amp;&amp; (
        &lt;div className="space-y-4 animate-fadeIn"&gt;
          &lt;div className="bg-white p-4 rounded-2xl border border-slate-200"&gt;
            &lt;h3 className="font-bold text-sm text-[#172554]"&gt;إدارة الوسائط وصور المتجر&lt;/h3&gt;
            &lt;p className="text-[11px] text-slate-400"&gt;
              ارفع صوراً حقيقية من هاتفك أو جهازك لصورة الغلاف، شعار المتجر، وأطباق القائمة
            &lt;/p&gt;
          &lt;/div&gt;

          {/* Hidden File Inputs */}
          &lt;input
            ref={bannerInputRef}
            type="file"
            accept="image/*"
            onChange={handleBannerUpload}
            className="hidden"
          /&gt;
          &lt;input
            ref={logoInputRef}
            type="file"
            accept="image/*"
            onChange={handleLogoUpload}
            className="hidden"
          /&gt;

          &lt;div className="grid grid-cols-1 md:grid-cols-2 gap-4"&gt;
            {/* Store Banner Uploader Card */}
            &lt;div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs space-y-3"&gt;
              &lt;div className="flex items-center justify-between"&gt;
                &lt;h4 className="font-bold text-xs text-slate-800"&gt;صورة غلاف المتجر (Banner)&lt;/h4&gt;
                &lt;button
                  type="button"
                  onClick={() =&gt; bannerInputRef.current?.click()}
                  disabled={isUploadingMedia}
                  className="px-3 py-1.5 bg-[#F47721] hover:bg-[#e06816] text-white rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all disabled:opacity-50"
                &gt;
                  &lt;Upload className="w-3.5 h-3.5" /&gt;
                  &lt;span&gt;تغيير / رفع صورة الغلاف&lt;/span&gt;
                &lt;/button&gt;
              &lt;/div&gt;

              &lt;div className="h-44 w-full rounded-xl overflow-hidden bg-slate-100 relative border border-slate-200"&gt;
                &lt;img
                  src={settingsForm.banner}
                  alt="غلاف المتجر"
                  className="w-full h-full object-cover"
                /&gt;
              &lt;/div&gt;
              &lt;p className="text-[10px] text-slate-400"&gt;
                يُفضل استخدام صورة أفقية واضحة للمطعم أو صينية المأكولات بدقة عالية.
              &lt;/p&gt;
            &lt;/div&gt;

            {/* Store Logo Uploader Card */}
            &lt;div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs space-y-3"&gt;
              &lt;div className="flex items-center justify-between"&gt;
                &lt;h4 className="font-bold text-xs text-slate-800"&gt;شعار المتجر (Logo)&lt;/h4&gt;
                &lt;button
                  type="button"
                  onClick={() =&gt; logoInputRef.current?.click()}
                  disabled={isUploadingMedia}
                  className="px-3 py-1.5 bg-[#172554] hover:bg-slate-900 text-white rounded-xl text-xs font-bold flex items-center gap-1.5 transition-all disabled:opacity-50"
                &gt;
                  &lt;Upload className="w-3.5 h-3.5" /&gt;
                  &lt;span&gt;تغيير / رفع الشعار&lt;/span&gt;
                &lt;/button&gt;
              &lt;/div&gt;

              &lt;div className="h-44 w-full rounded-xl bg-slate-50 flex items-center justify-center border border-slate-200"&gt;
                &lt;img
                  src={settingsForm.logo}
                  alt="شعار المتجر"
                  className="w-28 h-28 rounded-2xl object-cover shadow-sm border-2 border-white"
                /&gt;
              &lt;/div&gt;
              &lt;p className="text-[10px] text-slate-400"&gt;
                شعار المتجر يظهر في بطاقات المطاعم وشريط التصفح العلوي.
              &lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ================= TAB 5: STORE PROFILE SETTINGS ================= */}
      {activeTab === 'settings' &amp;&amp; (
        &lt;div className="space-y-4 animate-fadeIn"&gt;
          &lt;form onSubmit={handleSaveStoreSettings} className="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs space-y-4"&gt;
            &lt;div className="flex items-center justify-between border-b border-slate-100 pb-3"&gt;
              &lt;div&gt;
                &lt;h3 className="font-bold text-sm text-[#172554]"&gt;بيانات ومعلومات المتجر&lt;/h3&gt;
                &lt;p className="text-[11px] text-slate-400"&gt;تعديل الاسم والوصف ورقم الهاتف وساعات العمل وأجرة التوصيل&lt;/p&gt;
              &lt;/div&gt;
              &lt;button
                type="submit"
                disabled={isSavingSettings}
                className="px-5 py-2.5 bg-[#F47721] hover:bg-[#e06816] text-white rounded-xl font-bold text-xs flex items-center gap-2 shadow-sm transition-all disabled:opacity-50"
              &gt;
                &lt;Save className="w-4 h-4" /&gt;
                &lt;span&gt;{isSavingSettings ? 'جاري الحفظ...' : 'حفظ التعديلات في Firebase'}&lt;/span&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            {settingsSuccessMessage &amp;&amp; (
              &lt;div className="p-3 bg-emerald-50 border border-emerald-200 text-emerald-800 rounded-xl text-xs font-bold flex items-center gap-2"&gt;
                &lt;CheckCircle2 className="w-4 h-4 shrink-0 text-emerald-600" /&gt;
                &lt;span&gt;{settingsSuccessMessage}&lt;/span&gt;
              &lt;/div&gt;
            )}

            &lt;div className="grid grid-cols-1 sm:grid-cols-2 gap-3 text-xs"&gt;
              &lt;div&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;اسم المطعم أو المتجر&lt;/label&gt;
                &lt;input
                  type="text"
                  value={settingsForm.name}
                  onChange={(e) =&gt; setSettingsForm({ ...settingsForm, name: e.target.value })}
                  className="w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-[#F47721] focus:outline-none"
                  required
                /&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;رقم هاتف المتجر المباشر&lt;/label&gt;
                &lt;input
                  type="text"
                  value={settingsForm.phone}
                  onChange={(e) =&gt; setSettingsForm({ ...settingsForm, phone: e.target.value })}
                  className="w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-[#F47721] focus:outline-none font-mono"
                  placeholder="0780xxxxxxx"
                  required
                /&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;المنطقة / الحي&lt;/label&gt;
                &lt;input
                  type="text"
                  value={settingsForm.neighborhood}
                  onChange={(e) =&gt; setSettingsForm({ ...settingsForm, neighborhood: e.target.value })}
                  className="w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-[#F47721] focus:outline-none"
                  required
                /&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;ساعات العمل اليومية&lt;/label&gt;
                &lt;input
                  type="text"
                  value={settingsForm.openingHours}
                  onChange={(e) =&gt; setSettingsForm({ ...settingsForm, openingHours: e.target.value })}
                  className="w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-[#F47721] focus:outline-none"
                  placeholder="11:00 ص - 12:00 م"
                /&gt;
              &lt;/div&gt;

              &lt;div className="sm:col-span-2"&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;العنوان التفصيلي&lt;/label&gt;
                &lt;input
                  type="text"
                  value={settingsForm.address}
                  onChange={(e) =&gt; setSettingsForm({ ...settingsForm, address: e.target.value })}
                  className="w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-[#F47721] focus:outline-none"
                  required
                /&gt;
              &lt;/div&gt;

              &lt;div className="sm:col-span-2"&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;وصف المتجر ونوع المأكولات&lt;/label&gt;
                &lt;textarea
                  rows={2}
                  value={settingsForm.description}
                  onChange={(e) =&gt; setSettingsForm({ ...settingsForm, description: e.target.value })}
                  className="w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-[#F47721] focus:outline-none"
                /&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;أجرة التوصيل للزبون (د.ع)&lt;/label&gt;
                &lt;input
                  type="number"
                  step="250"
                  value={settingsForm.deliveryFee}
                  onChange={(e) =&gt; setSettingsForm({ ...settingsForm, deliveryFee: Number(e.target.value) })}
                  className="w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-[#F47721] focus:outline-none font-bold"
                  required
                /&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;الحد الأدنى للطلب (د.ع)&lt;/label&gt;
                &lt;input
                  type="number"
                  step="500"
                  value={settingsForm.minimumOrder}
                  onChange={(e) =&gt; setSettingsForm({ ...settingsForm, minimumOrder: Number(e.target.value) })}
                  className="w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white focus:border-[#F47721] focus:outline-none font-bold"
                  required
                /&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            {/* Read-Only RBAC Commission Box */}
            &lt;div className="p-3.5 bg-slate-100 rounded-2xl border border-slate-200 text-xs text-slate-600 flex items-center justify-between"&gt;
              &lt;div className="flex items-center gap-2"&gt;
                &lt;ShieldCheck className="w-5 h-5 text-emerald-600" /&gt;
                &lt;div&gt;
                  &lt;span className="font-bold text-slate-900 block"&gt;نسبة عمولة منصة طلبي (RBAC Protection)&lt;/span&gt;
                  &lt;span className="text-[10px] text-slate-400"&gt;تحدد حصرياً من قبل إدارة المنصة ولا يمكن للمطعم تعديلها.&lt;/span&gt;
                &lt;/div&gt;
              &lt;/div&gt;
              &lt;span className="font-extrabold text-sm text-[#172554] bg-white px-3 py-1 rounded-xl border border-slate-200"&gt;
                %{pricingSettings.defaultPlatformCommissionPercent}
              &lt;/span&gt;
            &lt;/div&gt;
          &lt;/form&gt;
        &lt;/div&gt;
      )}

      {/* ================= TAB 6: REVIEWS &amp; RATINGS ================= */}
      {activeTab === 'reviews' &amp;&amp; (
        &lt;div className="space-y-4 animate-fadeIn"&gt;
          {/* Rating Summary Card */}
          &lt;div className="bg-white p-5 rounded-2xl border border-slate-200 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4"&gt;
            &lt;div className="flex items-center gap-4 text-center sm:text-right"&gt;
              &lt;div className="w-16 h-16 rounded-2xl bg-amber-50 border border-amber-200 flex flex-col items-center justify-center"&gt;
                &lt;span className="text-xl font-black text-amber-600"&gt;{currentStore.rating.toFixed(1)}&lt;/span&gt;
                &lt;span className="text-[9px] text-slate-400"&gt;من 5.0&lt;/span&gt;
              &lt;/div&gt;
              &lt;div&gt;
                &lt;h3 className="font-bold text-sm text-[#172554]"&gt;متوسط تقييمات الزبائن للمطعم&lt;/h3&gt;
                &lt;p className="text-xs text-slate-400 mt-0.5"&gt;
                  بناءً على {currentStore.ratingCount} تقييماً حقيقياً مسجلاً في Firebase
                &lt;/p&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            {/* Star Filters */}
            &lt;div className="flex items-center gap-1"&gt;
              &lt;button
                onClick={() =&gt; setReviewStarFilter(null)}
                className={`px-3 py-1 rounded-xl text-xs font-bold ${
                  reviewStarFilter === null ? 'bg-amber-500 text-white' : 'bg-slate-100 text-slate-600'
                }`}
              &gt;
                الكل
              &lt;/button&gt;
              {[5, 4, 3, 2, 1].map((st) =&gt; (
                &lt;button
                  key={st}
                  onClick={() =&gt; setReviewStarFilter(st)}
                  className={`px-2.5 py-1 rounded-xl text-xs font-bold flex items-center gap-0.5 ${
                    reviewStarFilter === st ? 'bg-amber-500 text-white' : 'bg-slate-100 text-slate-600'
                  }`}
                &gt;
                  &lt;span&gt;{st}&lt;/span&gt;
                  &lt;Star className="w-3 h-3 fill-amber-400 text-amber-400" /&gt;
                &lt;/button&gt;
              ))}
            &lt;/div&gt;
          &lt;/div&gt;

          {/* Reviews List */}
          &lt;div className="space-y-3"&gt;
            {storeRatings
              .filter((r) =&gt; reviewStarFilter === null || r.storeRating === reviewStarFilter)
              .map((r) =&gt; (
                &lt;div key={r.id} className="bg-white p-4 rounded-2xl border border-slate-200 shadow-xs space-y-2"&gt;
                  &lt;div className="flex items-center justify-between"&gt;
                    &lt;div className="flex items-center gap-1.5"&gt;
                      &lt;div className="flex items-center text-amber-400"&gt;
                        {Array.from({ length: 5 }).map((_, i) =&gt; (
                          &lt;Star
                            key={i}
                            className={`w-3.5 h-3.5 ${
                              i &lt; r.storeRating ? 'fill-amber-400 text-amber-400' : 'text-slate-200'
                            }`}
                          /&gt;
                        ))}
                      &lt;/div&gt;
                      &lt;span className="text-xs font-bold text-slate-900"&gt;{r.customerName}&lt;/span&gt;
                    &lt;/div&gt;
                    &lt;span className="text-[10px] text-slate-400"&gt;
                      {new Date(r.createdAt).toLocaleDateString('ar-IQ')}
                    &lt;/span&gt;
                  &lt;/div&gt;

                  {r.storeComment &amp;&amp; (
                    &lt;p className="text-xs text-slate-600 bg-slate-50 p-2.5 rounded-xl border border-slate-100 leading-relaxed"&gt;
                      "{r.storeComment}"
                    &lt;/p&gt;
                  )}
                &lt;/div&gt;
              ))}

            {storeRatings.length === 0 &amp;&amp; (
              &lt;div className="text-center py-12 bg-white rounded-2xl border border-slate-200"&gt;
                &lt;Star className="w-8 h-8 text-amber-200 mx-auto mb-2" /&gt;
                &lt;p className="text-xs text-slate-400"&gt;لا توجد تقييمات مسجلة لهذا المطعم حتى الآن.&lt;/p&gt;
              &lt;/div&gt;
            )}
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ================= MODAL: ADD / EDIT PRODUCT ================= */}
      {isProductModalOpen &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 flex items-center justify-center p-3 bg-black/60 backdrop-blur-xs overflow-y-auto animate-fadeIn"&gt;
          &lt;div className="bg-white rounded-3xl w-full max-w-lg shadow-2xl border border-slate-200 max-h-[92vh] flex flex-col overflow-hidden my-auto"&gt;
            &lt;div className="p-4 border-b border-slate-100 flex items-center justify-between bg-white"&gt;
              &lt;h3 className="font-bold text-sm text-[#172554]"&gt;
                {editingProductId ? 'تعديل بيانات الصنف' : 'إضافة أكلة / منتج جديد'}
              &lt;/h3&gt;
              &lt;button
                type="button"
                onClick={() =&gt; setIsProductModalOpen(false)}
                className="w-8 h-8 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center hover:bg-slate-200"
              &gt;
                &lt;X className="w-4 h-4" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            &lt;form onSubmit={handleSaveProduct} className="flex-1 overflow-y-auto p-4 space-y-3.5 text-xs"&gt;
              {/* Product Photo Upload */}
              &lt;div&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;صورة الأكلة أو المنتج&lt;/label&gt;
                &lt;input
                  ref={prodImgInputRef}
                  type="file"
                  accept="image/*"
                  onChange={handleProdImageUpload}
                  className="hidden"
                /&gt;
                &lt;div className="flex items-center gap-3"&gt;
                  &lt;div className="w-20 h-20 rounded-xl overflow-hidden bg-slate-100 border border-slate-200 shrink-0"&gt;
                    &lt;img src={prodForm.imageUrl} alt="معاينة" className="w-full h-full object-cover" /&gt;
                  &lt;/div&gt;
                  &lt;div className="space-y-1.5 flex-1"&gt;
                    &lt;button
                      type="button"
                      onClick={() =&gt; prodImgInputRef.current?.click()}
                      disabled={isUploadingProdImg}
                      className="px-3 py-1.5 bg-orange-50 hover:bg-[#F47721] text-[#F47721] hover:text-white rounded-xl font-bold text-xs flex items-center gap-1.5 transition-colors disabled:opacity-50"
                    &gt;
                      &lt;Upload className="w-3.5 h-3.5" /&gt;
                      &lt;span&gt;{isUploadingProdImg ? 'جاري التحميل...' : 'رفع صورة من الجهاز'}&lt;/span&gt;
                    &lt;/button&gt;
                    &lt;input
                      type="text"
                      value={prodForm.imageUrl}
                      onChange={(e) =&gt; setProdForm({ ...prodForm, imageUrl: e.target.value })}
                      placeholder="أو الصق رابط صورة مباشر..."
                      className="w-full p-2 rounded-lg border border-slate-200 text-[11px] bg-slate-50"
                    /&gt;
                  &lt;/div&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Name &amp; Price */}
              &lt;div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5"&gt;
                &lt;div&gt;
                  &lt;label className="block font-semibold text-slate-700 mb-1"&gt;اسم الصنف / الأكلة&lt;/label&gt;
                  &lt;input
                    type="text"
                    value={prodForm.name}
                    onChange={(e) =&gt; setProdForm({ ...prodForm, name: e.target.value })}
                    className="w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white"
                    placeholder="مثال: نفر كباب مشوي عالفحم"
                    required
                  /&gt;
                &lt;/div&gt;
                &lt;div&gt;
                  &lt;label className="block font-semibold text-slate-700 mb-1"&gt;السعر الأساسي (د.ع)&lt;/label&gt;
                  &lt;input
                    type="number"
                    step="250"
                    value={prodForm.price}
                    onChange={(e) =&gt; setProdForm({ ...prodForm, price: Number(e.target.value) })}
                    className="w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white font-bold"
                    required
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Category &amp; Preparation Time */}
              &lt;div className="grid grid-cols-1 sm:grid-cols-2 gap-2.5"&gt;
                &lt;div&gt;
                  &lt;label className="block font-semibold text-slate-700 mb-1"&gt;التصنيف والقسم&lt;/label&gt;
                  &lt;input
                    type="text"
                    value={prodForm.category}
                    onChange={(e) =&gt; setProdForm({ ...prodForm, category: e.target.value })}
                    className="w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white"
                    placeholder="مشاوي، برغر، مقبلات..."
                    required
                  /&gt;
                &lt;/div&gt;
                &lt;div&gt;
                  &lt;label className="block font-semibold text-slate-700 mb-1"&gt;وقت التحضير المتوقع (دقيقة)&lt;/label&gt;
                  &lt;input
                    type="number"
                    value={prodForm.preparationTimeMinutes}
                    onChange={(e) =&gt; setProdForm({ ...prodForm, preparationTimeMinutes: Number(e.target.value) })}
                    className="w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white font-bold"
                    required
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Description */}
              &lt;div&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;وصف المكونات والتقديم&lt;/label&gt;
                &lt;textarea
                  rows={2}
                  value={prodForm.description}
                  onChange={(e) =&gt; setProdForm({ ...prodForm, description: e.target.value })}
                  className="w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white"
                  placeholder="وصف مختصر للوجبة أو المنتج..."
                /&gt;
              &lt;/div&gt;

              {/* Attached Option Groups */}
              &lt;div className="pt-2 border-t border-slate-100"&gt;
                &lt;div className="flex items-center justify-between mb-2"&gt;
                  &lt;span className="font-bold text-slate-800"&gt;مجموعات الخيارات المرفقة ({prodForm.optionGroups.length})&lt;/span&gt;
                  &lt;button
                    type="button"
                    onClick={() =&gt; setIsGroupBuilderOpen(true)}
                    className="text-[11px] font-bold text-[#F47721] hover:underline flex items-center gap-1"
                  &gt;
                    &lt;Plus className="w-3.5 h-3.5" /&gt;
                    &lt;span&gt;إضافة مجموعة خيارات&lt;/span&gt;
                  &lt;/button&gt;
                &lt;/div&gt;

                &lt;div className="space-y-2"&gt;
                  {prodForm.optionGroups.map((grp, gi) =&gt; (
                    &lt;div key={grp.id} className="p-2.5 bg-slate-50 rounded-xl border border-slate-200 flex items-center justify-between"&gt;
                      &lt;div&gt;
                        &lt;span className="font-bold text-slate-900 block"&gt;{grp.title}&lt;/span&gt;
                        &lt;span className="text-[10px] text-slate-400"&gt;
                          {grp.isRequired ? 'إلزامي' : 'اختياري'} • {grp.options.length} خيارات
                        &lt;/span&gt;
                      &lt;/div&gt;
                      &lt;button
                        type="button"
                        onClick={() =&gt; {
                          setProdForm((prev) =&gt; ({
                            ...prev,
                            optionGroups: prev.optionGroups.filter((_, idx) =&gt; idx !== gi),
                          }));
                        }}
                        className="text-rose-600 hover:text-rose-800 p-1"
                      &gt;
                        &lt;Trash2 className="w-3.5 h-3.5" /&gt;
                      &lt;/button&gt;
                    &lt;/div&gt;
                  ))}
                &lt;/div&gt;
              &lt;/div&gt;

              &lt;div className="pt-3 border-t border-slate-100 flex items-center justify-end gap-2"&gt;
                &lt;button
                  type="button"
                  onClick={() =&gt; setIsProductModalOpen(false)}
                  className="px-4 py-2 rounded-xl border border-slate-200 text-slate-700 font-bold hover:bg-slate-50"
                &gt;
                  إلغاء
                &lt;/button&gt;
                &lt;button
                  type="submit"
                  className="px-5 py-2 bg-[#F47721] hover:bg-[#e06816] text-white rounded-xl font-bold shadow-sm"
                &gt;
                  {editingProductId ? 'حفظ التعديلات' : 'إضافة إلى القائمة'}
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/form&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ================= MODAL: OPTION GROUP BUILDER ================= */}
      {isGroupBuilderOpen &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 flex items-center justify-center p-3 bg-black/60 backdrop-blur-xs overflow-y-auto animate-fadeIn"&gt;
          &lt;div className="bg-white rounded-3xl w-full max-w-md shadow-2xl border border-slate-200 p-4 space-y-4 my-auto"&gt;
            &lt;div className="flex items-center justify-between border-b border-slate-100 pb-2.5"&gt;
              &lt;h3 className="font-bold text-sm text-[#172554]"&gt;إنشاء مجموعة خيارات (أحجام أو إضافات)&lt;/h3&gt;
              &lt;button
                type="button"
                onClick={() =&gt; setIsGroupBuilderOpen(false)}
                className="w-7 h-7 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center hover:bg-slate-200"
              &gt;
                &lt;X className="w-4 h-4" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            &lt;div className="space-y-3 text-xs"&gt;
              &lt;div&gt;
                &lt;label className="block font-semibold text-slate-700 mb-1"&gt;اسم المجموعة&lt;/label&gt;
                &lt;input
                  type="text"
                  value={newGroupTitle}
                  onChange={(e) =&gt; setNewGroupTitle(e.target.value)}
                  placeholder="مثال: حجم الوجبة، إضافات الجبن، المشروب..."
                  className="w-full p-2.5 rounded-xl border border-slate-200 bg-slate-50 focus:bg-white"
                /&gt;
              &lt;/div&gt;

              &lt;div className="grid grid-cols-2 gap-2"&gt;
                &lt;label className="flex items-center gap-2 p-2 rounded-xl border border-slate-200 cursor-pointer bg-slate-50"&gt;
                  &lt;input
                    type="checkbox"
                    checked={newGroupRequired}
                    onChange={(e) =&gt; setNewGroupRequired(e.target.checked)}
                    className="accent-[#F47721]"
                  /&gt;
                  &lt;span className="font-bold text-slate-800"&gt;اختيار إلزامي&lt;/span&gt;
                &lt;/label&gt;

                &lt;div&gt;
                  &lt;select
                    value={newGroupMaxSelect}
                    onChange={(e) =&gt; setNewGroupMaxSelect(Number(e.target.value))}
                    className="w-full p-2 rounded-xl border border-slate-200 bg-slate-50 font-medium"
                  &gt;
                    &lt;option value={1}&gt;خيار واحد فقط (Radio)&lt;/option&gt;
                    &lt;option value={2}&gt;حتى خيارين (Checkbox)&lt;/option&gt;
                    &lt;option value={3}&gt;حتى 3 خيارات&lt;/option&gt;
                    &lt;option value={5}&gt;خيارات متعددة غير محدودة&lt;/option&gt;
                  &lt;/select&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Items List */}
              &lt;div className="space-y-2"&gt;
                &lt;div className="flex items-center justify-between"&gt;
                  &lt;span className="font-bold text-slate-700"&gt;عناصر الخيارات والأسعار&lt;/span&gt;
                  &lt;button
                    type="button"
                    onClick={() =&gt;
                      setNewGroupItems((prev) =&gt; [
                        ...prev,
                        { id: 'item_' + Date.now(), name: '', price: 0 },
                      ])
                    }
                    className="text-[11px] font-bold text-[#F47721] hover:underline"
                  &gt;
                    + إضافة خيار
                  &lt;/button&gt;
                &lt;/div&gt;

                {newGroupItems.map((item, idx) =&gt; (
                  &lt;div key={item.id} className="flex items-center gap-2"&gt;
                    &lt;input
                      type="text"
                      value={item.name}
                      onChange={(e) =&gt; {
                        const copy = [...newGroupItems];
                        copy[idx].name = e.target.value;
                        setNewGroupItems(copy);
                      }}
                      placeholder="اسم الخيار (مثال: جبن إضافي)"
                      className="flex-1 p-2 rounded-lg border border-slate-200 bg-slate-50"
                    /&gt;
                    &lt;input
                      type="number"
                      step="250"
                      value={item.price}
                      onChange={(e) =&gt; {
                        const copy = [...newGroupItems];
                        copy[idx].price = Number(e.target.value);
                        setNewGroupItems(copy);
                      }}
                      placeholder="السعر (0 لمجاناً)"
                      className="w-24 p-2 rounded-lg border border-slate-200 bg-slate-50 font-bold text-center"
                    /&gt;
                    &lt;button
                      type="button"
                      onClick={() =&gt; setNewGroupItems((prev) =&gt; prev.filter((_, i) =&gt; i !== idx))}
                      className="p-1.5 text-rose-600 hover:bg-rose-50 rounded-lg"
                    &gt;
                      &lt;Trash2 className="w-3.5 h-3.5" /&gt;
                    &lt;/button&gt;
                  &lt;/div&gt;
                ))}
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;div className="pt-3 border-t border-slate-100 flex items-center justify-end gap-2"&gt;
              &lt;button
                type="button"
                onClick={() =&gt; setIsGroupBuilderOpen(false)}
                className="px-4 py-2 rounded-xl border border-slate-200 text-slate-700 font-bold hover:bg-slate-50 text-xs"
              &gt;
                إلغاء
              &lt;/button&gt;
              &lt;button
                type="button"
                onClick={handleSaveOptionGroup}
                className="px-5 py-2 bg-[#F47721] hover:bg-[#e06816] text-white rounded-xl font-bold text-xs shadow-sm"
              &gt;
                حفظ المجموعة
              &lt;/button&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}
    &lt;/div&gt;
  );
};
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/merchant/RegisterRestaurantModal.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000045577&#65533;15267721203&#65533;022067&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import React, { useState } from 'react';
import {
  X,
  Store as StoreIcon,
  MapPin,
  Phone,
  User,
  Upload,
  CheckCircle,
  AlertCircle,
  FileText,
  Clock,
  Sparkles,
  DollarSign,
  UtensilsCrossed,
} from 'lucide-react';
import { useApp } from '../../context/AppContext';
import { LocationCoordinates } from '../../types';
import RealInteractiveMap from '../common/RealInteractiveMap';

interface RegisterRestaurantModalProps {
  isOpen: boolean;
  onClose: () =&gt; void;
}

const CATEGORIES = [
  'وجبات سريعة وبرجر',
  'مشويات وكباب عراقي',
  'شاورما وصاج',
  'بيتزا وفطائر',
  'مأكولات شعبية وتمن',
  'حلويات وآيس كريم',
  'كافيه وعصائر طبيعية',
  'سوبرماركت وبقالة',
];

const RegisterRestaurantModal: React.FC&lt;RegisterRestaurantModalProps&gt; = ({
  isOpen,
  onClose,
}) =&gt; {
  const { submitRestaurantApplication, uploadImageFile, currentUser } = useApp();

  const [storeName, setStoreName] = useState('');
  const [category, setCategory] = useState(CATEGORIES[0]);
  const [ownerName, setOwnerName] = useState(currentUser?.name || '');
  const [ownerPhone, setOwnerPhone] = useState(currentUser?.phone || '0770');
  const [city, setCity] = useState('بغداد');
  const [neighborhood, setNeighborhood] = useState('المنصور');
  const [address, setAddress] = useState('');
  const [minOrder, setMinOrder] = useState&lt;number&gt;(5000);
  const [description, setDescription] = useState('');
  const [logoPreview, setLogoPreview] = useState&lt;string&gt;('');
  const [coordinates, setCoordinates] = useState&lt;LocationCoordinates&gt;({
    lat: 33.3152,
    lng: 44.3661,
  });

  const [isSubmitting, setIsSubmitting] = useState(false);
  const [submittedSuccess, setSubmittedSuccess] = useState(false);
  const [errorMsg, setErrorMsg] = useState&lt;string | null&gt;(null);

  if (!isOpen) return null;

  const handleImageChange = async (e: React.ChangeEvent&lt;HTMLInputElement&gt;) =&gt; {
    const file = e.target.files?.[0];
    if (!file) return;

    try {
      const base64 = await uploadImageFile(file);
      setLogoPreview(base64);
    } catch (err) {
      console.error('Failed to read image', err);
      setErrorMsg('تعذر تحميل الصورة، يرجى تجربة صورة أصغر حجماً');
    }
  };

  const handleSubmit = async (e: React.FormEvent) =&gt; {
    e.preventDefault();
    setErrorMsg(null);

    if (!storeName.trim()) {
      setErrorMsg('يرجى كتابة اسم المطعم أو المتجر');
      return;
    }
    if (!ownerPhone.trim() || ownerPhone.length &lt; 10) {
      setErrorMsg('يرجى كتابة رقم هاتف عراقي صحيح للتواصل');
      return;
    }
    if (!address.trim()) {
      setErrorMsg('يرجى كتابة العنوان التفصيلي ونقطة دالة');
      return;
    }

    setIsSubmitting(true);

    try {
      const res = await submitRestaurantApplication({
        storeName: storeName.trim(),
        ownerName: ownerName.trim() || 'صاحب المتجر',
        ownerPhone: ownerPhone.trim(),
        category,
        address: `${city} - ${neighborhood}، ${address.trim()}`,
        coordinates,
        logoUrl: logoPreview || 'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=500&amp;auto=format&amp;fit=crop&amp;q=80',
        minOrder: Number(minOrder) || 5000,
        applicantUserId: currentUser?.id,
        documents: {
          commercialLicenseUrl: logoPreview || undefined,
        },
      });

      if (res.success) {
        setSubmittedSuccess(true);
      } else {
        setErrorMsg(res.error || 'تعذر إرسال الطلب، يرجى المحاولة لاحقاً');
      }
    } catch (err: any) {
      setErrorMsg(err.message || 'حدث خطأ غير متوقع');
    } finally {
      setIsSubmitting(false);
    }
  };

  const handleResetAndClose = () =&gt; {
    setSubmittedSuccess(false);
    setErrorMsg(null);
    onClose();
  };

  return (
    &lt;div className="fixed inset-0 z-50 overflow-y-auto bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-3 sm:p-6" dir="rtl"&gt;
      &lt;div className="bg-white rounded-2xl shadow-2xl max-w-2xl w-full border border-slate-100 overflow-hidden transform transition-all flex flex-col max-h-[92vh]"&gt;
        {/* Modal Header */}
        &lt;div className="bg-gradient-to-l from-orange-600 via-orange-500 to-amber-500 p-5 text-white flex items-center justify-between relative"&gt;
          &lt;div className="flex items-center gap-3"&gt;
            &lt;div className="w-12 h-12 rounded-xl bg-white/20 backdrop-blur-md flex items-center justify-center shadow-inner text-white"&gt;
              &lt;StoreIcon className="w-6 h-6" /&gt;
            &lt;/div&gt;
            &lt;div&gt;
              &lt;div className="flex items-center gap-2"&gt;
                &lt;h3 className="text-xl font-black"&gt;انضم كمطعم شريك في TALABI&lt;/h3&gt;
                &lt;span className="bg-white/20 text-xs px-2.5 py-0.5 rounded-full font-medium"&gt;تسجيل جديد&lt;/span&gt;
              &lt;/div&gt;
              &lt;p className="text-orange-100 text-xs mt-0.5"&gt;
                وسّع مبيعاتك في العراق وانضم لأسرع منصة توصيل ذكية
              &lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;
          &lt;button
            onClick={handleResetAndClose}
            className="w-9 h-9 rounded-full bg-white/10 hover:bg-white/25 flex items-center justify-center transition text-white"
          &gt;
            &lt;X className="w-5 h-5" /&gt;
          &lt;/button&gt;
        &lt;/div&gt;

        {/* Modal Body */}
        &lt;div className="p-5 sm:p-6 overflow-y-auto flex-1 space-y-5"&gt;
          {submittedSuccess ? (
            &lt;div className="py-8 text-center space-y-4"&gt;
              &lt;div className="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto shadow-sm"&gt;
                &lt;CheckCircle className="w-10 h-10 animate-bounce" /&gt;
              &lt;/div&gt;
              &lt;h4 className="text-xl font-black text-slate-800"&gt;
                تم استلام طلب انضمام مطعمك بنجاح!
              &lt;/h4&gt;
              &lt;div className="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-900 max-w-md mx-auto leading-relaxed text-right space-y-2"&gt;
                &lt;div className="flex items-center gap-2 font-bold text-amber-800"&gt;
                  &lt;Clock className="w-4 h-4 text-amber-600" /&gt;
                  &lt;span&gt;الحالة الحالية: بانتظار موافقة المدير&lt;/span&gt;
                &lt;/div&gt;
                &lt;p className="text-xs text-amber-700"&gt;
                  تم تسجيل طلبك وحفظه في النظام. سيقوم فريق إدارة طلبي بمراجعة البيانات واعتماد المتجر. فور الموافقة، ستتمكن من فتح لوحة المطعم، ضبط القائمة، وتلقي الطلبات فوراً.
                &lt;/p&gt;
              &lt;/div&gt;

              &lt;div className="pt-4 flex justify-center"&gt;
                &lt;button
                  type="button"
                  onClick={handleResetAndClose}
                  className="px-6 py-2.5 bg-orange-500 hover:bg-orange-600 text-white font-bold rounded-xl shadow-md transition"
                &gt;
                  فهمت، شكراً لك
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/div&gt;
          ) : (
            &lt;form onSubmit={handleSubmit} className="space-y-4"&gt;
              {errorMsg &amp;&amp; (
                &lt;div className="p-3 bg-red-50 border border-red-200 rounded-xl flex items-center gap-2.5 text-xs text-red-700 font-semibold"&gt;
                  &lt;AlertCircle className="w-4 h-4 flex-shrink-0 text-red-500" /&gt;
                  &lt;span&gt;{errorMsg}&lt;/span&gt;
                &lt;/div&gt;
              )}

              {/* Status Notice */}
              &lt;div className="bg-blue-50 border border-blue-200 rounded-xl p-3 flex items-start gap-3 text-xs text-blue-900"&gt;
                &lt;Sparkles className="w-4 h-4 text-blue-600 flex-shrink-0 mt-0.5" /&gt;
                &lt;div&gt;
                  &lt;span className="font-bold"&gt;سياسة الانضمام: &lt;/span&gt;
                  يُحفظ الطلب مباشرة بحالة &lt;strong&gt;«بانتظار موافقة المدير»&lt;/strong&gt; لحماية جودة المنصة. بعد الاعتماد يمكنك إدارة الأسعار والقوائم والطلبات بالكامل.
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Store Basic Info */}
              &lt;div className="grid grid-cols-1 sm:grid-cols-2 gap-3.5"&gt;
                &lt;div&gt;
                  &lt;label className="block text-xs font-bold text-slate-700 mb-1"&gt;
                    اسم المطعم / المتجر &lt;span className="text-red-500"&gt;*&lt;/span&gt;
                  &lt;/label&gt;
                  &lt;div className="relative"&gt;
                    &lt;StoreIcon className="w-4 h-4 text-slate-400 absolute right-3 top-3" /&gt;
                    &lt;input
                      type="text"
                      required
                      value={storeName}
                      onChange={(e) =&gt; setStoreName(e.target.value)}
                      placeholder="مثال: شاورما خان البغدادي"
                      className="w-full pr-9 pl-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-orange-400 focus:outline-none"
                    /&gt;
                  &lt;/div&gt;
                &lt;/div&gt;

                &lt;div&gt;
                  &lt;label className="block text-xs font-bold text-slate-700 mb-1"&gt;
                    تصنيف الطعام أو النشاط &lt;span className="text-red-500"&gt;*&lt;/span&gt;
                  &lt;/label&gt;
                  &lt;div className="relative"&gt;
                    &lt;UtensilsCrossed className="w-4 h-4 text-slate-400 absolute right-3 top-3 pointer-events-none" /&gt;
                    &lt;select
                      value={category}
                      onChange={(e) =&gt; setCategory(e.target.value)}
                      className="w-full pr-9 pl-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-orange-400 focus:outline-none appearance-none bg-white font-medium"
                    &gt;
                      {CATEGORIES.map((cat) =&gt; (
                        &lt;option key={cat} value={cat}&gt;
                          {cat}
                        &lt;/option&gt;
                      ))}
                    &lt;/select&gt;
                  &lt;/div&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Owner Info */}
              &lt;div className="grid grid-cols-1 sm:grid-cols-2 gap-3.5"&gt;
                &lt;div&gt;
                  &lt;label className="block text-xs font-bold text-slate-700 mb-1"&gt;
                    اسم المسؤول / صاحب المطعم
                  &lt;/label&gt;
                  &lt;div className="relative"&gt;
                    &lt;User className="w-4 h-4 text-slate-400 absolute right-3 top-3" /&gt;
                    &lt;input
                      type="text"
                      value={ownerName}
                      onChange={(e) =&gt; setOwnerName(e.target.value)}
                      placeholder="اسمك الكامل"
                      className="w-full pr-9 pl-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-orange-400 focus:outline-none"
                    /&gt;
                  &lt;/div&gt;
                &lt;/div&gt;

                &lt;div&gt;
                  &lt;label className="block text-xs font-bold text-slate-700 mb-1"&gt;
                    رقم الهاتف للتواصل &lt;span className="text-red-500"&gt;*&lt;/span&gt;
                  &lt;/label&gt;
                  &lt;div className="relative"&gt;
                    &lt;Phone className="w-4 h-4 text-slate-400 absolute right-3 top-3" /&gt;
                    &lt;input
                      type="tel"
                      required
                      value={ownerPhone}
                      onChange={(e) =&gt; setOwnerPhone(e.target.value)}
                      placeholder="0770XXXXXXX"
                      className="w-full pr-9 pl-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-orange-400 focus:outline-none font-mono"
                    /&gt;
                  &lt;/div&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Address &amp; City */}
              &lt;div className="grid grid-cols-1 sm:grid-cols-3 gap-3"&gt;
                &lt;div&gt;
                  &lt;label className="block text-xs font-bold text-slate-700 mb-1"&gt;المدينة&lt;/label&gt;
                  &lt;input
                    type="text"
                    value={city}
                    onChange={(e) =&gt; setCity(e.target.value)}
                    className="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-orange-400 focus:outline-none"
                  /&gt;
                &lt;/div&gt;
                &lt;div&gt;
                  &lt;label className="block text-xs font-bold text-slate-700 mb-1"&gt;المنطقة / الحي&lt;/label&gt;
                  &lt;input
                    type="text"
                    value={neighborhood}
                    onChange={(e) =&gt; setNeighborhood(e.target.value)}
                    placeholder="مثال: المنصور، الكرادة"
                    className="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-orange-400 focus:outline-none"
                  /&gt;
                &lt;/div&gt;
                &lt;div&gt;
                  &lt;label className="block text-xs font-bold text-slate-700 mb-1"&gt;الحد الأدنى للطلب (د.ع)&lt;/label&gt;
                  &lt;div className="relative"&gt;
                    &lt;DollarSign className="w-4 h-4 text-slate-400 absolute right-3 top-3" /&gt;
                    &lt;input
                      type="number"
                      step={500}
                      value={minOrder}
                      onChange={(e) =&gt; setMinOrder(Number(e.target.value))}
                      className="w-full pr-9 pl-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-orange-400 focus:outline-none font-mono"
                    /&gt;
                  &lt;/div&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              &lt;div&gt;
                &lt;label className="block text-xs font-bold text-slate-700 mb-1"&gt;
                  العنوان التفصيلي ونقطة دالة &lt;span className="text-red-500"&gt;*&lt;/span&gt;
                &lt;/label&gt;
                &lt;div className="relative"&gt;
                  &lt;MapPin className="w-4 h-4 text-slate-400 absolute right-3 top-3" /&gt;
                  &lt;input
                    type="text"
                    required
                    value={address}
                    onChange={(e) =&gt; setAddress(e.target.value)}
                    placeholder="مثال: شارع 14 رمضان، مجاور مصرف الرافدين، قرب تقاطع الرواد"
                    className="w-full pr-9 pl-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-orange-400 focus:outline-none"
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Interactive Map Picker */}
              &lt;div className="space-y-1.5"&gt;
                &lt;div className="flex items-center justify-between"&gt;
                  &lt;label className="block text-xs font-bold text-slate-700"&gt;
                    حدد موقع المطعم الدقيق على الخريطة &lt;span className="text-red-500"&gt;*&lt;/span&gt;
                  &lt;/label&gt;
                  &lt;span className="text-[11px] text-slate-400 font-mono"&gt;
                    {coordinates.lat.toFixed(4)}, {coordinates.lng.toFixed(4)}
                  &lt;/span&gt;
                &lt;/div&gt;
                &lt;div className="h-48 rounded-xl overflow-hidden border border-slate-200 shadow-inner"&gt;
                  &lt;RealInteractiveMap
                    destinationCoords={coordinates}
                    isInteractivePicker={true}
                    onCoordinateSelect={(coords: LocationCoordinates) =&gt; setCoordinates(coords)}
                  /&gt;
                &lt;/div&gt;
                &lt;p className="text-[11px] text-slate-500"&gt;
                  انقر على الخريطة لتثبيت مؤشر موقع المطعم لحساب مسافات التوصيل الدقيقة للزبائن.
                &lt;/p&gt;
              &lt;/div&gt;

              {/* Logo / Store Photo Upload */}
              &lt;div&gt;
                &lt;label className="block text-xs font-bold text-slate-700 mb-1.5"&gt;
                  صورة / شعار المطعم (أو واجهة المحل)
                &lt;/label&gt;
                &lt;div className="flex items-center gap-4"&gt;
                  &lt;label className="cursor-pointer flex items-center gap-2 px-4 py-2 bg-slate-100 hover:bg-slate-200 text-slate-700 text-xs font-bold rounded-xl transition border border-dashed border-slate-300"&gt;
                    &lt;Upload className="w-4 h-4 text-orange-500" /&gt;
                    &lt;span&gt;اختر صورة المطعم&lt;/span&gt;
                    &lt;input
                      type="file"
                      accept="image/*"
                      onChange={handleImageChange}
                      className="hidden"
                    /&gt;
                  &lt;/label&gt;

                  {logoPreview ? (
                    &lt;div className="flex items-center gap-2"&gt;
                      &lt;img
                        src={logoPreview}
                        alt="Preview"
                        className="w-12 h-12 object-cover rounded-xl border border-slate-200 shadow-sm"
                      /&gt;
                      &lt;span className="text-xs text-emerald-600 font-medium"&gt;تم تجهيز الصورة&lt;/span&gt;
                    &lt;/div&gt;
                  ) : (
                    &lt;span className="text-xs text-slate-400"&gt;
                      يمكنك رفع صورة شعار أو قائمة طعام
                    &lt;/span&gt;
                  )}
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Submit Buttons */}
              &lt;div className="pt-3 border-t border-slate-100 flex items-center justify-end gap-2.5"&gt;
                &lt;button
                  type="button"
                  onClick={handleResetAndClose}
                  className="px-4 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-100 rounded-xl transition"
                &gt;
                  إلغاء
                &lt;/button&gt;
                &lt;button
                  type="submit"
                  disabled={isSubmitting}
                  className="px-6 py-2.5 bg-orange-500 hover:bg-orange-600 disabled:opacity-50 text-white text-xs font-bold rounded-xl shadow-md transition flex items-center gap-2"
                &gt;
                  {isSubmitting ? (
                    &lt;&gt;
                      &lt;div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin" /&gt;
                      &lt;span&gt;جاري إرسال الطلب...&lt;/span&gt;
                    &lt;/&gt;
                  ) : (
                    &lt;&gt;
                      &lt;StoreIcon className="w-4 h-4" /&gt;
                      &lt;span&gt;إرسال طلب الانضمام للمراجعة&lt;/span&gt;
                    &lt;/&gt;
                  )}
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/form&gt;
          )}
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
};

export default RegisterRestaurantModal;
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/admin/&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000755&#65533;0000000&#65533;0000000&#65533;00000000000&#65533;15267721203&#65533;013762&#65533; 5&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/admin/AdminView.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000100536&#65533;15267721203&#65533;016412&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import React, { useState } from 'react';
import { useApp } from '../../context/AppContext';
import { OrderStatus } from '../../types';
import { PricingAndCommissionsManager } from './PricingAndCommissionsManager';
import {
  ShieldAlert,
  Activity,
  Layers,
  Store,
  Bike,
  FileText,
  Download,
  Upload,
  RotateCcw,
  AlertTriangle,
  WifiOff,
  CreditCard,
  UserX,
  Search,
  CheckCircle2,
  Clock,
  Ban,
  ArrowUpDown,
  ExternalLink,
  Coins,
  ClipboardCheck,
  UserCheck,
} from 'lucide-react';
import { ApplicationReviewSection } from './ApplicationReviewSection';

export const AdminView: React.FC = () =&gt; {
  const {
    orders,
    stores,
    couriers,
    auditLogs,
    restaurantApplications,
    courierApplications,
    updateOrderStatus,
    assignCourierToOrder,
    cancelOrder,
    isSimulatedOffline,
    setIsSimulatedOffline,
    forcePaymentFail,
    setForcePaymentFail,
    forceNoCourier,
    setForceNoCourier,
    resetToInitialData,
    exportDatabaseJson,
    importDatabaseJson,
    setActiveTrackedOrderId,
    setRole,
  } = useApp();

  const [activeTab, setActiveTab] = useState&lt;
    | 'orders'
    | 'stores'
    | 'couriers'
    | 'pricing'
    | 'audit'
    | 'simulator'
    | 'restaurant_applications'
    | 'courier_applications'
  &gt;('orders');
  const [orderSearch, setOrderSearch] = useState('');
  const [orderStatusFilter, setOrderStatusFilter] = useState&lt;string&gt;('all');
  const [importJsonText, setImportJsonText] = useState('');
  const [showImportBox, setShowImportBox] = useState(false);

  // Platform KPIs
  const totalGMV = orders
    .filter((o) =&gt; o.status !== 'cancelled')
    .reduce((acc, o) =&gt; acc + o.total, 0);

  const activeOrdersCount = orders.filter(
    (o) =&gt; o.status !== 'delivered' &amp;&amp; o.status !== 'cancelled'
  ).length;

  const onlineCouriersCount = couriers.filter((c) =&gt; c.isOnline).length;
  const openStoresCount = stores.filter((s) =&gt; s.isOpen).length;
  const pendingRestaurantsCount = (restaurantApplications || []).filter((a) =&gt; a.status === 'pending').length;
  const pendingCouriersCount = (courierApplications || []).filter((a) =&gt; a.status === 'pending').length;

  // Filtered orders
  const filteredOrders = orders.filter((o) =&gt; {
    const matchesSearch =
      o.id.includes(orderSearch) ||
      o.customer.name.toLowerCase().includes(orderSearch.toLowerCase()) ||
      o.storeName.toLowerCase().includes(orderSearch.toLowerCase());
    const matchesStatus = orderStatusFilter === 'all' || o.status === orderStatusFilter;
    return matchesSearch &amp;&amp; matchesStatus;
  });

  const handleExport = () =&gt; {
    const jsonStr = exportDatabaseJson();
    const blob = new Blob([jsonStr], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `talabi_backup_${new Date().toISOString().slice(0, 10)}.json`;
    a.click();
    URL.revokeObjectURL(url);
  };

  const handleImportSubmit = () =&gt; {
    if (!importJsonText.trim()) return;
    const ok = importDatabaseJson(importJsonText);
    if (ok) {
      setShowImportBox(false);
      setImportJsonText('');
    } else {
      alert('صيغة ملف النسخة الاحتياطية غير صالحة.');
    }
  };

  return (
    &lt;div className="max-w-6xl mx-auto px-4 py-6 space-y-6 text-slate-800"&gt;
      {/* Admin Operations Tower Header */}
      &lt;div className="bg-[#172554] text-white rounded-3xl p-5 shadow-lg flex flex-col md:flex-row items-start md:items-center justify-between gap-4"&gt;
        &lt;div className="flex items-center gap-3"&gt;
          &lt;div className="w-12 h-12 rounded-2xl bg-orange-500 flex items-center justify-center text-white shadow-md"&gt;
            &lt;ShieldAlert className="w-6 h-6" /&gt;
          &lt;/div&gt;
          &lt;div&gt;
            &lt;div className="flex items-center gap-2"&gt;
              &lt;h2 className="font-black text-lg text-white"&gt;غرفة العمليات المركزية | إدارة طلبي&lt;/h2&gt;
              &lt;span className="text-[10px] bg-orange-500/30 text-orange-200 border border-orange-500/40 px-2 py-0.5 rounded font-bold"&gt;
                Admin Control Tower
              &lt;/span&gt;
            &lt;/div&gt;
            &lt;p className="text-xs text-slate-300"&gt;مراقبة الطلبات المباشرة، إدارة الأسطول، وسجل التدقيق والامتثال&lt;/p&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Quick Data Operations */}
        &lt;div className="flex items-center gap-2 flex-wrap"&gt;
          &lt;button
            onClick={handleExport}
            className="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-xs font-bold flex items-center gap-1.5 border border-slate-700 transition-colors"
          &gt;
            &lt;Download className="w-3.5 h-3.5 text-orange-400" /&gt;
            &lt;span&gt;تصدير نسخة احتياطية&lt;/span&gt;
          &lt;/button&gt;

          &lt;button
            onClick={() =&gt; setShowImportBox(!showImportBox)}
            className="px-3 py-1.5 bg-slate-800 hover:bg-slate-700 text-slate-200 rounded-xl text-xs font-bold flex items-center gap-1.5 border border-slate-700 transition-colors"
          &gt;
            &lt;Upload className="w-3.5 h-3.5 text-sky-400" /&gt;
            &lt;span&gt;استعادة نسخة&lt;/span&gt;
          &lt;/button&gt;

          &lt;button
            onClick={() =&gt; {
              if (confirm('هل أنت متأكد من رغبتك في إعادة ضبط جميع الجداول والبيانات إلى حالتها الأولية؟')) {
                resetToInitialData();
              }
            }}
            className="px-3 py-1.5 bg-rose-900/60 hover:bg-rose-900 text-rose-200 rounded-xl text-xs font-bold flex items-center gap-1.5 border border-rose-800 transition-colors"
          &gt;
            &lt;RotateCcw className="w-3.5 h-3.5" /&gt;
            &lt;span&gt;إعادة ضبط المصنع&lt;/span&gt;
          &lt;/button&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      {/* Import Modal */}
      {showImportBox &amp;&amp; (
        &lt;div className="p-4 bg-slate-100 rounded-2xl border border-slate-300 space-y-2 animate-in fade-in"&gt;
          &lt;label className="text-xs font-bold text-slate-800 block"&gt;
            الصق محتوى ملف JSON للنسخة الاحتياطية هنا:
          &lt;/label&gt;
          &lt;textarea
            rows={4}
            value={importJsonText}
            onChange={(e) =&gt; setImportJsonText(e.target.value)}
            placeholder='{"stores": [...], "orders": [...]}'
            className="w-full p-2.5 rounded-xl border border-slate-300 font-mono text-xs bg-white"
          /&gt;
          &lt;div className="flex justify-end gap-2"&gt;
            &lt;button
              onClick={() =&gt; setShowImportBox(false)}
              className="px-3 py-1.5 rounded-lg text-xs font-bold text-slate-600 hover:bg-slate-200"
            &gt;
              إلغاء
            &lt;/button&gt;
            &lt;button
              onClick={handleImportSubmit}
              className="px-4 py-1.5 bg-orange-500 hover:bg-orange-600 text-white rounded-lg text-xs font-bold"
            &gt;
              استيراد وتطبيق البيانات
            &lt;/button&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* KPI Stats Bar */}
      &lt;div className="grid grid-cols-2 sm:grid-cols-4 gap-3"&gt;
        &lt;div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs space-y-1"&gt;
          &lt;span className="text-[11px] font-bold text-slate-400 block"&gt;إجمالي التعاملات (GMV)&lt;/span&gt;
          &lt;p className="text-lg font-black text-emerald-600"&gt;{totalGMV.toLocaleString()} د.ع&lt;/p&gt;
          &lt;span className="text-[10px] text-slate-400"&gt;دينار عراقي محقق&lt;/span&gt;
        &lt;/div&gt;

        &lt;div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs space-y-1"&gt;
          &lt;span className="text-[11px] font-bold text-slate-400 block"&gt;الطلبات النشطة الآن&lt;/span&gt;
          &lt;p className="text-lg font-black text-orange-600"&gt;{activeOrdersCount} طلب&lt;/p&gt;
          &lt;span className="text-[10px] text-slate-400"&gt;قيد المعالجة والتوصيل&lt;/span&gt;
        &lt;/div&gt;

        &lt;div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs space-y-1"&gt;
          &lt;span className="text-[11px] font-bold text-slate-400 block"&gt;المناديب على رأس العمل&lt;/span&gt;
          &lt;p className="text-lg font-black text-[#172554]"&gt;{onlineCouriersCount} كابتن&lt;/p&gt;
          &lt;span className="text-[10px] text-slate-400"&gt;من أصل {couriers.length} مسجلين&lt;/span&gt;
        &lt;/div&gt;

        &lt;div className="bg-white p-4 rounded-2xl border border-slate-200 shadow-2xs space-y-1"&gt;
          &lt;span className="text-[11px] font-bold text-slate-400 block"&gt;المتاجر والمطاعم المفتوحة&lt;/span&gt;
          &lt;p className="text-lg font-black text-sky-600"&gt;{openStoresCount} متجر&lt;/p&gt;
          &lt;span className="text-[10px] text-slate-400"&gt;من أصل {stores.length} معتمدين&lt;/span&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      {/* Nav Tabs */}
      &lt;div className="flex items-center gap-2 border-b border-slate-200 pb-2 overflow-x-auto"&gt;
        &lt;button
          onClick={() =&gt; setActiveTab('orders')}
          className={`flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap ${
            activeTab === 'orders' ? 'bg-[#172554] text-white shadow' : 'text-slate-600 hover:bg-slate-100'
          }`}
        &gt;
          &lt;Layers className="w-4 h-4" /&gt;
          &lt;span&gt;كل الطلبات ({orders.length})&lt;/span&gt;
        &lt;/button&gt;

        &lt;button
          onClick={() =&gt; setActiveTab('stores')}
          className={`flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap ${
            activeTab === 'stores' ? 'bg-[#172554] text-white shadow' : 'text-slate-600 hover:bg-slate-100'
          }`}
        &gt;
          &lt;Store className="w-4 h-4" /&gt;
          &lt;span&gt;المتاجر والشركاء ({stores.length})&lt;/span&gt;
        &lt;/button&gt;

        &lt;button
          onClick={() =&gt; setActiveTab('couriers')}
          className={`flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap ${
            activeTab === 'couriers' ? 'bg-[#172554] text-white shadow' : 'text-slate-600 hover:bg-slate-100'
          }`}
        &gt;
          &lt;Bike className="w-4 h-4" /&gt;
          &lt;span&gt;أسطول المناديب ({couriers.length})&lt;/span&gt;
        &lt;/button&gt;

        &lt;button
          onClick={() =&gt; setActiveTab('restaurant_applications')}
          className={`flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap ${
            activeTab === 'restaurant_applications'
              ? 'bg-[#172554] text-white shadow'
              : 'text-slate-600 hover:bg-slate-100'
          }`}
        &gt;
          &lt;ClipboardCheck className="w-4 h-4 text-orange-400" /&gt;
          &lt;span&gt;طلبات انضمام المطاعم&lt;/span&gt;
          {pendingRestaurantsCount &gt; 0 &amp;&amp; (
            &lt;span className="bg-orange-500 text-white text-[10px] font-black px-1.5 py-0.5 rounded-full"&gt;
              {pendingRestaurantsCount}
            &lt;/span&gt;
          )}
        &lt;/button&gt;

        &lt;button
          onClick={() =&gt; setActiveTab('courier_applications')}
          className={`flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap ${
            activeTab === 'courier_applications'
              ? 'bg-[#172554] text-white shadow'
              : 'text-slate-600 hover:bg-slate-100'
          }`}
        &gt;
          &lt;UserCheck className="w-4 h-4 text-blue-400" /&gt;
          &lt;span&gt;طلبات انضمام الكباتن&lt;/span&gt;
          {pendingCouriersCount &gt; 0 &amp;&amp; (
            &lt;span className="bg-blue-600 text-white text-[10px] font-black px-1.5 py-0.5 rounded-full"&gt;
              {pendingCouriersCount}
            &lt;/span&gt;
          )}
        &lt;/button&gt;

        &lt;button
          onClick={() =&gt; setActiveTab('pricing')}
          className={`flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap ${
            activeTab === 'pricing' ? 'bg-[#F47721] text-white shadow' : 'text-slate-600 hover:bg-slate-100'
          }`}
        &gt;
          &lt;Coins className="w-4 h-4" /&gt;
          &lt;span&gt;العمولات وأجور التوصيل&lt;/span&gt;
        &lt;/button&gt;

        &lt;button
          onClick={() =&gt; setActiveTab('audit')}
          className={`flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap ${
            activeTab === 'audit' ? 'bg-[#172554] text-white shadow' : 'text-slate-600 hover:bg-slate-100'
          }`}
        &gt;
          &lt;FileText className="w-4 h-4" /&gt;
          &lt;span&gt;سجل التدقيق (Audit Logs)&lt;/span&gt;
        &lt;/button&gt;

        &lt;button
          onClick={() =&gt; setActiveTab('simulator')}
          className={`flex items-center gap-2 px-3.5 py-2 rounded-xl text-xs font-bold transition-all whitespace-nowrap ${
            activeTab === 'simulator'
              ? 'bg-orange-500 text-white shadow'
              : 'text-orange-700 bg-orange-50 hover:bg-orange-100 border border-orange-200'
          }`}
        &gt;
          &lt;AlertTriangle className="w-4 h-4" /&gt;
          &lt;span&gt;محاكي الأعطال وفحص الجودة&lt;/span&gt;
        &lt;/button&gt;
      &lt;/div&gt;

      {/* TAB 1: ALL ORDERS MANAGEMENT */}
      {activeTab === 'orders' &amp;&amp; (
        &lt;div className="bg-white rounded-3xl border border-slate-200 p-4 shadow-sm space-y-4"&gt;
          &lt;div className="flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3"&gt;
            &lt;div className="relative flex-1"&gt;
              &lt;Search className="w-4 h-4 text-slate-400 absolute right-3 top-3" /&gt;
              &lt;input
                type="text"
                placeholder="بحث برقم الطلب، اسم الزبون، أو المتجر..."
                value={orderSearch}
                onChange={(e) =&gt; setOrderSearch(e.target.value)}
                className="w-full pr-9 pl-3 py-2 text-xs rounded-xl border border-slate-200 focus:outline-none focus:border-orange-500"
              /&gt;
            &lt;/div&gt;

            &lt;select
              value={orderStatusFilter}
              onChange={(e) =&gt; setOrderStatusFilter(e.target.value)}
              className="text-xs p-2 rounded-xl border border-slate-200 font-bold bg-white"
            &gt;
              &lt;option value="all"&gt;جميع الحالات&lt;/option&gt;
              &lt;option value="created"&gt;تم الاستلام&lt;/option&gt;
              &lt;option value="merchant_accepted"&gt;وافق المطعم&lt;/option&gt;
              &lt;option value="preparing"&gt;قيد التحضير&lt;/option&gt;
              &lt;option value="ready_for_pickup"&gt;جاهز للمندوب&lt;/option&gt;
              &lt;option value="courier_assigned"&gt;تم تعيين مندوب&lt;/option&gt;
              &lt;option value="picked_up"&gt;في الطريق&lt;/option&gt;
              &lt;option value="delivered"&gt;مكتمل&lt;/option&gt;
              &lt;option value="cancelled"&gt;ملغي&lt;/option&gt;
            &lt;/select&gt;
          &lt;/div&gt;

          &lt;div className="overflow-x-auto"&gt;
            &lt;table className="w-full text-right text-xs"&gt;
              &lt;thead&gt;
                &lt;tr className="bg-slate-50 text-slate-500 border-b border-slate-200"&gt;
                  &lt;th className="p-3 font-bold"&gt;رقم الطلب&lt;/th&gt;
                  &lt;th className="p-3 font-bold"&gt;الزبون&lt;/th&gt;
                  &lt;th className="p-3 font-bold"&gt;المتجر&lt;/th&gt;
                  &lt;th className="p-3 font-bold"&gt;المندوب&lt;/th&gt;
                  &lt;th className="p-3 font-bold"&gt;الحسابات والعمولات&lt;/th&gt;
                  &lt;th className="p-3 font-bold"&gt;طريقة الدفع&lt;/th&gt;
                  &lt;th className="p-3 font-bold"&gt;الحالة&lt;/th&gt;
                  &lt;th className="p-3 font-bold text-center"&gt;إجراءات&lt;/th&gt;
                &lt;/tr&gt;
              &lt;/thead&gt;
              &lt;tbody className="divide-y divide-slate-100"&gt;
                {filteredOrders.map((o) =&gt; (
                  &lt;tr key={o.id} className="hover:bg-slate-50/60 transition-colors"&gt;
                    &lt;td className="p-3 font-extrabold text-[#172554]"&gt;#{o.id}&lt;/td&gt;
                    &lt;td className="p-3"&gt;
                      &lt;p className="font-bold text-slate-800"&gt;{o.customer.name}&lt;/p&gt;
                      &lt;p className="text-[10px] text-slate-400"&gt;{o.customer.phone}&lt;/p&gt;
                    &lt;/td&gt;
                    &lt;td className="p-3 font-medium text-slate-700"&gt;{o.storeName}&lt;/td&gt;
                    &lt;td className="p-3"&gt;
                      {o.courierName ? (
                        &lt;span className="font-bold text-slate-800"&gt;{o.courierName}&lt;/span&gt;
                      ) : (
                        &lt;select
                          onChange={(e) =&gt; assignCourierToOrder(o.id, e.target.value)}
                          defaultValue=""
                          className="text-[10px] p-1 border rounded bg-white text-orange-600 font-bold"
                        &gt;
                          &lt;option value="" disabled&gt;
                            إسناد مندوب...
                          &lt;/option&gt;
                          {couriers
                            .filter((c) =&gt; c.isOnline)
                            .map((c) =&gt; (
                              &lt;option key={c.id} value={c.id}&gt;
                                {c.name}
                              &lt;/option&gt;
                            ))}
                        &lt;/select&gt;
                      )}
                    &lt;/td&gt;
                    &lt;td className="p-3"&gt;
                      &lt;p className="font-black text-slate-900"&gt;{o.total.toLocaleString()} د.ع&lt;/p&gt;
                      {o.financials ? (
                        &lt;div className="flex flex-col gap-0.5 mt-1 text-[10px]"&gt;
                          &lt;span className="text-emerald-700 font-bold"&gt;
                            صافي المتجر: {o.financials.storeNetPayout.toLocaleString()} د.ع
                          &lt;/span&gt;
                          &lt;span className="text-purple-700 font-medium"&gt;
                            عمولة المنصة ({o.financials.platformCommissionPercent}%): {o.financials.platformCommissionAmount.toLocaleString()} د.ع
                          &lt;/span&gt;
                          &lt;span className="text-sky-700 font-medium"&gt;
                            مستحق المندوب: {o.financials.courierTotalEarnings.toLocaleString()} د.ع
                            {o.financials.courierBonus &gt; 0 &amp;&amp; ` (+${o.financials.courierBonus.toLocaleString()} حافز)`}
                          &lt;/span&gt;
                        &lt;/div&gt;
                      ) : (
                        &lt;span className="text-[10px] text-slate-400"&gt;توصيل: {o.deliveryFee.toLocaleString()} د.ع&lt;/span&gt;
                      )}
                    &lt;/td&gt;
                    &lt;td className="p-3"&gt;
                      &lt;span className="text-[10px] bg-slate-100 text-slate-700 px-2 py-0.5 rounded font-bold"&gt;
                        {o.payment.method === 'zain_cash'
                          ? 'زين كاش'
                          : o.payment.method === 'qi_card'
                          ? 'كي كارد'
                          : 'نقد (COD)'}
                      &lt;/span&gt;
                    &lt;/td&gt;
                    &lt;td className="p-3"&gt;
                      &lt;span
                        className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${
                          o.status === 'delivered'
                            ? 'bg-emerald-100 text-emerald-800'
                            : o.status === 'cancelled'
                            ? 'bg-rose-100 text-rose-800'
                            : 'bg-orange-100 text-orange-800'
                        }`}
                      &gt;
                        {o.status}
                      &lt;/span&gt;
                    &lt;/td&gt;
                    &lt;td className="p-3 text-center"&gt;
                      &lt;div className="flex items-center justify-center gap-1.5"&gt;
                        &lt;button
                          onClick={() =&gt; {
                            setActiveTrackedOrderId(o.id);
                            setRole('customer');
                          }}
                          className="p-1 text-slate-400 hover:text-orange-500"
                          title="عرض في شاشة التتبع"
                        &gt;
                          &lt;ExternalLink className="w-3.5 h-3.5" /&gt;
                        &lt;/button&gt;

                        {o.status !== 'delivered' &amp;&amp; o.status !== 'cancelled' &amp;&amp; (
                          &lt;button
                            onClick={() =&gt; cancelOrder(o.id, 'إلغاء إداري من غرفة العمليات')}
                            className="text-[10px] text-rose-600 hover:underline font-bold"
                          &gt;
                            إلغاء
                          &lt;/button&gt;
                        )}
                      &lt;/div&gt;
                    &lt;/td&gt;
                  &lt;/tr&gt;
                ))}
              &lt;/tbody&gt;
            &lt;/table&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* TAB 2: STORES */}
      {activeTab === 'stores' &amp;&amp; (
        &lt;div className="grid grid-cols-1 md:grid-cols-2 gap-4"&gt;
          {stores.map((s) =&gt; (
            &lt;div key={s.id} className="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm flex items-center justify-between gap-3"&gt;
              &lt;div className="flex items-center gap-3"&gt;
                &lt;img src={s.logo} alt={s.name} className="w-12 h-12 rounded-xl object-cover bg-slate-100" /&gt;
                &lt;div&gt;
                  &lt;h4 className="font-black text-xs text-slate-900"&gt;{s.name}&lt;/h4&gt;
                  &lt;p className="text-[11px] text-slate-400"&gt;{s.neighborhood} • {s.category}&lt;/p&gt;
                  &lt;p className="text-[10px] text-emerald-700 font-bold mt-0.5"&gt;عمولة المنصة: 10% • أجور التوصيل: {s.deliveryFee.toLocaleString()} د.ع&lt;/p&gt;
                &lt;/div&gt;
              &lt;/div&gt;
              &lt;span
                className={`text-[10px] font-bold px-2.5 py-1 rounded-full ${
                  s.isOpen ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800'
                }`}
              &gt;
                {s.isOpen ? 'مفتوح' : 'مغلق'}
              &lt;/span&gt;
            &lt;/div&gt;
          ))}
        &lt;/div&gt;
      )}

      {/* TAB 3: COURIERS FLEET */}
      {activeTab === 'couriers' &amp;&amp; (
        &lt;div className="grid grid-cols-1 md:grid-cols-3 gap-4"&gt;
          {couriers.map((c) =&gt; (
            &lt;div key={c.id} className="bg-white rounded-2xl border border-slate-200 p-4 shadow-sm space-y-2"&gt;
              &lt;div className="flex items-center justify-between"&gt;
                &lt;h4 className="font-extrabold text-xs text-slate-900"&gt;{c.name}&lt;/h4&gt;
                &lt;span
                  className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${
                    c.isOnline ? 'bg-emerald-100 text-emerald-800' : 'bg-slate-100 text-slate-600'
                  }`}
                &gt;
                  {c.isOnline ? 'متصل' : 'غير متصل'}
                &lt;/span&gt;
              &lt;/div&gt;
              &lt;p className="text-[11px] text-slate-500"&gt;
                مركبة: {c.vehicleType} ({c.vehiclePlate})
              &lt;/p&gt;
              &lt;div className="pt-2 border-t border-slate-100 flex justify-between text-[11px]"&gt;
                &lt;span&gt;التوصيلات: &lt;strong&gt;{c.totalDeliveries}&lt;/strong&gt;&lt;/span&gt;
                &lt;span&gt;المحفظة: &lt;strong className="text-emerald-600"&gt;{c.walletBalance.toLocaleString()} د.ع&lt;/strong&gt;&lt;/span&gt;
              &lt;/div&gt;
            &lt;/div&gt;
          ))}
        &lt;/div&gt;
      )}

      {/* TAB 4: PRICING &amp; COMMISSIONS MANAGER */}
      {activeTab === 'pricing' &amp;&amp; &lt;PricingAndCommissionsManager /&gt;}

      {/* TAB 4: AUDIT LOGS */}
      {activeTab === 'audit' &amp;&amp; (
        &lt;div className="bg-white rounded-3xl border border-slate-200 p-4 shadow-sm space-y-3"&gt;
          &lt;div className="flex items-center justify-between pb-2 border-b border-slate-200"&gt;
            &lt;h3 className="font-black text-xs text-[#172554]"&gt;سجل تدقيق العمليات الآمن (Audit Trail)&lt;/h3&gt;
            &lt;span className="text-[10px] text-slate-400"&gt;آخر 100 إجراء مسجل بالكامل مع البصمة الزمنية&lt;/span&gt;
          &lt;/div&gt;

          &lt;div className="divide-y divide-slate-100 max-h-96 overflow-y-auto"&gt;
            {auditLogs.map((log) =&gt; (
              &lt;div key={log.id} className="py-2.5 text-xs flex items-start justify-between gap-3"&gt;
                &lt;div&gt;
                  &lt;div className="flex items-center gap-2"&gt;
                    &lt;span className="font-mono text-[10px] text-slate-400"&gt;{log.timestamp}&lt;/span&gt;
                    &lt;span className="font-bold text-slate-800"&gt;{log.action}&lt;/span&gt;
                    &lt;span className="text-[10px] bg-slate-100 text-slate-600 px-1.5 py-0.2 rounded font-semibold"&gt;
                      {log.entityType}
                    &lt;/span&gt;
                  &lt;/div&gt;
                  &lt;p className="text-slate-600 text-[11px] mt-0.5"&gt;{log.details}&lt;/p&gt;
                &lt;/div&gt;
                &lt;span className="text-[10px] text-slate-400 shrink-0 font-medium"&gt;{log.performedBy}&lt;/span&gt;
              &lt;/div&gt;
            ))}
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* TAB 5: RELIABILITY &amp; EDGE-CASE SIMULATOR */}
      {activeTab === 'simulator' &amp;&amp; (
        &lt;div className="bg-white rounded-3xl border-2 border-orange-300 p-6 shadow-sm space-y-6"&gt;
          &lt;div className="space-y-1"&gt;
            &lt;h3 className="font-black text-base text-orange-950 flex items-center gap-2"&gt;
              &lt;AlertTriangle className="w-5 h-5 text-orange-500" /&gt;
              محاكي الأعطال وسيناريوهات فحص الجودة (Quality Assurance Suite)
            &lt;/h3&gt;
            &lt;p className="text-xs text-slate-500"&gt;
              اختبار متطلبات الوثيقة (Requirements #8 &amp; #10): انقطاع الإنترنت، فشل بوابات الدفع، إلغاء الطلبات، منع تكرار الطلب، وعدم توفر مندوب.
            &lt;/p&gt;
          &lt;/div&gt;

          &lt;div className="grid grid-cols-1 md:grid-cols-3 gap-4"&gt;
            {/* Test 1: Offline simulation */}
            &lt;div className={`p-4 rounded-2xl border transition-all ${
              isSimulatedOffline ? 'bg-rose-50 border-rose-300' : 'bg-slate-50 border-slate-200'
            }`}&gt;
              &lt;div className="flex items-center justify-between mb-2"&gt;
                &lt;span className="font-bold text-xs flex items-center gap-1.5 text-slate-800"&gt;
                  &lt;WifiOff className="w-4 h-4 text-rose-500" /&gt;
                  محاكاة انقطاع الإنترنت
                &lt;/span&gt;
                &lt;span className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${
                  isSimulatedOffline ? 'bg-rose-200 text-rose-800' : 'bg-slate-200 text-slate-600'
                }`}&gt;
                  {isSimulatedOffline ? 'مفعل' : 'معطل'}
                &lt;/span&gt;
              &lt;/div&gt;
              &lt;p className="text-[11px] text-slate-500 mb-3"&gt;
                يفحص سلوك التطبيق عند فقدان الاتصال بالخادم ويمنع الطلبات مع عرض رسالة خطأ واضحة للمستخدم.
              &lt;/p&gt;
              &lt;button
                onClick={() =&gt; setIsSimulatedOffline(!isSimulatedOffline)}
                className={`w-full py-2 rounded-xl text-xs font-bold transition-colors ${
                  isSimulatedOffline ? 'bg-rose-600 text-white' : 'bg-slate-200 text-slate-700 hover:bg-slate-300'
                }`}
              &gt;
                {isSimulatedOffline ? 'إيقاف المحاكاة (عودة الاتصال)' : 'تفعيل انقطاع الإنترنت'}
              &lt;/button&gt;
            &lt;/div&gt;

            {/* Test 2: Payment failure simulation */}
            &lt;div className={`p-4 rounded-2xl border transition-all ${
              forcePaymentFail ? 'bg-amber-50 border-amber-300' : 'bg-slate-50 border-slate-200'
            }`}&gt;
              &lt;div className="flex items-center justify-between mb-2"&gt;
                &lt;span className="font-bold text-xs flex items-center gap-1.5 text-slate-800"&gt;
                  &lt;CreditCard className="w-4 h-4 text-amber-500" /&gt;
                  محاكاة فشل الدفع الإلكتروني
                &lt;/span&gt;
                &lt;span className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${
                  forcePaymentFail ? 'bg-amber-200 text-amber-800' : 'bg-slate-200 text-slate-600'
                }`}&gt;
                  {forcePaymentFail ? 'مفعل' : 'معطل'}
                &lt;/span&gt;
              &lt;/div&gt;
              &lt;p className="text-[11px] text-slate-500 mb-3"&gt;
                يرفض بوابات الدفع (زين كاش / كي كارد) للتحقق من عدم سحب أي مبالغ وإتاحة إعادة المحاولة أو الدفع نقداً.
              &lt;/p&gt;
              &lt;button
                onClick={() =&gt; setForcePaymentFail(!forcePaymentFail)}
                className={`w-full py-2 rounded-xl text-xs font-bold transition-colors ${
                  forcePaymentFail ? 'bg-amber-600 text-white' : 'bg-slate-200 text-slate-700 hover:bg-slate-300'
                }`}
              &gt;
                {forcePaymentFail ? 'إيقاف المحاكاة (دفع ناجح)' : 'تفعيل فشل بوابات الدفع'}
              &lt;/button&gt;
            &lt;/div&gt;

            {/* Test 3: No Courier Available simulation */}
            &lt;div className={`p-4 rounded-2xl border transition-all ${
              forceNoCourier ? 'bg-purple-50 border-purple-300' : 'bg-slate-50 border-slate-200'
            }`}&gt;
              &lt;div className="flex items-center justify-between mb-2"&gt;
                &lt;span className="font-bold text-xs flex items-center gap-1.5 text-slate-800"&gt;
                  &lt;UserX className="w-4 h-4 text-purple-500" /&gt;
                  محاكاة عدم توفر مناديب
                &lt;/span&gt;
                &lt;span className={`text-[10px] font-bold px-2 py-0.5 rounded-full ${
                  forceNoCourier ? 'bg-purple-200 text-purple-800' : 'bg-slate-200 text-slate-600'
                }`}&gt;
                  {forceNoCourier ? 'مفعل' : 'معطل'}
                &lt;/span&gt;
              &lt;/div&gt;
              &lt;p className="text-[11px] text-slate-500 mb-3"&gt;
                يمنع التعيين التلقائي للمناديب للتحقق من إشعار إدارة العمليات وتصعيد الطلب لإسناده يدوياً.
              &lt;/p&gt;
              &lt;button
                onClick={() =&gt; setForceNoCourier(!forceNoCourier)}
                className={`w-full py-2 rounded-xl text-xs font-bold transition-colors ${
                  forceNoCourier ? 'bg-purple-600 text-white' : 'bg-slate-200 text-slate-700 hover:bg-slate-300'
                }`}
              &gt;
                {forceNoCourier ? 'إيقاف المحاكاة (توفر مناديب)' : 'تفعيل عجز المناديب'}
              &lt;/button&gt;
            &lt;/div&gt;

            {/* Test 4: Idempotency &amp; Duplicate Prevention Test */}
            &lt;div className="p-4 rounded-2xl border border-slate-200 bg-slate-50"&gt;
              &lt;div className="flex items-center justify-between mb-2"&gt;
                &lt;span className="font-bold text-xs flex items-center gap-1.5 text-slate-800"&gt;
                  &lt;CheckCircle2 className="w-4 h-4 text-emerald-600" /&gt;
                  فحص منع تكرار الطلب (Idempotency)
                &lt;/span&gt;
                &lt;span className="text-[10px] font-bold px-2 py-0.5 rounded-full bg-emerald-100 text-emerald-800"&gt;
                  نشط ومحمي
                &lt;/span&gt;
              &lt;/div&gt;
              &lt;p className="text-[11px] text-slate-500 mb-3"&gt;
                يتحقق من توليد مفاتيح عشوائية فريدة لكل معاملة لمنع خصم المبلغ مرتين أو تكرار إرسال الطلب للمطعم.
              &lt;/p&gt;
              &lt;button
                onClick={() =&gt; {
                  alert('فحص Idempotency Key:\nجميع الطلبات تسند بمفتاح فريد (e.g. idem_store_user_timestamp) لمنع التكرار المزدوج عند نقر الزر أكثر من مرة.');
                }}
                className="w-full py-2 rounded-xl text-xs font-bold bg-slate-200 hover:bg-slate-300 text-slate-800 transition-colors"
              &gt;
                اختبار التحقق من المفتاح
              &lt;/button&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* TAB: RESTAURANT APPLICATIONS REVIEW */}
      {activeTab === 'restaurant_applications' &amp;&amp; (
        &lt;ApplicationReviewSection type="restaurants" /&gt;
      )}

      {/* TAB: COURIER APPLICATIONS REVIEW */}
      {activeTab === 'courier_applications' &amp;&amp; (
        &lt;ApplicationReviewSection type="couriers" /&gt;
      )}
    &lt;/div&gt;
  );
};
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/admin/ApplicationReviewSection.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000115155&#65533;15267721203&#65533;021504&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import React, { useState } from 'react';
import {
  Store as StoreIcon,
  Bike,
  Clock,
  CheckCircle,
  XCircle,
  AlertOctagon,
  Eye,
  MapPin,
  Phone,
  User,
  FileText,
  Calendar,
  ExternalLink,
  ShieldAlert,
  Search,
  Car,
  Image as ImageIcon,
  X,
  Check,
} from 'lucide-react';
import { useApp } from '../../context/AppContext';
import { RestaurantApplication, CourierApplication, ApplicationStatus } from '../../types';
import RealInteractiveMap from '../common/RealInteractiveMap';

interface ApplicationReviewSectionProps {
  type: 'restaurants' | 'couriers';
}

export const ApplicationReviewSection: React.FC&lt;ApplicationReviewSectionProps&gt; = ({ type }) =&gt; {
  const {
    restaurantApplications,
    courierApplications,
    reviewRestaurantApplication,
    reviewCourierApplication,
  } = useApp();

  const [statusFilter, setStatusFilter] = useState&lt;string&gt;('all');
  const [searchQuery, setSearchQuery] = useState('');

  // Modals state
  const [selectedDocUrl, setSelectedDocUrl] = useState&lt;{ title: string; url: string } | null&gt;(null);
  const [selectedCoords, setSelectedCoords] = useState&lt;{ title: string; coords: { lat: number; lng: number } } | null&gt;(null);
  const [reviewActionTarget, setReviewActionTarget] = useState&lt;{
    appId: string;
    action: 'approve' | 'reject' | 'suspend';
    title: string;
  } | null&gt;(null);
  const [adminNotesInput, setAdminNotesInput] = useState('');
  const [isProcessing, setIsProcessing] = useState(false);

  const isRestaurants = type === 'restaurants';

  const rawApplications = isRestaurants ? restaurantApplications : courierApplications;

  const filteredApps = rawApplications.filter((app: any) =&gt; {
    const matchesStatus = statusFilter === 'all' || app.status === statusFilter;
    const nameMatch = isRestaurants
      ? (app.storeName || '').toLowerCase().includes(searchQuery.toLowerCase()) ||
        (app.ownerName || '').toLowerCase().includes(searchQuery.toLowerCase()) ||
        (app.ownerPhone || '').includes(searchQuery)
      : (app.fullName || '').toLowerCase().includes(searchQuery.toLowerCase()) ||
        (app.phone || '').includes(searchQuery) ||
        (app.vehiclePlate || '').toLowerCase().includes(searchQuery.toLowerCase());
    return matchesStatus &amp;&amp; nameMatch;
  });

  const pendingCount = rawApplications.filter((a) =&gt; a.status === 'pending').length;
  const approvedCount = rawApplications.filter((a) =&gt; a.status === 'approved').length;
  const rejectedCount = rawApplications.filter((a) =&gt; a.status === 'rejected').length;
  const suspendedCount = rawApplications.filter((a) =&gt; a.status === 'suspended').length;

  const handleExecuteReview = async () =&gt; {
    if (!reviewActionTarget) return;
    setIsProcessing(true);

    try {
      if (isRestaurants) {
        await reviewRestaurantApplication(
          reviewActionTarget.appId,
          reviewActionTarget.action,
          adminNotesInput.trim() || undefined
        );
      } else {
        await reviewCourierApplication(
          reviewActionTarget.appId,
          reviewActionTarget.action,
          adminNotesInput.trim() || undefined
        );
      }
      setReviewActionTarget(null);
      setAdminNotesInput('');
    } finally {
      setIsProcessing(false);
    }
  };

  const getStatusBadge = (status: ApplicationStatus) =&gt; {
    switch (status) {
      case 'pending':
        return (
          &lt;span className="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-amber-100 text-amber-800 border border-amber-300"&gt;
            &lt;Clock className="w-3.5 h-3.5 text-amber-600 animate-spin" /&gt;
            &lt;span&gt;بانتظار موافقة المدير&lt;/span&gt;
          &lt;/span&gt;
        );
      case 'approved':
        return (
          &lt;span className="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-emerald-100 text-emerald-800 border border-emerald-300"&gt;
            &lt;CheckCircle className="w-3.5 h-3.5 text-emerald-600" /&gt;
            &lt;span&gt;معتمد ونشط&lt;/span&gt;
          &lt;/span&gt;
        );
      case 'rejected':
        return (
          &lt;span className="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-rose-100 text-rose-800 border border-rose-300"&gt;
            &lt;XCircle className="w-3.5 h-3.5 text-rose-600" /&gt;
            &lt;span&gt;مرفوض&lt;/span&gt;
          &lt;/span&gt;
        );
      case 'suspended':
        return (
          &lt;span className="inline-flex items-center gap-1 px-2.5 py-1 rounded-full text-xs font-bold bg-orange-100 text-orange-800 border border-orange-300"&gt;
            &lt;AlertOctagon className="w-3.5 h-3.5 text-orange-600" /&gt;
            &lt;span&gt;معلق مؤقتاً&lt;/span&gt;
          &lt;/span&gt;
        );
      default:
        return null;
    }
  };

  return (
    &lt;div className="space-y-4"&gt;
      {/* Top Banner &amp; Quick Metrics */}
      &lt;div className="bg-white rounded-3xl border border-slate-200 p-5 shadow-xs flex flex-col md:flex-row items-start md:items-center justify-between gap-4"&gt;
        &lt;div className="flex items-center gap-3"&gt;
          &lt;div
            className={`w-12 h-12 rounded-2xl flex items-center justify-center text-white shadow-md ${
              isRestaurants
                ? 'bg-gradient-to-tr from-orange-600 to-amber-500'
                : 'bg-gradient-to-tr from-blue-900 to-indigo-700'
            }`}
          &gt;
            {isRestaurants ? &lt;StoreIcon className="w-6 h-6" /&gt; : &lt;Bike className="w-6 h-6" /&gt;}
          &lt;/div&gt;
          &lt;div&gt;
            &lt;h3 className="font-black text-slate-900 text-base"&gt;
              {isRestaurants ? 'طلبات انضمام المطاعم والشركاء' : 'طلبات انضمام الكباتن ومناديب التوصيل'}
            &lt;/h3&gt;
            &lt;p className="text-xs text-slate-500"&gt;
              {isRestaurants
                ? 'مراجعة وتدقيق المتاجر الجديدة، التحقق من المواقع واعتماد فتح الحسابات المالية'
                : 'فحص وثائق الكباتن، بيانات المركبة، وإصدار قرارات القبول والتعليق المؤقت'}
            &lt;/p&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Counter Pills */}
        &lt;div className="flex items-center gap-2 flex-wrap"&gt;
          &lt;div className="px-3 py-1.5 bg-amber-50 border border-amber-200 rounded-xl text-center"&gt;
            &lt;span className="text-[10px] text-amber-700 font-bold block"&gt;بانتظار القرار&lt;/span&gt;
            &lt;span className="text-base font-black text-amber-800"&gt;{pendingCount}&lt;/span&gt;
          &lt;/div&gt;
          &lt;div className="px-3 py-1.5 bg-emerald-50 border border-emerald-200 rounded-xl text-center"&gt;
            &lt;span className="text-[10px] text-emerald-700 font-bold block"&gt;معتمدة&lt;/span&gt;
            &lt;span className="text-base font-black text-emerald-800"&gt;{approvedCount}&lt;/span&gt;
          &lt;/div&gt;
          &lt;div className="px-3 py-1.5 bg-rose-50 border border-rose-200 rounded-xl text-center"&gt;
            &lt;span className="text-[10px] text-rose-700 font-bold block"&gt;مرفوضة&lt;/span&gt;
            &lt;span className="text-base font-black text-rose-800"&gt;{rejectedCount}&lt;/span&gt;
          &lt;/div&gt;
          &lt;div className="px-3 py-1.5 bg-orange-50 border border-orange-200 rounded-xl text-center"&gt;
            &lt;span className="text-[10px] text-orange-700 font-bold block"&gt;معلقة&lt;/span&gt;
            &lt;span className="text-base font-black text-orange-800"&gt;{suspendedCount}&lt;/span&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      {/* Search &amp; Status Filters */}
      &lt;div className="bg-white rounded-2xl border border-slate-200 p-3 shadow-2xs flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3"&gt;
        &lt;div className="relative flex-1"&gt;
          &lt;Search className="w-4 h-4 text-slate-400 absolute right-3 top-3" /&gt;
          &lt;input
            type="text"
            value={searchQuery}
            onChange={(e) =&gt; setSearchQuery(e.target.value)}
            placeholder={
              isRestaurants
                ? 'ابحث باسم المطعم، المالك، أو رقم الهاتف...'
                : 'ابحث باسم الكابتن، رقم الهاتف، أو لوحة المركبة...'
            }
            className="w-full pr-9 pl-3 py-2 text-xs border border-slate-200 rounded-xl focus:ring-2 focus:ring-orange-400 focus:outline-none"
          /&gt;
        &lt;/div&gt;

        &lt;div className="flex items-center gap-1.5 overflow-x-auto pb-1 sm:pb-0"&gt;
          {[
            { id: 'all', label: `الكل (${rawApplications.length})` },
            { id: 'pending', label: `بانتظار الموافقة (${pendingCount})` },
            { id: 'approved', label: `معتمدة (${approvedCount})` },
            { id: 'suspended', label: `معلقة (${suspendedCount})` },
            { id: 'rejected', label: `مرفوضة (${rejectedCount})` },
          ].map((tab) =&gt; (
            &lt;button
              key={tab.id}
              onClick={() =&gt; setStatusFilter(tab.id)}
              className={`px-3 py-1.5 rounded-xl text-xs font-bold transition whitespace-nowrap ${
                statusFilter === tab.id
                  ? 'bg-slate-900 text-white shadow-xs'
                  : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
              }`}
            &gt;
              {tab.label}
            &lt;/button&gt;
          ))}
        &lt;/div&gt;
      &lt;/div&gt;

      {/* Applications Cards Grid */}
      {filteredApps.length === 0 ? (
        &lt;div className="bg-white rounded-3xl border border-slate-200 p-12 text-center space-y-3 shadow-xs"&gt;
          &lt;div className="w-14 h-14 bg-slate-100 rounded-2xl flex items-center justify-center mx-auto text-slate-400"&gt;
            &lt;FileText className="w-7 h-7" /&gt;
          &lt;/div&gt;
          &lt;p className="text-sm font-bold text-slate-700"&gt;لا توجد طلبات مطابقة للمعايير المحددة&lt;/p&gt;
          &lt;p className="text-xs text-slate-400"&gt;
            {statusFilter !== 'all' ? 'جرب تغيير فلتر الحالة لعرض باقي الطلبات' : 'لم يتم تسجيل أي طلب بعد'}
          &lt;/p&gt;
        &lt;/div&gt;
      ) : (
        &lt;div className="grid grid-cols-1 md:grid-cols-2 gap-4"&gt;
          {filteredApps.map((item: any) =&gt; {
            if (isRestaurants) {
              const app = item as RestaurantApplication;
              return (
                &lt;div
                  key={app.id}
                  className="bg-white rounded-2xl border border-slate-200 p-4 shadow-xs hover:shadow-md transition space-y-3.5 flex flex-col justify-between"
                &gt;
                  &lt;div className="space-y-3"&gt;
                    {/* Top Row: Store Info &amp; Status */}
                    &lt;div className="flex items-start justify-between gap-3"&gt;
                      &lt;div className="flex items-center gap-3"&gt;
                        &lt;img
                          src={
                            app.logoUrl ||
                            'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=500&amp;auto=format&amp;fit=crop&amp;q=80'
                          }
                          alt={app.storeName}
                          className="w-12 h-12 rounded-xl object-cover border border-slate-200 shadow-xs"
                        /&gt;
                        &lt;div&gt;
                          &lt;h4 className="font-black text-slate-900 text-sm"&gt;{app.storeName}&lt;/h4&gt;
                          &lt;span className="text-[11px] text-orange-600 font-bold bg-orange-50 px-2 py-0.5 rounded-md inline-block mt-0.5"&gt;
                            {app.category}
                          &lt;/span&gt;
                        &lt;/div&gt;
                      &lt;/div&gt;
                      &lt;div&gt;{getStatusBadge(app.status)}&lt;/div&gt;
                    &lt;/div&gt;

                    {/* Metadata Details */}
                    &lt;div className="bg-slate-50 rounded-xl p-3 space-y-2 text-xs text-slate-700 border border-slate-100"&gt;
                      &lt;div className="flex items-center justify-between"&gt;
                        &lt;span className="text-slate-500 flex items-center gap-1"&gt;
                          &lt;User className="w-3.5 h-3.5 text-slate-400" /&gt;
                          &lt;span&gt;المالك / المسؤول:&lt;/span&gt;
                        &lt;/span&gt;
                        &lt;span className="font-bold text-slate-900"&gt;{app.ownerName}&lt;/span&gt;
                      &lt;/div&gt;

                      &lt;div className="flex items-center justify-between"&gt;
                        &lt;span className="text-slate-500 flex items-center gap-1"&gt;
                          &lt;Phone className="w-3.5 h-3.5 text-slate-400" /&gt;
                          &lt;span&gt;رقم الهاتف:&lt;/span&gt;
                        &lt;/span&gt;
                        &lt;a
                          href={`tel:${app.ownerPhone}`}
                          className="font-mono font-bold text-orange-600 hover:underline"
                        &gt;
                          {app.ownerPhone}
                        &lt;/a&gt;
                      &lt;/div&gt;

                      &lt;div className="flex items-start justify-between gap-2"&gt;
                        &lt;span className="text-slate-500 flex items-center gap-1 flex-shrink-0"&gt;
                          &lt;MapPin className="w-3.5 h-3.5 text-slate-400" /&gt;
                          &lt;span&gt;العنوان:&lt;/span&gt;
                        &lt;/span&gt;
                        &lt;span className="font-medium text-slate-800 text-left text-[11px] leading-tight"&gt;
                          {app.address}
                        &lt;/span&gt;
                      &lt;/div&gt;

                      &lt;div className="flex items-center justify-between pt-1 border-t border-slate-200/60 text-[11px]"&gt;
                        &lt;span className="text-slate-500 flex items-center gap-1"&gt;
                          &lt;Calendar className="w-3 h-3 text-slate-400" /&gt;
                          &lt;span&gt;تاريخ التقديم:&lt;/span&gt;
                        &lt;/span&gt;
                        &lt;span className="font-mono text-slate-600"&gt;
                          {new Date(app.createdAt).toLocaleDateString('ar-IQ', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit',
                          })}
                        &lt;/span&gt;
                      &lt;/div&gt;

                      {app.adminNotes &amp;&amp; (
                        &lt;div className="p-2 bg-amber-50 rounded-lg text-amber-900 text-[11px] font-medium border border-amber-200"&gt;
                          &lt;span className="font-bold"&gt;ملاحظة الإدارة: &lt;/span&gt;
                          {app.adminNotes}
                        &lt;/div&gt;
                      )}
                    &lt;/div&gt;

                    {/* Preview Buttons: Map Pin &amp; Documents */}
                    &lt;div className="flex items-center gap-2"&gt;
                      &lt;button
                        type="button"
                        onClick={() =&gt;
                          setSelectedCoords({
                            title: `موقع ${app.storeName} على الخريطة`,
                            coords: app.coordinates || { lat: 33.3152, lng: 44.3661 },
                          })
                        }
                        className="flex-1 py-1.5 px-2 bg-slate-100 hover:bg-slate-200 rounded-xl text-slate-700 text-[11px] font-bold flex items-center justify-center gap-1.5 transition"
                      &gt;
                        &lt;MapPin className="w-3.5 h-3.5 text-orange-500" /&gt;
                        &lt;span&gt;معاينة الموقع الخرائطي&lt;/span&gt;
                      &lt;/button&gt;

                      {Boolean(app.logoUrl || app.logo) &amp;&amp; (
                        &lt;button
                          type="button"
                          onClick={() =&gt;
                            setSelectedDocUrl({
                              title: `شعار / واجهة ${app.storeName}`,
                              url: app.logoUrl || app.logo || '',
                            })
                          }
                          className="py-1.5 px-3 bg-slate-100 hover:bg-slate-200 rounded-xl text-slate-700 text-[11px] font-bold flex items-center justify-center gap-1.5 transition"
                        &gt;
                          &lt;Eye className="w-3.5 h-3.5 text-blue-500" /&gt;
                          &lt;span&gt;الصورة&lt;/span&gt;
                        &lt;/button&gt;
                      )}
                    &lt;/div&gt;
                  &lt;/div&gt;

                  {/* Admin Actions Bar */}
                  &lt;div className="pt-3 border-t border-slate-100 flex items-center gap-2"&gt;
                    {app.status === 'pending' &amp;&amp; (
                      &lt;&gt;
                        &lt;button
                          type="button"
                          onClick={() =&gt;
                            setReviewActionTarget({
                              appId: app.id,
                              action: 'approve',
                              title: `الموافقة على انضمام مطعم «${app.storeName}» وتفعيل حسابه`,
                            })
                          }
                          className="flex-1 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow-xs transition flex items-center justify-center gap-1.5"
                        &gt;
                          &lt;Check className="w-3.5 h-3.5" /&gt;
                          &lt;span&gt;موافقة واعتماد&lt;/span&gt;
                        &lt;/button&gt;
                        &lt;button
                          type="button"
                          onClick={() =&gt;
                            setReviewActionTarget({
                              appId: app.id,
                              action: 'reject',
                              title: `رفض طلب انضمام مطعم «${app.storeName}»`,
                            })
                          }
                          className="py-2 px-3 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1"
                        &gt;
                          &lt;X className="w-3.5 h-3.5" /&gt;
                          &lt;span&gt;رفض&lt;/span&gt;
                        &lt;/button&gt;
                      &lt;/&gt;
                    )}

                    {app.status === 'approved' &amp;&amp; (
                      &lt;button
                        type="button"
                        onClick={() =&gt;
                          setReviewActionTarget({
                            appId: app.id,
                            action: 'suspend',
                            title: `تعليق مؤقت لحساب مطعم «${app.storeName}» وإيقاف استقبال الطلبات`,
                          })
                        }
                        className="flex-1 py-2 bg-orange-50 hover:bg-orange-100 text-orange-800 border border-orange-300 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5"
                      &gt;
                        &lt;AlertOctagon className="w-3.5 h-3.5 text-orange-600" /&gt;
                        &lt;span&gt;تعليق مؤقت للحساب&lt;/span&gt;
                      &lt;/button&gt;
                    )}

                    {app.status === 'suspended' &amp;&amp; (
                      &lt;button
                        type="button"
                        onClick={() =&gt;
                          setReviewActionTarget({
                            appId: app.id,
                            action: 'approve',
                            title: `إعادة تنشيط واعتماد مطعم «${app.storeName}»`,
                          })
                        }
                        className="flex-1 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5"
                      &gt;
                        &lt;CheckCircle className="w-3.5 h-3.5" /&gt;
                        &lt;span&gt;إلغاء التعليق وإعادة التنشيط&lt;/span&gt;
                      &lt;/button&gt;
                    )}

                    {app.status === 'rejected' &amp;&amp; (
                      &lt;button
                        type="button"
                        onClick={() =&gt;
                          setReviewActionTarget({
                            appId: app.id,
                            action: 'approve',
                            title: `إعادة النظر والموافقة على «${app.storeName}»`,
                          })
                        }
                        className="flex-1 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-xl text-xs font-bold transition"
                      &gt;
                        إعادة النظر والموافقة
                      &lt;/button&gt;
                    )}
                  &lt;/div&gt;
                &lt;/div&gt;
              );
            } else {
              // Courier Application Card
              const app = item as CourierApplication;
              return (
                &lt;div
                  key={app.id}
                  className="bg-white rounded-2xl border border-slate-200 p-4 shadow-xs hover:shadow-md transition space-y-3.5 flex flex-col justify-between"
                &gt;
                  &lt;div className="space-y-3"&gt;
                    {/* Top Row: Courier Info &amp; Status */}
                    &lt;div className="flex items-start justify-between gap-3"&gt;
                      &lt;div className="flex items-center gap-3"&gt;
                        &lt;img
                          src={
                            app.documents?.profilePhotoUrl ||
                            'https://images.unsplash.com/photo-1534528741775-53994a69daeb?w=150&amp;auto=format&amp;fit=crop&amp;q=80'
                          }
                          alt={app.fullName}
                          className="w-12 h-12 rounded-xl object-cover border border-slate-200 shadow-xs"
                        /&gt;
                        &lt;div&gt;
                          &lt;h4 className="font-black text-slate-900 text-sm"&gt;{app.fullName}&lt;/h4&gt;
                          &lt;div className="flex items-center gap-1.5 text-[11px] text-blue-700 font-bold bg-blue-50 px-2 py-0.5 rounded-md mt-0.5"&gt;
                            &lt;Bike className="w-3 h-3" /&gt;
                            &lt;span&gt;{app.vehicleType}&lt;/span&gt;
                          &lt;/div&gt;
                        &lt;/div&gt;
                      &lt;/div&gt;
                      &lt;div&gt;{getStatusBadge(app.status)}&lt;/div&gt;
                    &lt;/div&gt;

                    {/* Metadata Details */}
                    &lt;div className="bg-slate-50 rounded-xl p-3 space-y-2 text-xs text-slate-700 border border-slate-100"&gt;
                      &lt;div className="flex items-center justify-between"&gt;
                        &lt;span className="text-slate-500 flex items-center gap-1"&gt;
                          &lt;Phone className="w-3.5 h-3.5 text-slate-400" /&gt;
                          &lt;span&gt;رقم الهاتف:&lt;/span&gt;
                        &lt;/span&gt;
                        &lt;a
                          href={`tel:${app.phone}`}
                          className="font-mono font-bold text-blue-700 hover:underline"
                        &gt;
                          {app.phone}
                        &lt;/a&gt;
                      &lt;/div&gt;

                      &lt;div className="flex items-center justify-between"&gt;
                        &lt;span className="text-slate-500 flex items-center gap-1"&gt;
                          &lt;Car className="w-3.5 h-3.5 text-slate-400" /&gt;
                          &lt;span&gt;رقم اللوحة والموديل:&lt;/span&gt;
                        &lt;/span&gt;
                        &lt;span className="font-mono font-bold text-slate-900"&gt;
                          {app.vehiclePlate} {app.vehicleModel ? `(${app.vehicleModel})` : ''}
                        &lt;/span&gt;
                      &lt;/div&gt;

                      &lt;div className="flex items-start justify-between gap-2"&gt;
                        &lt;span className="text-slate-500 flex items-center gap-1 flex-shrink-0"&gt;
                          &lt;MapPin className="w-3.5 h-3.5 text-slate-400" /&gt;
                          &lt;span&gt;منطقة التواجد:&lt;/span&gt;
                        &lt;/span&gt;
                        &lt;span className="font-medium text-slate-800 text-left text-[11px] leading-tight"&gt;
                          {app.address}
                        &lt;/span&gt;
                      &lt;/div&gt;

                      &lt;div className="flex items-center justify-between pt-1 border-t border-slate-200/60 text-[11px]"&gt;
                        &lt;span className="text-slate-500 flex items-center gap-1"&gt;
                          &lt;Calendar className="w-3 h-3 text-slate-400" /&gt;
                          &lt;span&gt;تاريخ التقديم:&lt;/span&gt;
                        &lt;/span&gt;
                        &lt;span className="font-mono text-slate-600"&gt;
                          {new Date(app.createdAt).toLocaleDateString('ar-IQ', {
                            year: 'numeric',
                            month: 'short',
                            day: 'numeric',
                            hour: '2-digit',
                            minute: '2-digit',
                          })}
                        &lt;/span&gt;
                      &lt;/div&gt;

                      {app.adminNotes &amp;&amp; (
                        &lt;div className="p-2 bg-amber-50 rounded-lg text-amber-900 text-[11px] font-medium border border-amber-200"&gt;
                          &lt;span className="font-bold"&gt;ملاحظة الإدارة: &lt;/span&gt;
                          {app.adminNotes}
                        &lt;/div&gt;
                      )}
                    &lt;/div&gt;

                    {/* Uploaded Documents Gallery */}
                    &lt;div className="space-y-1"&gt;
                      &lt;span className="text-[11px] font-bold text-slate-700 block"&gt;
                        المستندات المرفقة:
                      &lt;/span&gt;
                      &lt;div className="grid grid-cols-3 gap-1.5"&gt;
                        &lt;button
                          type="button"
                          onClick={() =&gt; {
                            if (app.documents?.driverLicenseUrl) {
                              setSelectedDocUrl({
                                title: `إجازة سوق الكابتن ${app.fullName}`,
                                url: app.documents.driverLicenseUrl,
                              });
                            }
                          }}
                          disabled={!app.documents?.driverLicenseUrl}
                          className={`py-1 px-2 rounded-lg text-[10px] font-bold border transition flex items-center justify-center gap-1 ${
                            app.documents?.driverLicenseUrl
                              ? 'bg-blue-50 text-blue-800 border-blue-200 hover:bg-blue-100'
                              : 'bg-slate-100 text-slate-400 border-slate-200 cursor-not-allowed'
                          }`}
                        &gt;
                          &lt;FileText className="w-3 h-3" /&gt;
                          &lt;span&gt;إجازة السوق&lt;/span&gt;
                        &lt;/button&gt;

                        &lt;button
                          type="button"
                          onClick={() =&gt; {
                            if (app.documents?.nationalIdUrl) {
                              setSelectedDocUrl({
                                title: `البطاقة الوطنية للكابتن ${app.fullName}`,
                                url: app.documents.nationalIdUrl,
                              });
                            }
                          }}
                          disabled={!app.documents?.nationalIdUrl}
                          className={`py-1 px-2 rounded-lg text-[10px] font-bold border transition flex items-center justify-center gap-1 ${
                            app.documents?.nationalIdUrl
                              ? 'bg-blue-50 text-blue-800 border-blue-200 hover:bg-blue-100'
                              : 'bg-slate-100 text-slate-400 border-slate-200 cursor-not-allowed'
                          }`}
                        &gt;
                          &lt;FileText className="w-3 h-3" /&gt;
                          &lt;span&gt;الهوية الوطنية&lt;/span&gt;
                        &lt;/button&gt;

                        &lt;button
                          type="button"
                          onClick={() =&gt; {
                            if (app.documents?.vehicleRegistrationUrl) {
                              setSelectedDocUrl({
                                title: `سنوية مركبة الكابتن ${app.fullName}`,
                                url: app.documents.vehicleRegistrationUrl,
                              });
                            }
                          }}
                          disabled={!app.documents?.vehicleRegistrationUrl}
                          className={`py-1 px-2 rounded-lg text-[10px] font-bold border transition flex items-center justify-center gap-1 ${
                            app.documents?.vehicleRegistrationUrl
                              ? 'bg-blue-50 text-blue-800 border-blue-200 hover:bg-blue-100'
                              : 'bg-slate-100 text-slate-400 border-slate-200 cursor-not-allowed'
                          }`}
                        &gt;
                          &lt;FileText className="w-3 h-3" /&gt;
                          &lt;span&gt;السنوية&lt;/span&gt;
                        &lt;/button&gt;
                      &lt;/div&gt;
                    &lt;/div&gt;
                  &lt;/div&gt;

                  {/* Actions Bar */}
                  &lt;div className="pt-3 border-t border-slate-100 flex items-center gap-2"&gt;
                    {app.status === 'pending' &amp;&amp; (
                      &lt;&gt;
                        &lt;button
                          type="button"
                          onClick={() =&gt;
                            setReviewActionTarget({
                              appId: app.id,
                              action: 'approve',
                              title: `الموافقة على انضمام الكابتن «${app.fullName}» واعتماد حسابه`,
                            })
                          }
                          className="flex-1 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold shadow-xs transition flex items-center justify-center gap-1.5"
                        &gt;
                          &lt;Check className="w-3.5 h-3.5" /&gt;
                          &lt;span&gt;موافقة واعتماد&lt;/span&gt;
                        &lt;/button&gt;
                        &lt;button
                          type="button"
                          onClick={() =&gt;
                            setReviewActionTarget({
                              appId: app.id,
                              action: 'reject',
                              title: `رفض طلب انضمام الكابتن «${app.fullName}»`,
                            })
                          }
                          className="py-2 px-3 bg-rose-50 hover:bg-rose-100 text-rose-700 border border-rose-200 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1"
                        &gt;
                          &lt;X className="w-3.5 h-3.5" /&gt;
                          &lt;span&gt;رفض&lt;/span&gt;
                        &lt;/button&gt;
                      &lt;/&gt;
                    )}

                    {app.status === 'approved' &amp;&amp; (
                      &lt;button
                        type="button"
                        onClick={() =&gt;
                          setReviewActionTarget({
                            appId: app.id,
                            action: 'suspend',
                            title: `تعليق مؤقت لحساب الكابتن «${app.fullName}» وإيقاف استقبال الطلبات`,
                          })
                        }
                        className="flex-1 py-2 bg-orange-50 hover:bg-orange-100 text-orange-800 border border-orange-300 rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5"
                      &gt;
                        &lt;AlertOctagon className="w-3.5 h-3.5 text-orange-600" /&gt;
                        &lt;span&gt;تعليق مؤقت للحساب&lt;/span&gt;
                      &lt;/button&gt;
                    )}

                    {app.status === 'suspended' &amp;&amp; (
                      &lt;button
                        type="button"
                        onClick={() =&gt;
                          setReviewActionTarget({
                            appId: app.id,
                            action: 'approve',
                            title: `إلغاء تعليق وإعادة تنشيط حساب الكابتن «${app.fullName}»`,
                          })
                        }
                        className="flex-1 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition flex items-center justify-center gap-1.5"
                      &gt;
                        &lt;CheckCircle className="w-3.5 h-3.5" /&gt;
                        &lt;span&gt;إلغاء التعليق وتفعيل الحساب&lt;/span&gt;
                      &lt;/button&gt;
                    )}

                    {app.status === 'rejected' &amp;&amp; (
                      &lt;button
                        type="button"
                        onClick={() =&gt;
                          setReviewActionTarget({
                            appId: app.id,
                            action: 'approve',
                            title: `إعادة النظر واعتماد الكابتن «${app.fullName}»`,
                          })
                        }
                        className="flex-1 py-2 bg-slate-100 hover:bg-slate-200 text-slate-800 rounded-xl text-xs font-bold transition"
                      &gt;
                        إعادة النظر واعتماد الكابتن
                      &lt;/button&gt;
                    )}
                  &lt;/div&gt;
                &lt;/div&gt;
              );
            }
          })}
        &lt;/div&gt;
      )}

      {/* Confirmation &amp; Decision Modal */}
      {reviewActionTarget &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 overflow-y-auto bg-slate-900/60 backdrop-blur-sm flex items-center justify-center p-4"&gt;
          &lt;div className="bg-white rounded-3xl max-w-md w-full p-5 space-y-4 shadow-2xl border border-slate-100"&gt;
            &lt;div className="flex items-center justify-between"&gt;
              &lt;h4 className="font-black text-slate-900 text-base flex items-center gap-2"&gt;
                &lt;ShieldAlert className="w-5 h-5 text-orange-500" /&gt;
                &lt;span&gt;تأكيد الإجراء الإداري&lt;/span&gt;
              &lt;/h4&gt;
              &lt;button
                onClick={() =&gt; setReviewActionTarget(null)}
                className="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 flex items-center justify-center text-slate-600"
              &gt;
                &lt;X className="w-4 h-4" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            &lt;p className="text-xs text-slate-600 leading-relaxed font-medium"&gt;
              {reviewActionTarget.title}
            &lt;/p&gt;

            &lt;div&gt;
              &lt;label className="block text-xs font-bold text-slate-700 mb-1"&gt;
                ملاحظات أو أسباب الإدارة (اختياري / يظهر في السجل):
              &lt;/label&gt;
              &lt;textarea
                rows={2}
                value={adminNotesInput}
                onChange={(e) =&gt; setAdminNotesInput(e.target.value)}
                placeholder="مثال: تم تدقيق السجلات والتأكد من مطابقة الوثائق الرسمية..."
                className="w-full p-2.5 text-xs border border-slate-200 rounded-xl focus:ring-2 focus:ring-orange-400 focus:outline-none"
              /&gt;
            &lt;/div&gt;

            &lt;div className="flex items-center justify-end gap-2 pt-2"&gt;
              &lt;button
                type="button"
                onClick={() =&gt; setReviewActionTarget(null)}
                className="px-4 py-2 text-xs font-bold text-slate-600 hover:bg-slate-100 rounded-xl"
              &gt;
                تراجع
              &lt;/button&gt;
              &lt;button
                type="button"
                disabled={isProcessing}
                onClick={handleExecuteReview}
                className={`px-5 py-2 text-xs font-bold text-white rounded-xl shadow-md transition flex items-center gap-1.5 ${
                  reviewActionTarget.action === 'approve'
                    ? 'bg-emerald-600 hover:bg-emerald-700'
                    : reviewActionTarget.action === 'reject'
                    ? 'bg-rose-600 hover:bg-rose-700'
                    : 'bg-orange-600 hover:bg-orange-700'
                }`}
              &gt;
                {isProcessing ? 'جاري التنفيذ...' : 'تأكيد وحفظ القرار'}
              &lt;/button&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* Document / Photo Viewer Modal */}
      {selectedDocUrl &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 overflow-y-auto bg-slate-900/80 backdrop-blur-md flex items-center justify-center p-4"&gt;
          &lt;div className="bg-white rounded-3xl max-w-lg w-full overflow-hidden shadow-2xl"&gt;
            &lt;div className="p-4 bg-slate-900 text-white flex items-center justify-between"&gt;
              &lt;h4 className="text-xs font-bold truncate"&gt;{selectedDocUrl.title}&lt;/h4&gt;
              &lt;button
                onClick={() =&gt; setSelectedDocUrl(null)}
                className="w-7 h-7 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center text-white"
              &gt;
                &lt;X className="w-4 h-4" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;
            &lt;div className="p-4 bg-slate-100 flex items-center justify-center max-h-[70vh] overflow-auto"&gt;
              &lt;img
                src={selectedDocUrl.url}
                alt={selectedDocUrl.title}
                className="max-h-[65vh] w-auto rounded-xl object-contain shadow-md"
              /&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* Map Coordinates Modal */}
      {selectedCoords &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 overflow-y-auto bg-slate-900/80 backdrop-blur-md flex items-center justify-center p-4"&gt;
          &lt;div className="bg-white rounded-3xl max-w-xl w-full overflow-hidden shadow-2xl flex flex-col"&gt;
            &lt;div className="p-4 bg-slate-900 text-white flex items-center justify-between"&gt;
              &lt;h4 className="text-xs font-bold flex items-center gap-1.5"&gt;
                &lt;MapPin className="w-4 h-4 text-orange-400" /&gt;
                &lt;span&gt;{selectedCoords.title}&lt;/span&gt;
              &lt;/h4&gt;
              &lt;button
                onClick={() =&gt; setSelectedCoords(null)}
                className="w-7 h-7 rounded-full bg-white/20 hover:bg-white/30 flex items-center justify-center text-white"
              &gt;
                &lt;X className="w-4 h-4" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;
            &lt;div className="h-72 w-full"&gt;
              &lt;RealInteractiveMap
                destinationCoords={selectedCoords.coords}
                isInteractivePicker={false}
              /&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}
    &lt;/div&gt;
  );
};
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/admin/PricingAndCommissionsManager.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000127677&#65533;15267721203&#65533;022303&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import React, { useState } from 'react';
import { useApp } from '../../context/AppContext';
import { AreaFeeConfig, StoreCommissionOverride } from '../../types';
import {
  DollarSign,
  Percent,
  Bike,
  Store,
  MapPin,
  Save,
  Plus,
  Trash2,
  Edit2,
  CheckCircle2,
  AlertCircle,
  Calculator,
  History,
  ShieldCheck,
  Gift,
  Coins,
  ArrowRight,
  TrendingUp,
  Navigation,
  Route,
  Gauge,
  Zap,
} from 'lucide-react';
import { computeDistanceDeliveryFee } from '../../utils/distancePricing';

export const PricingAndCommissionsManager: React.FC = () =&gt; {
  const {
    pricingSettings,
    updatePricingSettings,
    stores,
    currentUser,
    firebaseUser,
    auditLogs,
  } = useApp();

  const isAdmin =
    currentUser.role === 'admin' ||
    (firebaseUser &amp;&amp; (firebaseUser.email === 'msr33777@gmail.com' || (firebaseUser as any).isAdmin));

  // Local editing state for Distance-Based Delivery Pricing
  const [distanceBaseFee, setDistanceBaseFee] = useState&lt;number&gt;(
    pricingSettings.distanceBaseFee ?? 1500
  );
  const [distanceFeePerKm, setDistanceFeePerKm] = useState&lt;number&gt;(
    pricingSettings.distanceFeePerKm ?? 250
  );
  const [distanceMaxFee, setDistanceMaxFee] = useState&lt;number&gt;(
    pricingSettings.distanceMaxFee ?? 5000
  );
  const [isDistancePricingEnabled, setIsDistancePricingEnabled] = useState&lt;boolean&gt;(
    pricingSettings.isDistancePricingEnabled !== false
  );

  // Local editing state for Global Settings
  const [defaultDeliveryFee, setDefaultDeliveryFee] = useState(pricingSettings.defaultDeliveryFee);
  const [defaultCourierBasePayout, setDefaultCourierBasePayout] = useState(pricingSettings.defaultCourierBasePayout);
  const [defaultCourierBonus, setDefaultCourierBonus] = useState(pricingSettings.defaultCourierBonus);
  const [isCourierBonusActive, setIsCourierBonusActive] = useState&lt;boolean&gt;(pricingSettings.isCourierBonusActive !== false);
  const [defaultPlatformCommissionPercent, setDefaultPlatformCommissionPercent] = useState(
    pricingSettings.defaultPlatformCommissionPercent
  );

  // Local editing state for Area Fees
  const [areaFees, setAreaFees] = useState&lt;AreaFeeConfig[]&gt;(pricingSettings.areaDeliveryFees || []);
  const [newAreaName, setNewAreaName] = useState('');
  const [newAreaDeliveryFee, setNewAreaDeliveryFee] = useState(3000);
  const [newAreaCourierPayout, setNewAreaCourierPayout] = useState(2500);

  // Local editing state for Store Overrides
  const [storeOverrides, setStoreOverrides] = useState&lt;StoreCommissionOverride[]&gt;(
    pricingSettings.storeCommissionOverrides || []
  );

  // Status message
  const [isSaving, setIsSaving] = useState(false);
  const [saveSuccessMessage, setSaveSuccessMessage] = useState&lt;string | null&gt;(null);
  const [saveErrorMessage, setSaveErrorMessage] = useState&lt;string | null&gt;(null);

  // Interactive Live Calculator Simulation state
  const [calcSubtotal, setCalcSubtotal] = useState(25000);
  const [calcSelectedStoreId, setCalcSelectedStoreId] = useState(stores[0]?.id || 'store_1');
  const [calcSelectedArea, setCalcSelectedArea] = useState(areaFees[0]?.name || 'بغداد - المنصور');
  const [calcDistanceKm, setCalcDistanceKm] = useState&lt;number&gt;(5.0);

  // Handle saving global settings
  const handleSaveGlobalSettings = async (e: React.FormEvent) =&gt; {
    e.preventDefault();
    if (!isAdmin) {
      setSaveErrorMessage('فقط المدير المصرح له يملك صلاحية حفظ وتعديل الإعدادات المالية.');
      return;
    }

    // Validation for Distance Pricing
    if (distanceBaseFee &lt; 0 || distanceFeePerKm &lt; 0 || distanceMaxFee &lt;= 0) {
      setSaveErrorMessage('قيم نظام أجور التوصيل حسب المسافة يجب أن تكون أرقاماً موجبة.');
      return;
    }
    if (distanceMaxFee &lt; distanceBaseFee) {
      setSaveErrorMessage('الحد الأعلى لأجرة التوصيل (الحد الأقصى) يجب أن يكون أكبر من أو يساوي أجرة البداية.');
      return;
    }

    // Validation against negative values &amp; realistic ranges
    if (defaultPlatformCommissionPercent &lt; 0 || defaultPlatformCommissionPercent &gt; 50) {
      setSaveErrorMessage('نسبة عمولة المنصة يجب أن تكون بين 0% و 50%.');
      return;
    }

    if (defaultDeliveryFee &lt; 0 || defaultCourierBasePayout &lt; 0 || defaultCourierBonus &lt; 0) {
      setSaveErrorMessage('لا يمكن إدخال قيم سالبة لأجور التوصيل أو مستحقات المندوب.');
      return;
    }

    const hasNegativeArea = areaFees.some((a) =&gt; a.deliveryFee &lt; 0 || a.courierPayout &lt; 0);
    if (hasNegativeArea) {
      setSaveErrorMessage('يرجى التحقق من أجور المناطق، لا يمكن أن تكون سالبة.');
      return;
    }

    const hasNegativeOverride = storeOverrides.some((s) =&gt; s.commissionPercent &lt; 0 || s.commissionPercent &gt; 50);
    if (hasNegativeOverride) {
      setSaveErrorMessage('عمولات المتاجر المخصصة يجب أن تكون بين 0% و 50%.');
      return;
    }

    setIsSaving(true);
    setSaveSuccessMessage(null);
    setSaveErrorMessage(null);

    const res = await updatePricingSettings({
      distanceBaseFee: Number(distanceBaseFee) || 1500,
      distanceFeePerKm: Number(distanceFeePerKm) || 250,
      distanceMaxFee: Number(distanceMaxFee) || 5000,
      isDistancePricingEnabled,
      defaultDeliveryFee: Number(defaultDeliveryFee),
      defaultCourierBasePayout: Number(defaultCourierBasePayout),
      defaultCourierBonus: Number(defaultCourierBonus),
      isCourierBonusActive,
      defaultPlatformCommissionPercent: Number(defaultPlatformCommissionPercent),
      areaDeliveryFees: areaFees,
      storeCommissionOverrides: storeOverrides,
    });

    setIsSaving(false);

    if (res.success) {
      setSaveSuccessMessage('تم حفظ وتطبيق السياسة المالية في قاعدة بيانات Firebase بنجاح!');
      setTimeout(() =&gt; setSaveSuccessMessage(null), 4000);
    } else {
      setSaveErrorMessage(res.error || 'حدث خطأ أثناء حفظ الإعدادات.');
    }
  };

  // Add new area fee rule
  const handleAddArea = () =&gt; {
    if (!newAreaName.trim()) return;
    const newId = 'area_' + Date.now();
    const updatedAreas = [
      ...areaFees,
      {
        id: newId,
        name: newAreaName.trim(),
        deliveryFee: Number(newAreaDeliveryFee) || 3000,
        courierPayout: Number(newAreaCourierPayout) || 2500,
        isActive: true,
      },
    ];
    setAreaFees(updatedAreas);
    setNewAreaName('');
    setNewAreaDeliveryFee(3000);
    setNewAreaCourierPayout(2500);
  };

  // Toggle area active status
  const handleToggleAreaActive = (id: string) =&gt; {
    setAreaFees(
      areaFees.map((a) =&gt; (a.id === id ? { ...a, isActive: a.isActive === false ? true : false } : a))
    );
  };

  // Remove area fee rule
  const handleRemoveArea = (id: string) =&gt; {
    setAreaFees(areaFees.filter((a) =&gt; a.id !== id));
  };

  // Update specific area in list
  const handleUpdateArea = (id: string, field: 'deliveryFee' | 'courierPayout', val: number) =&gt; {
    setAreaFees(
      areaFees.map((a) =&gt; (a.id === id ? { ...a, [field]: Number(val) || 0 } : a))
    );
  };

  // Update store override commission
  const handleUpdateStoreOverride = (storeId: string, storeName: string, percent: number) =&gt; {
    const existing = storeOverrides.find((s) =&gt; s.storeId === storeId);
    if (existing) {
      setStoreOverrides(
        storeOverrides.map((s) =&gt; (s.storeId === storeId ? { ...s, commissionPercent: Number(percent) } : s))
      );
    } else {
      setStoreOverrides([
        ...storeOverrides,
        { storeId, storeName, commissionPercent: Number(percent) },
      ]);
    }
  };

  // Live calculation preview calculation
  const selectedAreaObj = areaFees.find((a) =&gt; a.name === calcSelectedArea);
  const distanceCalculatedFee = computeDistanceDeliveryFee(calcDistanceKm, {
    distanceBaseFee,
    distanceFeePerKm,
    distanceMaxFee,
  });
  const activeDeliveryFee = isDistancePricingEnabled
    ? distanceCalculatedFee
    : (selectedAreaObj ? selectedAreaObj.deliveryFee : defaultDeliveryFee);
  const activeCourierBase = selectedAreaObj ? selectedAreaObj.courierPayout : defaultCourierBasePayout;
  const activeCourierBonus = isCourierBonusActive ? defaultCourierBonus : 0;
  const activeCourierTotal = activeCourierBase + activeCourierBonus;

  const activeStoreOverride = storeOverrides.find((s) =&gt; s.storeId === calcSelectedStoreId);
  const activeCommissionPercent = activeStoreOverride
    ? activeStoreOverride.commissionPercent
    : defaultPlatformCommissionPercent;
  const activeCommissionAmount = Math.round((calcSubtotal * activeCommissionPercent) / 100);
  const activeStoreNetPayout = Math.max(0, calcSubtotal - activeCommissionAmount);
  const activeServiceFee = 1000;
  const activeTotalCustomerPays = calcSubtotal + activeDeliveryFee + activeServiceFee;

  // Filter audit logs for pricing
  const pricingLogs = auditLogs.filter(
    (l) =&gt; l.action === 'PRICING_SETTINGS_UPDATED' || l.entityType === 'system'
  );

  return (
    &lt;div className="space-y-6 text-slate-800"&gt;
      {/* Header Banner */}
      &lt;div className="bg-gradient-to-r from-[#172554] via-slate-900 to-[#F47721] text-white p-6 rounded-3xl shadow-xl flex flex-col md:flex-row items-start md:items-center justify-between gap-4"&gt;
        &lt;div className="space-y-1"&gt;
          &lt;div className="flex items-center gap-2"&gt;
            &lt;span className="bg-orange-500 text-white text-[10px] font-black px-2.5 py-0.5 rounded-full"&gt;
              إدارة الإيرادات والسياسات
            &lt;/span&gt;
            &lt;span className="text-xs text-orange-200"&gt;مربوطة سحابياً بـ Firebase Firestore&lt;/span&gt;
          &lt;/div&gt;
          &lt;h2 className="text-xl font-black"&gt;إدارة أجور التوصيل وعمولات المتاجر والمناديب&lt;/h2&gt;
          &lt;p className="text-xs text-slate-300"&gt;
            تحديد أجور المسافة، أجور المناطق، مكافآت السائقين، ونسب عمولة المطاعم مع احتساب الصافي تلقائياً
          &lt;/p&gt;
        &lt;/div&gt;

        &lt;div className="flex items-center gap-2"&gt;
          &lt;div className="bg-white/10 backdrop-blur-md px-3 py-2 rounded-2xl border border-white/20 text-xs"&gt;
            &lt;span className="text-slate-300 block text-[10px]"&gt;آخر تعديل محفوظ&lt;/span&gt;
            &lt;span className="font-bold text-orange-300"&gt;
              {pricingSettings.updatedAt} • {pricingSettings.updatedBy}
            &lt;/span&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      {/* Security alert if not admin */}
      {!isAdmin &amp;&amp; (
        &lt;div className="p-4 bg-amber-50 border border-amber-300 text-amber-900 rounded-2xl flex items-center gap-3 text-xs font-bold"&gt;
          &lt;AlertCircle className="w-5 h-5 text-amber-600 shrink-0" /&gt;
          &lt;span&gt;
            تنبيه: أنت تتصفح هذا القسم للعرض فقط. لا يمكن حفظ التعديلات إلا من خلال حساب المدير المعتمد في قواعد الأمان.
          &lt;/span&gt;
        &lt;/div&gt;
      )}

      {/* Feedback Messages */}
      {saveSuccessMessage &amp;&amp; (
        &lt;div className="p-4 bg-emerald-50 border border-emerald-300 text-emerald-900 rounded-2xl flex items-center gap-2 text-xs font-bold animate-in fade-in"&gt;
          &lt;CheckCircle2 className="w-5 h-5 text-emerald-600 shrink-0" /&gt;
          &lt;span&gt;{saveSuccessMessage}&lt;/span&gt;
        &lt;/div&gt;
      )}

      {saveErrorMessage &amp;&amp; (
        &lt;div className="p-4 bg-rose-50 border border-rose-300 text-rose-900 rounded-2xl flex items-center gap-2 text-xs font-bold animate-in fade-in"&gt;
          &lt;AlertCircle className="w-5 h-5 text-rose-600 shrink-0" /&gt;
          &lt;span&gt;{saveErrorMessage}&lt;/span&gt;
        &lt;/div&gt;
      )}

      {/* Main Settings Form */}
      &lt;form onSubmit={handleSaveGlobalSettings} className="space-y-6"&gt;
        {/* Section 1: Distance-Based Delivery Pricing System */}
        &lt;div className="bg-white rounded-3xl border-2 border-orange-200 p-5 shadow-sm space-y-4"&gt;
          &lt;div className="flex flex-col sm:flex-row items-start sm:items-center justify-between pb-3 border-b border-slate-100 gap-3"&gt;
            &lt;div className="flex items-center gap-2.5"&gt;
              &lt;div className="w-9 h-9 rounded-2xl bg-orange-100 text-[#F47721] flex items-center justify-center shrink-0"&gt;
                &lt;Route className="w-5 h-5" /&gt;
              &lt;/div&gt;
              &lt;div&gt;
                &lt;div className="flex items-center gap-2 flex-wrap"&gt;
                  &lt;h3 className="font-black text-sm text-[#172554]"&gt;
                    1. نظام أجور التوصيل التلقائي حسب المسافة (Distance-Based Delivery)
                  &lt;/h3&gt;
                  &lt;span className="bg-emerald-100 text-emerald-800 text-[10px] font-black px-2 py-0.5 rounded-full"&gt;
                    حساب بمسارات الطرق الفعلية
                  &lt;/span&gt;
                &lt;/div&gt;
                &lt;p className="text-[11px] text-slate-500"&gt;
                  المعادلة التلقائية: أجرة التوصيل = أجرة البداية + (المسافة بالكيلومتر × أجرة الكيلومتر) بحيث لا تتجاوز الحد الأعلى.
                &lt;/p&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;div className="flex items-center gap-2"&gt;
              &lt;button
                type="button"
                onClick={() =&gt; setIsDistancePricingEnabled(!isDistancePricingEnabled)}
                className={`text-xs font-bold px-3 py-1.5 rounded-xl transition-all flex items-center gap-1.5 cursor-pointer ${
                  isDistancePricingEnabled
                    ? 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-sm'
                    : 'bg-slate-200 text-slate-600'
                }`}
              &gt;
                &lt;Zap className="w-3.5 h-3.5" /&gt;
                &lt;span&gt;{isDistancePricingEnabled ? 'النظام مفعل (افتراضي)' : 'النظام معطل (اعتماد المناطق)'}&lt;/span&gt;
              &lt;/button&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          {/* 3 Main Distance Controls */}
          &lt;div className="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs"&gt;
            {/* 1. Base Fee (أجرة البداية) */}
            &lt;div className="space-y-1.5 bg-orange-50/60 p-4 rounded-2xl border border-orange-200"&gt;
              &lt;label className="font-bold text-slate-800 flex items-center justify-between"&gt;
                &lt;span&gt;1. أجرة البداية (فتح العداد)&lt;/span&gt;
                &lt;span className="text-[10px] text-orange-600 font-black"&gt;Base Fee&lt;/span&gt;
              &lt;/label&gt;
              &lt;div className="relative"&gt;
                &lt;input
                  type="number"
                  step="250"
                  min="0"
                  required
                  value={distanceBaseFee}
                  onChange={(e) =&gt; setDistanceBaseFee(Number(e.target.value))}
                  className="w-full p-2.5 pl-12 rounded-xl border border-orange-300 bg-white font-black text-slate-900 focus:outline-none focus:border-orange-500 text-sm"
                /&gt;
                &lt;span className="absolute left-3 top-2.5 text-slate-400 font-bold"&gt;د.ع&lt;/span&gt;
              &lt;/div&gt;
              &lt;p className="text-[10px] text-slate-500"&gt;
                المبلغ الأساسي الثابت عند انطلاق الرحلة (الافتراضي: 1,500 د.ع)
              &lt;/p&gt;
            &lt;/div&gt;

            {/* 2. Fee Per Km (أجرة كل كيلومتر) */}
            &lt;div className="space-y-1.5 bg-sky-50/60 p-4 rounded-2xl border border-sky-200"&gt;
              &lt;label className="font-bold text-slate-800 flex items-center justify-between"&gt;
                &lt;span&gt;2. أجرة كل كيلومتر&lt;/span&gt;
                &lt;span className="text-[10px] text-sky-700 font-black"&gt;Per Km&lt;/span&gt;
              &lt;/label&gt;
              &lt;div className="relative"&gt;
                &lt;input
                  type="number"
                  step="50"
                  min="0"
                  required
                  value={distanceFeePerKm}
                  onChange={(e) =&gt; setDistanceFeePerKm(Number(e.target.value))}
                  className="w-full p-2.5 pl-12 rounded-xl border border-sky-300 bg-white font-black text-sky-800 focus:outline-none focus:border-sky-500 text-sm"
                /&gt;
                &lt;span className="absolute left-3 top-2.5 text-slate-400 font-bold"&gt;د.ع&lt;/span&gt;
              &lt;/div&gt;
              &lt;p className="text-[10px] text-slate-500"&gt;
                المبلغ المضاف لكل كيلومتر مسار طريق (الافتراضي: 250 د.ع/كم)
              &lt;/p&gt;
            &lt;/div&gt;

            {/* 3. Max Fee (الحد الأعلى لأجرة التوصيل) */}
            &lt;div className="space-y-1.5 bg-emerald-50/60 p-4 rounded-2xl border border-emerald-200"&gt;
              &lt;label className="font-bold text-slate-800 flex items-center justify-between"&gt;
                &lt;span&gt;3. الحد الأعلى لأجرة التوصيل&lt;/span&gt;
                &lt;span className="text-[10px] text-emerald-700 font-black"&gt;Max Cap&lt;/span&gt;
              &lt;/label&gt;
              &lt;div className="relative"&gt;
                &lt;input
                  type="number"
                  step="500"
                  min="500"
                  required
                  value={distanceMaxFee}
                  onChange={(e) =&gt; setDistanceMaxFee(Number(e.target.value))}
                  className="w-full p-2.5 pl-12 rounded-xl border border-emerald-300 bg-white font-black text-emerald-800 focus:outline-none focus:border-emerald-500 text-sm"
                /&gt;
                &lt;span className="absolute left-3 top-2.5 text-slate-400 font-bold"&gt;د.ع&lt;/span&gt;
              &lt;/div&gt;
              &lt;p className="text-[10px] text-slate-500"&gt;
                سقف أقصى لا تتجاوزه الأجرة مهما بلغت المسافة (الافتراضي: 5,000 د.ع)
              &lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          {/* Interactive Examples Table based on current input values */}
          &lt;div className="bg-slate-50 p-4 rounded-2xl border border-slate-200 space-y-2"&gt;
            &lt;div className="flex flex-col sm:flex-row items-start sm:items-center justify-between gap-1"&gt;
              &lt;span className="text-xs font-black text-[#172554] flex items-center gap-1.5"&gt;
                &lt;Gauge className="w-4 h-4 text-orange-500" /&gt;
                محاكاة تطبيق المعادلة على أمثلة المسافات بالقيم المدخلة أعلاه:
              &lt;/span&gt;
              &lt;span className="text-[10px] text-slate-500 font-mono" dir="ltr"&gt;
                Fee = min({distanceMaxFee}, {distanceBaseFee} + dist × {distanceFeePerKm})
              &lt;/span&gt;
            &lt;/div&gt;

            &lt;div className="grid grid-cols-2 sm:grid-cols-6 gap-2 pt-1 text-center"&gt;
              {[1, 2, 5, 10, 14, 20].map((dist) =&gt; {
                const raw = distanceBaseFee + dist * distanceFeePerKm;
                const isCapped = raw &gt; distanceMaxFee;
                const finalFee = Math.min(distanceMaxFee, raw);
                return (
                  &lt;div
                    key={dist}
                    className={`p-2.5 rounded-xl border text-xs transition-all ${
                      isCapped
                        ? 'bg-amber-50 border-amber-300 text-amber-900 shadow-2xs'
                        : 'bg-white border-slate-200 text-slate-800 shadow-2xs'
                    }`}
                  &gt;
                    &lt;span className="text-[11px] font-bold block text-slate-500"&gt;{dist} كم&lt;/span&gt;
                    &lt;strong className="text-sm font-black block my-0.5 text-[#172554]"&gt;
                      {finalFee.toLocaleString()} د.ع
                    &lt;/strong&gt;
                    &lt;span className="text-[9px] text-slate-400 block"&gt;
                      {isCapped ? 'سقف الحد الأعلى' : `${raw.toLocaleString()} د.ع`}
                    &lt;/span&gt;
                  &lt;/div&gt;
                );
              })}
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Section 2: Global Courier Delivery &amp; Incentive Rules */}
        &lt;div className="bg-white rounded-3xl border border-slate-200 p-5 shadow-sm space-y-4"&gt;
          &lt;div className="flex items-center justify-between pb-3 border-b border-slate-100"&gt;
            &lt;div className="flex items-center gap-2"&gt;
              &lt;Bike className="w-5 h-5 text-orange-500" /&gt;
              &lt;h3 className="font-black text-sm text-[#172554]"&gt;
                2. القواعد العامة ومستحقات المندوب (الاحتياطية للمناطق)
              &lt;/h3&gt;
            &lt;/div&gt;
            &lt;span className="text-[11px] text-slate-400"&gt;تُطبق بالدينار العراقي (د.ع)&lt;/span&gt;
          &lt;/div&gt;

          &lt;div className="grid grid-cols-1 sm:grid-cols-3 gap-4 text-xs"&gt;
            {/* Default Delivery Fee (Customer) */}
            &lt;div className="space-y-1.5 bg-slate-50 p-3.5 rounded-2xl border border-slate-200"&gt;
              &lt;label className="font-bold text-slate-700 block"&gt;
                أجرة التوصيل الأساسية (يدفعها الزبون)
              &lt;/label&gt;
              &lt;div className="relative"&gt;
                &lt;input
                  type="number"
                  step="250"
                  required
                  value={defaultDeliveryFee}
                  onChange={(e) =&gt; setDefaultDeliveryFee(Number(e.target.value))}
                  className="w-full p-2.5 pl-12 rounded-xl border border-slate-300 bg-white font-black text-slate-900 focus:outline-none focus:border-orange-500"
                /&gt;
                &lt;span className="absolute left-3 top-2.5 text-slate-400 font-bold"&gt;د.ع&lt;/span&gt;
              &lt;/div&gt;
              &lt;p className="text-[10px] text-slate-400"&gt;تُعتمد إذا لم تُحدد المنطقة الخاصة&lt;/p&gt;
            &lt;/div&gt;

            {/* Default Courier Base Payout */}
            &lt;div className="space-y-1.5 bg-slate-50 p-3.5 rounded-2xl border border-slate-200"&gt;
              &lt;label className="font-bold text-slate-700 block"&gt;
                مستحق المندوب الأساسي عن كل طلب
              &lt;/label&gt;
              &lt;div className="relative"&gt;
                &lt;input
                  type="number"
                  step="250"
                  required
                  value={defaultCourierBasePayout}
                  onChange={(e) =&gt; setDefaultCourierBasePayout(Number(e.target.value))}
                  className="w-full p-2.5 pl-12 rounded-xl border border-slate-300 bg-white font-black text-emerald-700 focus:outline-none focus:border-orange-500"
                /&gt;
                &lt;span className="absolute left-3 top-2.5 text-slate-400 font-bold"&gt;د.ع&lt;/span&gt;
              &lt;/div&gt;
              &lt;p className="text-[10px] text-slate-400"&gt;المبلغ الثابت الذي يودع في محفظة الكابتن&lt;/p&gt;
            &lt;/div&gt;

            {/* Courier Extra Incentive / Bonus */}
            &lt;div className="space-y-1.5 bg-slate-50 p-3.5 rounded-2xl border border-slate-200"&gt;
              &lt;div className="flex items-center justify-between"&gt;
                &lt;label className="font-bold text-slate-700 flex items-center gap-1"&gt;
                  &lt;Gift className="w-4 h-4 text-orange-500" /&gt;
                  حافز ومكافأة الكابتن الإضافية
                &lt;/label&gt;
                &lt;button
                  type="button"
                  onClick={() =&gt; setIsCourierBonusActive(!isCourierBonusActive)}
                  className={`text-[10px] font-bold px-2 py-0.5 rounded-full transition-colors ${
                    isCourierBonusActive
                      ? 'bg-emerald-100 text-emerald-800 border border-emerald-300'
                      : 'bg-slate-200 text-slate-600'
                  }`}
                &gt;
                  {isCourierBonusActive ? 'مفعل' : 'معطل'}
                &lt;/button&gt;
              &lt;/div&gt;
              &lt;div className="relative"&gt;
                &lt;input
                  type="number"
                  step="250"
                  value={defaultCourierBonus}
                  onChange={(e) =&gt; setDefaultCourierBonus(Number(e.target.value))}
                  disabled={!isCourierBonusActive}
                  className="w-full p-2.5 pl-12 rounded-xl border border-slate-300 bg-white font-black text-orange-600 focus:outline-none focus:border-orange-500 disabled:opacity-40"
                /&gt;
                &lt;span className="absolute left-3 top-2.5 text-slate-400 font-bold"&gt;د.ع&lt;/span&gt;
              &lt;/div&gt;
              &lt;p className="text-[10px] text-slate-400"&gt;حافز اختياري إضافي يُصرف مع كل توصيل&lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Section 2: Area-based Custom Delivery Fees Table */}
        &lt;div className="bg-white rounded-3xl border border-slate-200 p-5 shadow-sm space-y-4"&gt;
          &lt;div className="flex items-center justify-between pb-3 border-b border-slate-100"&gt;
            &lt;div className="flex items-center gap-2"&gt;
              &lt;MapPin className="w-5 h-5 text-emerald-600" /&gt;
              &lt;h3 className="font-black text-sm text-[#172554]"&gt;
                2. تخصيص أجور التوصيل ومستحقات المندوب حسب المناطق ({areaFees.length})
              &lt;/h3&gt;
            &lt;/div&gt;
            &lt;span className="text-[11px] text-slate-400"&gt;إضافة وتعديل وحذف أجور المناطق&lt;/span&gt;
          &lt;/div&gt;

          {/* Add Area Row */}
          &lt;div className="bg-slate-50 p-4 rounded-2xl border border-slate-200 space-y-3"&gt;
            &lt;span className="text-xs font-bold text-slate-800 block"&gt;إضافة منطقة جديدة:&lt;/span&gt;
            &lt;div className="grid grid-cols-1 sm:grid-cols-4 gap-2 text-xs"&gt;
              &lt;input
                type="text"
                placeholder="اسم المنطقة (مثلاً: بغداد - اليرموك)"
                value={newAreaName}
                onChange={(e) =&gt; setNewAreaName(e.target.value)}
                className="p-2.5 rounded-xl border border-slate-300 bg-white font-medium"
              /&gt;
              &lt;div className="relative"&gt;
                &lt;input
                  type="number"
                  step="250"
                  placeholder="أجرة الزبون"
                  value={newAreaDeliveryFee}
                  onChange={(e) =&gt; setNewAreaDeliveryFee(Number(e.target.value))}
                  className="w-full p-2.5 pl-10 rounded-xl border border-slate-300 bg-white font-bold"
                /&gt;
                &lt;span className="absolute left-2.5 top-2.5 text-slate-400 text-[10px]"&gt;د.ع&lt;/span&gt;
              &lt;/div&gt;
              &lt;div className="relative"&gt;
                &lt;input
                  type="number"
                  step="250"
                  placeholder="مستحق المندوب"
                  value={newAreaCourierPayout}
                  onChange={(e) =&gt; setNewAreaCourierPayout(Number(e.target.value))}
                  className="w-full p-2.5 pl-10 rounded-xl border border-slate-300 bg-white font-bold text-emerald-700"
                /&gt;
                &lt;span className="absolute left-2.5 top-2.5 text-slate-400 text-[10px]"&gt;د.ع&lt;/span&gt;
              &lt;/div&gt;
              &lt;button
                type="button"
                onClick={handleAddArea}
                disabled={!newAreaName.trim()}
                className="py-2.5 px-4 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl font-bold text-xs disabled:opacity-50 flex items-center justify-center gap-1.5 shadow-sm transition-colors"
              &gt;
                &lt;Plus className="w-4 h-4" /&gt;
                &lt;span&gt;إضافة المنطقة&lt;/span&gt;
              &lt;/button&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          {/* Areas Table */}
          &lt;div className="overflow-x-auto"&gt;
            &lt;table className="w-full text-right text-xs"&gt;
              &lt;thead&gt;
                &lt;tr className="bg-slate-50 text-slate-600 border-b border-slate-200"&gt;
                  &lt;th className="p-3 font-bold"&gt;اسم المنطقة / الحي&lt;/th&gt;
                  &lt;th className="p-3 font-bold"&gt;الحالة&lt;/th&gt;
                  &lt;th className="p-3 font-bold"&gt;أجرة التوصيل (على الزبون)&lt;/th&gt;
                  &lt;th className="p-3 font-bold"&gt;مستحق المندوب الأساسي&lt;/th&gt;
                  &lt;th className="p-3 font-bold"&gt;المكافأة المعتمدة&lt;/th&gt;
                  &lt;th className="p-3 font-bold"&gt;إجمالي دخل المندوب&lt;/th&gt;
                  &lt;th className="p-3 font-bold text-center"&gt;إجراء&lt;/th&gt;
                &lt;/tr&gt;
              &lt;/thead&gt;
              &lt;tbody className="divide-y divide-slate-100"&gt;
                {areaFees.map((area) =&gt; (
                  &lt;tr
                    key={area.id}
                    className={`hover:bg-slate-50/60 transition-colors ${
                      area.isActive === false ? 'opacity-60 bg-slate-50/60' : ''
                    }`}
                  &gt;
                    &lt;td className="p-3 font-bold text-slate-900"&gt;{area.name}&lt;/td&gt;
                    &lt;td className="p-3"&gt;
                      &lt;button
                        type="button"
                        onClick={() =&gt; handleToggleAreaActive(area.id)}
                        className={`text-[10px] font-bold px-2 py-0.5 rounded-full transition-colors cursor-pointer ${
                          area.isActive !== false
                            ? 'bg-emerald-100 text-emerald-800 border border-emerald-300'
                            : 'bg-slate-200 text-slate-600 border border-slate-300'
                        }`}
                      &gt;
                        {area.isActive !== false ? 'مفعلة' : 'معطلة'}
                      &lt;/button&gt;
                    &lt;/td&gt;
                    &lt;td className="p-3"&gt;
                      &lt;div className="flex items-center gap-1 max-w-[120px]"&gt;
                        &lt;input
                          type="number"
                          step="250"
                          value={area.deliveryFee}
                          onChange={(e) =&gt; handleUpdateArea(area.id, 'deliveryFee', Number(e.target.value))}
                          className="w-24 p-1.5 rounded-lg border border-slate-300 text-xs font-bold"
                        /&gt;
                        &lt;span className="text-[10px] text-slate-400"&gt;د.ع&lt;/span&gt;
                      &lt;/div&gt;
                    &lt;/td&gt;
                    &lt;td className="p-3"&gt;
                      &lt;div className="flex items-center gap-1 max-w-[120px]"&gt;
                        &lt;input
                          type="number"
                          step="250"
                          value={area.courierPayout}
                          onChange={(e) =&gt; handleUpdateArea(area.id, 'courierPayout', Number(e.target.value))}
                          className="w-24 p-1.5 rounded-lg border border-slate-300 text-xs font-bold text-emerald-700"
                        /&gt;
                        &lt;span className="text-[10px] text-slate-400"&gt;د.ع&lt;/span&gt;
                      &lt;/div&gt;
                    &lt;/td&gt;
                    &lt;td className="p-3 font-semibold text-orange-600"&gt;
                      {isCourierBonusActive
                        ? `+${defaultCourierBonus.toLocaleString()} د.ع`
                        : &lt;span className="text-slate-400 font-normal"&gt;معطلة (0)&lt;/span&gt;}
                    &lt;/td&gt;
                    &lt;td className="p-3 font-black text-emerald-700"&gt;
                      {(area.courierPayout + (isCourierBonusActive ? defaultCourierBonus : 0)).toLocaleString()} د.ع
                    &lt;/td&gt;
                    &lt;td className="p-3 text-center"&gt;
                      &lt;button
                        type="button"
                        onClick={() =&gt; handleRemoveArea(area.id)}
                        className="p-1.5 text-slate-400 hover:text-rose-600 rounded-lg hover:bg-rose-50 transition-colors"
                        title="حذف المنطقة"
                      &gt;
                        &lt;Trash2 className="w-4 h-4" /&gt;
                      &lt;/button&gt;
                    &lt;/td&gt;
                  &lt;/tr&gt;
                ))}
              &lt;/tbody&gt;
            &lt;/table&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Section 3: Restaurant &amp; Store Commission Management */}
        &lt;div className="bg-white rounded-3xl border border-slate-200 p-5 shadow-sm space-y-4"&gt;
          &lt;div className="flex items-center justify-between pb-3 border-b border-slate-100"&gt;
            &lt;div className="flex items-center gap-2"&gt;
              &lt;Store className="w-5 h-5 text-sky-600" /&gt;
              &lt;h3 className="font-black text-sm text-[#172554]"&gt;
                3. إدارة عمولات المطاعم والماركت واحتساب صافي المستحقات
              &lt;/h3&gt;
            &lt;/div&gt;
            &lt;span className="text-[11px] text-slate-400"&gt;تحديد نسبة كل متجر أو النسبة العامة&lt;/span&gt;
          &lt;/div&gt;

          {/* Global Commission Setting */}
          &lt;div className="bg-slate-50 p-4 rounded-2xl border border-slate-200 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 text-xs"&gt;
            &lt;div&gt;
              &lt;span className="font-bold text-slate-900 block"&gt;نسبة عمولة المنصة العامة الافتراضية&lt;/span&gt;
              &lt;p className="text-[11px] text-slate-500 mt-0.5"&gt;
                تُطبق تلقائياً على أي متجر أو مطعم لا يمتلك نسبة خاصة محددة.
              &lt;/p&gt;
            &lt;/div&gt;
            &lt;div className="flex items-center gap-2"&gt;
              &lt;input
                type="number"
                min="0"
                max="100"
                step="0.5"
                required
                value={defaultPlatformCommissionPercent}
                onChange={(e) =&gt; setDefaultPlatformCommissionPercent(Number(e.target.value))}
                className="w-20 p-2 rounded-xl border border-slate-300 bg-white font-black text-center text-sm text-sky-700"
              /&gt;
              &lt;span className="font-bold text-slate-600"&gt;%&lt;/span&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          {/* Store-specific commission overrides */}
          &lt;div className="space-y-2"&gt;
            &lt;span className="text-xs font-bold text-slate-700 block"&gt;
              نسب العمولة المخصصة لكل متجر (يتم اعتمادها بدلاً من النسبة العامة):
            &lt;/span&gt;

            &lt;div className="grid grid-cols-1 md:grid-cols-2 gap-3"&gt;
              {stores.map((s) =&gt; {
                const override = storeOverrides.find((o) =&gt; o.storeId === s.id);
                const currentPercent = override ? override.commissionPercent : defaultPlatformCommissionPercent;
                const isCustom = !!override;

                return (
                  &lt;div
                    key={s.id}
                    className="p-3 bg-white rounded-2xl border border-slate-200 flex items-center justify-between gap-3 shadow-2xs"
                  &gt;
                    &lt;div className="flex items-center gap-2.5"&gt;
                      &lt;img src={s.logo} alt={s.name} className="w-10 h-10 rounded-xl object-cover bg-slate-100" /&gt;
                      &lt;div&gt;
                        &lt;h4 className="font-black text-xs text-slate-900 truncate max-w-[180px]"&gt;{s.name}&lt;/h4&gt;
                        &lt;span className="text-[10px] text-slate-400"&gt;{s.neighborhood} • {s.category}&lt;/span&gt;
                      &lt;/div&gt;
                    &lt;/div&gt;

                    &lt;div className="flex items-center gap-1.5"&gt;
                      &lt;div className="flex items-center gap-1"&gt;
                        &lt;input
                          type="number"
                          min="0"
                          max="100"
                          step="0.5"
                          value={currentPercent}
                          onChange={(e) =&gt; handleUpdateStoreOverride(s.id, s.name, Number(e.target.value))}
                          className="w-16 p-1.5 rounded-lg border border-slate-300 text-xs font-black text-center text-sky-700 bg-white"
                        /&gt;
                        &lt;span className="text-xs font-bold text-slate-500"&gt;%&lt;/span&gt;
                      &lt;/div&gt;
                      &lt;span
                        className={`text-[9px] px-1.5 py-0.5 rounded font-bold ${
                          isCustom ? 'bg-orange-100 text-orange-800' : 'bg-slate-100 text-slate-500'
                        }`}
                      &gt;
                        {isCustom ? 'مخصصة' : 'افتراضية'}
                      &lt;/span&gt;
                    &lt;/div&gt;
                  &lt;/div&gt;
                );
              })}
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Save Bar */}
        &lt;div className="flex items-center justify-between p-4 bg-slate-900 text-white rounded-2xl shadow-lg"&gt;
          &lt;div&gt;
            &lt;p className="text-xs font-bold text-white"&gt;حفظ التغييرات في قاعدة بيانات Firebase Firestore&lt;/p&gt;
            &lt;p className="text-[10px] text-slate-400"&gt;
              تُطبق الإعدادات فوراً على جميع الطلبات الجديدة في النظام دون التأثير على الحسابات التاريخية للطلبات السابقة.
            &lt;/p&gt;
          &lt;/div&gt;

          &lt;button
            type="submit"
            disabled={isSaving}
            className="px-6 py-2.5 bg-[#F47721] hover:bg-orange-600 disabled:opacity-50 text-white rounded-xl font-black text-xs shadow-md transition-all flex items-center gap-2 cursor-pointer"
          &gt;
            &lt;Save className="w-4 h-4" /&gt;
            &lt;span&gt;{isSaving ? 'جاري الحفظ في Firestore...' : 'حفظ وتطبيق السياسة الآن'}&lt;/span&gt;
          &lt;/button&gt;
        &lt;/div&gt;
      &lt;/form&gt;

      {/* Section 4: Live Interactive Order Financials Simulator */}
      &lt;div className="bg-gradient-to-br from-amber-50/60 to-orange-50/40 rounded-3xl border-2 border-orange-300 p-5 shadow-sm space-y-4"&gt;
        &lt;div className="flex items-center justify-between pb-3 border-b border-orange-200"&gt;
          &lt;div className="flex items-center gap-2"&gt;
            &lt;Calculator className="w-5 h-5 text-orange-600" /&gt;
            &lt;h3 className="font-black text-sm text-[#172554]"&gt;
              4. المحاكي المالي التفاعلي للطلب (Live Financial Breakdown)
            &lt;/h3&gt;
          &lt;/div&gt;
          &lt;span className="text-xs font-bold text-orange-800"&gt;
            فصل أجرة التوصيل عن حساب المطعم واحتساب صافي الأرباح
          &lt;/span&gt;
        &lt;/div&gt;

        {/* Simulator controls */}
        &lt;div className="grid grid-cols-1 sm:grid-cols-3 gap-3 text-xs"&gt;
          &lt;div&gt;
            &lt;label className="font-bold text-slate-700 block mb-1"&gt;المتجر / المطعم المطلوب منه:&lt;/label&gt;
            &lt;select
              value={calcSelectedStoreId}
              onChange={(e) =&gt; setCalcSelectedStoreId(e.target.value)}
              className="w-full p-2 rounded-xl border border-slate-300 bg-white font-medium"
            &gt;
              {stores.map((s) =&gt; (
                &lt;option key={s.id} value={s.id}&gt;
                  {s.name}
                &lt;/option&gt;
              ))}
            &lt;/select&gt;
          &lt;/div&gt;

          &lt;div&gt;
            &lt;label className="font-bold text-slate-700 block mb-1"&gt;منطقة التوصيل للزبون:&lt;/label&gt;
            &lt;select
              value={calcSelectedArea}
              onChange={(e) =&gt; setCalcSelectedArea(e.target.value)}
              className="w-full p-2 rounded-xl border border-slate-300 bg-white font-medium"
            &gt;
              {areaFees.map((a) =&gt; (
                &lt;option key={a.id} value={a.name}&gt;
                  {a.name}
                &lt;/option&gt;
              ))}
            &lt;/select&gt;
          &lt;/div&gt;

          &lt;div&gt;
            &lt;label className="font-bold text-slate-700 block mb-1"&gt;سعر أصناف الوجبات (المجموع الفرعي):&lt;/label&gt;
            &lt;div className="relative"&gt;
              &lt;input
                type="number"
                step="1000"
                value={calcSubtotal}
                onChange={(e) =&gt; setCalcSubtotal(Number(e.target.value))}
                className="w-full p-2 pl-10 rounded-xl border border-slate-300 bg-white font-black text-slate-900"
              /&gt;
              &lt;span className="absolute left-2.5 top-2 text-slate-400 font-bold"&gt;د.ع&lt;/span&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Visual Partition Breakdown Cards */}
        &lt;div className="grid grid-cols-2 sm:grid-cols-4 gap-3 pt-2"&gt;
          {/* Customer Total */}
          &lt;div className="bg-white p-3.5 rounded-2xl border border-slate-200 shadow-xs space-y-1"&gt;
            &lt;span className="text-[10px] text-slate-400 font-bold block"&gt;إجمالي ما يدفعه الزبون&lt;/span&gt;
            &lt;p className="text-base font-black text-[#172554]"&gt;{activeTotalCustomerPays.toLocaleString()} د.ع&lt;/p&gt;
            &lt;p className="text-[9px] text-slate-500"&gt;
              أصناف {calcSubtotal.toLocaleString()} + توصيل {activeDeliveryFee.toLocaleString()} + خدمة 1,000
            &lt;/p&gt;
          &lt;/div&gt;

          {/* Platform Commission */}
          &lt;div className="bg-white p-3.5 rounded-2xl border border-sky-200 shadow-xs space-y-1"&gt;
            &lt;div className="flex justify-between items-center"&gt;
              &lt;span className="text-[10px] text-sky-700 font-bold block"&gt;عمولة منصة طلبي&lt;/span&gt;
              &lt;span className="text-[9px] bg-sky-100 text-sky-800 px-1 rounded font-black"&gt;{activeCommissionPercent}%&lt;/span&gt;
            &lt;/div&gt;
            &lt;p className="text-base font-black text-sky-700"&gt;{activeCommissionAmount.toLocaleString()} د.ع&lt;/p&gt;
            &lt;p className="text-[9px] text-slate-500"&gt;تخصم من قيمة طعام المطعم فقط&lt;/p&gt;
          &lt;/div&gt;

          {/* Store Net Payout */}
          &lt;div className="bg-white p-3.5 rounded-2xl border border-emerald-200 shadow-xs space-y-1"&gt;
            &lt;span className="text-[10px] text-emerald-700 font-bold block"&gt;صافي مستحقات المطعم&lt;/span&gt;
            &lt;p className="text-base font-black text-emerald-600"&gt;{activeStoreNetPayout.toLocaleString()} د.ع&lt;/p&gt;
            &lt;p className="text-[9px] text-slate-500"&gt;المجموع الفرعي - عمولة المنصة&lt;/p&gt;
          &lt;/div&gt;

          {/* Courier Total Earning */}
          &lt;div className="bg-white p-3.5 rounded-2xl border border-orange-200 shadow-xs space-y-1"&gt;
            &lt;span className="text-[10px] text-orange-700 font-bold block"&gt;مستحق المندوب الكامل&lt;/span&gt;
            &lt;p className="text-base font-black text-orange-600"&gt;{activeCourierTotal.toLocaleString()} د.ع&lt;/p&gt;
            &lt;p className="text-[9px] text-slate-500"&gt;
              أساسي {activeCourierBase.toLocaleString()} + مكافأة {activeCourierBonus.toLocaleString()}
            &lt;/p&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      {/* Section 5: Settings Audit Log */}
      &lt;div className="bg-white rounded-3xl border border-slate-200 p-5 shadow-sm space-y-3"&gt;
        &lt;div className="flex items-center justify-between pb-2 border-b border-slate-100"&gt;
          &lt;div className="flex items-center gap-2"&gt;
            &lt;History className="w-4 h-4 text-slate-600" /&gt;
            &lt;h4 className="font-black text-xs text-[#172554]"&gt;
              سجل تدقيق تغييرات السياسة المالية والعمولات (Audit Log)
            &lt;/h4&gt;
          &lt;/div&gt;
          &lt;span className="text-[10px] text-slate-400"&gt;توثيق تاريخي آمن لكل تعديل&lt;/span&gt;
        &lt;/div&gt;

        &lt;div className="divide-y divide-slate-100 max-h-48 overflow-y-auto"&gt;
          {pricingLogs.length === 0 ? (
            &lt;p className="text-xs text-slate-400 py-3 text-center"&gt;لا توجد تعديلات مسجلة حديثاً&lt;/p&gt;
          ) : (
            pricingLogs.map((log) =&gt; (
              &lt;div key={log.id} className="py-2 text-xs flex items-center justify-between gap-3"&gt;
                &lt;div className="flex items-center gap-2"&gt;
                  &lt;span className="font-mono text-[10px] text-slate-400"&gt;{log.timestamp}&lt;/span&gt;
                  &lt;span className="font-bold text-slate-800"&gt;{log.details}&lt;/span&gt;
                &lt;/div&gt;
                &lt;span className="text-[10px] text-slate-500 font-medium shrink-0"&gt;{log.performedBy}&lt;/span&gt;
              &lt;/div&gt;
            ))
          )}
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
};
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/courier/&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000755&#65533;0000000&#65533;0000000&#65533;00000000000&#65533;15267721203&#65533;014342&#65533; 5&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/courier/CourierView.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000135312&#65533;15267721203&#65533;017352&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import React, { useState, useEffect } from 'react';
import { useApp } from '../../context/AppContext';
import { InAppSupportChatModal } from '../common/InAppSupportChatModal';
import { LocationCoordinates, Order } from '../../types';
import {
  Bike,
  Power,
  MapPin,
  Phone,
  Navigation,
  CheckCircle2,
  DollarSign,
  Star,
  Clock,
  Package,
  AlertCircle,
  HelpCircle,
  Banknote,
  Store as StoreIcon,
  MessageCircle,
  Menu,
  Percent,
  Crosshair,
  TrendingUp,
  Gift,
  ShieldCheck,
  ChevronDown,
  X,
  Compass,
  ArrowUpRight,
  ExternalLink,
  MessageSquare,
  Sparkles,
  Layers,
  Info,
} from 'lucide-react';

export const CourierView: React.FC = () =&gt; {
  const {
    couriers,
    toggleCourierStatus,
    orders,
    courierAcceptOrder,
    courierDeliverOrder,
    updateOrderStatus,
    updateCourierLocation,
    startSupportConversation,
    setRole,
    addNotification,
    addAuditLog,
    getCourierRatings,
    pricingSettings,
    conversations,
  } = useApp();

  // Active courier (default to first courier: حيدر الكرخي)
  const [selectedCourierId, setSelectedCourierId] = useState&lt;string&gt;(couriers[0]?.id || 'cour_1');
  const currentCourier = couriers.find((c) =&gt; c.id === selectedCourierId) || couriers[0];
  const courierRatings = getCourierRatings(currentCourier.id);

  // Modals &amp; Drawers
  const [isSupportChatOpen, setIsSupportChatOpen] = useState(false);
  const [isCommissionModalOpen, setIsCommissionModalOpen] = useState(false);
  const [isProfileDrawerOpen, setIsProfileDrawerOpen] = useState(false);
  const [isIncentivesModalOpen, setIsIncentivesModalOpen] = useState(false);
  const [showReviewsModal, setShowReviewsModal] = useState(false);
  const [showMapInfoModal, setShowMapInfoModal] = useState(false);

  // GPS &amp; Live Location
  const [captainCoords, setCaptainCoords] = useState&lt;LocationCoordinates&gt;({
    lat: 33.3152,
    lng: 44.3541,
    accuracy: 15,
    isManualPin: false,
    verifiedAt: new Date().toLocaleTimeString('ar-IQ'),
  });
  const [isGpsLoading, setIsGpsLoading] = useState(false);
  const [gpsError, setGpsError] = useState&lt;string | null&gt;(null);

  // Active order assigned to this courier
  const activeOrder = orders.find(
    (o) =&gt;
      o.courierId === currentCourier.id &amp;&amp;
      (o.status === 'courier_assigned' || o.status === 'picked_up' || o.status === 'courier_arrived')
  );

  // Available orders waiting for dispatch (ready_for_pickup with no courier)
  const availableOrders = orders.filter(
    (o) =&gt; o.status === 'ready_for_pickup' &amp;&amp; !o.courierId
  );

  // Unread messages count for this courier
  const unreadMessagesCount = conversations
    .filter((c) =&gt; c.userId === currentCourier.userId || c.userId === currentCourier.id)
    .reduce((acc, c) =&gt; acc + (c.status === 'open' ? 1 : 0), 1);

  // Fetch / Recenter GPS
  const handleRecenterLocation = () =&gt; {
    if (!navigator.geolocation) {
      setGpsError('خاصية تحديد الموقع غير مدعومة في متصفحك');
      return;
    }

    setIsGpsLoading(true);
    setGpsError(null);

    navigator.geolocation.getCurrentPosition(
      (pos) =&gt; {
        setIsGpsLoading(false);
        const newCoords: LocationCoordinates = {
          lat: pos.coords.latitude,
          lng: pos.coords.longitude,
          accuracy: Math.round(pos.coords.accuracy),
          isManualPin: false,
          verifiedAt: new Date().toLocaleTimeString('ar-IQ'),
        };
        setCaptainCoords(newCoords);

        addNotification(
          'تم تحديث موقع الكابتن',
          `تم تثبيت إحداثياتك الميدانية بدقة ±${Math.round(pos.coords.accuracy)} متر`,
          'success'
        );

        // If on active order, sync with order &amp; Firestore
        if (activeOrder) {
          updateCourierLocation(activeOrder.id, newCoords);
        }
      },
      (err) =&gt; {
        setIsGpsLoading(false);
        setGpsError('تعذر الحصول على إشارة GPS. تأكد من منح إذن الموقع في المتصفح.');
      },
      { enableHighAccuracy: true, timeout: 10000 }
    );
  };

  // Auto request location once on mount
  useEffect(() =&gt; {
    if (navigator.geolocation) {
      navigator.geolocation.getCurrentPosition(
        (pos) =&gt; {
          const coords: LocationCoordinates = {
            lat: pos.coords.latitude,
            lng: pos.coords.longitude,
            accuracy: Math.round(pos.coords.accuracy),
            isManualPin: false,
            verifiedAt: new Date().toLocaleTimeString('ar-IQ'),
          };
          setCaptainCoords(coords);
          if (activeOrder) {
            updateCourierLocation(activeOrder.id, coords);
          }
        },
        () =&gt; {},
        { enableHighAccuracy: true }
      );
    }
  }, [activeOrder?.id]);

  // Arrived at Doorstep Action
  const handleCourierArrived = () =&gt; {
    if (!activeOrder) return;
    const timeStr = new Date().toLocaleTimeString('ar-IQ', { hour: '2-digit', minute: '2-digit' });
    updateOrderStatus(
      activeOrder.id,
      'courier_arrived',
      `وصل الكابتن ${currentCourier.name} إلى عنوان الزبون وهو عند الباب الآن (${timeStr})`
    );
    addNotification(
      'الكابتن بالباب الآن!',
      `تم إرسال إشعار فوري للزبون بأنك وصلت إلى عنوانه ومعه الطلب #${activeOrder.id.slice(-6)}`,
      'success',
      activeOrder.id
    );
  };

  // Complete delivery
  const handleDeliverOrder = () =&gt; {
    if (!activeOrder) return;
    courierDeliverOrder(currentCourier.id, activeOrder.id);
    addNotification('مبارك! تم إتمام التوصيل', 'أضيفت أرباح الطلب ومستحقاتك فورياً إلى محفظتك', 'success');
  };

  // Format WhatsApp link for Iraqi numbers
  const formatWhatsAppUrl = (phone: string) =&gt; {
    let clean = phone.replace(/\D/g, '');
    if (clean.startsWith('0')) clean = clean.substring(1);
    if (!clean.startsWith('964')) clean = `964${clean}`;
    return `https://wa.me/${clean}`;
  };

  return (
    &lt;div className="min-h-screen bg-slate-100 flex flex-col relative overflow-hidden select-none" dir="rtl"&gt;
      {/* ================= 1. INTERACTIVE REAL MAP VIEWPORT (FILLS MOST OF THE SCREEN) ================= */}
      &lt;div className="relative w-full flex-1 h-[78vh] sm:h-[82vh] bg-slate-900 overflow-hidden"&gt;
        {/* OpenStreetMap Real Tile Layer */}
        &lt;div
          className="absolute inset-0 bg-cover bg-center transition-all duration-700"
          style={{
            backgroundImage: `url('https://tile.openstreetmap.org/15/${Math.floor(
              ((captainCoords.lng + 180) / 360) * Math.pow(2, 15)
            )}/${Math.floor(
              ((1 -
                Math.log(
                  Math.tan((captainCoords.lat * Math.PI) / 180) +
                    1 / Math.cos((captainCoords.lat * Math.PI) / 180)
                ) /
                  Math.PI) /
                2) *
                Math.pow(2, 15)
            )}.png')`,
            filter: 'contrast(1.05) saturate(1.1)',
          }}
        /&gt;

        {/* Baghdad Map Grid Overlay for spatial feel */}
        &lt;div className="absolute inset-0 bg-gradient-to-t from-slate-900/60 via-transparent to-slate-900/30 pointer-events-none" /&gt;

        {/* Central Captain Live Position Marker with Radar Pulse */}
        &lt;div className="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 z-20 pointer-events-none flex flex-col items-center"&gt;
          {currentCourier.isOnline ? (
            &lt;div className="relative flex items-center justify-center"&gt;
              {/* Radar pulse rings */}
              &lt;div className="absolute w-24 h-24 rounded-full bg-orange-500/20 animate-ping" /&gt;
              &lt;div className="absolute w-16 h-16 rounded-full bg-[#F47721]/30 animate-pulse" /&gt;
              
              {/* Captain Marker Pin */}
              &lt;div className="relative w-12 h-12 rounded-full bg-[#172554] border-3 border-[#F47721] text-white flex items-center justify-center shadow-2xl"&gt;
                &lt;Bike className="w-6 h-6 text-orange-400" /&gt;
              &lt;/div&gt;

              {/* Status Tag */}
              &lt;div className="absolute -bottom-7 bg-[#172554]/90 backdrop-blur-md text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow-md whitespace-nowrap border border-orange-500/30"&gt;
                موقعك الفعلي: {currentCourier.name.split(' ')[0]}
              &lt;/div&gt;
            &lt;/div&gt;
          ) : (
            &lt;div className="relative flex items-center justify-center"&gt;
              &lt;div className="w-12 h-12 rounded-full bg-slate-700 border-3 border-slate-500 text-slate-300 flex items-center justify-center shadow-lg"&gt;
                &lt;Power className="w-5 h-5 text-slate-400" /&gt;
              &lt;/div&gt;
              &lt;div className="absolute -bottom-6 bg-slate-800 text-slate-300 text-[10px] font-bold px-2 py-0.5 rounded-full shadow-md whitespace-nowrap"&gt;
                غير متصل
              &lt;/div&gt;
            &lt;/div&gt;
          )}
        &lt;/div&gt;

        {/* If Active Order: Show Restaurant Pin (Pickup) &amp; Customer Pin (Dropoff) */}
        {activeOrder &amp;&amp; (
          &lt;&gt;
            {/* Restaurant Marker (Offset visually on map) */}
            &lt;div className="absolute top-[35%] right-[28%] z-20 flex flex-col items-center animate-bounce"&gt;
              &lt;div className="w-9 h-9 rounded-2xl bg-[#F47721] text-white flex items-center justify-center shadow-lg border-2 border-white"&gt;
                &lt;StoreIcon className="w-5 h-5" /&gt;
              &lt;/div&gt;
              &lt;span className="bg-white/95 text-slate-900 text-[10px] font-bold px-2 py-0.5 rounded-full shadow-md mt-1 border border-slate-200"&gt;
                المطعم: {activeOrder.storeName}
              &lt;/span&gt;
            &lt;/div&gt;

            {/* Customer Marker (Offset visually on map) */}
            &lt;div className="absolute bottom-[36%] left-[26%] z-20 flex flex-col items-center"&gt;
              &lt;div className="w-9 h-9 rounded-2xl bg-[#172554] text-white flex items-center justify-center shadow-lg border-2 border-orange-400 animate-pulse"&gt;
                &lt;MapPin className="w-5 h-5 text-orange-400" /&gt;
              &lt;/div&gt;
              &lt;span className="bg-[#172554] text-white text-[10px] font-bold px-2 py-0.5 rounded-full shadow-md mt-1 border border-orange-400/50"&gt;
                الزبون: {activeOrder.customer.neighborhood}
              &lt;/span&gt;
            &lt;/div&gt;

            {/* Direct Route Indicator SVG */}
            &lt;svg className="absolute inset-0 w-full h-full pointer-events-none z-10 opacity-70"&gt;
              &lt;line
                x1="72%"
                y1="35%"
                x2="50%"
                y2="50%"
                stroke="#F47721"
                strokeWidth="3"
                strokeDasharray="6 4"
              /&gt;
              &lt;line
                x1="50%"
                y1="50%"
                x2="26%"
                y2="64%"
                stroke="#172554"
                strokeWidth="3"
                strokeDasharray="6 4"
              /&gt;
            &lt;/svg&gt;
          &lt;/&gt;
        )}

        {/* ================= 2. TOP FLOATING CARDS &amp; CONTROLS ================= */}
        {/* A. Menu Button (Top Right) */}
        &lt;button
          onClick={() =&gt; setIsProfileDrawerOpen(true)}
          className="absolute top-4 right-4 z-30 w-11 h-11 rounded-2xl bg-white/95 hover:bg-white text-slate-800 flex items-center justify-center shadow-lg border border-slate-200/80 active:scale-95 transition-all"
          title="القائمة والإعدادات والملف الشخصي"
        &gt;
          &lt;Menu className="w-5 h-5 text-[#172554]" /&gt;
        &lt;/button&gt;

        {/* B. Balance Card (Top Center - بطاقة الرصيد في الأعلى) */}
        &lt;div className="absolute top-4 left-1/2 -translate-x-1/2 z-30"&gt;
          &lt;div className="bg-white/95 backdrop-blur-md px-4 py-2 rounded-2xl shadow-xl border border-slate-200/80 flex items-center gap-2.5"&gt;
            &lt;div className="w-8 h-8 rounded-xl bg-orange-50 text-[#F47721] flex items-center justify-center font-bold"&gt;
              &lt;Banknote className="w-4 h-4" /&gt;
            &lt;/div&gt;
            &lt;div className="text-right"&gt;
              &lt;span className="text-[10px] text-slate-400 font-semibold block leading-tight"&gt;
                رصيد الكابتن الفعلي
              &lt;/span&gt;
              &lt;span className="font-extrabold text-sm sm:text-base text-[#172554]"&gt;
                {currentCourier.walletBalance.toLocaleString()} د.ع
              &lt;/span&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* C. Circular Commission &amp; Earnings Button (Top Left - زر دائري أعلى اليسار) */}
        &lt;div className="absolute top-4 left-4 z-30 flex items-center gap-2"&gt;
          &lt;button
            onClick={() =&gt; setIsCommissionModalOpen(true)}
            className="w-11 h-11 rounded-full bg-white/95 hover:bg-white text-slate-800 flex flex-col items-center justify-center shadow-lg border border-slate-200/80 active:scale-95 transition-all"
            title="نسبة العمولة وتفاصيل الأرباح"
          &gt;
            &lt;Percent className="w-4 h-4 text-[#F47721]" /&gt;
            &lt;span className="text-[8px] font-black text-[#172554] leading-none"&gt;
              %{pricingSettings.defaultPlatformCommissionPercent}
            &lt;/span&gt;
          &lt;/button&gt;

          {/* D. Messages Button with Unread Badge */}
          &lt;button
            onClick={() =&gt; setIsSupportChatOpen(true)}
            className="w-11 h-11 rounded-full bg-white/95 hover:bg-white text-slate-800 flex items-center justify-center shadow-lg border border-slate-200/80 active:scale-95 transition-all relative"
            title="الرسائل والدعم الفني"
          &gt;
            &lt;MessageCircle className="w-5 h-5 text-sky-600" /&gt;
            {unreadMessagesCount &gt; 0 &amp;&amp; (
              &lt;span className="absolute -top-1 -right-1 w-5 h-5 bg-[#F47721] text-white text-[10px] font-bold rounded-full flex items-center justify-center shadow-sm"&gt;
                {unreadMessagesCount}
              &lt;/span&gt;
            )}
          &lt;/button&gt;
        &lt;/div&gt;

        {/* E. Map Help / Prototype API Explanation Trigger */}
        &lt;button
          onClick={() =&gt; setShowMapInfoModal(true)}
          className="absolute top-18 right-4 z-30 bg-white/90 hover:bg-white text-slate-700 px-2.5 py-1 rounded-xl text-[10px] font-bold flex items-center gap-1 shadow-md border border-slate-200"
        &gt;
          &lt;Info className="w-3.5 h-3.5 text-[#F47721]" /&gt;
          &lt;span&gt;إعداد الخريطة وGPS&lt;/span&gt;
        &lt;/button&gt;

        {/* Approval Status Alert Banner */}
        {currentCourier.approvalStatus &amp;&amp; currentCourier.approvalStatus !== 'approved' &amp;&amp; (
          &lt;div className="absolute top-18 left-4 right-4 sm:right-36 z-30 bg-amber-500/95 backdrop-blur-md text-white px-4 py-2.5 rounded-2xl shadow-xl flex items-center justify-between gap-3 border border-amber-300"&gt;
            &lt;div className="flex items-center gap-2"&gt;
              &lt;Clock className="w-5 h-5 text-amber-200 animate-pulse shrink-0" /&gt;
              &lt;div&gt;
                &lt;span className="text-xs font-black block"&gt;
                  {currentCourier.approvalStatus === 'pending'
                    ? 'الحساب بانتظار موافقة واعتماد المدير'
                    : currentCourier.approvalStatus === 'suspended'
                    ? 'تم تعليق حساب الكابتن مؤقتاً'
                    : 'طلب الانضمام مرفوض'}
                &lt;/span&gt;
                &lt;span className="text-[10px] text-amber-100 block"&gt;
                  {currentCourier.approvalStatus === 'pending'
                    ? 'لا يمكنك تفعيل الاتصال أو استقبال طلبات الزبائن قبل اعتماد الإدارة للمستندات والبيانات.'
                    : 'يرجى مراجعة إدارة طلبي لمزيد من التفاصيل.'}
                &lt;/span&gt;
              &lt;/div&gt;
            &lt;/div&gt;
            &lt;span className="text-[10px] bg-white/20 px-2 py-0.5 rounded-full font-bold shrink-0"&gt;
              {currentCourier.approvalStatus === 'pending' ? 'قيد التدقيق' : 'معطل'}
            &lt;/span&gt;
          &lt;/div&gt;
        )}

        {/* F. Recenter Current Location Button (Bottom Right of Map) */}
        &lt;div className="absolute bottom-24 right-4 z-30 flex flex-col gap-2"&gt;
          &lt;button
            onClick={handleRecenterLocation}
            disabled={isGpsLoading}
            className="w-12 h-12 rounded-2xl bg-white hover:bg-slate-50 text-slate-800 flex items-center justify-center shadow-xl border border-slate-200 active:scale-95 transition-all disabled:opacity-50"
            title="تحديد وتثبيت موقعي الحالي الحقيقي"
          &gt;
            &lt;Crosshair className={`w-5 h-5 text-[#F47721] ${isGpsLoading ? 'animate-spin' : ''}`} /&gt;
          &lt;/button&gt;
        &lt;/div&gt;

        {/* GPS Error notice if any */}
        {gpsError &amp;&amp; (
          &lt;div className="absolute bottom-24 left-4 right-18 z-30 bg-rose-50 border border-rose-200 text-rose-800 p-2.5 rounded-2xl text-[11px] font-bold flex items-center gap-2 shadow-lg"&gt;
            &lt;AlertCircle className="w-4 h-4 shrink-0" /&gt;
            &lt;span&gt;{gpsError}&lt;/span&gt;
          &lt;/div&gt;
        )}
      &lt;/div&gt;

      {/* ================= 3. ACTIVE ORDER OVERLAY SHEET (IF ASSIGNED) ================= */}
      {activeOrder &amp;&amp; (
        &lt;div className="bg-white border-t border-slate-200 shadow-2xl p-4 -mt-6 rounded-t-3xl relative z-30 max-w-xl mx-auto w-full space-y-3"&gt;
          &lt;div className="flex items-center justify-between"&gt;
            &lt;div className="flex items-center gap-2"&gt;
              &lt;span className="text-xs font-mono font-black text-slate-400"&gt;
                #{activeOrder.id.slice(-6)}
              &lt;/span&gt;
              &lt;span className="text-xs bg-orange-100 text-[#F47721] font-bold px-2 py-0.5 rounded-full"&gt;
                {activeOrder.status === 'courier_assigned'
                  ? 'طلب جديد مسند إليك'
                  : activeOrder.status === 'picked_up'
                  ? 'الطلب معك وفي الطريق'
                  : 'أنت عند باب الزبون'}
              &lt;/span&gt;
            &lt;/div&gt;

            &lt;div className="text-left font-black text-sm text-[#172554]"&gt;
              أرباحك:{' '}
              &lt;span className="text-[#F47721]"&gt;
                {(activeOrder.financials?.courierTotalEarnings ?? 3000).toLocaleString()} د.ع
              &lt;/span&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          {/* Locations detail: Pickup &amp; Dropoff */}
          &lt;div className="bg-slate-50 p-3 rounded-2xl border border-slate-200/80 space-y-2 text-xs"&gt;
            {/* Store Pickup */}
            &lt;div className="flex items-start gap-2"&gt;
              &lt;StoreIcon className="w-4 h-4 text-[#F47721] shrink-0 mt-0.5" /&gt;
              &lt;div&gt;
                &lt;span className="font-bold text-slate-900 block"&gt;{activeOrder.storeName}&lt;/span&gt;
                &lt;span className="text-[11px] text-slate-400"&gt;{activeOrder.storeAddress}&lt;/span&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            {/* Customer Dropoff */}
            &lt;div className="flex items-start justify-between gap-2 pt-2 border-t border-slate-200"&gt;
              &lt;div className="flex items-start gap-2"&gt;
                &lt;MapPin className="w-4 h-4 text-emerald-600 shrink-0 mt-0.5" /&gt;
                &lt;div&gt;
                  &lt;span className="font-bold text-slate-900 block"&gt;
                    {activeOrder.customer.name} ({activeOrder.customer.neighborhood})
                  &lt;/span&gt;
                  &lt;span className="text-[11px] text-slate-400"&gt;{activeOrder.customer.address}&lt;/span&gt;
                  {activeOrder.customer.notes &amp;&amp; (
                    &lt;span className="text-[10px] text-orange-600 block font-medium"&gt;
                      ملاحظة: {activeOrder.customer.notes}
                    &lt;/span&gt;
                  )}
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Call &amp; WhatsApp actions */}
              &lt;div className="flex items-center gap-1.5 shrink-0"&gt;
                &lt;a
                  href={`tel:${activeOrder.customer.phone}`}
                  className="p-2 rounded-xl bg-white border border-slate-200 hover:bg-slate-100 text-slate-700 shadow-xs"
                  title="اتصال هاتفي"
                &gt;
                  &lt;Phone className="w-3.5 h-3.5" /&gt;
                &lt;/a&gt;
                &lt;a
                  href={formatWhatsAppUrl(activeOrder.customer.phone)}
                  target="_blank"
                  rel="noreferrer"
                  className="p-2 rounded-xl bg-emerald-500 hover:bg-emerald-600 text-white shadow-xs"
                  title="محادثة واتساب"
                &gt;
                  &lt;MessageSquare className="w-3.5 h-3.5" /&gt;
                &lt;/a&gt;
              &lt;/div&gt;
            &lt;/div&gt;
          &lt;/div&gt;

          {/* Action Step Buttons */}
          &lt;div className="flex items-center gap-2"&gt;
            {activeOrder.status === 'courier_assigned' &amp;&amp; (
              &lt;button
                onClick={() =&gt; updateOrderStatus(activeOrder.id, 'picked_up', 'استلم الكابتن الطلب وبدأ مسار التوصيل')}
                className="flex-1 py-3 bg-[#F47721] hover:bg-[#e06816] text-white rounded-2xl font-bold text-xs shadow-md shadow-orange-500/20 active:scale-[0.99] transition-all flex items-center justify-center gap-1.5"
              &gt;
                &lt;Package className="w-4 h-4" /&gt;
                &lt;span&gt;استلمت الطلب من المطعم وبدأت التوصيل&lt;/span&gt;
              &lt;/button&gt;
            )}

            {activeOrder.status === 'picked_up' &amp;&amp; (
              &lt;button
                onClick={handleCourierArrived}
                className="flex-1 py-3 bg-purple-600 hover:bg-purple-700 text-white rounded-2xl font-bold text-xs shadow-md active:scale-[0.99] transition-all flex items-center justify-center gap-1.5"
              &gt;
                &lt;BellRingIcon className="w-4 h-4" /&gt;
                &lt;span&gt;وصلت للعنوان وأنا عند الباب (تنبيه الزبون)&lt;/span&gt;
              &lt;/button&gt;
            )}

            {activeOrder.status === 'courier_arrived' &amp;&amp; (
              &lt;button
                onClick={handleDeliverOrder}
                className="flex-1 py-3 bg-emerald-600 hover:bg-emerald-700 text-white rounded-2xl font-bold text-xs shadow-md active:scale-[0.99] transition-all flex items-center justify-center gap-1.5"
              &gt;
                &lt;CheckCircle2 className="w-4 h-4" /&gt;
                &lt;span&gt;تم التسليم بنجاح واستلام المبلغ&lt;/span&gt;
              &lt;/button&gt;
            )}
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ================= 4. AVAILABLE ORDERS SHEET (IF ONLINE &amp; NO ACTIVE ORDER) ================= */}
      {!activeOrder &amp;&amp; availableOrders.length &gt; 0 &amp;&amp; currentCourier.isOnline &amp;&amp; (
        &lt;div className="bg-white border-t border-slate-200 shadow-2xl p-4 -mt-6 rounded-t-3xl relative z-30 max-w-xl mx-auto w-full space-y-3"&gt;
          &lt;div className="flex items-center justify-between"&gt;
            &lt;h3 className="font-bold text-xs text-slate-800 flex items-center gap-1.5"&gt;
              &lt;span className="w-2.5 h-2.5 rounded-full bg-emerald-500 animate-pulse" /&gt;
              &lt;span&gt;طلبات جاهزة للتوصيل بالقرب منك ({availableOrders.length})&lt;/span&gt;
            &lt;/h3&gt;
            &lt;span className="text-[10px] text-slate-400"&gt;اختر طلباً لبدء رحلتك&lt;/span&gt;
          &lt;/div&gt;

          &lt;div className="space-y-2 max-h-40 overflow-y-auto"&gt;
            {availableOrders.map((ord) =&gt; (
              &lt;div
                key={ord.id}
                className="bg-slate-50 p-3 rounded-2xl border border-slate-200 flex items-center justify-between gap-3"
              &gt;
                &lt;div&gt;
                  &lt;h4 className="font-bold text-xs text-slate-900"&gt;{ord.storeName}&lt;/h4&gt;
                  &lt;p className="text-[11px] text-slate-500"&gt;
                    التوصيل إلى: {ord.customer.neighborhood} • {ord.items.length} أصناف
                  &lt;/p&gt;
                  &lt;span className="text-xs font-bold text-[#F47721] block mt-0.5"&gt;
                    أرباحك: {(ord.financials?.courierTotalEarnings ?? 3000).toLocaleString()} د.ع
                  &lt;/span&gt;
                &lt;/div&gt;

                &lt;button
                  onClick={() =&gt; courierAcceptOrder(currentCourier.id, ord.id)}
                  className="px-3.5 py-2 bg-[#F47721] hover:bg-[#e06816] text-white rounded-xl font-bold text-xs shadow-xs transition-all active:scale-95 whitespace-nowrap"
                &gt;
                  قبول وتوصيل
                &lt;/button&gt;
              &lt;/div&gt;
            ))}
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ================= 5. BOTTOM FLOATING BAR (HELP, BIG ONLINE TOGGLE, INCENTIVES) ================= */}
      &lt;div className="fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-200 p-3 shadow-2xl"&gt;
        &lt;div className="max-w-xl mx-auto flex items-center justify-between gap-3"&gt;
          {/* A. Help Button (المساعدة) */}
          &lt;button
            onClick={() =&gt; {
              startSupportConversation('مساعدة كابتن ميداني', activeOrder?.id);
              setIsSupportChatOpen(true);
            }}
            className="flex flex-col items-center gap-1 px-3 py-1.5 rounded-2xl hover:bg-slate-100 text-slate-600 transition-colors"
          &gt;
            &lt;HelpCircle className="w-5 h-5 text-slate-500" /&gt;
            &lt;span className="text-[10px] font-bold"&gt;المساعدة&lt;/span&gt;
          &lt;/button&gt;

          {/* B. Big Central Online / Offline Toggle Button (زر التبديل الكبير في المنتصف) */}
          &lt;button
            onClick={() =&gt; toggleCourierStatus(currentCourier.id)}
            disabled={Boolean(currentCourier.approvalStatus &amp;&amp; currentCourier.approvalStatus !== 'approved')}
            className={`flex-1 py-3 px-5 rounded-2xl font-black text-xs sm:text-sm flex items-center justify-center gap-2 shadow-lg transition-all active:scale-[0.98] ${
              currentCourier.approvalStatus &amp;&amp; currentCourier.approvalStatus !== 'approved'
                ? 'bg-amber-600/90 text-white cursor-not-allowed opacity-90'
                : currentCourier.isOnline
                ? 'bg-emerald-600 hover:bg-emerald-700 text-white shadow-emerald-500/20'
                : 'bg-slate-800 hover:bg-slate-900 text-white shadow-slate-900/20'
            }`}
          &gt;
            &lt;span
              className={`w-3 h-3 rounded-full ${
                currentCourier.approvalStatus &amp;&amp; currentCourier.approvalStatus !== 'approved'
                  ? 'bg-amber-300'
                  : currentCourier.isOnline
                  ? 'bg-white animate-pulse'
                  : 'bg-rose-500'
              }`}
            /&gt;
            &lt;span&gt;
              {currentCourier.approvalStatus === 'pending'
                ? 'بانتظار موافقة المدير (غير متاح)'
                : currentCourier.approvalStatus === 'suspended'
                ? 'الحساب معلق مؤقتاً'
                : currentCourier.approvalStatus === 'rejected'
                ? 'الطلب مرفوض'
                : currentCourier.isOnline
                ? 'متصل (استقبال الطلبات مفعل)'
                : 'غير متصل (اضغط للاتصال)'}
            &lt;/span&gt;
          &lt;/button&gt;

          {/* C. Incentives &amp; Earnings Section (قسم الحوافز والأرباح) */}
          &lt;button
            onClick={() =&gt; setIsIncentivesModalOpen(true)}
            className="flex flex-col items-center gap-1 px-3 py-1.5 rounded-2xl hover:bg-slate-100 text-slate-600 transition-colors relative"
          &gt;
            &lt;TrendingUp className="w-5 h-5 text-orange-500" /&gt;
            &lt;span className="text-[10px] font-bold"&gt;الأرباح والحوافز&lt;/span&gt;
            {pricingSettings.isCourierBonusActive &amp;&amp; (
              &lt;span className="w-2 h-2 rounded-full bg-[#F47721] absolute top-1 right-2" /&gt;
            )}
          &lt;/button&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      {/* ================= 6. MODAL: COMMISSION &amp; EARNINGS BREAKDOWN (TOP-LEFT CIRCLE) ================= */}
      {isCommissionModalOpen &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs animate-fadeIn"&gt;
          &lt;div className="bg-white rounded-3xl max-w-sm w-full p-5 shadow-2xl border border-slate-200 space-y-4"&gt;
            &lt;div className="flex items-center justify-between border-b border-slate-100 pb-3"&gt;
              &lt;div className="flex items-center gap-2"&gt;
                &lt;div className="w-8 h-8 rounded-xl bg-orange-100 text-[#F47721] flex items-center justify-center font-bold"&gt;
                  &lt;Percent className="w-4 h-4" /&gt;
                &lt;/div&gt;
                &lt;h3 className="font-bold text-sm text-[#172554]"&gt;تفاصيل العمولة والأرباح&lt;/h3&gt;
              &lt;/div&gt;
              &lt;button
                onClick={() =&gt; setIsCommissionModalOpen(false)}
                className="w-7 h-7 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center hover:bg-slate-200"
              &gt;
                &lt;X className="w-4 h-4" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            &lt;div className="space-y-2.5 text-xs"&gt;
              &lt;div className="p-3 bg-slate-50 rounded-2xl border border-slate-200/80 flex items-center justify-between"&gt;
                &lt;span className="text-slate-600"&gt;نسبة عمولة منصة طلبي العامة:&lt;/span&gt;
                &lt;span className="font-extrabold text-[#172554] bg-white px-2.5 py-1 rounded-lg border border-slate-200"&gt;
                  %{pricingSettings.defaultPlatformCommissionPercent}
                &lt;/span&gt;
              &lt;/div&gt;

              &lt;div className="p-3 bg-slate-50 rounded-2xl border border-slate-200/80 flex items-center justify-between"&gt;
                &lt;span className="text-slate-600"&gt;أجرة الكابتن الأساسية لكل توصيل:&lt;/span&gt;
                &lt;span className="font-extrabold text-emerald-700 bg-white px-2.5 py-1 rounded-lg border border-slate-200"&gt;
                  {pricingSettings.defaultCourierBasePayout.toLocaleString()} د.ع
                &lt;/span&gt;
              &lt;/div&gt;

              &lt;div className="p-3 bg-orange-50/70 rounded-2xl border border-orange-200 flex items-center justify-between"&gt;
                &lt;div&gt;
                  &lt;span className="font-bold text-slate-800 block"&gt;حافز الكابتن الإضافي:&lt;/span&gt;
                  &lt;span className="text-[10px] text-slate-400"&gt;
                    {pricingSettings.isCourierBonusActive ? 'مفعل من قبل إدارة المنصة' : 'غير مفعل حالياً'}
                  &lt;/span&gt;
                &lt;/div&gt;
                &lt;span className="font-extrabold text-[#F47721] bg-white px-2.5 py-1 rounded-lg border border-orange-200"&gt;
                  {pricingSettings.isCourierBonusActive
                    ? `+${pricingSettings.defaultCourierBonus.toLocaleString()} د.ع`
                    : '0 د.ع'}
                &lt;/span&gt;
              &lt;/div&gt;

              &lt;div className="p-3 bg-slate-100 rounded-2xl text-[11px] text-slate-600 space-y-1"&gt;
                &lt;p className="font-bold text-slate-800"&gt;كيف تُحسب مستحقاتك؟&lt;/p&gt;
                &lt;p&gt;يحصل الكابتن على مستحقات التوصيل كاملة (أجرة التوصيل + الحافز) مباشرة في محفظته فور تأكيد التسليم دون أي استقطاع عمولة من حصتك.&lt;/p&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;button
              onClick={() =&gt; setIsCommissionModalOpen(false)}
              className="w-full py-2.5 bg-[#172554] text-white rounded-xl font-bold text-xs shadow-sm hover:bg-slate-900"
            &gt;
              إغلاق
            &lt;/button&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ================= 7. DRAWER: CAPTAIN PROFILE &amp; SETTINGS (TOP-RIGHT MENU) ================= */}
      {isProfileDrawerOpen &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 flex items-start justify-end bg-black/60 backdrop-blur-xs animate-fadeIn"&gt;
          &lt;div className="bg-white h-full w-full max-w-xs p-5 shadow-2xl flex flex-col justify-between overflow-y-auto"&gt;
            &lt;div className="space-y-4"&gt;
              &lt;div className="flex items-center justify-between border-b border-slate-100 pb-3"&gt;
                &lt;h3 className="font-bold text-sm text-[#172554]"&gt;الملف الشخصي للكابتن&lt;/h3&gt;
                &lt;button
                  onClick={() =&gt; setIsProfileDrawerOpen(false)}
                  className="w-7 h-7 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center"
                &gt;
                  &lt;X className="w-4 h-4" /&gt;
                &lt;/button&gt;
              &lt;/div&gt;

              {/* Courier Profile Info */}
              &lt;div className="text-center space-y-2"&gt;
                &lt;div className="w-16 h-16 rounded-3xl bg-gradient-to-tr from-[#172554] to-[#F47721] text-white flex items-center justify-center font-black text-xl mx-auto shadow-md"&gt;
                  {currentCourier.name.charAt(0)}
                &lt;/div&gt;
                &lt;h4 className="font-bold text-sm text-slate-900"&gt;{currentCourier.name}&lt;/h4&gt;
                &lt;p className="text-xs text-slate-400 font-mono" dir="ltr"&gt;
                  {currentCourier.phone}
                &lt;/p&gt;

                &lt;div className="flex items-center justify-center gap-1 text-amber-500 font-bold text-xs"&gt;
                  &lt;Star className="w-4 h-4 fill-amber-400 text-amber-400" /&gt;
                  &lt;span&gt;{currentCourier.rating}&lt;/span&gt;
                  &lt;span className="text-slate-400 font-normal"&gt;({currentCourier.ratingCount || 142} تقييم)&lt;/span&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Vehicle &amp; Fleet Info */}
              &lt;div className="bg-slate-50 p-3.5 rounded-2xl border border-slate-200 text-xs space-y-2"&gt;
                &lt;div className="flex justify-between"&gt;
                  &lt;span className="text-slate-500"&gt;نوع المركبة:&lt;/span&gt;
                  &lt;span className="font-bold text-slate-800"&gt;{currentCourier.vehicleType}&lt;/span&gt;
                &lt;/div&gt;
                &lt;div className="flex justify-between"&gt;
                  &lt;span className="text-slate-500"&gt;رقم اللوحة:&lt;/span&gt;
                  &lt;span className="font-bold font-mono text-slate-800"&gt;{currentCourier.vehiclePlate}&lt;/span&gt;
                &lt;/div&gt;
                &lt;div className="flex justify-between"&gt;
                  &lt;span className="text-slate-500"&gt;إجمالي التوصيلات:&lt;/span&gt;
                  &lt;span className="font-bold text-[#F47721]"&gt;{currentCourier.totalDeliveries} طلب ناجح&lt;/span&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Switch Courier (For testing other fleet members) */}
              &lt;div className="space-y-1.5"&gt;
                &lt;label className="block text-[11px] font-bold text-slate-500"&gt;
                  تبديل الكابتن (للتجربة والمحاكاة)
                &lt;/label&gt;
                &lt;select
                  value={selectedCourierId}
                  onChange={(e) =&gt; setSelectedCourierId(e.target.value)}
                  className="w-full p-2.5 rounded-xl border border-slate-200 bg-white text-xs font-bold text-slate-800"
                &gt;
                  {couriers.map((c) =&gt; (
                    &lt;option key={c.id} value={c.id}&gt;
                      {c.name} ({c.vehicleType})
                    &lt;/option&gt;
                  ))}
                &lt;/select&gt;
              &lt;/div&gt;

              {/* Ratings List Modal trigger */}
              &lt;button
                onClick={() =&gt; setShowReviewsModal(true)}
                className="w-full py-2.5 bg-amber-50 hover:bg-amber-100 text-amber-800 rounded-xl font-bold text-xs border border-amber-200 flex items-center justify-center gap-1.5 transition-colors"
              &gt;
                &lt;Star className="w-3.5 h-3.5 fill-amber-500" /&gt;
                &lt;span&gt;عرض تقييمات وآراء الزبائن عني&lt;/span&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            &lt;div className="space-y-2 pt-4 border-t border-slate-100"&gt;
              &lt;button
                onClick={() =&gt; setRole('customer')}
                className="w-full py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 rounded-xl font-bold text-xs transition-colors"
              &gt;
                العودة لتطبيق الزبون
              &lt;/button&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ================= 8. MODAL: INCENTIVES &amp; EARNINGS ================= */}
      {isIncentivesModalOpen &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs animate-fadeIn"&gt;
          &lt;div className="bg-white rounded-3xl max-w-sm w-full p-5 shadow-2xl border border-slate-200 space-y-4"&gt;
            &lt;div className="flex items-center justify-between border-b border-slate-100 pb-3"&gt;
              &lt;div className="flex items-center gap-2"&gt;
                &lt;div className="w-8 h-8 rounded-xl bg-orange-100 text-[#F47721] flex items-center justify-center font-bold"&gt;
                  &lt;Gift className="w-4 h-4" /&gt;
                &lt;/div&gt;
                &lt;h3 className="font-bold text-sm text-[#172554]"&gt;الحوافز ومكافآت التوصيل&lt;/h3&gt;
              &lt;/div&gt;
              &lt;button
                onClick={() =&gt; setIsIncentivesModalOpen(false)}
                className="w-7 h-7 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center hover:bg-slate-200"
              &gt;
                &lt;X className="w-4 h-4" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            &lt;div className="space-y-3 text-xs"&gt;
              &lt;div className="bg-gradient-to-r from-orange-50 to-amber-50 p-3.5 rounded-2xl border border-orange-200 space-y-1"&gt;
                &lt;div className="flex items-center justify-between font-bold text-[#172554]"&gt;
                  &lt;span&gt;حافز إضافي على كل طلب:&lt;/span&gt;
                  &lt;span className="text-[#F47721] text-sm font-black"&gt;
                    {pricingSettings.isCourierBonusActive
                      ? `+${pricingSettings.defaultCourierBonus.toLocaleString()} د.ع`
                      : 'غير مفعل'}
                  &lt;/span&gt;
                &lt;/div&gt;
                &lt;p className="text-[10px] text-slate-500"&gt;
                  {pricingSettings.isCourierBonusActive
                    ? 'يضاف تلقائياً مع كل عملية توصيل ناجحة لتشجيع الكباتن في أوقات الذروة.'
                    : 'يتم تفعيل الحافز من قبل إدارة المنصة في أوقات الذروة.'}
                &lt;/p&gt;
              &lt;/div&gt;

              &lt;div className="p-3 bg-slate-50 rounded-2xl border border-slate-200 text-xs space-y-2"&gt;
                &lt;div className="flex justify-between"&gt;
                  &lt;span className="text-slate-600"&gt;التوصيلات المنجزة اليوم:&lt;/span&gt;
                  &lt;span className="font-bold text-slate-900"&gt;4 رحلات&lt;/span&gt;
                &lt;/div&gt;
                &lt;div className="flex justify-between"&gt;
                  &lt;span className="text-slate-600"&gt;أرباح اليوم التقديرية:&lt;/span&gt;
                  &lt;span className="font-bold text-emerald-700"&gt;14,000 د.ع&lt;/span&gt;
                &lt;/div&gt;
                &lt;div className="flex justify-between border-t border-slate-200 pt-1.5 font-bold"&gt;
                  &lt;span className="text-slate-800"&gt;إجمالي رصيد المحفظة:&lt;/span&gt;
                  &lt;span className="text-[#F47721]"&gt;{currentCourier.walletBalance.toLocaleString()} د.ع&lt;/span&gt;
                &lt;/div&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;button
              onClick={() =&gt; setIsIncentivesModalOpen(false)}
              className="w-full py-2.5 bg-[#172554] text-white rounded-xl font-bold text-xs hover:bg-slate-900"
            &gt;
              حسناً، فهمت
            &lt;/button&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ================= 9. MODAL: MAP API &amp; GPS SETUP EXPLANATION ================= */}
      {showMapInfoModal &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs animate-fadeIn"&gt;
          &lt;div className="bg-white rounded-3xl max-w-md w-full p-5 shadow-2xl border border-slate-200 space-y-4"&gt;
            &lt;div className="flex items-center justify-between border-b border-slate-100 pb-3"&gt;
              &lt;div className="flex items-center gap-2"&gt;
                &lt;Compass className="w-5 h-5 text-[#F47721]" /&gt;
                &lt;h3 className="font-bold text-sm text-[#172554]"&gt;إعداد الخرائط الحقيقية وGPS&lt;/h3&gt;
              &lt;/div&gt;
              &lt;button
                onClick={() =&gt; setShowMapInfoModal(false)}
                className="w-7 h-7 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center"
              &gt;
                &lt;X className="w-4 h-4" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            &lt;div className="text-xs text-slate-600 space-y-3 leading-relaxed"&gt;
              &lt;div className="p-3 bg-emerald-50 border border-emerald-200 rounded-2xl text-emerald-900 space-y-1"&gt;
                &lt;p className="font-bold"&gt;الخريطة الحقيقية تعمل حالياً بدون أي تكلفة:&lt;/p&gt;
                &lt;p className="text-[11px]"&gt;
                  التطبيق مدمج مع طبقات OpenStreetMap الحقيقية عالية الدقة لمدن العراق (بغداد، أربيل، البصرة)، وتعمل فوراً للمعاينة والتوصيل بدون الحاجة إلى إدخال بطاقة بنكية.
                &lt;/p&gt;
              &lt;/div&gt;

              &lt;div className="p-3 bg-slate-50 border border-slate-200 rounded-2xl space-y-1"&gt;
                &lt;p className="font-bold text-slate-800"&gt;لربط Google Maps Platform الرسمية في الإنتاج:&lt;/p&gt;
                &lt;ol className="list-decimal list-inside text-[11px] text-slate-500 space-y-1 pr-1"&gt;
                  &lt;li&gt;إنشاء مشروع في Google Cloud Console وتفعيل Maps JavaScript API.&lt;/li&gt;
                  &lt;li&gt;توليد مفتاح API Key وتقييده بنطاق التطبيق الخاص بك.&lt;/li&gt;
                  &lt;li&gt;تعيين المتغير &lt;code className="bg-slate-200 px-1 py-0.5 rounded font-mono text-slate-800"&gt;VITE_GOOGLE_MAPS_API_KEY&lt;/code&gt; في ملف البيئة.&lt;/li&gt;
                &lt;/ol&gt;
              &lt;/div&gt;

              &lt;div className="p-3 bg-orange-50 border border-orange-200 rounded-2xl text-orange-950 text-[11px] space-y-1"&gt;
                &lt;p className="font-bold"&gt;تحديد موقع GPS الحقيقي:&lt;/p&gt;
                &lt;p&gt;
                  يستخدم التطبيق Geolocation API للوصول إلى إحداثيات GPS الحقيقية لهاتفك، ويقوم بفحص دقة الإشارة والتحقق من الحدود الجغرافية للعراق ومزامنة موقع الكابتن والزبون عبر Firebase Firestore.
                &lt;/p&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;button
              onClick={() =&gt; setShowMapInfoModal(false)}
              className="w-full py-2.5 bg-[#172554] text-white rounded-xl font-bold text-xs"
            &gt;
              إغلاق
            &lt;/button&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ================= 10. MODAL: COURIER REVIEWS ================= */}
      {showReviewsModal &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-xs animate-fadeIn"&gt;
          &lt;div className="bg-white rounded-3xl max-w-md w-full p-5 shadow-2xl border border-slate-200 space-y-4 max-h-[85vh] flex flex-col"&gt;
            &lt;div className="flex items-center justify-between border-b border-slate-100 pb-3"&gt;
              &lt;div className="flex items-center gap-2"&gt;
                &lt;Star className="w-5 h-5 fill-amber-400 text-amber-400" /&gt;
                &lt;h3 className="font-bold text-sm text-[#172554]"&gt;
                  تقييمات الزبائن للكابتن {currentCourier.name}
                &lt;/h3&gt;
              &lt;/div&gt;
              &lt;button
                onClick={() =&gt; setShowReviewsModal(false)}
                className="w-7 h-7 rounded-full bg-slate-100 text-slate-500 flex items-center justify-center"
              &gt;
                &lt;X className="w-4 h-4" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;

            &lt;div className="flex-1 overflow-y-auto space-y-2.5"&gt;
              {courierRatings.map((r) =&gt; (
                &lt;div key={r.id} className="p-3 bg-slate-50 rounded-2xl border border-slate-200 text-xs space-y-1.5"&gt;
                  &lt;div className="flex items-center justify-between"&gt;
                    &lt;span className="font-bold text-slate-800"&gt;{r.customerName}&lt;/span&gt;
                    &lt;div className="flex items-center text-amber-400"&gt;
                      {Array.from({ length: 5 }).map((_, i) =&gt; (
                        &lt;Star
                          key={i}
                          className={`w-3 h-3 ${
                            i &lt; (r.courierRating || 5) ? 'fill-amber-400 text-amber-400' : 'text-slate-200'
                          }`}
                        /&gt;
                      ))}
                    &lt;/div&gt;
                  &lt;/div&gt;
                  {r.courierComment &amp;&amp; (
                    &lt;p className="text-[11px] text-slate-600 bg-white p-2 rounded-xl border border-slate-100"&gt;
                      "{r.courierComment}"
                    &lt;/p&gt;
                  )}
                  {r.courierTags &amp;&amp; r.courierTags.length &gt; 0 &amp;&amp; (
                    &lt;div className="flex flex-wrap gap-1"&gt;
                      {r.courierTags.map((tag, ti) =&gt; (
                        &lt;span key={ti} className="text-[9px] bg-amber-50 text-amber-800 px-2 py-0.5 rounded-full font-bold"&gt;
                          {tag}
                        &lt;/span&gt;
                      ))}
                    &lt;/div&gt;
                  )}
                &lt;/div&gt;
              ))}

              {courierRatings.length === 0 &amp;&amp; (
                &lt;p className="text-center py-8 text-xs text-slate-400"&gt;لا توجد تقييمات للكابتن بعد.&lt;/p&gt;
              )}
            &lt;/div&gt;

            &lt;button
              onClick={() =&gt; setShowReviewsModal(false)}
              className="w-full py-2.5 bg-slate-100 text-slate-700 rounded-xl font-bold text-xs hover:bg-slate-200"
            &gt;
              إغلاق
            &lt;/button&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* ================= 11. IN-APP SUPPORT CHAT MODAL ================= */}
      &lt;InAppSupportChatModal
        isOpen={isSupportChatOpen}
        onClose={() =&gt; setIsSupportChatOpen(false)}
        relatedOrderId={activeOrder?.id}
      /&gt;
    &lt;/div&gt;
  );
};

// Simple Icon wrapper for arrived alert
const BellRingIcon = ({ className }: { className?: string }) =&gt; (
  &lt;svg className={className} viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"&gt;
    &lt;path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9" /&gt;
    &lt;path d="M10.3 21a1.94 1.94 0 0 0 3.4 0" /&gt;
    &lt;path d="M4 2C2.8 3.7 2 5.7 2 8" /&gt;
    &lt;path d="M22 8c0-2.3-.8-4.3-2-6" /&gt;
  &lt;/svg&gt;
);
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/courier/RegisterCourierModal.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000057306&#65533;15267721203&#65533;021207&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import React, { useState } from 'react';
import {
  X,
  Bike,
  User,
  Phone,
  MapPin,
  Upload,
  CheckCircle,
  AlertCircle,
  ShieldCheck,
  FileText,
  Clock,
  Sparkles,
  Car,
} from 'lucide-react';
import { useApp } from '../../context/AppContext';
import { LocationCoordinates } from '../../types';
import RealInteractiveMap from '../common/RealInteractiveMap';

interface RegisterCourierModalProps {
  isOpen: boolean;
  onClose: () =&gt; void;
}

const VEHICLE_TYPES = [
  { id: 'دراجة نارية (ماطور)', label: 'دراجة نارية (ماطور)', icon: Bike },
  { id: 'سيارة صالون / خصوصي', label: 'سيارة خصوصي', icon: Car },
  { id: 'سكوتر كهربائي', label: 'سكوتر كهربائي', icon: Bike },
  { id: 'دراجة هوائية (بايسكل)', label: 'دراجة هوائية', icon: Bike },
];

const RegisterCourierModal: React.FC&lt;RegisterCourierModalProps&gt; = ({ isOpen, onClose }) =&gt; {
  const { submitCourierApplication, uploadImageFile, currentUser } = useApp();

  const [fullName, setFullName] = useState(currentUser?.name || '');
  const [phone, setPhone] = useState(currentUser?.phone || '0770');
  const [city, setCity] = useState('بغداد');
  const [neighborhood, setNeighborhood] = useState('المنصور واليرموك');
  const [address, setAddress] = useState('');
  const [vehicleType, setVehicleType] = useState('دراجة نارية (ماطور)');
  const [vehiclePlate, setVehiclePlate] = useState('');
  const [vehicleModel, setVehicleModel] = useState('');

  // Documents
  const [driverLicenseImg, setDriverLicenseImg] = useState&lt;string&gt;('');
  const [nationalIdImg, setNationalIdImg] = useState&lt;string&gt;('');
  const [vehicleRegImg, setVehicleRegImg] = useState&lt;string&gt;('');
  const [profilePhotoImg, setProfilePhotoImg] = useState&lt;string&gt;('');

  const [coordinates, setCoordinates] = useState&lt;LocationCoordinates&gt;({
    lat: 33.3152,
    lng: 44.3661,
  });

  const [isSubmitting, setIsSubmitting] = useState(false);
  const [submittedSuccess, setSubmittedSuccess] = useState(false);
  const [errorMsg, setErrorMsg] = useState&lt;string | null&gt;(null);

  if (!isOpen) return null;

  const handleFileUpload = async (
    file: File,
    setter: (val: string) =&gt; void
  ) =&gt; {
    try {
      const base64 = await uploadImageFile(file);
      setter(base64);
    } catch (err) {
      console.error('File upload error', err);
      setErrorMsg('تعذر رفع المستند، يرجى التأكد من أن حجم الصورة مناسب');
    }
  };

  const handleSubmit = async (e: React.FormEvent) =&gt; {
    e.preventDefault();
    setErrorMsg(null);

    if (!fullName.trim() || fullName.trim().length &lt; 4) {
      setErrorMsg('يرجى إدخال الاسم الثلاثي الكامل للكابتن');
      return;
    }
    if (!phone.trim() || phone.length &lt; 10) {
      setErrorMsg('يرجى إدخال رقم هاتف عراقي فعال للتواصل وتفعيل الحساب');
      return;
    }
    if (!vehiclePlate.trim()) {
      setErrorMsg('يرجى إدخال رقم لوحة المركبة أو رقم التعريف');
      return;
    }

    setIsSubmitting(true);

    try {
      const res = await submitCourierApplication({
        fullName: fullName.trim(),
        phone: phone.trim(),
        city,
        address: `${city} - ${neighborhood}، ${address.trim()}`,
        vehicleType,
        vehiclePlate: vehiclePlate.trim(),
        vehicleModel: vehicleModel.trim() || undefined,
        coordinates,
        applicantUserId: currentUser?.id,
        documents: {
          driverLicenseUrl: driverLicenseImg || undefined,
          nationalIdUrl: nationalIdImg || undefined,
          vehicleRegistrationUrl: vehicleRegImg || undefined,
          profilePhotoUrl: profilePhotoImg || undefined,
        },
      });

      if (res.success) {
        setSubmittedSuccess(true);
      } else {
        setErrorMsg(res.error || 'تعذر تسجيل الطلب، يرجى المحاولة لاحقاً');
      }
    } catch (err: any) {
      setErrorMsg(err.message || 'حدث خطأ غير متوقع');
    } finally {
      setIsSubmitting(false);
    }
  };

  const handleResetAndClose = () =&gt; {
    setSubmittedSuccess(false);
    setErrorMsg(null);
    onClose();
  };

  return (
    &lt;div className="fixed inset-0 z-50 overflow-y-auto bg-slate-900/70 backdrop-blur-sm flex items-center justify-center p-3 sm:p-6" dir="rtl"&gt;
      &lt;div className="bg-white rounded-2xl shadow-2xl max-w-2xl w-full border border-slate-100 overflow-hidden transform transition-all flex flex-col max-h-[92vh]"&gt;
        {/* Header */}
        &lt;div className="bg-gradient-to-l from-slate-900 via-indigo-950 to-blue-900 p-5 text-white flex items-center justify-between relative"&gt;
          &lt;div className="flex items-center gap-3"&gt;
            &lt;div className="w-12 h-12 rounded-xl bg-orange-500/20 border border-orange-500/40 backdrop-blur-md flex items-center justify-center shadow-inner text-orange-400"&gt;
              &lt;Bike className="w-6 h-6" /&gt;
            &lt;/div&gt;
            &lt;div&gt;
              &lt;div className="flex items-center gap-2"&gt;
                &lt;h3 className="text-xl font-black text-white"&gt;انضم ككابتن توصيل TALABI&lt;/h3&gt;
                &lt;span className="bg-orange-500 text-white text-[11px] font-bold px-2.5 py-0.5 rounded-full"&gt;
                  فرصة عمل حرة
                &lt;/span&gt;
              &lt;/div&gt;
              &lt;p className="text-slate-300 text-xs mt-0.5"&gt;
                أجور توصيل مميزة + حوافز إضافية وحرية اختيار أوقات العمل
              &lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;
          &lt;button
            onClick={handleResetAndClose}
            className="w-9 h-9 rounded-full bg-white/10 hover:bg-white/25 flex items-center justify-center transition text-white"
          &gt;
            &lt;X className="w-5 h-5" /&gt;
          &lt;/button&gt;
        &lt;/div&gt;

        {/* Body */}
        &lt;div className="p-5 sm:p-6 overflow-y-auto flex-1 space-y-5"&gt;
          {submittedSuccess ? (
            &lt;div className="py-8 text-center space-y-4"&gt;
              &lt;div className="w-16 h-16 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center mx-auto shadow-sm"&gt;
                &lt;CheckCircle className="w-10 h-10 animate-bounce" /&gt;
              &lt;/div&gt;
              &lt;h4 className="text-xl font-black text-slate-800"&gt;
                تم استلام طلب انضمامك ككابتن بنجاح!
              &lt;/h4&gt;
              &lt;div className="bg-amber-50 border border-amber-200 rounded-xl p-4 text-sm text-amber-900 max-w-md mx-auto leading-relaxed text-right space-y-2"&gt;
                &lt;div className="flex items-center gap-2 font-bold text-amber-800"&gt;
                  &lt;Clock className="w-4 h-4 text-amber-600" /&gt;
                  &lt;span&gt;الحالة الحالية: بانتظار موافقة المدير&lt;/span&gt;
                &lt;/div&gt;
                &lt;p className="text-xs text-amber-700"&gt;
                  تم تسجيل ملفك ورفع المستندات بنجاح. سيقوم مشرف العمليات بالتحقق من صحة المستندات واعتماد الحساب. فور الموافقة، ستتمكن من تسجيل الدخول وتفعيل حالة الاتصال واستلام الطلبات وتوليد الأرباح.
                &lt;/p&gt;
              &lt;/div&gt;

              &lt;div className="pt-4 flex justify-center"&gt;
                &lt;button
                  type="button"
                  onClick={handleResetAndClose}
                  className="px-6 py-2.5 bg-blue-900 hover:bg-blue-800 text-white font-bold rounded-xl shadow-md transition"
                &gt;
                  فهمت، شكراً لك
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/div&gt;
          ) : (
            &lt;form onSubmit={handleSubmit} className="space-y-4"&gt;
              {errorMsg &amp;&amp; (
                &lt;div className="p-3 bg-red-50 border border-red-200 rounded-xl flex items-center gap-2.5 text-xs text-red-700 font-semibold"&gt;
                  &lt;AlertCircle className="w-4 h-4 flex-shrink-0 text-red-500" /&gt;
                  &lt;span&gt;{errorMsg}&lt;/span&gt;
                &lt;/div&gt;
              )}

              {/* Status Notice */}
              &lt;div className="bg-slate-50 border border-slate-200 rounded-xl p-3 flex items-start gap-3 text-xs text-slate-700"&gt;
                &lt;ShieldCheck className="w-4 h-4 text-emerald-600 flex-shrink-0 mt-0.5" /&gt;
                &lt;div&gt;
                  &lt;span className="font-bold text-slate-900"&gt;شروط القبول والسرية: &lt;/span&gt;
                  يخضع جميع الكباتن للتدقيق الإداري والموافقة المسبقة لحماية الزبائن والمطاعم. لا يمكن فتح الاتصال أو استقبال الطلبات قبل صدور قرار الاعتماد.
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Personal Info */}
              &lt;div className="grid grid-cols-1 sm:grid-cols-2 gap-3.5"&gt;
                &lt;div&gt;
                  &lt;label className="block text-xs font-bold text-slate-700 mb-1"&gt;
                    الاسم الثلاثي الكامل &lt;span className="text-red-500"&gt;*&lt;/span&gt;
                  &lt;/label&gt;
                  &lt;div className="relative"&gt;
                    &lt;User className="w-4 h-4 text-slate-400 absolute right-3 top-3" /&gt;
                    &lt;input
                      type="text"
                      required
                      value={fullName}
                      onChange={(e) =&gt; setFullName(e.target.value)}
                      placeholder="مثال: علي حسن كاظم"
                      className="w-full pr-9 pl-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-400 focus:outline-none"
                    /&gt;
                  &lt;/div&gt;
                &lt;/div&gt;

                &lt;div&gt;
                  &lt;label className="block text-xs font-bold text-slate-700 mb-1"&gt;
                    رقم الهاتف الفعال &lt;span className="text-red-500"&gt;*&lt;/span&gt;
                  &lt;/label&gt;
                  &lt;div className="relative"&gt;
                    &lt;Phone className="w-4 h-4 text-slate-400 absolute right-3 top-3" /&gt;
                    &lt;input
                      type="tel"
                      required
                      value={phone}
                      onChange={(e) =&gt; setPhone(e.target.value)}
                      placeholder="0770XXXXXXX"
                      className="w-full pr-9 pl-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-400 focus:outline-none font-mono"
                    /&gt;
                  &lt;/div&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Vehicle Selection */}
              &lt;div&gt;
                &lt;label className="block text-xs font-bold text-slate-700 mb-1.5"&gt;
                  نوع وسيلة التوصيل &lt;span className="text-red-500"&gt;*&lt;/span&gt;
                &lt;/label&gt;
                &lt;div className="grid grid-cols-2 sm:grid-cols-4 gap-2"&gt;
                  {VEHICLE_TYPES.map((v) =&gt; {
                    const Icon = v.icon;
                    const isSelected = vehicleType === v.id;
                    return (
                      &lt;button
                        key={v.id}
                        type="button"
                        onClick={() =&gt; setVehicleType(v.id)}
                        className={`p-2.5 rounded-xl border text-center flex flex-col items-center gap-1.5 transition ${
                          isSelected
                            ? 'bg-blue-50 border-blue-600 text-blue-900 font-bold shadow-sm'
                            : 'bg-white border-slate-200 text-slate-600 hover:bg-slate-50'
                        }`}
                      &gt;
                        &lt;Icon className={`w-5 h-5 ${isSelected ? 'text-blue-600' : 'text-slate-400'}`} /&gt;
                        &lt;span className="text-[11px]"&gt;{v.label}&lt;/span&gt;
                      &lt;/button&gt;
                    );
                  })}
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Vehicle Plate &amp; Model */}
              &lt;div className="grid grid-cols-1 sm:grid-cols-2 gap-3.5"&gt;
                &lt;div&gt;
                  &lt;label className="block text-xs font-bold text-slate-700 mb-1"&gt;
                    رقم اللوحة / تسجيل المركبة &lt;span className="text-red-500"&gt;*&lt;/span&gt;
                  &lt;/label&gt;
                  &lt;input
                    type="text"
                    required
                    value={vehiclePlate}
                    onChange={(e) =&gt; setVehiclePlate(e.target.value)}
                    placeholder="مثال: بغداد 24519 ف"
                    className="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-400 focus:outline-none font-mono"
                  /&gt;
                &lt;/div&gt;

                &lt;div&gt;
                  &lt;label className="block text-xs font-bold text-slate-700 mb-1"&gt;
                    طراز وموديل المركبة
                  &lt;/label&gt;
                  &lt;input
                    type="text"
                    value={vehicleModel}
                    onChange={(e) =&gt; setVehicleModel(e.target.value)}
                    placeholder="مثال: هوندا كليك 2022"
                    className="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-400 focus:outline-none"
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Location */}
              &lt;div className="grid grid-cols-1 sm:grid-cols-2 gap-3.5"&gt;
                &lt;div&gt;
                  &lt;label className="block text-xs font-bold text-slate-700 mb-1"&gt;المدينة&lt;/label&gt;
                  &lt;input
                    type="text"
                    value={city}
                    onChange={(e) =&gt; setCity(e.target.value)}
                    className="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-400 focus:outline-none"
                  /&gt;
                &lt;/div&gt;
                &lt;div&gt;
                  &lt;label className="block text-xs font-bold text-slate-700 mb-1"&gt;
                    المناطق المفضلة للتوصيل
                  &lt;/label&gt;
                  &lt;input
                    type="text"
                    value={neighborhood}
                    onChange={(e) =&gt; setNeighborhood(e.target.value)}
                    placeholder="مثال: المنصور، اليرموك، الحارثية"
                    className="w-full px-3 py-2 text-sm border border-slate-200 rounded-xl focus:ring-2 focus:ring-blue-400 focus:outline-none"
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Interactive Location Pin */}
              &lt;div className="space-y-1.5"&gt;
                &lt;div className="flex items-center justify-between"&gt;
                  &lt;label className="block text-xs font-bold text-slate-700"&gt;
                    نقطة التواجد الأساسية / السكن على الخريطة
                  &lt;/label&gt;
                  &lt;span className="text-[11px] text-slate-400 font-mono"&gt;
                    {coordinates.lat.toFixed(4)}, {coordinates.lng.toFixed(4)}
                  &lt;/span&gt;
                &lt;/div&gt;
                &lt;div className="h-40 rounded-xl overflow-hidden border border-slate-200 shadow-inner"&gt;
                  &lt;RealInteractiveMap
                    destinationCoords={coordinates}
                    isInteractivePicker={true}
                    onCoordinateSelect={(coords: LocationCoordinates) =&gt; setCoordinates(coords)}
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Required Documents Upload */}
              &lt;div className="space-y-2 pt-2 border-t border-slate-100"&gt;
                &lt;div className="flex items-center justify-between"&gt;
                  &lt;label className="text-xs font-bold text-slate-800 flex items-center gap-1.5"&gt;
                    &lt;FileText className="w-4 h-4 text-blue-600" /&gt;
                    &lt;span&gt;المستندات والوثائق الرسمية (صورة واضحة)&lt;/span&gt;
                  &lt;/label&gt;
                  &lt;span className="text-[11px] text-slate-400"&gt;تُحفظ في بيئة مشفرة وآمنة&lt;/span&gt;
                &lt;/div&gt;

                &lt;div className="grid grid-cols-2 sm:grid-cols-4 gap-2.5"&gt;
                  {/* Driver License */}
                  &lt;div className="border border-slate-200 rounded-xl p-2.5 bg-slate-50 flex flex-col items-center justify-between text-center gap-2"&gt;
                    &lt;span className="text-[11px] font-bold text-slate-700"&gt;إجازة السوق&lt;/span&gt;
                    {driverLicenseImg ? (
                      &lt;div className="relative group w-full h-14 rounded-lg overflow-hidden border border-emerald-300"&gt;
                        &lt;img src={driverLicenseImg} alt="License" className="w-full h-full object-cover" /&gt;
                        &lt;span className="absolute bottom-0 inset-x-0 bg-emerald-600 text-white text-[9px] py-0.5"&gt;تم الرفع&lt;/span&gt;
                      &lt;/div&gt;
                    ) : (
                      &lt;label className="cursor-pointer w-full py-2 bg-white hover:bg-slate-100 text-slate-600 border border-dashed border-slate-300 rounded-lg text-[10px] font-bold flex flex-col items-center gap-1"&gt;
                        &lt;Upload className="w-3.5 h-3.5 text-blue-500" /&gt;
                        &lt;span&gt;رفع الإجازة&lt;/span&gt;
                        &lt;input
                          type="file"
                          accept="image/*"
                          className="hidden"
                          onChange={(e) =&gt; {
                            const f = e.target.files?.[0];
                            if (f) handleFileUpload(f, setDriverLicenseImg);
                          }}
                        /&gt;
                      &lt;/label&gt;
                    )}
                  &lt;/div&gt;

                  {/* National ID */}
                  &lt;div className="border border-slate-200 rounded-xl p-2.5 bg-slate-50 flex flex-col items-center justify-between text-center gap-2"&gt;
                    &lt;span className="text-[11px] font-bold text-slate-700"&gt;البطاقة الوطنية&lt;/span&gt;
                    {nationalIdImg ? (
                      &lt;div className="relative group w-full h-14 rounded-lg overflow-hidden border border-emerald-300"&gt;
                        &lt;img src={nationalIdImg} alt="ID" className="w-full h-full object-cover" /&gt;
                        &lt;span className="absolute bottom-0 inset-x-0 bg-emerald-600 text-white text-[9px] py-0.5"&gt;تم الرفع&lt;/span&gt;
                      &lt;/div&gt;
                    ) : (
                      &lt;label className="cursor-pointer w-full py-2 bg-white hover:bg-slate-100 text-slate-600 border border-dashed border-slate-300 rounded-lg text-[10px] font-bold flex flex-col items-center gap-1"&gt;
                        &lt;Upload className="w-3.5 h-3.5 text-blue-500" /&gt;
                        &lt;span&gt;رفع الهوية&lt;/span&gt;
                        &lt;input
                          type="file"
                          accept="image/*"
                          className="hidden"
                          onChange={(e) =&gt; {
                            const f = e.target.files?.[0];
                            if (f) handleFileUpload(f, setNationalIdImg);
                          }}
                        /&gt;
                      &lt;/label&gt;
                    )}
                  &lt;/div&gt;

                  {/* Vehicle Registration */}
                  &lt;div className="border border-slate-200 rounded-xl p-2.5 bg-slate-50 flex flex-col items-center justify-between text-center gap-2"&gt;
                    &lt;span className="text-[11px] font-bold text-slate-700"&gt;سنوية المركبة&lt;/span&gt;
                    {vehicleRegImg ? (
                      &lt;div className="relative group w-full h-14 rounded-lg overflow-hidden border border-emerald-300"&gt;
                        &lt;img src={vehicleRegImg} alt="Vehicle Reg" className="w-full h-full object-cover" /&gt;
                        &lt;span className="absolute bottom-0 inset-x-0 bg-emerald-600 text-white text-[9px] py-0.5"&gt;تم الرفع&lt;/span&gt;
                      &lt;/div&gt;
                    ) : (
                      &lt;label className="cursor-pointer w-full py-2 bg-white hover:bg-slate-100 text-slate-600 border border-dashed border-slate-300 rounded-lg text-[10px] font-bold flex flex-col items-center gap-1"&gt;
                        &lt;Upload className="w-3.5 h-3.5 text-blue-500" /&gt;
                        &lt;span&gt;رفع السنوية&lt;/span&gt;
                        &lt;input
                          type="file"
                          accept="image/*"
                          className="hidden"
                          onChange={(e) =&gt; {
                            const f = e.target.files?.[0];
                            if (f) handleFileUpload(f, setVehicleRegImg);
                          }}
                        /&gt;
                      &lt;/label&gt;
                    )}
                  &lt;/div&gt;

                  {/* Profile Photo */}
                  &lt;div className="border border-slate-200 rounded-xl p-2.5 bg-slate-50 flex flex-col items-center justify-between text-center gap-2"&gt;
                    &lt;span className="text-[11px] font-bold text-slate-700"&gt;صورة شخصية&lt;/span&gt;
                    {profilePhotoImg ? (
                      &lt;div className="relative group w-full h-14 rounded-lg overflow-hidden border border-emerald-300"&gt;
                        &lt;img src={profilePhotoImg} alt="Profile" className="w-full h-full object-cover" /&gt;
                        &lt;span className="absolute bottom-0 inset-x-0 bg-emerald-600 text-white text-[9px] py-0.5"&gt;تم الرفع&lt;/span&gt;
                      &lt;/div&gt;
                    ) : (
                      &lt;label className="cursor-pointer w-full py-2 bg-white hover:bg-slate-100 text-slate-600 border border-dashed border-slate-300 rounded-lg text-[10px] font-bold flex flex-col items-center gap-1"&gt;
                        &lt;Upload className="w-3.5 h-3.5 text-blue-500" /&gt;
                        &lt;span&gt;صورة الكابتن&lt;/span&gt;
                        &lt;input
                          type="file"
                          accept="image/*"
                          className="hidden"
                          onChange={(e) =&gt; {
                            const f = e.target.files?.[0];
                            if (f) handleFileUpload(f, setProfilePhotoImg);
                          }}
                        /&gt;
                      &lt;/label&gt;
                    )}
                  &lt;/div&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* Submit Buttons */}
              &lt;div className="pt-3 border-t border-slate-100 flex items-center justify-end gap-2.5"&gt;
                &lt;button
                  type="button"
                  onClick={handleResetAndClose}
                  className="px-4 py-2.5 text-xs font-bold text-slate-600 hover:bg-slate-100 rounded-xl transition"
                &gt;
                  إلغاء
                &lt;/button&gt;
                &lt;button
                  type="submit"
                  disabled={isSubmitting}
                  className="px-6 py-2.5 bg-slate-900 hover:bg-slate-800 disabled:opacity-50 text-white text-xs font-bold rounded-xl shadow-md transition flex items-center gap-2"
                &gt;
                  {isSubmitting ? (
                    &lt;&gt;
                      &lt;div className="w-4 h-4 border-2 border-white border-t-transparent rounded-full animate-spin" /&gt;
                      &lt;span&gt;جاري إرسال الطلب...&lt;/span&gt;
                    &lt;/&gt;
                  ) : (
                    &lt;&gt;
                      &lt;Bike className="w-4 h-4 text-orange-400" /&gt;
                      &lt;span&gt;تقديم طلب الانضمام ككابتن&lt;/span&gt;
                    &lt;/&gt;
                  )}
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/form&gt;
          )}
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
};

export default RegisterCourierModal;
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/layout/&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000755&#65533;0000000&#65533;0000000&#65533;00000000000&#65533;15267721203&#65533;014207&#65533; 5&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/components/layout/Header.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000033136&#65533;15267721203&#65533;016145&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import React, { useState } from 'react';
import { useApp } from '../../context/AppContext';
import { UserRole } from '../../types';
import { PhoneAuthModal } from '../common/PhoneAuthModal';
import {
  ShoppingBag,
  Store,
  Bike,
  ShieldAlert,
  Headphones,
  Smartphone,
  Monitor,
  Wifi,
  WifiOff,
  Clock,
  LogIn,
  LogOut,
  Database,
  Cloud,
  CheckCircle,
  Phone,
} from 'lucide-react';

export const Header: React.FC = () =&gt; {
  const {
    role,
    setRole,
    currentUser,
    users,
    switchUser,
    isMobileFrame,
    setIsMobileFrame,
    isSimulatedOffline,
    setIsSimulatedOffline,
    orders,
    couriers,
    conversations,
    setActiveTrackedOrderId,
    firebaseUser,
    signInWithGoogle,
    signOut,
    firestoreConnected,
  } = useApp();

  const [showDbModal, setShowDbModal] = useState(false);
  const [showPhoneModal, setShowPhoneModal] = useState(false);

  const rolesConfig: { id: UserRole; title: string; subtitle: string; icon: React.ReactNode }[] = [
    {
      id: 'customer',
      title: 'الزبون',
      subtitle: 'طلب الطعام والمقاضي',
      icon: &lt;ShoppingBag className="w-4 h-4" /&gt;,
    },
    {
      id: 'merchant',
      title: 'المطعم / الماركت',
      subtitle: 'إدارة الطلبات والمنيو',
      icon: &lt;Store className="w-4 h-4" /&gt;,
    },
    {
      id: 'courier',
      title: 'المندوب',
      subtitle: 'استلام وتوصيل الطلبات',
      icon: &lt;Bike className="w-4 h-4" /&gt;,
    },
    {
      id: 'admin',
      title: 'المدير',
      subtitle: 'غرفة العمليات والمراقبة',
      icon: &lt;ShieldAlert className="w-4 h-4" /&gt;,
    },
    {
      id: 'support',
      title: 'الدعم الفني',
      subtitle: 'محادثات خدمة العملاء',
      icon: &lt;Headphones className="w-4 h-4" /&gt;,
    },
  ];

  // Badges calculations
  const customerActiveOrders = orders.filter((o) =&gt; o.status !== 'delivered' &amp;&amp; o.status !== 'cancelled');
  const merchantPendingOrders = orders.filter((o) =&gt; o.status === 'created' || o.status === 'merchant_accepted');
  const courierDeliverable = orders.filter((o) =&gt; o.status === 'ready_for_pickup' &amp;&amp; !o.courierId);
  const openSupportTickets = conversations.filter((c) =&gt; c.status === 'open');

  return (
    &lt;header className="sticky top-0 z-40 bg-[#172554] text-white border-b border-slate-800 shadow-md"&gt;
      {/* Offline Simulation warning banner */}
      {isSimulatedOffline &amp;&amp; (
        &lt;div className="bg-rose-600 text-white text-xs py-1 px-4 text-center font-bold flex items-center justify-center gap-2"&gt;
          &lt;WifiOff className="w-3.5 h-3.5" /&gt;
          &lt;span&gt;تنبيه: أنت في وضع محاكاة انقطاع الإنترنت (Offline Mode). اضغط لإعادة الاتصال بالخادم.&lt;/span&gt;
          &lt;button
            onClick={() =&gt; setIsSimulatedOffline(false)}
            className="underline mr-2 bg-white/20 px-2 py-0.5 rounded text-[11px]"
          &gt;
            إلغاء المحاكاة
          &lt;/button&gt;
        &lt;/div&gt;
      )}

      &lt;div className="max-w-7xl mx-auto px-3 sm:px-6 py-2.5 flex flex-wrap items-center justify-between gap-3"&gt;
        {/* Logo and Tagline */}
        &lt;div className="flex items-center gap-3"&gt;
          &lt;div className="flex items-center gap-2"&gt;
            &lt;div className="w-9 h-9 rounded-xl bg-gradient-to-tr from-[#F47721] to-amber-500 flex items-center justify-center shadow-lg shadow-orange-950/40"&gt;
              &lt;span className="text-white font-extrabold text-lg"&gt;ط&lt;/span&gt;
            &lt;/div&gt;
            &lt;div&gt;
              &lt;div className="flex items-center gap-1.5"&gt;
                &lt;span className="font-extrabold text-lg tracking-tight text-white"&gt;طلبي&lt;/span&gt;
                &lt;span className="text-xs font-bold text-orange-400 bg-orange-500/20 px-1.5 py-0.5 rounded border border-orange-500/30"&gt;
                  TALABI
                &lt;/span&gt;
                {/* Cloud DB indicator */}
                &lt;button
                  onClick={() =&gt; setShowDbModal(true)}
                  className="hidden lg:flex items-center gap-1 text-[10px] bg-emerald-500/20 text-emerald-300 border border-emerald-500/30 px-2 py-0.5 rounded-full hover:bg-emerald-500/30 transition-colors"
                  title="عرض تفاصيل قاعدة بيانات Firestore الحقيقية"
                &gt;
                  &lt;Cloud className="w-3 h-3 text-emerald-400" /&gt;
                  &lt;span&gt;Firestore مفعّل&lt;/span&gt;
                &lt;/button&gt;
              &lt;/div&gt;
              &lt;p className="text-[10px] text-slate-300 hidden sm:block"&gt;كلشي تريده، لحد بابك • أسرع • أسهل • أوفر&lt;/p&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;

        {/* Roles Navigation Pill Switcher */}
        &lt;nav className="flex items-center gap-1 p-1 bg-slate-900/80 rounded-xl border border-slate-700/60 overflow-x-auto max-w-full"&gt;
          {rolesConfig.map((r) =&gt; {
            const isActive = role === r.id;
            let badgeCount = 0;
            if (r.id === 'customer') badgeCount = customerActiveOrders.length;
            if (r.id === 'merchant') badgeCount = merchantPendingOrders.length;
            if (r.id === 'courier') badgeCount = courierDeliverable.length;
            if (r.id === 'support') badgeCount = openSupportTickets.length;

            return (
              &lt;button
                key={r.id}
                onClick={() =&gt; setRole(r.id)}
                className={`flex items-center gap-1.5 px-2.5 py-1.5 rounded-lg text-xs font-bold transition-all relative whitespace-nowrap ${
                  isActive
                    ? 'bg-[#F47721] text-white shadow-md'
                    : 'text-slate-300 hover:text-white hover:bg-slate-800/80'
                }`}
              &gt;
                {r.icon}
                &lt;span&gt;{r.title}&lt;/span&gt;
                {badgeCount &gt; 0 &amp;&amp; (
                  &lt;span
                    className={`text-[10px] px-1.5 py-0.2 rounded-full font-black ${
                      isActive ? 'bg-white text-[#F47721]' : 'bg-orange-500 text-white'
                    }`}
                  &gt;
                    {badgeCount}
                  &lt;/span&gt;
                )}
              &lt;/button&gt;
            );
          })}
        &lt;/nav&gt;

        {/* Controls: Auth, Mobile toggle, Offline toggle */}
        &lt;div className="flex items-center gap-2"&gt;
          {/* Quick Active Order shortcut */}
          {customerActiveOrders.length &gt; 0 &amp;&amp; role === 'customer' &amp;&amp; (
            &lt;button
              onClick={() =&gt; setActiveTrackedOrderId(customerActiveOrders[0].id)}
              className="bg-emerald-600/30 text-emerald-300 border border-emerald-500/40 px-2.5 py-1 rounded-lg text-xs font-semibold flex items-center gap-1.5 hover:bg-emerald-600/40 transition-colors"
            &gt;
              &lt;Clock className="w-3.5 h-3.5 text-emerald-400 animate-spin" style={{ animationDuration: '6s' }} /&gt;
              &lt;span&gt;تتبع الطلب&lt;/span&gt;
            &lt;/button&gt;
          )}

          {/* Real Authentication button */}
          {firebaseUser ? (
            &lt;div className="flex items-center gap-1.5 bg-slate-800/90 py-1 px-2 rounded-xl border border-slate-700 text-xs"&gt;
              {firebaseUser.photoURL ? (
                &lt;img src={firebaseUser.photoURL} alt="User" className="w-5 h-5 rounded-full" /&gt;
              ) : (
                &lt;span className="w-5 h-5 rounded-full bg-orange-500 text-white flex items-center justify-center text-[10px] font-bold"&gt;
                  {firebaseUser.email?.charAt(0).toUpperCase()}
                &lt;/span&gt;
              )}
              &lt;span className="max-w-[75px] truncate text-[11px] font-medium hidden sm:inline"&gt;
                {firebaseUser.displayName || firebaseUser.email}
              &lt;/span&gt;
              &lt;button
                onClick={signOut}
                title="تسجيل الخروج"
                className="text-slate-400 hover:text-rose-400 p-0.5"
              &gt;
                &lt;LogOut className="w-3.5 h-3.5" /&gt;
              &lt;/button&gt;
            &lt;/div&gt;
          ) : (
            &lt;div className="flex items-center gap-1.5"&gt;
              &lt;button
                onClick={() =&gt; setShowPhoneModal(true)}
                className="flex items-center gap-1 px-2.5 py-1.5 rounded-xl text-xs font-bold bg-[#F47721] text-white hover:bg-orange-600 transition-colors shadow-xs"
                title="تسجيل الدخول برقم الهاتف العراقي +964 مع رمز OTP"
              &gt;
                &lt;Phone className="w-3.5 h-3.5" /&gt;
                &lt;span className="hidden sm:inline"&gt;دخول بالهاتف 🇮🇶&lt;/span&gt;
              &lt;/button&gt;

              &lt;button
                onClick={signInWithGoogle}
                className="flex items-center gap-1.5 px-2.5 py-1.5 rounded-xl text-xs font-bold bg-white text-slate-900 hover:bg-slate-100 transition-colors shadow-xs"
                title="تسجيل الدخول الحقيقي بحساب Google لحفظ طلباتك في السحابة"
              &gt;
                &lt;LogIn className="w-3.5 h-3.5 text-orange-500" /&gt;
                &lt;span className="hidden sm:inline"&gt;Google&lt;/span&gt;
              &lt;/button&gt;
            &lt;/div&gt;
          )}

          {/* Toggle Phone Frame View vs Full Responsive View */}
          &lt;button
            onClick={() =&gt; setIsMobileFrame(!isMobileFrame)}
            title={isMobileFrame ? 'تبديل إلى العرض الكامل' : 'تبديل إلى إطار هاتف أندرويد'}
            className="flex items-center gap-1 px-2 py-1.5 rounded-xl text-xs font-medium bg-slate-800 text-slate-200 hover:bg-slate-700 transition-colors border border-slate-700"
          &gt;
            {isMobileFrame ? (
              &lt;Smartphone className="w-4 h-4 text-orange-400" /&gt;
            ) : (
              &lt;Monitor className="w-4 h-4 text-sky-400" /&gt;
            )}
          &lt;/button&gt;

          {/* Network Simulator toggle */}
          &lt;button
            onClick={() =&gt; setIsSimulatedOffline(!isSimulatedOffline)}
            title={isSimulatedOffline ? 'إعادة الاتصال بالإنترنت' : 'محاكاة انقطاع الإنترنت'}
            className={`p-1.5 rounded-xl text-xs transition-colors border ${
              isSimulatedOffline
                ? 'bg-rose-700 text-white border-rose-600 animate-pulse'
                : 'bg-slate-800 text-emerald-400 border-slate-700 hover:bg-slate-700'
            }`}
          &gt;
            {isSimulatedOffline ? &lt;WifiOff className="w-4 h-4" /&gt; : &lt;Wifi className="w-4 h-4" /&gt;}
          &lt;/button&gt;
        &lt;/div&gt;
      &lt;/div&gt;

      {/* Cloud Services Modal Info */}
      {showDbModal &amp;&amp; (
        &lt;div className="fixed inset-0 z-50 flex items-center justify-center p-4 bg-black/60 backdrop-blur-sm animate-in fade-in text-slate-800"&gt;
          &lt;div className="bg-white rounded-3xl max-w-md w-full p-5 shadow-2xl space-y-4"&gt;
            &lt;div className="flex items-center justify-between border-b pb-3"&gt;
              &lt;div className="flex items-center gap-2"&gt;
                &lt;Database className="w-5 h-5 text-emerald-600" /&gt;
                &lt;h3 className="font-black text-sm text-[#172554]"&gt;تفاصيل قاعدة البيانات السحابية (Firestore)&lt;/h3&gt;
              &lt;/div&gt;
              &lt;button onClick={() =&gt; setShowDbModal(false)} className="text-slate-400 hover:text-slate-700"&gt;✕&lt;/button&gt;
            &lt;/div&gt;

            &lt;div className="space-y-2 text-xs"&gt;
              &lt;div className="p-3 bg-emerald-50 rounded-xl border border-emerald-200 text-emerald-900 space-y-1"&gt;
                &lt;div className="flex items-center gap-1.5 font-bold"&gt;
                  &lt;CheckCircle className="w-4 h-4 text-emerald-600" /&gt;
                  &lt;span&gt;تم ربط قاعدة البيانات الحقيقية وتفعيلها بنجاح:&lt;/span&gt;
                &lt;/div&gt;
                &lt;p&gt;• &lt;strong&gt;معرّف المشروع:&lt;/strong&gt; subtle-ranger-fsmzh&lt;/p&gt;
                &lt;p&gt;• &lt;strong&gt;قاعدة البيانات:&lt;/strong&gt; ai-studio-talabi-6a8714a3-14fa-4b58-aad4-fced9a57737b&lt;/p&gt;
                &lt;p&gt;• &lt;strong&gt;حالة الاتصال:&lt;/strong&gt; {firestoreConnected ? 'متصل ومحدث آنياً (Live)' : 'جاري الفحص'}&lt;/p&gt;
                &lt;p&gt;• &lt;strong&gt;خدمة المصادقة:&lt;/strong&gt; Firebase Authentication (Google Login)&lt;/p&gt;
              &lt;/div&gt;

              &lt;div className="text-slate-600 space-y-1 pt-1"&gt;
                &lt;p className="font-bold text-slate-800"&gt;المجموعات (Collections) المنشأة:&lt;/p&gt;
                &lt;p&gt;• &lt;code&gt;orders&lt;/code&gt;: لتخزين وتتبع الطلبات المباشرة بدقة مع تاريخ الحالات.&lt;/p&gt;
                &lt;p&gt;• &lt;code&gt;support_conversations&lt;/code&gt;: لمحادثات خدمة العملاء والمناديب.&lt;/p&gt;
                &lt;p&gt;• &lt;code&gt;audit_logs&lt;/code&gt;: لسجل الرقابة وتدقيق العمليات والتوقيت الزمني.&lt;/p&gt;
                &lt;p&gt;• &lt;code&gt;stores&lt;/code&gt; &amp; &lt;code&gt;products&lt;/code&gt;: لقوائم المطاعم والأصناف.&lt;/p&gt;
              &lt;/div&gt;
            &lt;/div&gt;

            &lt;div className="pt-2 border-t flex justify-end"&gt;
              &lt;button
                onClick={() =&gt; setShowDbModal(false)}
                className="px-4 py-2 bg-slate-900 text-white rounded-xl text-xs font-bold"
              &gt;
                إغلاق
              &lt;/button&gt;
            &lt;/div&gt;
          &lt;/div&gt;
        &lt;/div&gt;
      )}

      {/* Phone Auth Modal for Iraqi Phone Login */}
      &lt;PhoneAuthModal
        isOpen={showPhoneModal}
        onClose={() =&gt; setShowPhoneModal(false)}
        title="تسجيل الدخول بالهاتف العراقي (+964)"
        subtitle="أدخل رقمك العراقي لاستلام رمز التحقق OTP وتوثيق حسابك في طلبي"
      /&gt;
    &lt;/header&gt;
  );
};
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/index.css&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000000730&#65533;15267721203&#65533;012326&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;@import "tailwindcss";

@layer base {
  body {
    font-family: 'Cairo', system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
  }
}

/* Custom scrollbars for dashboard views */
::-webkit-scrollbar {
  width: 6px;
  height: 6px;
}
::-webkit-scrollbar-track {
  background: #f1f5f9;
}
::-webkit-scrollbar-thumb {
  background: #cbd5e1;
  border-radius: 9999px;
}
::-webkit-scrollbar-thumb:hover {
  background: #94a3b8;
}
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;./src/main.tsx&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;0000644&#65533;0000000&#65533;0000000&#65533;00000000237&#65533;15267721203&#65533;012173&#65533; 0&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;ustar  &#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;root&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;import {createRoot} from 'react-dom/client';
import App from './App.tsx';
import './index.css';

createRoot(document.getElementById('root')!).render(&lt;App /&gt;);
&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;&#65533;
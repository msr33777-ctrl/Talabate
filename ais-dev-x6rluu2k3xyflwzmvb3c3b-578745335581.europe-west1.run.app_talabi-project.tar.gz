            <div classname="sticky top-[102px] z-30 bg-slate-50/95 backdrop-blur-md py-2 -mx-3 px-3 overflow-x-auto scrollbar-none flex items-center gap-2">
              {storeCategoryTabs.map((cat) =&gt; (
                <button key="{cat}" ==""> setSelectedStoreCategory(cat)}
                  className={`px-3.5 py-1.5 rounded-full text-xs font-bold whitespace-nowrap transition-all ${
                    selectedStoreCategory === cat
                      ? 'bg-[#172554] text-white shadow-xs'
                      : 'bg-white text-slate-600 border border-slate-200/80 hover:bg-slate-100'
                  }`}
                &gt;
                  {cat}
                </button>
              ))}
            </div>

            {/* Dishes list: 2-column or clean cards */}
            <div classname="grid grid-cols-1 sm:grid-cols-2 gap-3">
              {filteredStoreProducts.map((prod) =&gt; (
                <div key="{prod.id}" classname="bg-white rounded-2xl p-3 border border-slate-100 shadow-xs hover:shadow-md transition-all flex gap-3 relative group">
                  {/* Dish Info */}
                  <div classname="flex-1 flex flex-col justify-between">
                    <div>
                      <h3 classname="font-bold text-xs sm:text-sm text-slate-900 leading-snug">
                        {prod.name}
                      </h3>
                      {prod.description &amp;&amp; (
                        <p classname="text-[11px] text-slate-400 line-clamp-2 mt-1 leading-relaxed">
                          {prod.description}
                        </p>
                      )}
                    </div>

                    <div classname="flex items-center justify-between mt-3 pt-2 border-t border-slate-50">
                      <div>
                        <span classname="font-extrabold text-xs sm:text-sm text-[#F47721]">
                          {prod.price.toLocaleString()} د.ع
                        </span>
                        {prod.optionGroups &amp;&amp; prod.optionGroups.length &gt; 0 &amp;&amp; (
                          <span classname="text-[9px] text-slate-400 block font-medium">خيارات متعددة</span>
                        )}
                      </div>

                      <button ==""> handleProductClick(prod)}
                        disabled={!prod.isAvailable || !currentSelectedStore.isOpen}
                        className="px-2.5 py-1.5 rounded-xl bg-orange-50 hover:bg-[#F47721] text-[#F47721] hover:text-white font-bold text-xs flex items-center gap-1 transition-all active:scale-95 disabled:opacity-40 disabled:pointer-events-none"
                      &gt;
                        <plus classname="w-3.5 h-3.5 stroke-[3]">
                        <span>إضافة</span>
                      </plus></button>
                    </div>
                  </div>

                  {/* Dish Photo */}
                  <div classname="w-24 h-24 sm:w-26 sm:h-26 rounded-xl overflow-hidden bg-slate-100 shrink-0 relative">
                    <img src="https://ais-dev-x6rluu2k3xyflwzmvb3c3b-578745335581.europe-west1.run.app/%7Bprod.imageUrl%7D" alt="{prod.name}" classname="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" ==""> {
                        (e.target as HTMLImageElement).src = 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=400&amp;auto=format&amp;fit=crop&amp;q=80';
                      }}
                    /&gt;
                    {!prod.isAvailable &amp;&amp; (
                      <div classname="absolute inset-0 bg-black/60 flex items-center justify-center p-1 text-center">
                        <span classname="text-[10px] text-white font-bold">نافد مؤقتاً</span>
                      </div>
                    )}
                  </div>
                </div>
              ))}
            </div>

            {filteredStoreProducts.length === 0 &amp;&amp; (
              <div classname="text-center py-12 bg-white rounded-2xl border border-slate-100">
                <p classname="text-xs text-slate-400">لا توجد أكلات متوفرة في هذا القسم حالياً.</p>
              </div>
            )}
          </div>
        ) : activeTab === 'home' ? (
          /* VIEW B: HOME TAB (Category Pills + 2-Column Mobile Restaurant Grid) */
          <div classname="space-y-4 animate-fadeIn">
            {/* 3. CATEGORY PILLS / CAROUSEL */}
            <div classname="overflow-x-auto scrollbar-none -mx-3 px-3 py-1 flex items-center gap-2">
              {categories.map((c) =&gt; {
                const isSelected = selectedCategory === c.filterKey;
                return (
                  <button key="{c.filterKey}" ==""> setSelectedCategory(c.filterKey)}
                    className={`flex items-center gap-1.5 px-3 py-2 rounded-2xl text-xs font-bold whitespace-nowrap transition-all ${
                      isSelected
                        ? 'bg-[#172554] text-white shadow-xs scale-[1.02]'
                        : 'bg-white text-slate-700 border border-slate-200/70 hover:bg-slate-100/70'
                    }`}
                  &gt;
                    <span classname="text-sm">{c.icon}</span>
                    <span>{c.label}</span>
                  </button>
                );
              })}
            </div>

            {/* Iraqi promotional banner chip */}
            <div classname="p-3 rounded-2xl bg-gradient-to-r from-[#172554] to-slate-800 text-white flex items-center justify-between shadow-sm">
              <div classname="flex items-center gap-2.5">
                <div classname="w-8 h-8 rounded-xl bg-[#F47721] flex items-center justify-center text-white shrink-0">
                  <flame classname="w-4 h-4">
                </flame></div>
                <div>
                  <h4 classname="font-bold text-xs">عروض الغداء والعشاء في {selectedNeighborhood}</h4>
                  <p classname="text-[10px] text-slate-300">توصيل سريع وأسعار مطابقة للمطعم مباشرة</p>
                </div>
              </div>
              <span classname="text-[10px] font-bold bg-white/10 px-2 py-1 rounded-lg">عروض حصرية</span>
            </div>

            {/* Section Header */}
            <div classname="flex items-center justify-between pt-1">
              <div>
                <h2 classname="font-black text-sm text-[#172554]">
                  {selectedCategory === 'الكل' ? 'جميع المطاعم والمتاجر' : `مطاعم: ${selectedCategory}`}
                </h2>
                <p classname="text-[10px] text-slate-400 font-medium">
                  {filteredStores.length} متجر متوفر في منطقتك
                </p>
              </div>
            </div>

            {/* 4. RESTAURANTS: 2-COLUMN GRID ON MOBILE (grid-cols-2) */}
            <div classname="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-2.5 sm:gap-3.5">
              {filteredStores.map((store) =&gt; (
                <div key="{store.id}" ==""> setActiveStoreId(store.id)}
                  className="bg-white rounded-2xl overflow-hidden border border-slate-100 shadow-xs hover:shadow-md transition-all cursor-pointer flex flex-col group relative"
                &gt;
                  {/* Cover Photo */}
                  <div classname="aspect-[4/3] w-full bg-slate-100 relative overflow-hidden">
                    <img src="https://ais-dev-x6rluu2k3xyflwzmvb3c3b-578745335581.europe-west1.run.app/%7Bstore.banner%7D" alt="{store.name}" classname="w-full h-full object-cover group-hover:scale-105 transition-transform duration-300" ==""> {
                        (e.target as HTMLImageElement).src = 'https://images.unsplash.com/photo-1555396273-367ea4eb4db5?w=500&amp;auto=format&amp;fit=crop&amp;q=80';
                      }}
                    /&gt;
                    <div classname="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent">

                    {/* Logo Overlay */}
                    <div classname="absolute top-2 right-2">
                      <img src="https://ais-dev-x6rluu2k3xyflwzmvb3c3b-578745335581.europe-west1.run.app/%7Bstore.logo%7D" alt="{store.name}" classname="w-7 h-7 sm:w-8 sm:h-8 rounded-full object-cover border-2 border-white shadow-sm bg-white" ==""> {
                          (e.target as HTMLImageElement).src = 'https://images.unsplash.com/photo-1568901346375-23c9450c58cd?w=100&amp;auto=format&amp;fit=crop&amp;q=80';
                        }}
                      /&gt;
                    </div>

                    {/* Open / Closed badge */}
                    <div classname="absolute top-2 left-2">
                      <span classname="{`text-[9px]" font-bold="" px-1.5="" py-0.5="" rounded-md="" backdrop-blur-md="" ${="" store.isopen="" ?="" 'bg-emerald-500="" 90="" text-white'="" :="" 'bg-rose-500="" }`}="">
                        {store.isOpen ? 'مفتوح' : 'مغلق'}
                      </span>
                    </div>

                    {/* Delivery Time Overlay */}
                    <div classname="absolute bottom-1.5 right-2 flex items-center gap-1 text-[10px] text-white font-semibold drop-shadow-sm">
                      <clock classname="w-3 h-3 text-[#F47721]">
                      <span>{store.deliveryTimeEstimate}</span>
                    </clock></div>
                  </div>

                  {/* Card Content */}
                  <div classname="p-2 sm:p-2.5 flex-1 flex flex-col justify-between">
                    <div>
                      <h3 classname="font-bold text-xs sm:text-sm text-slate-900 truncate leading-snug">
                        {store.name}
                      </h3>
                      <p classname="text-[10px] text-slate-400 truncate mt-0.5">
                        {store.category}
                      </p>
                    </div>

                    <div classname="mt-2 pt-2 border-t border-slate-50 flex items-center justify-between text-[10px]">
                      {/* Rating */}
                      <div classname="flex items-center gap-1 font-bold text-slate-800">
                        <star classname="w-3 h-3 fill-amber-400 text-amber-400">
                        <span>{store.rating.toFixed(1)}</span>
                        <span classname="text-slate-400 font-normal">({store.ratingCount})</span>
                      </star></div>

                      {/* Delivery Fee */}
                      <div classname="font-bold text-[#F47721]">
                        {store.deliveryFee === 0 ? 'توصيل مجاني' : `${store.deliveryFee.toLocaleString()} د.ع`}
                      </div>
                    </div>
                  </div>
                </div>
              ))}
            </div>

            {filteredStores.length === 0 &amp;&amp; (
              <div classname="text-center py-12 bg-white rounded-2xl border border-slate-100">
                <p classname="text-xs text-slate-400">لا توجد متاجر تطابق بحثك حالياً.</p>
                <button ==""> {
                    setSelectedCategory('الكل');
                    setSearchQuery('');
                  }}
                  className="mt-2 text-xs font-bold text-[#F47721]"
                &gt;
                  إعادة تعيين الفلاتر
                </button>
              </div>
            )}
          </div>
        ) : activeTab === 'search' ? (
          /* VIEW C: SEARCH TAB */
          <div classname="space-y-4 animate-fadeIn">
            <div>
              <h2 classname="font-black text-sm text-[#172554]">نتائج البحث الشامل</h2>
              <p classname="text-[11px] text-slate-400">
                {searchQuery ? `البحث عن: "${searchQuery}"` : 'اكتب في مربع البحث بالأعلى لتصفح الأكلات والمتاجر'}
              </p>
            </div>

            {/* Quick chips if no search */}
            {!searchQuery &amp;&amp; (
              <div classname="bg-white p-4 rounded-2xl border border-slate-100 space-y-3">
                <h4 classname="font-bold text-xs text-slate-700">الأكثر طلباً في بغداد</h4>
                <div classname="flex flex-wrap gap-2">
                  {['كباب عراقي', 'سماش برغر', 'بيتزا حطب', 'قوزي الشام', 'أرز عنبر', 'حلاوة دهينة', 'لبن أربيل'].map(
                    (term) =&gt; (
                      <button key="{term}" ==""> setSearchQuery(term)}
                        className="px-3 py-1.5 rounded-full bg-slate-100 hover:bg-orange-50 hover:text-[#F47721] text-xs font-semibold text-slate-700 transition-colors"
                      &gt;
                        {term}
                      </button>
                    )
                  )}
                </div>
              </div>
            )}

            {/* Matched Dishes */}
            {searchMatchedProducts.length &gt; 0 &amp;&amp; (
              <div classname="space-y-2">
                <h3 classname="font-bold text-xs text-slate-700">الأكلات والمنتجات المطابقة ({searchMatchedProducts.length})</h3>
                <div classname="grid grid-cols-1 sm:grid-cols-2 gap-2.5">
                  {searchMatchedProducts.map((p) =&gt; {
                    const store = stores.find((s) =&gt; s.id === p.storeId);
                    return (
                      <div key="{p.id}" classname="bg-white p-3 rounded-2xl border border-slate-100 flex items-center justify-between gap-3 shadow-xs hover:shadow-md transition-all">
                        <div classname="flex items-center gap-2.5">
                          <img src="https://ais-dev-x6rluu2k3xyflwzmvb3c3b-578745335581.europe-west1.run.app/%7Bp.imageUrl%7D" alt="{p.name}" classname="w-14 h-14 rounded-xl object-cover shrink-0" ==""> {
                              (e.target as HTMLImageElement).src = 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=200&amp;auto=format&amp;fit=crop&amp;q=80';
                            }}
                          /&gt;
                          <div>
                            <h4 classname="font-bold text-xs text-slate-900">{p.name}</h4>
                            <span classname="text-[10px] text-slate-400 block">{store?.name}</span>
                            <span classname="text-xs font-bold text-[#F47721] block mt-0.5">
                              {p.price.toLocaleString()} د.ع
                            </span>
                          </div>
                        </div>

                        <button ==""> handleProductClick(p)}
                          className="px-2.5 py-1.5 rounded-xl bg-orange-50 hover:bg-[#F47721] text-[#F47721] hover:text-white font-bold text-xs transition-colors"
                        &gt;
                          إضافة
                        </button>
                      </div>
                    );
                  })}
                </div>
              </div>
            )}

            {/* Matched Restaurants */}
            {filteredStores.length &gt; 0 &amp;&amp; searchQuery &amp;&amp; (
              <div classname="space-y-2 pt-2">
                <h3 classname="font-bold text-xs text-slate-700">المتاجر المطابقة ({filteredStores.length})</h3>
                <div classname="grid grid-cols-2 sm:grid-cols-3 gap-2.5">
                  {filteredStores.map((st) =&gt; (
                    <div key="{st.id}" ==""> setActiveStoreId(st.id)}
                      className="bg-white p-2.5 rounded-2xl border border-slate-100 cursor-pointer hover:shadow-md transition-all"
                    &gt;
                      <div classname="aspect-[4/3] rounded-xl overflow-hidden bg-slate-100 mb-2">
                        <img src="https://ais-dev-x6rluu2k3xyflwzmvb3c3b-578745335581.europe-west1.run.app/%7Bst.banner%7D" alt="{st.name}" classname="w-full h-full object-cover">
                      </div>
                      <h4 classname="font-bold text-xs text-slate-900 truncate">{st.name}</h4>
                      <p classname="text-[10px] text-slate-400 truncate">{st.neighborhood}</p>
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        ) : activeTab === 'orders' ? (
          /* VIEW D: MY ORDERS TAB */
          <div classname="space-y-4 animate-fadeIn">
            <div>
              <h2 classname="font-black text-sm text-[#172554]">طلباتي</h2>
              <p classname="text-[11px] text-slate-400">تتبع الطلبات الحالية وسجل الطلبات السابقة</p>
            </div>

            {/* Active Orders */}
            {activeOrders.length &gt; 0 &amp;&amp; (
              <div classname="space-y-3">
                <h3 classname="font-bold text-xs text-slate-700 flex items-center gap-1.5">
                  <span classname="w-2 h-2 rounded-full bg-emerald-500 animate-pulse">
                  <span>طلبات جارية التوصيل ({activeOrders.length})</span>
                </span></h3>

                {activeOrders.map((ord) =&gt; {
                  const store = stores.find((s) =&gt; s.id === ord.storeId);
                  return (
                    <div key="{ord.id}" classname="bg-white rounded-2xl p-4 border border-orange-200 shadow-sm space-y-3">
                      <div classname="flex items-center justify-between">
                        <div>
                          <span classname="text-[10px] text-slate-400 font-mono">رقم الطلب: #{ord.id.slice(-6)}</span>
                          <h4 classname="font-bold text-sm text-slate-900">{store?.name || 'مطعم معتمد'}</h4>
                        </div>
                        <span classname="text-xs bg-orange-100 text-[#F47721] px-2.5 py-1 rounded-full font-bold">
                          {ord.status === 'preparing'
                            ? 'جاري التحضير'
                            : ord.status === 'ready_for_pickup'
                            ? 'جاهز للاستلام'
                            : ord.status === 'picked_up'
                            ? 'المندوب في الطريق'
                            : 'تم استلام الطلب'}
                        </span>
                      </div>

                      <div classname="text-xs text-slate-600 bg-slate-50 p-2.5 rounded-xl space-y-1">
                        {ord.items.map((item, idx) =&gt; (
                          <div key="{idx}" classname="flex justify-between">
                            <span>
                              {item.quantity}x {item.name}
                            </span>
                            <span classname="font-bold">{(item.price * item.quantity).toLocaleString()} د.ع</span>
                          </div>
                        ))}
                      </div>

                      <div classname="flex items-center justify-between pt-2 border-t border-slate-100">
                        <span classname="font-black text-sm text-[#172554]">
                          المجموع: {(ord.financials?.total ?? ord.total).toLocaleString()} د.ع
                        </span>

                        <button ==""> setActiveTrackedOrderId(ord.id)}
                          className="px-3.5 py-2 bg-[#F47721] hover:bg-[#e06816] text-white font-bold text-xs rounded-xl shadow-xs transition-all flex items-center gap-1.5"
                        &gt;
                          <bike classname="w-3.5 h-3.5">
                          <span>تتبع على الخريطة</span>
                        </bike></button>
                      </div>
                    </div>
                  );
                })}
              </div>
            )}

            {/* Past Orders */}
            <div classname="space-y-3 pt-2">
              <h3 classname="font-bold text-xs text-slate-700">الطلبات المكتملة والسابقة</h3>

              {pastOrders.length &gt; 0 ? (
                pastOrders.map((ord) =&gt; {
                  const store = stores.find((s) =&gt; s.id === ord.storeId);
                  const isRated = isOrderRated(ord.id);

                  return (
                    <div key="{ord.id}" classname="bg-white rounded-2xl p-3.5 border border-slate-100 shadow-xs flex items-center justify-between gap-3">
                      <div>
                        <div classname="flex items-center gap-2">
                          <h4 classname="font-bold text-xs text-slate-900">{store?.name || 'مطعم معتمد'}</h4>
                          <span classname="{`text-[9px]" px-2="" py-0.5="" rounded-full="" font-bold="" ${="" ord.status="==" 'delivered'="" ?="" 'bg-emerald-50="" text-emerald-700'="" :="" 'bg-rose-50="" text-rose-700'="" }`}="">
                            {ord.status === 'delivered' ? 'مكتمل بنجاح' : 'ملغي'}
                          </span>
                        </div>
                        <span classname="text-[10px] text-slate-400 block mt-0.5">
                          {new Date(ord.createdAt).toLocaleDateString('ar-IQ')} • {ord.items.length} أصناف
                        </span>
                        <span classname="font-extrabold text-xs text-slate-800 block mt-1">
                          {(ord.financials?.total ?? ord.total).toLocaleString()} د.ع
                        </span>
                      </div>

                      <div classname="flex flex-col gap-1.5 items-end">
                        {ord.status === 'delivered' &amp;&amp; !isRated &amp;&amp; (
                          <button ==""> setOrderForRatingModal(ord)}
                            className="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white rounded-xl text-[11px] font-bold flex items-center gap-1 shadow-xs transition-colors"
                          &gt;
                            <star classname="w-3 h-3 fill-white">
                            <span>تقييم الطلب</span>
                          </star></button>
                        )}
                        {ord.status === 'delivered' &amp;&amp; isRated &amp;&amp; (
                          <span classname="text-[10px] text-emerald-600 font-bold flex items-center gap-1">
                            <checkcircle2 classname="w-3 h-3">
                            <span>تم التقييم</span>
                          </checkcircle2></span>
                        )}
                        <button ==""> setActiveTrackedOrderId(ord.id)}
                          className="text-[11px] font-bold text-slate-500 hover:text-slate-800"
                        &gt;
                          تفاصيل الفاتورة
                        </button>
                      </div>
                    </div>
                  );
                })
              ) : (
                <div classname="text-center py-10 bg-white rounded-2xl border border-slate-100">
                  <p classname="text-xs text-slate-400">لا توجد طلبات سابقة حتى الآن.</p>
                </div>
              )}
            </div>
          </div>
        ) : (
          /* VIEW E: ACCOUNT TAB */
          <div classname="space-y-4 animate-fadeIn">
            <div>
              <h2 classname="font-black text-sm text-[#172554]">حسابي</h2>
              <p classname="text-[11px] text-slate-400">إدارة الملف الشخصي والعناوين والتحقق</p>
            </div>

            {/* Profile Card */}
            <div classname="bg-white p-4 rounded-2xl border border-slate-100 shadow-xs flex items-center justify-between">
              <div classname="flex items-center gap-3">
                <div classname="w-12 h-12 rounded-2xl bg-gradient-to-tr from-[#172554] to-[#F47721] text-white flex items-center justify-center font-black text-lg shadow-sm">
                  {currentUser.name ? currentUser.name.charAt(0) : 'ز'}
                </div>
                <div>
                  <h3 classname="font-bold text-sm text-slate-900">{customerName}</h3>
                  <p classname="text-xs text-slate-500 font-mono" dir="ltr">
                    {customerPhone}
                  </p>
                  <span classname="text-[10px] text-emerald-600 font-semibold flex items-center gap-1 mt-0.5">
                    <shieldcheck classname="w-3 h-3">
                    <span>رقم عراقي موثق (+964)</span>
                  </shieldcheck></span>
                </div>
              </div>

              <button ==""> setIsPhoneAuthOpen(true)}
                className="px-3 py-1.5 rounded-xl border border-slate-200 text-slate-700 hover:bg-slate-50 font-bold text-xs"
              &gt;
                تعديل الرقم
              </button>
            </div>

            {/* Merchant Onboarding Card */}
            <div classname="bg-gradient-to-r from-orange-50 to-amber-50 p-4 rounded-2xl border border-orange-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div classname="flex items-start gap-3">
                <div classname="w-10 h-10 rounded-xl bg-orange-500 text-white flex items-center justify-center shrink-0 shadow-xs">
                  <storeicon classname="w-5 h-5">
                </storeicon></div>
                <div>
                  <h4 classname="font-bold text-xs text-[#172554]">هل تملك مطعماً أو ماركت في العراق؟</h4>
                  <p classname="text-[11px] text-slate-600 mt-0.5">سجل متجرك الآن للانضمام لمنصة TALABI والوصول لآلاف الزبائن</p>
                </div>
              </div>
              <div classname="flex items-center gap-2 self-end sm:self-auto">
                <button ==""> setIsRegisterRestaurantOpen(true)}
                  className="px-3.5 py-2 bg-[#F47721] hover:bg-[#e06816] text-white font-bold text-xs rounded-xl shadow-xs transition-all whitespace-nowrap"
                &gt;
                  انضم كمطعم
                </button>
                <button ==""> setRole('merchant')}
                  className="px-3 py-2 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs rounded-xl border border-slate-200 transition-all whitespace-nowrap"
                &gt;
                  لوحة المطعم
                </button>
              </div>
            </div>

            {/* Courier Onboarding Card */}
            <div classname="bg-gradient-to-r from-blue-50 to-indigo-50 p-4 rounded-2xl border border-blue-200 flex flex-col sm:flex-row sm:items-center justify-between gap-3">
              <div classname="flex items-start gap-3">
                <div classname="w-10 h-10 rounded-xl bg-[#172554] text-white flex items-center justify-center shrink-0 shadow-xs">
                  <bike classname="w-5 h-5">
                </bike></div>
                <div>
                  <h4 classname="font-bold text-xs text-[#172554]">هل ترغب بالعمل ككابتن توصيل حر؟</h4>
                  <p classname="text-[11px] text-slate-600 mt-0.5">حقق دخلاً يومياً مجزياً مع أجور توصيل عادلة وحوافز إضافية</p>
                </div>
              </div>
              <div classname="flex items-center gap-2 self-end sm:self-auto">
                <button ==""> setIsRegisterCourierOpen(true)}
                  className="px-3.5 py-2 bg-[#172554] hover:bg-blue-950 text-white font-bold text-xs rounded-xl shadow-xs transition-all whitespace-nowrap"
                &gt;
                  انضم ككابتن
                </button>
                <button ==""> setRole('courier')}
                  className="px-3 py-2 bg-white hover:bg-slate-50 text-slate-700 font-bold text-xs rounded-xl border border-slate-200 transition-all whitespace-nowrap"
                &gt;
                  لوحة الكابتن
                </button>
              </div>
            </div>

            {/* Help &amp; Support */}
            <div classname="bg-white rounded-2xl border border-slate-100 overflow-hidden divide-y divide-slate-100">
              <button ==""> setIsSupportChatOpen(true)}
                className="w-full p-3.5 flex items-center justify-between text-xs font-bold text-slate-700 hover:bg-slate-50"
              &gt;
                <div classname="flex items-center gap-2">
                  <headphones classname="w-4 h-4 text-[#F47721]">
                  <span>خدمة العملاء والشكاوى المباشرة</span>
                </headphones></div>
                <chevronleft classname="w-4 h-4 text-slate-400">
              </chevronleft></button>

              <div classname="p-3.5 text-xs text-slate-500 flex justify-between items-center">
                <span>إصدار التطبيق</span>
                <span classname="font-mono text-slate-400">v2.4.0 (Iraqi Edition)</span>
              </div>
            </div>
          </div>
        )}
      </div></div></main>

      {/* 5. FLOATING CART DRAWER / BAR (when cart has items) */}
      {cart.length &gt; 0 &amp;&amp; (
        <div classname="fixed bottom-16 left-0 right-0 z-30 p-3 pointer-events-none">
          <div classname="max-w-md mx-auto pointer-events-auto">
            <button ==""> setIsCartOpen(true)}
              className="w-full bg-[#172554] hover:bg-slate-900 text-white p-3 rounded-2xl shadow-xl border border-orange-500/40 flex items-center justify-between transition-all active:scale-[0.99]"
            &gt;
              <div classname="flex items-center gap-2.5">
                <div classname="w-8 h-8 rounded-xl bg-[#F47721] text-white flex items-center justify-center font-bold text-xs">
                  {cart.reduce((a, b) =&gt; a + b.quantity, 0)}
                </div>
                <div classname="text-right">
                  <span classname="text-[11px] text-slate-300 block">عرض سلة المشتريات</span>
                  <span classname="font-extrabold text-xs text-white">
                    {cartTotal.toLocaleString()} د.ع
                  </span>
                </div>
              </div>

              <div classname="flex items-center gap-1 font-bold text-xs text-[#F47721]">
                <span>المتابعة</span>
                <chevronleft classname="w-4 h-4">
              </chevronleft></div>
            </button>
          </div>
        </div>
      )}

      {/* 6. BOTTOM NAVIGATION BAR (Home, Search, Orders, Account) */}
      <nav classname="fixed bottom-0 left-0 right-0 z-40 bg-white/95 backdrop-blur-md border-t border-slate-100 shadow-lg">
        <div classname="max-w-md mx-auto px-4 py-2 flex items-center justify-around">
          <button ==""> {
              setActiveTab('home');
              setActiveStoreId(null);
            }}
            className={`flex flex-col items-center gap-0.5 py-1 px-3 rounded-xl transition-all ${
              activeTab === 'home' &amp;&amp; !activeStoreId
                ? 'text-[#F47721] font-bold'
                : 'text-slate-400 hover:text-slate-600 font-medium'
            }`}
          &gt;
            <home classname="w-5 h-5">
            <span classname="text-[10px]">الرئيسية</span>
          </home></button>

          <button ==""> {
              setActiveTab('search');
              setActiveStoreId(null);
            }}
            className={`flex flex-col items-center gap-0.5 py-1 px-3 rounded-xl transition-all ${
              activeTab === 'search'
                ? 'text-[#F47721] font-bold'
                : 'text-slate-400 hover:text-slate-600 font-medium'
            }`}
          &gt;
            <search classname="w-5 h-5">
            <span classname="text-[10px]">البحث</span>
          </search></button>

          <button ==""> {
              setActiveTab('orders');
              setActiveStoreId(null);
            }}
            className={`flex flex-col items-center gap-0.5 py-1 px-3 rounded-xl transition-all relative ${
              activeTab === 'orders'
                ? 'text-[#F47721] font-bold'
                : 'text-slate-400 hover:text-slate-600 font-medium'
            }`}
          &gt;
            <receipt classname="w-5 h-5">
            <span classname="text-[10px]">طلباتي</span>
            {activeOrders.length &gt; 0 &amp;&amp; (
              <span classname="w-2 h-2 rounded-full bg-[#F47721] absolute top-1 right-3">
            )}
          </span></receipt></button>

          <button ==""> {
              setActiveTab('account');
              setActiveStoreId(null);
            }}
            className={`flex flex-col items-center gap-0.5 py-1 px-3 rounded-xl transition-all ${
              activeTab === 'account'
                ? 'text-[#F47721] font-bold'
                : 'text-slate-400 hover:text-slate-600 font-medium'
            }`}
          &gt;
            <usericon classname="w-5 h-5">
            <span classname="text-[10px]">حسابي</span>
          </usericon></button>
        </div>
      </nav>

      {/* 7. CART SLIDE-OVER MODAL */}
      {isCartOpen &amp;&amp; (
        <div classname="fixed inset-0 z-50 flex items-end sm:items-center justify-center p-0 sm:p-4 bg-black/60 backdrop-blur-xs animate-fadeIn">
          <div classname="w-full sm:max-w-md bg-white rounded-t-3xl sm:rounded-2xl max-h-[88vh] flex flex-col shadow-2xl overflow-hidden border border-slate-100">
            {/* Header */}
            <div classname="p-4 border-b border-slate-100 flex items-center justify-between">
              <div classname="flex items-center gap-2">
                <shoppingbag classname="w-5 h-5 text-[#F47721]">
                <h3 classname="font-black text-sm text-[#172554]">سلة المشتريات</h3>
                <span classname="text-xs bg-slate-100 text-slate-600 px-2 py-0.5 rounded-full font-bold">
                  {cart.reduce((a, b) =&gt; a + b.quantity, 0)} أصناف
                </span>
              </shoppingbag></div>
              <button ==""> setIsCartOpen(false)}
                className="w-8 h-8 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center hover:bg-slate-200"
              &gt;
                <x classname="w-4 h-4">
              </x></button>
            </div>

            {/* Cart Items list */}
            <div classname="flex-1 overflow-y-auto p-4 space-y-3 divide-y divide-slate-100">
              {cart.map((item, idx) =&gt; (
                <div key="{idx}" classname="pt-3 first:pt-0 flex items-start justify-between gap-3">
                  <div classname="flex-1">
                    <h4 classname="font-bold text-xs text-slate-900">{item.name}</h4>
                    {/* Render Selected Option Groups */}
                    {item.selectedOptionGroups &amp;&amp; item.selectedOptionGroups.length &gt; 0 ? (
                      <div classname="text-[10px] text-slate-500 mt-0.5 space-y-0.5">
                        {item.selectedOptionGroups.map((g, gi) =&gt; (
                          <div key="{gi}" classname="flex items-center gap-1">
                            <span classname="text-slate-400">{g.groupTitle}:</span>
                            <span classname="font-medium text-slate-700">
                              {g.selectedItems.map((si) =&gt; si.name).join('، ')}
                            </span>
                          </div>
                        ))}
                      </div>
                    ) : item.selectedOptions &amp;&amp; item.selectedOptions.length &gt; 0 ? (
                      <p classname="text-[10px] text-slate-400 mt-0.5">
                        {item.selectedOptions.map((o) =&gt; o.name).join('، ')}
                      </p>
                    ) : null}

                    {item.notes &amp;&amp; (
                      <p classname="text-[10px] text-orange-600 mt-0.5 font-medium">ملاحظة: {item.notes}</p>
                    )}
                    <span classname="text-xs font-extrabold text-slate-800 block mt-1">
                      {(item.price * item.quantity).toLocaleString()} د.ع
                    </span>
                  </div>

                  <div classname="flex items-center gap-2 bg-slate-100 px-2 py-1 rounded-xl">
                    <button ==""> updateCartQuantity(idx, item.quantity - 1)}
                      className="text-slate-600 hover:text-rose-600 p-0.5"
                    &gt;
                      {item.quantity === 1 ? <trash2 classname="w-3.5 h-3.5"> : <minus classname="w-3.5 h-3.5">}
                    </minus></trash2></button>
                    <span classname="text-xs font-black min-w-4 text-center">{item.quantity}</span>
                    <button ==""> updateCartQuantity(idx, item.quantity + 1)}
                      className="text-slate-600 hover:text-orange-600 p-0.5"
                    &gt;
                      <plus classname="w-3.5 h-3.5">
                    </plus></button>
                  </div>
                </div>
              ))}
            </div>

            {/* Summary &amp; Checkout Button */}
            <div classname="p-4 bg-slate-50 border-t border-slate-100 space-y-2 text-xs">
              <div classname="flex justify-between text-slate-600">
                <span>المجموع الفرعي:</span>
                <span classname="font-bold">{cartSubtotal.toLocaleString()} د.ع</span>
              </div>
              <div classname="flex justify-between text-slate-600">
                <span>أجرة التوصيل:</span>
                <span classname="font-bold">{cartDeliveryFee.toLocaleString()} د.ع</span>
              </div>
              <div classname="flex justify-between text-slate-600">
                <span>رسوم تشغيل النظام:</span>
                <span classname="font-bold">1,000 د.ع</span>
              </div>
              <div classname="flex justify-between text-sm font-black text-[#172554] pt-2 border-t border-slate-200">
                <span>المجموع الإجمالي:</span>
                <span classname="text-[#F47721]">{cartTotal.toLocaleString()} د.ع</span>
              </div>

              <button ==""> {
                  setIsCartOpen(false);
                  setIsCheckoutOpen(true);
                }}
                className="w-full mt-3 py-3 bg-[#F47721] hover:bg-[#e06816] text-white rounded-xl font-extrabold text-xs shadow-md transition-all flex items-center justify-center gap-2 active:scale-[0.99]"
              &gt;
                <span>المتابعة إلى العنوان وتحديد الدفع</span>
                <chevronleft classname="w-4 h-4">
              </chevronleft></button>
            </div>
          </div>
        </div>
      )}

      {/* 8. CHECKOUT MODAL */}
      {isCheckoutOpen &amp;&amp; (
        <div classname="fixed inset-0 z-50 flex items-center justify-center p-3 bg-black/65 backdrop-blur-xs overflow-y-auto animate-fadeIn">
          <div classname="bg-white rounded-3xl w-full max-w-lg shadow-2xl border border-slate-100 flex flex-col max-h-[92vh] overflow-y-auto my-auto text-slate-800">
            <div classname="sticky top-0 bg-white/95 backdrop-blur-md p-4 border-b border-slate-100 flex items-center justify-between">
              <h3 classname="font-black text-base text-[#172554]">إتمام الطلب وتحديد الدفع</h3>
              <button ==""> setIsCheckoutOpen(false)}
                className="w-8 h-8 rounded-full bg-slate-100 text-slate-600 flex items-center justify-center hover:bg-slate-200"
              &gt;
                <x classname="w-4 h-4">
              </x></button>
            </div>

            <div classname="p-5 space-y-4 text-xs">
              {checkoutError &amp;&amp; (
                <div classname="p-3 bg-rose-50 border border-rose-300 text-rose-700 rounded-xl flex items-center gap-2 font-bold">
                  <alertcircle classname="w-4 h-4 shrink-0">
                  <span>{checkoutError}</span>
                </alertcircle></div>
              )}

              {/* Delivery Details */}
              <div classname="space-y-3 bg-slate-50 p-4 rounded-2xl border border-slate-200">
                <h4 classname="font-bold text-slate-900 flex items-center gap-1.5">
                  <mappin classname="w-4 h-4 text-[#F47721]">
                  عنوان التوصيل في العراق
                </mappin></h4>

                <div classname="grid grid-cols-2 gap-2">
                  <div>
                    <label classname="block text-[11px] font-semibold text-slate-500 mb-1">اسم المستلم</label>
                    <input type="text" value="{customerName}" ==""> setCustomerName(e.target.value)}
                      className="w-full p-2 rounded-lg border border-slate-200 bg-white font-medium"
                    /&gt;
                  </div>
                  <div>
                    <label classname="block text-[11px] font-semibold text-slate-500 mb-1">رقم الهاتف (عراقي)</label>
                    <input type="text" value="{customerPhone}" ==""> setCustomerPhone(e.target.value)}
                      placeholder="077xxxxxxxx"
                      className="w-full p-2 rounded-lg border border-slate-200 bg-white font-medium"
                    /&gt;
                  </div>
                </div>

                <div>
                  <label classname="block text-[11px] font-semibold text-slate-500 mb-1">المنطقة والحي</label>
                  <select value="{selectedNeighborhood}" ==""> setSelectedNeighborhood(e.target.value)}
                    className="w-full p-2 rounded-lg border border-slate-200 bg-white font-medium"
                  &gt;
                    {neighborhoods.map((n) =&gt; (
                      <option key="{n}" value="{n}">
                        {n}
                      </option>
                    ))}
                  </select>
                </div>

                <div>
                  <label classname="block text-[11px] font-semibold text-slate-500 mb-1">العنوان التفصيلي / نقطة دالة</label>
                  <input type="text" value="{customerAddress}" ==""> setCustomerAddress(e.target.value)}
                    placeholder="اسم الشارع، رقم العمارة أو البيت، قرب معلم معروف"
                    className="w-full p-2 rounded-lg border border-slate-200 bg-white font-medium"
                  /&gt;
                </div>

                <div>
                  <label classname="block text-[11px] font-semibold text-slate-500 mb-1">ملاحظات للمندوب</label>
                  <input type="text" value="{deliveryNotes}" ==""> setDeliveryNotes(e.target.value)}
                    placeholder="رن الجرس، عدم الاتصال إلا عند الباب..."
                    className="w-full p-2 rounded-lg border border-slate-200 bg-white font-medium"
                  /&gt;
                </div>

                {/* Real Interactive Map */}
                <div classname="space-y-1.5 pt-2">
                  <div classname="flex items-center justify-between">
                    <label classname="block text-[11px] font-bold text-slate-700">
                      تأكيد الموقع الجغرافي الحقيقي على الخريطة
                    </label>
                    <span classname="text-[10px] text-orange-600 font-bold">
                      انقر لتعديل وتثبيت الدبوس
                    </span>
                  </div>
                  <realinteractivemap storename="{currentSelectedStore?.name" ||="" stores[0].name}="" storeaddress="{currentSelectedStore?.address" stores[0].address}="" customeraddress="{`${selectedNeighborhood}" -="" ${customeraddress}`}="" customercoordinates="{customerCoords}" ==""> setCustomerCoords(c)}
                    isInteractivePicker={true}
                  /&gt;
                </realinteractivemap></div>
              </div>

              {/* Payment Methods */}
              <div classname="space-y-3 bg-slate-50 p-4 rounded-2xl border border-slate-200">
                <div classname="flex items-center justify-between">
                  <h4 classname="font-bold text-slate-900 flex items-center gap-1.5">
                    <shieldcheck classname="w-4 h-4 text-emerald-600">
                    طريقة الدفع (بوابات الدفع في العراق)
                  </shieldcheck></h4>
                  <span classname="text-[10px] text-slate-500">مشفرة وآمنة</span>
                </div>

                <div classname="grid grid-cols-1 sm:grid-cols-2 gap-2">
                  <label classname="{`p-3" rounded-xl="" border="" flex="" items-center="" gap-2="" cursor-pointer="" transition-all="" ${="" paymentmethod="==" 'zain_cash'="" ?="" 'border-orange-500="" bg-orange-50="" 80="" font-bold="" text-orange-950="" shadow-xs'="" :="" 'border-slate-200="" bg-white="" hover:bg-slate-50="" text-slate-700'="" }`}="">
                    <input type="radio" name="payment" checked="{paymentMethod" =="=" 'zain_cash'}=""> setPaymentMethod('zain_cash')}
                      className="accent-[#F47721]"
                    /&gt;
                    <smartphone classname="w-4 h-4 text-orange-500">
                    <div>
                      <p classname="text-xs">محفظة زين كاش</p>
                      <p classname="text-[10px] text-slate-400 font-normal">Zain Cash Iraq</p>
                    </div>
                  </smartphone></label>

                  <label classname="{`p-3" rounded-xl="" border="" flex="" items-center="" gap-2="" cursor-pointer="" transition-all="" ${="" paymentmethod="==" 'qi_card'="" ?="" 'border-orange-500="" bg-orange-50="" 80="" font-bold="" text-orange-950="" shadow-xs'="" :="" 'border-slate-200="" bg-white="" hover:bg-slate-50="" text-slate-700'="" }`}="">
                    <input type="radio" name="payment" checked="{paymentMethod" =="=" 'qi_card'}=""> setPaymentMethod('qi_card')}
                      className="accent-[#F47721]"
                    /&gt;
                    <creditcard classname="w-4 h-4 text-sky-600">
                    <div>
                      <p classname="text-xs">بطاقة كي كارد / ماستر</p>
                      <p classname="text-[10px] text-slate-400 font-normal">Qi Card Payment</p>
                    </div>
                  </creditcard></label>

                  <label classname="{`p-3" rounded-xl="" border="" flex="" items-center="" gap-2="" cursor-pointer="" transition-all="" ${="" paymentmethod="==" 'asia_pay'="" ?="" 'border-orange-500="" bg-orange-50="" 80="" font-bold="" text-orange-950="" shadow-xs'="" :="" 'border-slate-200="" bg-white="" hover:bg-slate-50="" text-slate-700'="" }`}="">
                    <input type="radio" name="payment" checked="{paymentMethod" =="=" 'asia_pay'}=""> setPaymentMethod('asia_pay')}
                      className="accent-[#F47721]"
                    /&gt;
                    <smartphone classname="w-4 h-4 text-purple-600">
                    <div>
                      <p classname="text-xs">آسيا حوالة / FastPay</p>
                      <p classname="text-[10px] text-slate-400 font-normal">محفظة رقمية</p>
                    </div>
                  </smartphone></label>

                  <label classname="{`p-3" rounded-xl="" border="" flex="" items-center="" gap-2="" cursor-pointer="" transition-all="" ${="" paymentmethod="==" 'cash_on_delivery'="" ?="" 'border-orange-500="" bg-orange-50="" 80="" font-bold="" text-orange-950="" shadow-xs'="" :="" 'border-slate-200="" bg-white="" hover:bg-slate-50="" text-slate-700'="" }`}="">
                    <input type="radio" name="payment" checked="{paymentMethod" =="=" 'cash_on_delivery'}=""> setPaymentMethod('cash_on_delivery')}
                      className="accent-[#F47721]"
                    /&gt;
                    <banknote classname="w-4 h-4 text-emerald-600">
                    <div>
                      <p classname="text-xs">نقد عند الاستلام (COD)</p>
                      <p classname="text-[10px] text-slate-400 font-normal">الدفع كاش للمندوب</p>
                    </div>
                  </banknote></label>
                </div>
              </div>

              {/* Total Display */}
              <div classname="bg-slate-100 p-3.5 rounded-2xl flex items-center justify-between font-bold">
                <span classname="text-slate-700">المبلغ الإجمالي المستحق:</span>
                <span classname="text-base font-black text-[#F47721]">{cartTotal.toLocaleString()} د.ع</span>
              </div>
            </div>

            <div classname="p-4 bg-slate-50 border-t border-slate-100 flex items-center gap-3">
              <button ==""> setIsCheckoutOpen(false)}
                className="px-4 py-2.5 rounded-xl border border-slate-300 text-slate-700 font-bold text-xs hover:bg-slate-100"
              &gt;
                تعديل السلة
              </button>

              <button disabled="{isSubmittingOrder}" classname="flex-1 py-3 bg-[#F47721] hover:bg-[#e06816] text-white rounded-xl font-black text-xs shadow-lg transition-colors flex items-center justify-center gap-2 disabled:opacity-50">
                <span>المتابعة لمراجعة الطلب النهائية ({cartTotal.toLocaleString()} د.ع)</span>
                <chevronleft classname="w-4 h-4">
              </chevronleft></button>
            </div>
          </div>
        </div>
      )}

      {/* 9. FOOD CUSTOMIZATION MODAL (Sizes, Add-ons, Dynamic Price) */}
      {customizingProduct &amp;&amp; (
        <foodcustomizationmodal product="{customizingProduct}" isopen="{Boolean(customizingProduct)}" ==""> setCustomizingProduct(null)}
          onAddToCart={handleAddCustomizedToCart}
        /&gt;
      )}

      {/* 10. FINAL ORDER REVIEW MODAL (Anti-fraud &amp; Anti-duplicate check) */}
      {isFinalReviewOpen &amp;&amp; (
        <finalorderreviewmodal isopen="{isFinalReviewOpen}" ==""> setIsFinalReviewOpen(false)}
          store={currentSelectedStore || stores[0]}
          items={cart}
          customerName={customerName}
          customerPhone={customerPhone}
          address={customerAddress}
          neighborhood={selectedNeighborhood}
          notes={deliveryNotes}
          paymentMethod={paymentMethod}
          subtotal={cartSubtotal}
          deliveryFee={cartDeliveryFee}
          serviceFee={1000}
          total={cartTotal}
          coordinates={customerCoords}
          onConfirmOrder={handleConfirmFinalOrder}
          isSubmitting={isSubmittingOrder}
        /&gt;
      )}

      {/* 11. PHONE AUTH MODAL */}
      <phoneauthmodal isopen="{isPhoneAuthOpen}" ==""> setIsPhoneAuthOpen(false)}
        onVerifiedSuccess={(phone) =&gt; {
          setCustomerPhone(phone);
        }}
        title="توثيق الحساب بالرقم العراقي (+964)"
        subtitle="حماية حسابك وتفادي الطلبات الوهمية برمز OTP عبر رسالة نصية قصيرة"
      /&gt;

      {/* 12. IN-APP SUPPORT CHAT MODAL */}
      <inappsupportchatmodal isopen="{isSupportChatOpen}" ==""> setIsSupportChatOpen(false)}
        relatedOrderId={activeOrders[0]?.id}
      /&gt;

      {/* 13. ACTIVE ORDER TRACKER MODAL */}
      {activeTrackedOrderId &amp;&amp; (
        <ordertrackermodal orderid="{activeTrackedOrderId}" ==""> setActiveTrackedOrderId(null)}
        /&gt;
      )}

      {/* 14. STORE REVIEWS MODAL */}
      {selectedStoreForReviews &amp;&amp; (
        <storereviewsmodal store="{selectedStoreForReviews}" isopen="{Boolean(selectedStoreForReviews)}" ==""> setSelectedStoreForReviews(null)}
        /&gt;
      )}

      {/* 15. ORDER RATING MODAL */}
      {orderForRatingModal &amp;&amp; (
        <orderratingmodal order="{orderForRatingModal}" isopen="{Boolean(orderForRatingModal)}" ==""> setOrderForRatingModal(null)}
        /&gt;
      )}

      {/* 16. RESTAURANT REGISTRATION MODAL */}
      <registerrestaurantmodal isopen="{isRegisterRestaurantOpen}" ==""> setIsRegisterRestaurantOpen(false)}
      /&gt;

      {/* 17. COURIER REGISTRATION MODAL */}
      <registercouriermodal isopen="{isRegisterCourierOpen}" ==""> setIsRegisterCourierOpen(false)}
      /&gt;
    </registercouriermodal></registerrestaurantmodal></orderratingmodal></storereviewsmodal></ordertrackermodal></inappsupportchatmodal></phoneauthmodal></finalorderreviewmodal></foodcustomizationmodal></div>
  );
};
./src/components/customer/OrderRatingModal.tsx0000644000000000000000000004305615267721203020500 0ustar  rootrootimport React, { useState } from 'react';
import { useApp } from '../../context/AppContext';
import { Order } from '../../types';
import {
  Star,
  X,
  Store,
  Bike,
  Heart,
  MessageSquare,
  CheckCircle2,
  AlertCircle,
  Sparkles,
  Send,
} from 'lucide-react';

interface OrderRatingModalProps {
  order: Order;
  isOpen: boolean;
  onClose: () =&gt; void;
  onSuccess?: () =&gt; void;
}

const STORE_TAG_OPTIONS = [
  'طعام ساخن ولذيذ',
  'تغليف محكم وممتاز',
  'كمية وفيرة ومُشبعة',
  'طعم بغدادي أصيل',
  'توصيل أسرع من المتوقع',
  'أصناف طازجة 100%',
];

const COURIER_TAG_OPTIONS = [
  'كابتن لبق وخلوق',
  'وصل بسرعة قياسية',
  'ملتزم بالتعليمات وعنوان الباب',
  'حافظ على سخونة الطلب',
  'تعامل راقي ومحترم',
  'محافظ على سلامة الوجبة',
];

const RATING_LABELS: Record<number, string=""> = {
  1: 'تجربة سيئة جداً',
  2: 'أقل من المتوقع',
  3: 'جيد ومقبول',
  4: 'جيد جداً ولذيذ',
  5: 'ممتاز وفوق التقييم!',
};

export const OrderRatingModal: React.FC<orderratingmodalprops> = ({
  order,
  isOpen,
  onClose,
  onSuccess,
}) =&gt; {
  const { submitOrderRating, currentUser, isOrderRated } = useApp();

  const [storeRating, setStoreRating] = useState<number>(5);
  const [storeHover, setStoreHover] = useState<number |="" null="">(null);
  const [storeComment, setStoreComment] = useState('');
  const [selectedStoreTags, setSelectedStoreTags] = useState<string[]>([
    'طعام ساخن ولذيذ',
    'تغليف محكم وممتاز',
  ]);

  const [courierRating, setCourierRating] = useState<number>(order.courierId ? 5 : 0);
  const [courierHover, setCourierHover] = useState<number |="" null="">(null);
  const [courierComment, setCourierComment] = useState('');
  const [selectedCourierTags, setSelectedCourierTags] = useState<string[]>([
    'كابتن لبق وخلوق',
    'وصل بسرعة قياسية',
  ]);

  const [isSubmitting, setIsSubmitting] = useState(false);
  const [submittedSuccess, setSubmittedSuccess] = useState(false);
  const [errorMessage, setErrorMessage] = useState<string |="" null="">(null);

  if (!isOpen) return null;

  const alreadyRated = isOrderRated(order.id) || order.isRated;

  const toggleStoreTag = (tag: string) =&gt; {
    setSelectedStoreTags((prev) =&gt;
      prev.includes(tag) ? prev.filter((t) =&gt; t !== tag) : [...prev, tag]
    );
  };

  const toggleCourierTag = (tag: string) =&gt; {
    setSelectedCourierTags((prev) =&gt;
      prev.includes(tag) ? prev.filter((t) =&gt; t !== tag) : [...prev, tag]
    );
  };

  const handleSubmit = async (e: React.FormEvent) =&gt; {
    e.preventDefault();
    setErrorMessage(null);

    if (storeRating &lt; 1) {
      setErrorMessage('يرجى تحديد تقييم المطعم بنجمة واحدة على الأقل');
      return;
    }

    if (order.courierId &amp;&amp; courierRating &lt; 1) {
      setErrorMessage('يرجى تحديد تقييم الكابتن المندوب');
      return;
    }

    setIsSubmitting(true);

    const res = await submitOrderRating({
      orderId: order.id,
      customerId: currentUser.id,
      customerName: currentUser.name || order.customer.name,
      customerPhone: currentUser.phone || order.customer.phone,
      storeId: order.storeId,
      storeName: order.storeName,
      storeRating,
      storeComment: storeComment.trim() || undefined,
      storeTags: selectedStoreTags,
      courierId: order.courierId || undefined,
      courierName: order.courierName || undefined,
      courierRating: order.courierId ? courierRating : undefined,
      courierComment: courierComment.trim() || undefined,
      courierTags: selectedCourierTags,
    });

    setIsSubmitting(false);

    if (res.success) {
      setSubmittedSuccess(true);
      if (onSuccess) onSuccess();
      setTimeout(() =&gt; {
        onClose();
      }, 2000);
    } else {
      setErrorMessage(res.error || 'تعذر إرسال التقييم، يرجى المحاولة لاحقاً');
    }
  };

  return (
    <div classname="fixed inset-0 z-50 flex items-center justify-center p-3 bg-black/60 backdrop-blur-sm overflow-y-auto animate-in fade-in">
      <div classname="bg-white rounded-3xl w-full max-w-lg max-h-[92vh] overflow-y-auto shadow-2xl border border-slate-100 flex flex-col my-auto text-slate-800">
        {/* Header */}
        <div classname="sticky top-0 z-20 bg-white/95 backdrop-blur-md px-5 py-4 border-b border-slate-100 flex items-center justify-between">
          <div classname="flex items-center gap-2">
            <div classname="w-8 h-8 rounded-xl bg-orange-100 text-orange-600 flex items-center justify-center">
              <sparkles classname="w-4 h-4">
            </sparkles></div>
            <div>
              <h3 classname="font-extrabold text-base text-[#172554]">
                تقييم الطلب #{order.id}
              </h3>
              <p classname="text-[11px] text-slate-400">
                رأيك يمنح التقدير للمطاعم والمناديب المتميزين
              </p>
            </div>
          </div>
          <button classname="w-8 h-8 rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200 flex items-center justify-center transition-colors">
            <x classname="w-5 h-5">
          </x></button>
        </div>

        {/* Content */}
        <div classname="p-5 space-y-6">
          {alreadyRated ? (
            <div classname="p-8 text-center space-y-3 bg-emerald-50 rounded-3xl border border-emerald-200">
              <checkcircle2 classname="w-14 h-14 text-emerald-600 mx-auto animate-bounce">
              <h4 classname="font-black text-lg text-emerald-950">
                تم استلام تقييمك لهذا الطلب مسبقاً!
              </h4>
              <p classname="text-xs text-emerald-800 max-w-sm mx-auto leading-relaxed">
                شكراً لمشاركتك رأيك القيّم، تم تحديث متوسط تقييم متجر{' '}
                <strong>{order.storeName}</strong> والكابتن في النظام فورياً.
              </p>
              <button classname="mt-2 px-6 py-2.5 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold transition-colors">
                إغلاق النافذة
              </button>
            </checkcircle2></div>
          ) : submittedSuccess ? (
            <div classname="p-8 text-center space-y-3 bg-gradient-to-b from-orange-50 to-amber-50 rounded-3xl border border-orange-200">
              <div classname="w-16 h-16 rounded-full bg-orange-500 text-white flex items-center justify-center mx-auto shadow-lg animate-pulse">
                <heart classname="w-8 h-8 fill-white">
              </heart></div>
              <h4 classname="font-black text-xl text-[#172554]">
                عاشت إيدك! تم حفظ التقييم بنجاح
              </h4>
              <p classname="text-xs text-slate-600 max-w-sm mx-auto leading-relaxed">
                تم تحديث تقييم مطعم {order.storeName}
                {order.courierName ? ` والكابتن ${order.courierName}` : ''} فورياً في المنصة.
              </p>
              <div classname="flex justify-center gap-1 text-amber-500 pt-1">
                {[...Array(5)].map((_, i) =&gt; (
                  <star key="{i}" classname="w-5 h-5 fill-amber-500">
                ))}
              </star></div>
            </div>
          ) : (
            <form classname="space-y-6">
              {errorMessage &amp;&amp; (
                <div classname="p-3 bg-rose-50 border border-rose-200 rounded-2xl flex items-center gap-2 text-xs text-rose-700 font-bold">
                  <alertcircle classname="w-4 h-4 shrink-0">
                  <span>{errorMessage}</span>
                </alertcircle></div>
              )}

              {/* 1. Store Rating Card */}
              <div classname="p-4 rounded-3xl bg-slate-50 border border-slate-200/80 space-y-4">
                <div classname="flex items-center justify-between">
                  <div classname="flex items-center gap-2.5">
                    <div classname="w-10 h-10 rounded-2xl bg-orange-500 text-white flex items-center justify-center shadow">
                      <store classname="w-5 h-5">
                    </store></div>
                    <div>
                      <span classname="text-[10px] text-orange-600 font-bold block uppercase tracking-wider">
                        تقييم المطعم والمتجر
                      </span>
                      <h4 classname="font-black text-sm text-[#172554]">
                        {order.storeName}
                      </h4>
                    </div>
                  </div>
                  <span classname="text-xs font-bold text-amber-600 bg-amber-50 px-2.5 py-1 rounded-full border border-amber-200">
                    {RATING_LABELS[storeHover || storeRating] || ''}
                  </span>
                </div>

                {/* Stars selector */}
                <div classname="flex items-center justify-center gap-2 py-2">
                  {[1, 2, 3, 4, 5].map((star) =&gt; {
                    const active = (storeHover || storeRating) &gt;= star;
                    return (
                      <button type="button" key="{star}" ==""> setStoreRating(star)}
                        onMouseEnter={() =&gt; setStoreHover(star)}
                        onMouseLeave={() =&gt; setStoreHover(null)}
                        className="p-1 rounded-xl transition-transform hover:scale-125 focus:outline-none"
                      &gt;
                        <star classname="{`w-9" h-9="" transition-colors="" ${="" active="" ?="" 'text-amber-400="" fill-amber-400="" drop-shadow-sm'="" :="" 'text-slate-300'="" }`}="">
                      </star></button>
                    );
                  })}
                </div>

                {/* Quick Compliment Tags */}
                <div classname="space-y-2">
                  <span classname="text-xs font-bold text-slate-700 block">
                    ما الذي أعجبك في الطلب؟ (اختر ما يناسبك):
                  </span>
                  <div classname="flex flex-wrap gap-1.5">
                    {STORE_TAG_OPTIONS.map((tag) =&gt; {
                      const selected = selectedStoreTags.includes(tag);
                      return (
                        <button type="button" key="{tag}" ==""> toggleStoreTag(tag)}
                          className={`text-xs px-3 py-1.5 rounded-xl font-bold transition-all ${
                            selected
                              ? 'bg-orange-500 text-white shadow-xs'
                              : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-100'
                          }`}
                        &gt;
                          {tag}
                        </button>
                      );
                    })}
                  </div>
                </div>

                {/* Review Text */}
                <div classname="space-y-1.5 pt-1">
                  <label classname="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                    <messagesquare classname="w-3.5 h-3.5 text-orange-500">
                    رأيك للمطعم (اختياري)
                  </messagesquare></label>
                  <textarea rows="{2}" value="{storeComment}" ==""> setStoreComment(e.target.value)}
                    placeholder="مثلاً: الطعم أصيل، البهارات مضبوطة، الوجبة وصلت ساخنة..."
                    className="w-full text-xs p-3 rounded-2xl border border-slate-200 focus:outline-none focus:border-orange-500 bg-white"
                  /&gt;
                &lt;/div&gt;
              &lt;/div&gt;

              {/* 2. Courier Rating Card (if courier was assigned) */}
              {order.courierName &amp;&amp; (
                &lt;div className="p-4 rounded-3xl bg-slate-50 border border-slate-200/80 space-y-4"&gt;
                  &lt;div className="flex items-center justify-between"&gt;
                    &lt;div className="flex items-center gap-2.5"&gt;
                      &lt;div className="w-10 h-10 rounded-2xl bg-[#172554] text-white flex items-center justify-center shadow"&gt;
                        &lt;Bike className="w-5 h-5 text-orange-400" /&gt;
                      &lt;/div&gt;
                      &lt;div&gt;
                        &lt;span className="text-[10px] text-blue-600 font-bold block uppercase tracking-wider"&gt;
                          تقييم كابتن التوصيل
                        &lt;/span&gt;
                        &lt;h4 className="font-black text-sm text-[#172554]"&gt;
                          {order.courierName}
                        &lt;/h4&gt;
                      &lt;/div&gt;
                    &lt;/div&gt;
                    &lt;span className="text-xs font-bold text-amber-600 bg-amber-50 px-2.5 py-1 rounded-full border border-amber-200"&gt;
                      {RATING_LABELS[courierHover || courierRating] || ''}
                    &lt;/span&gt;
                  &lt;/div&gt;

                  {/* Stars selector */}
                  &lt;div className="flex items-center justify-center gap-2 py-2"&gt;
                    {[1, 2, 3, 4, 5].map((star) =&gt; {
                      const active = (courierHover || courierRating) &gt;= star;
                      return (
                        &lt;button
                          type="button"
                          key={star}
                          onClick={() =&gt; setCourierRating(star)}
                          onMouseEnter={() =&gt; setCourierHover(star)}
                          onMouseLeave={() =&gt; setCourierHover(null)}
                          className="p-1 rounded-xl transition-transform hover:scale-125 focus:outline-none"
                        &gt;
                          &lt;Star
                            className={`w-9 h-9 transition-colors ${
                              active
                                ? 'text-amber-400 fill-amber-400 drop-shadow-sm'
                                : 'text-slate-300'
                            }`}
                          /&gt;
                        &lt;/button&gt;
                      );
                    })}
                  &lt;/div&gt;

                  {/* Quick Compliment Tags for Courier */}
                  &lt;div className="space-y-2"&gt;
                    &lt;span className="text-xs font-bold text-slate-700 block"&gt;
                      إشادات بأداء الكابتن:
                    &lt;/span&gt;
                    &lt;div className="flex flex-wrap gap-1.5"&gt;
                      {COURIER_TAG_OPTIONS.map((tag) =&gt; {
                        const selected = selectedCourierTags.includes(tag);
                        return (
                          &lt;button
                            type="button"
                            key={tag}
                            onClick={() =&gt; toggleCourierTag(tag)}
                            className={`text-xs px-3 py-1.5 rounded-xl font-bold transition-all ${
                              selected
                                ? 'bg-[#172554] text-white shadow-xs'
                                : 'bg-white text-slate-600 border border-slate-200 hover:bg-slate-100'
                            }`}
                          &gt;
                            {tag}
                          &lt;/button&gt;
                        );
                      })}
                    &lt;/div&gt;
                  &lt;/div&gt;

                  {/* Courier Comment */}
                  &lt;div className="space-y-1.5 pt-1"&gt;
                    &lt;label className="text-xs font-bold text-slate-700 flex items-center gap-1.5"&gt;
                      &lt;MessageSquare className="w-3.5 h-3.5 text-blue-500" /&gt;
                      كلمة شكر أو ملاحظة للكابتن (اختياري)
                    &lt;/label&gt;
                    &lt;textarea
                      rows={2}
                      value={courierComment}
                      onChange={(e) =&gt; setCourierComment(e.target.value)}
                      placeholder="مثلاً: كابتن محترم جداً، وصل بسرعة وحافظ على سخونة الوجبة..."
                      className="w-full text-xs p-3 rounded-2xl border border-slate-200 focus:outline-none focus:border-blue-500 bg-white"
                    /&gt;
                  &lt;/div&gt;
                &lt;/div&gt;
              )}

              {/* Submit Button */}
              &lt;div className="pt-2"&gt;
                &lt;button
                  type="submit"
                  disabled={isSubmitting}
                  className="w-full py-3.5 px-4 bg-gradient-to-r from-orange-500 to-amber-500 hover:from-orange-600 hover:to-amber-600 text-white rounded-2xl font-black text-sm shadow-lg shadow-orange-500/25 flex items-center justify-center gap-2 transition-all disabled:opacity-50"
                &gt;
                  {isSubmitting ? (
                    &lt;span&gt;جاري حفظ وتحديث التقييم في الخادم...&lt;/span&gt;
                  ) : (
                    &lt;&gt;
                      &lt;Send className="w-4 h-4" /&gt;
                      &lt;span&gt;إرسال التقييم النهائي&lt;/span&gt;
                    &lt;/&gt;
                  )}
                &lt;/button&gt;
              &lt;/div&gt;
            &lt;/form&gt;
          )}
        &lt;/div&gt;
      &lt;/div&gt;
    &lt;/div&gt;
  );
};

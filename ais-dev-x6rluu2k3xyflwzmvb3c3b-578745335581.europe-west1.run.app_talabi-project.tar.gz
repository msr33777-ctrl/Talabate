export interface RouteDistanceResult {
  success: boolean;
  distanceKm?: number;
  durationMinutes?: number;
  routeGeometry?: any;
  serviceUsed?: 'osrm' | 'google_maps' | 'straight_line_estimate';
  error?: string;
}

// Baghdad default center (Al-Mansour)
export const DEFAULT_BAGHDAD_COORDS = { lat: 33.3130, lng: 44.3512 };

// Known neighborhood coordinate centroids in Iraq for fallback resolution
export const NEIGHBORHOOD_COORDS: Record<string, {="" lat:="" number;="" lng:="" number="" }=""> = {
  'المنصور': { lat: 33.3130, lng: 44.3512 },
  'بغداد - المنصور': { lat: 33.3130, lng: 44.3512 },
  'الكرادة': { lat: 33.3055, lng: 44.4225 },
  'بغداد - الكرادة': { lat: 33.3055, lng: 44.4225 },
  'الجادرية': { lat: 33.2842, lng: 44.3820 },
  'بغداد - الجادرية': { lat: 33.2842, lng: 44.3820 },
  'زيونة': { lat: 33.3289, lng: 44.4410 },
  'بغداد - زيونة': { lat: 33.3289, lng: 44.4410 },
  'الأعظمية': { lat: 33.3710, lng: 44.3580 },
  'بغداد - الأعظمية': { lat: 33.3710, lng: 44.3580 },
  'حي الجامعة': { lat: 33.3260, lng: 44.3210 },
  'اليرموك': { lat: 33.3005, lng: 44.3415 },
  'شارع فلسطين': { lat: 33.3450, lng: 44.4290 },
  'عينكاوة': { lat: 36.2230, lng: 43.9930 },
  'أربيل - عينكاوة': { lat: 36.2230, lng: 43.9930 },
  'العشار': { lat: 30.5085, lng: 47.8130 },
  'البصرة - العشار': { lat: 30.5085, lng: 47.8130 },
};

/**
 * Resolves coordinates for a store, using its explicit coordinates or neighborhood centroid
 */
export function getStoreCoordinates(store: Partial<store>): { lat: number; lng: number } {
  if (store.coordinates?.lat &amp;&amp; store.coordinates?.lng) {
    return { lat: store.coordinates.lat, lng: store.coordinates.lng };
  }

  const neighborhood = store.neighborhood?.trim() || '';
  if (neighborhood &amp;&amp; NEIGHBORHOOD_COORDS[neighborhood]) {
    return NEIGHBORHOOD_COORDS[neighborhood];
  }

  for (const [key, coords] of Object.entries(NEIGHBORHOOD_COORDS)) {
    if (neighborhood.includes(key) || (store.address &amp;&amp; store.address.includes(key))) {
      return coords;
    }
  }

  return DEFAULT_BAGHDAD_COORDS;
}

/**
 * Calculates delivery fee based on road distance and admin pricing settings.
 * Formula: deliveryFee = baseFee + (distanceKm * feePerKm)
 * Capped at: maxFee (cannot exceed maxFee regardless of distance)
 *
 * User specification:
 * - Default Base Fee = 1,500 IQD
 * - Default Fee Per Km = 250 IQD
 * - Default Max Fee = 5,000 IQD
 *
 * Examples:
 * 1 km = 1,750 IQD
 * 2 km = 2,000 IQD
 * 5 km = 2,750 IQD
 * 10 km = 4,000 IQD
 * 14 km = 5,000 IQD
 * 20 km = 5,000 IQD (capped)
 */
export function computeDistanceDeliveryFee(
  distanceKm: number,
  settings?: Partial<platformpricingsettings>
): number {
  const baseFee = settings?.distanceBaseFee ?? 1500;
  const feePerKm = settings?.distanceFeePerKm ?? 250;
  const maxFee = settings?.distanceMaxFee ?? 5000;

  if (distanceKm &lt;= 0) {
    return baseFee;
  }

  const rawFee = baseFee + distanceKm * feePerKm;
  // Round to nearest 50 IQD
  const rounded = Math.round(rawFee / 50) * 50;
  return Math.min(maxFee, rounded);
}

/**
 * Computes road network distance between store and customer location
 * Uses real routing services (OSRM road network API, and Google Directions when available).
 * If calculation fails or coordinates are missing, returns an explicit error without guessing.
 */
export async function calculateRouteDistance(
  origin: { lat: number; lng: number },
  destination: { lat: number; lng: number }
): Promise<routedistanceresult> {
  // 1. Validation check
  if (!origin?.lat || !origin?.lng || !destination?.lat || !destination?.lng) {
    return {
      success: false,
      error: 'إحداثيات نقطة الانطلاق أو التوصيل غير محددة بدقة.',
    };
  }

  // Check valid coordinates range
  if (
    isNaN(origin.lat) ||
    isNaN(origin.lng) ||
    isNaN(destination.lat) ||
    isNaN(destination.lng) ||
    Math.abs(origin.lat) &gt; 90 ||
    Math.abs(destination.lat) &gt; 90
  ) {
    return {
      success: false,
      error: 'إحداثيات الموقع غير صالحة.',
    };
  }

  // 2. Try Google Maps Directions / DistanceMatrix Service if available in window
  if (typeof window !== 'undefined' &amp;&amp; (window as any).google?.maps?.DistanceMatrixService) {
    try {
      const googleService = new (window as any).google.maps.DistanceMatrixService();
      const googleResult: any = await new Promise((resolve, reject) =&gt; {
        googleService.getDistanceMatrix(
          {
            origins: [{ lat: origin.lat, lng: origin.lng }],
            destinations: [{ lat: destination.lat, lng: destination.lng }],
            travelMode: (window as any).google.maps.TravelMode.DRIVING,
          },
          (response: any, status: string) =&gt; {
            if (status === 'OK' &amp;&amp; response?.rows?.[0]?.elements?.[0]?.status === 'OK') {
              resolve(response.rows[0].elements[0]);
            } else {
              reject(new Error(status));
            }
          }
        );
      });

      if (googleResult &amp;&amp; googleResult.distance?.value) {
        const meters = googleResult.distance.value;
        const seconds = googleResult.duration?.value || 0;
        const distanceKm = Math.round((meters / 1000) * 10) / 10;
        const durationMinutes = Math.max(1, Math.round(seconds / 60));
        return {
          success: true,
          distanceKm,
          durationMinutes,
          serviceUsed: 'google_maps',
        };
      }
    } catch {
      // Fall through to OSRM
    }
  }

  // 3. Query OSRM Driving Routing API (Real road network)
  try {
    const controller = new AbortController();
    const timeoutId = setTimeout(() =&gt; controller.abort(), 4000); // 4-second timeout

    const osrmUrl = `https://router.project-osrm.org/route/v1/driving/${origin.lng},${origin.lat};${destination.lng},${destination.lat}?overview=false`;
    const response = await fetch(osrmUrl, {
      signal: controller.signal,
      headers: {
        Accept: 'application/json',
      },
    });

    clearTimeout(timeoutId);

    if (response.ok) {
      const data = await response.json();
      if (data.code === 'Ok' &amp;&amp; data.routes &amp;&amp; data.routes.length &gt; 0) {
        const primaryRoute = data.routes[0];
        const distanceMeters = primaryRoute.distance; // in meters along roads
        const durationSeconds = primaryRoute.duration; // in seconds

        const distanceKm = Math.max(0.1, Math.round((distanceMeters / 1000) * 10) / 10);
        const durationMinutes = Math.max(1, Math.round(durationSeconds / 60));

        return {
          success: true,
          distanceKm,
          durationMinutes,
          serviceUsed: 'osrm',
        };
      }
    }
  } catch (err: any) {
    console.warn('OSRM route calculation unavailable or timed out:', err?.message || err);
  }

  // 4. Return explicit failure - as required: "إذا تعذّر حساب المسافة، لا تخمّن أجرة نهائية؛ اعرض رسالة واضحة"
  return {
    success: false,
    error: 'تعذّر الاتصال بخدمة مسارات الخرائط لقياس مسافة الطريق الفعلية. يرجى التأكد من اتصال الإنترنت وإعادة تحديد الموقع.',
  };
}
./src/components/0000755000000000000000000000000015267721203012672 5ustar  rootroot./src/components/customer/0000755000000000000000000000000015267721203014533 5ustar  rootroot./src/components/customer/FinalOrderReviewModal.tsx0000644000000000000000000003463615267721203021473 0ustar  rootrootimport React, { useState } from 'react';
import { useApp } from '../../context/AppContext';
import { Store, OrderItem, PaymentMethod, LocationCoordinates } from '../../types';
import { RealInteractiveMap } from '../common/RealInteractiveMap';
import { PhoneAuthModal } from '../common/PhoneAuthModal';
import {
  X,
  CheckCircle2,
  AlertTriangle,
  ShieldCheck,
  ShoppingBag,
  MapPin,
  Banknote,
  Smartphone,
  CreditCard,
  Lock,
  ArrowRight,
  Phone,
  HelpCircle,
} from 'lucide-react';

interface FinalOrderReviewModalProps {
  isOpen: boolean;
  onClose: () =&gt; void;
  store: Store;
  items: OrderItem[];
  customerName: string;
  customerPhone: string;
  address: string;
  neighborhood: string;
  notes?: string;
  paymentMethod: PaymentMethod;
  subtotal: number;
  deliveryFee: number;
  serviceFee: number;
  total: number;
  coordinates: LocationCoordinates;
  onConfirmOrder: (idempotencyKey: string) =&gt; Promise<void>;
  isSubmitting: boolean;
}

export const FinalOrderReviewModal: React.FC<finalorderreviewmodalprops> = ({
  isOpen,
  onClose,
  store,
  items,
  customerName,
  customerPhone,
  address,
  neighborhood,
  notes,
  paymentMethod,
  subtotal,
  deliveryFee,
  serviceFee,
  total,
  coordinates,
  onConfirmOrder,
  isSubmitting,
}) =&gt; {
  const { currentUser } = useApp();
  const [hasConfirmedCheckbox, setHasConfirmedCheckbox] = useState(false);
  const [showPhoneOtpModal, setShowPhoneOtpModal] = useState(false);
  const [isPhoneVerifiedForCod, setIsPhoneVerifiedForCod] = useState(
    Boolean((currentUser as any)?.phoneVerified)
  );

  // Unique Idempotency Key generated per review session
  const [idempotencyKey] = useState(
    () =&gt; `idem_${store.id}_${currentUser.id}_${Date.now()}_${Math.random().toString(36).substring(2, 7)}`
  );

  if (!isOpen) return null;

  const handleFinalSubmit = async () =&gt; {
    // If Cash on delivery, verify phone first to prevent fake anonymous orders
    if (paymentMethod === 'cash_on_delivery' &amp;&amp; !isPhoneVerifiedForCod) {
      setShowPhoneOtpModal(true);
      return;
    }

    if (!hasConfirmedCheckbox) {
      return;
    }

    await onConfirmOrder(idempotencyKey);
  };

  const paymentTitles: Record<paymentmethod, {="" title:="" string;="" desc:="" icon:="" react.reactnode="" }=""> = {
    cash_on_delivery: {
      title: 'نقد عند الاستلام (COD)',
      desc: 'الدفع نقداً بالدينار العراقي للمندوب فور وصوله إلى بابك',
      icon: <banknote classname="w-4 h-4 text-emerald-600">,
    },
    zain_cash: {
      title: 'محفظة زين كاش العراقية',
      desc: 'خصم فوري وآمن من رصيد محفظة زين كاش',
      icon: <smartphone classname="w-4 h-4 text-orange-500">,
    },
    qi_card: {
      title: 'بطاقة كي كارد / ماستركارد',
      desc: 'دفع إلكتروني فوري ومشفر',
      icon: <creditcard classname="w-4 h-4 text-sky-600">,
    },
    asia_pay: {
      title: 'آسيا حوالة / FastPay',
      desc: 'محفظة رقمية محلية',
      icon: <smartphone classname="w-4 h-4 text-purple-600">,
    },
  };

  return (
    <div classname="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-4 bg-black/60 backdrop-blur-sm animate-in fade-in text-slate-800">
      <div classname="bg-white rounded-3xl w-full max-w-xl max-h-[92vh] overflow-y-auto shadow-2xl border border-slate-100 flex flex-col my-auto">
        {/* Header */}
        <div classname="sticky top-0 z-20 bg-white/95 backdrop-blur-md px-5 py-4 border-b border-slate-100 flex items-center justify-between">
          <div classname="flex items-center gap-2">
            <div classname="w-9 h-9 rounded-xl bg-orange-500/10 text-orange-600 flex items-center justify-center">
              <shieldcheck classname="w-5 h-5">
            </shieldcheck></div>
            <div>
              <h3 classname="font-extrabold text-base text-[#172554]">
                مراجعة وتأكيد الطلب النهائي
              </h3>
              <p classname="text-[11px] text-slate-400">
                صفحة التأكيد الإلزامي لمنع الطلبات بالخطأ أو الوهمية
              </p>
            </div>
          </div>
          <button disabled="{isSubmitting}" classname="w-8 h-8 rounded-full bg-slate-100 text-slate-500 hover:bg-slate-200 flex items-center justify-center transition-colors disabled:opacity-40">
            <x classname="w-4 h-4">
          </x></button>
        </div>

        {/* Content */}
        <div classname="p-5 space-y-4">
          {/* Store Info Banner */}
          <div classname="bg-slate-50 p-3.5 rounded-2xl border border-slate-200 flex items-center justify-between">
            <div classname="flex items-center gap-2.5">
              <img src="https://ais-dev-x6rluu2k3xyflwzmvb3c3b-578745335581.europe-west1.run.app/%7Bstore.logo%7D" alt="{store.name}" classname="w-11 h-11 rounded-xl object-cover border border-slate-200">
              <div>
                <h4 classname="font-extrabold text-xs text-slate-900">{store.name}</h4>
                <p classname="text-[11px] text-slate-500">{store.neighborhood} - {store.address}</p>
              </div>
            </div>
            <span classname="text-[10px] font-bold text-slate-500 bg-white px-2 py-1 rounded-lg border border-slate-200">
              {items.length} أصناف
            </span>
          </div>

          {/* Items Summary Table */}
          <div classname="border border-slate-200 rounded-2xl overflow-hidden text-xs">
            <div classname="bg-slate-100 px-3.5 py-2 font-bold text-slate-600 flex justify-between">
              <span>الأصناف المختارة</span>
              <span>السعر الإفرادي</span>
            </div>
            <div classname="divide-y divide-slate-100 max-h-40 overflow-y-auto">
              {items.map((item, idx) =&gt; (
                <div key="{idx}" classname="p-3 flex items-center justify-between">
                  <div classname="space-y-0.5">
                    <span classname="font-extrabold text-slate-800">
                      {item.quantity} × {item.name}
                    </span>
                    {item.selectedOptions &amp;&amp; item.selectedOptions.length &gt; 0 &amp;&amp; (
                      <p classname="text-[10px] text-slate-400">
                        {item.selectedOptions.map((o) =&gt; o.name).join('، ')}
                      </p>
                    )}
                    {item.notes &amp;&amp; (
                      <p classname="text-[10px] text-amber-700 italic">ملاحظة: {item.notes}</p>
                    )}
                  </div>
                  <span classname="font-bold text-slate-700">
                    {(item.price * item.quantity).toLocaleString()} د.ع
                  </span>
                </div>
              ))}
            </div>
          </div>

          {/* Delivery &amp; Destination Details */}
          <div classname="bg-slate-50 p-3.5 rounded-2xl border border-slate-200 space-y-2 text-xs">
            <h5 classname="font-extrabold text-slate-900 flex items-center gap-1.5">
              <mappin classname="w-4 h-4 text-orange-500">
              تفاصيل التوصيل وموقع العميل
            </mappin></h5>
            <div classname="grid grid-cols-1 sm:grid-cols-2 gap-2 text-[11px] text-slate-600">
              <div>
                <span classname="text-slate-400 block">اسم المستلم:</span>
                <strong classname="text-slate-900">{customerName}</strong>
              </div>
              <div>
                <span classname="text-slate-400 block">رقم الهاتف:</span>
                <span classname="font-mono text-slate-900 font-bold" dir="ltr">
                  {customerPhone}
                </span>
              </div>
              <div classname="sm:col-span-2">
                <span classname="text-slate-400 block">عنوان التوصيل والنقطة الدالة:</span>
                <strong classname="text-slate-900">{neighborhood} - {address}</strong>
                {notes &amp;&amp; <p classname="text-amber-800 text-[10px] mt-0.5">ملاحظات: {notes}</p>}
              </div>
            </div>

            {/* Coordinates verification badge */}
            <div classname="pt-2 border-t border-slate-200/80 flex items-center justify-between text-[10px]">
              <span classname="text-slate-500">
                الإحداثيات الجغرافية: {coordinates.lat.toFixed(4)}, {coordinates.lng.toFixed(4)}
              </span>
              <span classname="text-emerald-700 font-bold bg-emerald-100/70 px-2 py-0.5 rounded-md">
                موقع موثق داخل العراق
              </span>
            </div>
          </div>

          {/* Payment Method Review */}
          <div classname="p-3 bg-slate-50 rounded-2xl border border-slate-200 flex items-center justify-between text-xs">
            <div classname="flex items-center gap-2">
              <div classname="w-8 h-8 rounded-xl bg-white border border-slate-200 flex items-center justify-center">
                {paymentTitles[paymentMethod].icon}
              </div>
              <div>
                <h6 classname="font-extrabold text-slate-900">{paymentTitles[paymentMethod].title}</h6>
                <p classname="text-[10px] text-slate-400">{paymentTitles[paymentMethod].desc}</p>
              </div>
            </div>
            {paymentMethod === 'cash_on_delivery' &amp;&amp; (
              <div>
                {isPhoneVerifiedForCod ? (
                  <span classname="text-[10px] bg-emerald-100 text-emerald-800 font-bold px-2 py-0.5 rounded-full flex items-center gap-1">
                    <checkcircle2 classname="w-3 h-3 text-emerald-600">
                    رقم موثق بـ OTP
                  </checkcircle2></span>
                ) : (
                  <button type="button" ==""> setShowPhoneOtpModal(true)}
                    className="text-[10px] bg-orange-100 hover:bg-orange-200 text-orange-800 font-bold px-2.5 py-1 rounded-lg transition-colors flex items-center gap-1"
                  &gt;
                    <phone classname="w-3 h-3">
                    <span>توثيق الرقم بـ OTP الآن</span>
                  </phone></button>
                )}
              </div>
            )}
          </div>

          {/* Price Breakdown */}
          <div classname="bg-slate-50 p-4 rounded-2xl border border-slate-200 space-y-1.5 text-xs">
            <div classname="flex justify-between text-slate-600">
              <span>مجموع الأصناف:</span>
              <span classname="font-bold">{subtotal.toLocaleString()} د.ع</span>
            </div>
            <div classname="flex justify-between text-slate-600">
              <span>أجرة التوصيل ({neighborhood}):</span>
              <span classname="font-bold">{deliveryFee.toLocaleString()} د.ع</span>
            </div>
            <div classname="flex justify-between text-slate-600">
              <span>رسوم الخدمة والتشغيل:</span>
              <span classname="font-bold">{serviceFee.toLocaleString()} د.ع</span>
            </div>
            <div classname="pt-2 border-t border-slate-200 flex justify-between font-black text-sm text-[#172554]">
              <span>المبلغ الإجمالي النهائي:</span>
              <span classname="text-base text-orange-600 font-black">{total.toLocaleString()} د.ع</span>
            </div>
          </div>

          {/* Idempotency &amp; Anti-fraud badge */}
          <div classname="p-2.5 bg-slate-100 rounded-xl text-[10px] text-slate-500 flex items-center justify-between">
            <span classname="flex items-center gap-1">
              <lock classname="w-3 h-3 text-slate-400">
              <span>مفتاح عدم التكرار (Idempotency Key):</span>
            </lock></span>
            <span classname="font-mono text-slate-700 font-semibold">{idempotencyKey.substring(0, 22)}...</span>
          </div>

          {/* Explicit User Confirmation Checkbox */}
          <label classname="flex items-start gap-2.5 p-3 rounded-2xl border border-orange-200 bg-orange-50/50 cursor-pointer text-xs select-none">
            <input type="checkbox" checked="{hasConfirmedCheckbox}" ==""> setHasConfirmedCheckbox(e.target.checked)}
              className="mt-0.5 accent-orange-500 w-4 h-4 rounded cursor-pointer"
            /&gt;
            <span classname="text-slate-700 leading-snug">
              أؤكد صحة تفاصيل الطلب والعنوان ورغبتي الفعلية بالاستلام، وأوافق على شروط سياسة التوصيل والإلغاء في تطبيق طلبي TALABI.
            </span>
          </label>
        </div>

        {/* Action Buttons */}
        <div classname="sticky bottom-0 bg-white px-5 py-4 border-t border-slate-100 flex items-center gap-3">
          <button disabled="{isSubmitting}" classname="px-4 py-3 rounded-2xl border border-slate-200 text-slate-700 font-bold text-xs hover:bg-slate-100 transition-colors">
            تعديل الطلب
          </button>

          <button disabled="{isSubmitting" ||="" !hasconfirmedcheckbox="" (paymentmethod="==" 'cash_on_delivery'="" &&="" !isphoneverifiedforcod)}="" classname="flex-1 py-3.5 bg-[#F47721] hover:bg-orange-600 text-white rounded-2xl font-black text-xs sm:text-sm shadow-xl transition-all flex items-center justify-center gap-2 disabled:opacity-40">
            {isSubmitting ? (
              <span>جاري توثيق وإرسال الطلب للخادم...</span>
            ) : (
              &lt;&gt;
                <checkcircle2 classname="w-4 h-4">
                <span>إرسال الطلب النهائي الآن ({total.toLocaleString()} د.ع)</span>
              
            )}
          </checkcircle2></button>
        </div>
      </div>

      {/* Embedded Phone OTP Modal for COD if needed */}
      <phoneauthmodal isopen="{showPhoneOtpModal}" ==""> setShowPhoneOtpModal(false)}
        onVerifiedSuccess={(phone) =&gt; {
          setIsPhoneVerifiedForCod(true);
        }}
        title="تأكيد رقم الهاتف للطلبات النقدية"
        subtitle="لمنع الطلبات الوهمية، يرجى تأكيد رمز OTP لطلب الدفع نقد عند الاستلام"
        requireForCod={true}
      /&gt;
    </phoneauthmodal></div>
  );
};
./src/components/customer/StoreReviewsModal.tsx0000644000000000000000000002373715267721203020725 0ustar  rootrootimport React, { useState } from 'react';
import { useApp } from '../../context/AppContext';
import { Store, OrderRating } from '../../types';
import {
  Star,
  X,
  CheckCircle2,
  ThumbsUp,
  MessageSquare,
  ShieldCheck,
  Bike,
  Sparkles,
} from 'lucide-react';

interface StoreReviewsModalProps {
  store: Store;
  isOpen: boolean;
  onClose: () =&gt; void;
}

export const StoreReviewsModal: React.FC<storereviewsmodalprops> = ({
  store,
  isOpen,
  onClose,
}) =&gt; {
  const { getStoreRatings } = useApp();
  const [selectedStarFilter, setSelectedStarFilter] = useState<number |="" null="">(null);

  if (!isOpen) return null;

  const storeRatings = getStoreRatings(store.id);

  // Filter ratings
  const filteredRatings = selectedStarFilter
    ? storeRatings.filter((r) =&gt; r.storeRating === selectedStarFilter)
    : storeRatings;

  // Rating distribution calculations
  const totalCount = storeRatings.length;
  const countPerStar: Record<number, number=""> = { 5: 0, 4: 0, 3: 0, 2: 0, 1: 0 };
  storeRatings.forEach((r) =&gt; {
    if (countPerStar[r.storeRating] !== undefined) {
      countPerStar[r.storeRating]++;
    }
  });

  return (
    <div classname="fixed inset-0 z-50 flex items-center justify-center p-3 bg-black/60 backdrop-blur-sm overflow-y-auto animate-in fade-in">
      <div classname="bg-white rounded-3xl w-full max-w-xl max-h-[92vh] overflow-y-auto shadow-2xl border border-slate-100 flex flex-col my-auto text-slate-800">
        {/* Header */}
        <div classname="sticky top-0 z-20 bg-white/95 backdrop-blur-md px-5 py-4 border-b border-slate-100 flex items-center justify-between">
          <div classname="flex items-center gap-3">
            <img src="https://ais-dev-x6rluu2k3xyflwzmvb3c3b-578745335581.europe-west1.run.app/%7Bstore.logo%7D" alt="{store.name}" classname="w-10 h-10 rounded-2xl object-cover border border-slate-200">
            <div>
              <h3 classname="font-extrabold text-base text-[#172554]">{store.name}</h3>
              <p classname="text-[11px] text-slate-400">آراء وتقييمات زبائن طلبي الموثقة</p>
            </div>
          </div>
          <button classname="w-8 h-8 rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200 flex items-center justify-center transition-colors">
            <x classname="w-5 h-5">
          </x></button>
        </div>

        {/* Content */}
        <div classname="p-5 space-y-5">
          {/* Rating Summary Card */}
          <div classname="bg-gradient-to-br from-amber-50 to-orange-50/50 rounded-3xl p-5 border border-amber-200/80 flex flex-col sm:flex-row items-center gap-6">
            <div classname="text-center sm:text-right shrink-0">
              <span classname="text-4xl font-black text-[#172554] block">{store.rating}</span>
              <div classname="flex items-center justify-center sm:justify-start gap-1 text-amber-500 my-1">
                {[1, 2, 3, 4, 5].map((s) =&gt; (
                  <star key="{s}" classname="{`w-4" h-4="" ${="" s="" <="Math.round(store.rating)" ?="" 'fill-amber-500="" text-amber-500'="" :="" 'text-slate-300'="" }`}="">
                ))}
              </star></div>
              <span classname="text-xs text-slate-500 font-bold block">
                مبني على {store.ratingCount || totalCount} تقييم حقيقي
              </span>
            </div>

            {/* Bars */}
            <div classname="flex-1 w-full space-y-1.5 text-xs">
              {[5, 4, 3, 2, 1].map((stars) =&gt; {
                const count = countPerStar[stars] || 0;
                const percent = totalCount &gt; 0 ? (count / totalCount) * 100 : 0;
                return (
                  <div key="{stars}" classname="flex items-center gap-2">
                    <span classname="w-8 text-[11px] font-bold text-slate-600 flex items-center gap-1">
                      {stars} <star classname="w-3 h-3 fill-amber-500 text-amber-500 inline">
                    </star></span>
                    <div classname="flex-1 h-2 bg-slate-200/70 rounded-full overflow-hidden">
                      <div classname="h-full bg-amber-500 rounded-full transition-all duration-500" style="{{" width:="" `${percent}%`="" }}=""></div>
                    </div>
                    <span classname="w-6 text-[10px] text-slate-400 text-left">{count}</span>
                  </div>
                );
              })}
            </div>
          </div>

          {/* Filter Chips */}
          <div classname="flex items-center gap-2 overflow-x-auto pb-1 text-xs">
            <button ==""> setSelectedStarFilter(null)}
              className={`px-3 py-1.5 rounded-xl font-bold transition-colors whitespace-nowrap ${
                selectedStarFilter === null
                  ? 'bg-[#172554] text-white shadow'
                  : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
              }`}
            &gt;
              جميع التقييمات ({storeRatings.length})
            </button>
            {[5, 4, 3, 2, 1].map((s) =&gt; (
              <button key="{s}" ==""> setSelectedStarFilter(s === selectedStarFilter ? null : s)}
                className={`px-3 py-1.5 rounded-xl font-bold flex items-center gap-1 transition-colors whitespace-nowrap ${
                  selectedStarFilter === s
                    ? 'bg-amber-500 text-white shadow'
                    : 'bg-slate-100 text-slate-600 hover:bg-slate-200'
                }`}
              &gt;
                <span>{s}</span>
                <star classname="{`w-3" h-3="" ${selectedstarfilter="==" s="" ?="" 'fill-white'="" :="" 'fill-amber-500="" text-amber-500'}`}="">
                <span>({countPerStar[s] || 0})</span>
              </star></button>
            ))}
          </div>

          {/* Reviews List */}
          <div classname="space-y-3">
            {filteredRatings.length === 0 ? (
              <div classname="p-8 text-center bg-slate-50 rounded-2xl border border-slate-100">
                <messagesquare classname="w-8 h-8 text-slate-300 mx-auto mb-2">
                <p classname="text-xs font-bold text-slate-500">لا توجد تقييمات مطابقة لهذا الفلتر بعد.</p>
              </messagesquare></div>
            ) : (
              filteredRatings.map((review) =&gt; (
                <div key="{review.id}" classname="bg-white border border-slate-100 rounded-2xl p-4 shadow-2xs space-y-2.5 hover:border-slate-200 transition-colors">
                  <div classname="flex items-center justify-between">
                    <div classname="flex items-center gap-2">
                      <div classname="w-8 h-8 rounded-full bg-orange-100 text-orange-700 font-black text-xs flex items-center justify-center">
                        {review.customerName.charAt(0)}
                      </div>
                      <div>
                        <div classname="flex items-center gap-1.5">
                          <span classname="font-extrabold text-xs text-slate-900">{review.customerName}</span>
                          <span classname="text-[10px] bg-emerald-50 text-emerald-700 px-1.5 py-0.2 rounded font-semibold flex items-center gap-0.5">
                            <shieldcheck classname="w-3 h-3 text-emerald-600">
                            طلب موثق
                          </shieldcheck></span>
                        </div>
                        <span classname="text-[10px] text-slate-400 block">{review.createdAt}</span>
                      </div>
                    </div>

                    <div classname="flex items-center gap-0.5 text-amber-500 bg-amber-50 px-2 py-0.5 rounded-lg border border-amber-200">
                      <span classname="text-xs font-black ml-1">{review.storeRating}</span>
                      {[...Array(5)].map((_, i) =&gt; (
                        <star key="{i}" classname="{`w-3" h-3="" ${="" i="" <="" review.storerating="" ?="" 'fill-amber-500="" text-amber-500'="" :="" 'text-slate-200'="" }`}="">
                      ))}
                    </star></div>
                  </div>

                  {/* Compliment Tags */}
                  {review.storeTags &amp;&amp; review.storeTags.length &gt; 0 &amp;&amp; (
                    <div classname="flex flex-wrap gap-1">
                      {review.storeTags.map((tag, idx) =&gt; (
                        <span key="{idx}" classname="text-[10px] bg-orange-50 text-orange-800 px-2 py-0.5 rounded-md font-bold border border-orange-100">
                          {tag}
                        </span>
                      ))}
                    </div>
                  )}

                  {/* Comment */}
                  {review.storeComment &amp;&amp; (
                    <p classname="text-xs text-slate-700 leading-relaxed bg-slate-50/70 p-2.5 rounded-xl border border-slate-100">
                      "{review.storeComment}"
                    </p>
                  )}

                  {/* Courier Note if rated together */}
                  {review.courierName &amp;&amp; review.courierRating &amp;&amp; (
                    <div classname="pt-1.5 border-t border-slate-100 flex items-center justify-between text-[11px] text-slate-500">
                      <span classname="flex items-center gap-1">
                        <bike classname="w-3.5 h-3.5 text-slate-400">
                        الكابتن: <strong classname="text-slate-700">{review.courierName}</strong>
                      </bike></span>
                      <span classname="flex items-center gap-0.5 text-amber-500 font-bold">
                        <star classname="w-3 h-3 fill-amber-500">
                        {review.courierRating} نجوم
                      </star></span>
                    </div>
                  )}
                </div>
              ))
            )}
          </div>
        </div>
      </div>
    </div>
  );
};
./src/components/customer/OrderTrackerModal.tsx0000644000000000000000000005052715267721203020650 0ustar  rootrootimport React, { useState } from 'react';
import { useApp } from '../../context/AppContext';
import { RealInteractiveMap } from '../common/RealInteractiveMap';
import { OrderRatingModal } from './OrderRatingModal';
import {
  X,
  Clock,
  CheckCircle2,
  Phone,
  AlertCircle,
  HelpCircle,
  Receipt,
  MapPin,
  Store,
  Bike,
  Ban,
  BellRing,
  Navigation,
  ShieldCheck,
  Star,
} from 'lucide-react';
import { OrderStatus } from '../../types';

interface OrderTrackerModalProps {
  orderId: string;
  onClose: () =&gt; void;
}

export const OrderTrackerModal: React.FC<ordertrackermodalprops> = ({ orderId, onClose }) =&gt; {
  const { orders, cancelOrder, startSupportConversation, setRole, role, isOrderRated } = useApp();
  const [showCancelDialog, setShowCancelDialog] = useState(false);
  const [cancelReason, setCancelReason] = useState('تم الطلب عن طريق الخطأ');
  const [isRatingModalOpen, setIsRatingModalOpen] = useState(false);

  const order = orders.find((o) =&gt; o.id === orderId);

  if (!order) return null;

  const steps: { status: OrderStatus; label: string; sub: string }[] = [
    { status: 'created', label: 'تم استلام الطلب', sub: 'وصل طلبك بنجاح إلى النظام' },
    { status: 'merchant_accepted', label: 'المتجر وافق', sub: 'بدأ فريق العمل مراجعة طلبك' },
    { status: 'preparing', label: 'قيد التحضير', sub: 'يجري تحضير وتغليف وجبتك' },
    { status: 'ready_for_pickup', label: 'جاهز للاستلام', sub: 'بانتظار استلام الكابتن' },
    { status: 'courier_assigned', label: 'تم تعيين المندوب', sub: `${order.courierName || 'الكابتن'} في الطريق للمتجر` },
    { status: 'picked_up', label: 'في الطريق إليك', sub: 'الكابتن استلم الطلب وهو متوجه لعنوانك' },
    { status: 'courier_arrived', label: 'الكابتن وصل عند الباب', sub: 'الكابتن بانتظارك الآن لتسليم الطلب' },
    { status: 'delivered', label: 'تم التوصيل بنجاح', sub: 'بالعافية! تم تسليم طلبك' },
  ];

  const getStepIndex = (status: OrderStatus) =&gt; {
    if (status === 'cancelled') return -1;
    return steps.findIndex((s) =&gt; s.status === status);
  };

  const currentStepIdx = getStepIndex(order.status);
  const canCancel = order.status === 'created' || order.status === 'merchant_accepted';

  const handleCallCourier = () =&gt; {
    if (order.courierPhone) {
      window.location.href = `tel:${order.courierPhone}`;
    }
  };

  const handleContactSupport = () =&gt; {
    startSupportConversation(`استفسار بخصوص الطلب #${order.id}`, order.id);
    setRole('support');
    onClose();
  };

  return (
    <div classname="fixed inset-0 z-50 flex items-center justify-center p-3 bg-black/60 backdrop-blur-sm overflow-y-auto animate-in fade-in">
      <div classname="bg-white rounded-3xl w-full max-w-xl max-h-[92vh] overflow-y-auto shadow-2xl border border-slate-100 flex flex-col my-auto text-slate-800">
        {/* Header */}
        <div classname="sticky top-0 z-20 bg-white/95 backdrop-blur-md px-5 py-4 border-b border-slate-100 flex items-center justify-between">
          <div classname="flex items-center gap-2">
            <span classname="w-2.5 h-2.5 rounded-full bg-orange-500 animate-pulse"></span>
            <h3 classname="font-extrabold text-lg text-[#172554]">تتبع الطلب #{order.id}</h3>
          </div>
          <button classname="w-8 h-8 rounded-full bg-slate-100 text-slate-600 hover:bg-slate-200 flex items-center justify-center transition-colors">
            <x classname="w-5 h-5">
          </x></button>
        </div>

        {/* Content */}
        <div classname="p-5 space-y-4">
          {/* High Priority Arrival Banner if courier arrived */}
          {order.status === 'courier_arrived' &amp;&amp; (
            <div classname="p-4 rounded-3xl bg-gradient-to-r from-orange-500 to-amber-500 text-white shadow-lg flex items-center justify-between gap-3 animate-bounce">
              <div classname="flex items-center gap-3">
                <div classname="w-12 h-12 rounded-2xl bg-white text-orange-600 flex items-center justify-center shadow">
                  <bellring classname="w-6 h-6 animate-pulse">
                </bellring></div>
                <div>
                  <h4 classname="font-black text-sm">الكابتن وصل إلى عنوانك وهو بالباب الآن!</h4>
                  <p classname="text-xs text-orange-100 mt-0.5">
                    يرجى النزول أو فتح الباب لاستلام الوجبة. وقت الوصول: {order.courierArrivedAt || 'الآن'}
                  </p>
                </div>
              </div>
            </div>
          )}

          {/* Status banner */}
          <div classname="{`p-4" rounded-2xl="" border="" flex="" items-center="" justify-between="" ${="" order.status="==" 'delivered'="" ?="" 'bg-emerald-50="" border-emerald-200="" text-emerald-900'="" :="" 'cancelled'="" 'bg-rose-50="" border-rose-200="" text-rose-900'="" 'courier_arrived'="" 'bg-orange-50="" border-orange-300="" text-orange-950="" font-bold'="" border-orange-200="" text-[#172554]'="" }`}="">
            <div>
              <span classname="text-xs font-bold uppercase tracking-wider text-orange-600">الحالة المباشرة</span>
              <h4 classname="text-base font-extrabold mt-0.5">
                {order.status === 'delivered'
                  ? 'تم استلام الطلب بنجاح'
                  : order.status === 'cancelled'
                  ? `تم إلغاء الطلب: ${order.cancellationReason || ''}`
                  : steps.find((s) =&gt; s.status === order.status)?.label || 'قيد المتابعة'}
              </h4>
              <p classname="text-xs text-slate-600 mt-0.5">
                {order.status === 'cancelled'
                  ? 'تم تسجيل سبب الإلغاء في سجل الرقابة'
                  : order.status === 'courier_arrived'
                  ? 'الكابتن متواجد عند الباب بانتظارك'
                  : `الوقت المتوقع للوصول: ${order.estimatedDeliveryTime || '25 دقيقة'}`}
              </p>
            </div>
            <div classname="w-12 h-12 rounded-2xl bg-white shadow-sm flex items-center justify-center text-orange-500 border border-slate-100">
              {order.status === 'delivered' ? (
                <checkcircle2 classname="w-6 h-6 text-emerald-600">
              ) : order.status === 'cancelled' ? (
                <ban classname="w-6 h-6 text-rose-600">
              ) : (
                <clock classname="w-6 h-6 text-orange-500 animate-spin" style="{{" animationduration:="" '8s'="" }}="">
              )}
            </clock></ban></checkcircle2></div>
          </div>

          {/* Rating CTA if delivered */}
          {order.status === 'delivered' &amp;&amp; (
            <div classname="p-4 rounded-3xl bg-gradient-to-r from-amber-50 to-orange-50 border-2 border-orange-300 shadow-sm flex flex-col sm:flex-row items-center justify-between gap-3 animate-in fade-in">
              <div classname="flex items-center gap-3">
                <div classname="w-11 h-11 rounded-2xl bg-orange-500 text-white flex items-center justify-center shadow shrink-0">
                  <star classname="w-6 h-6 fill-white">
                </star></div>
                <div>
                  <h4 classname="font-black text-sm text-[#172554]">
                    {isOrderRated(order.id) || order.isRated ? 'تم تقييم هذا الطلب بنجاح!' : 'كيف كانت وجبتك والخدمة؟'}
                  </h4>
                  <p classname="text-xs text-slate-600 mt-0.5">
                    {isOrderRated(order.id) || order.isRated
                      ? 'شكراً لرأيك، تم تحديث تقييم المتجر والكابتن فورياً.'
                      : 'شاركنا تقييمك لمطعمك المفضل والكابتن بالنجوم والملاحظات.'}
                  </p>
                </div>
              </div>

              <button ==""> setIsRatingModalOpen(true)}
                className="w-full sm:w-auto px-5 py-2.5 bg-orange-500 hover:bg-orange-600 text-white rounded-xl text-xs font-black shadow transition-all flex items-center justify-center gap-1.5 shrink-0"
              &gt;
                <star classname="w-4 h-4 fill-white">
                <span>{isOrderRated(order.id) || order.isRated ? 'عرض التقييم' : 'قيّم الطلب الآن'}</span>
              </star></button>
            </div>
          )}

          {/* Real Interactive Map with Real Coordinates */}
          {order.status !== 'cancelled' &amp;&amp; (
            <div classname="space-y-2">
              <div classname="flex items-center justify-between">
                <span classname="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                  <mappin classname="w-4 h-4 text-orange-500">
                  خريطة التتبع الحقيقية وموقع التوصيل
                </mappin></span>
                <span classname="text-[10px] text-slate-400">بدون مسارات وهمية مصطنعة</span>
              </div>
              <realinteractivemap status="{order.status}" storename="{order.storeName}" storeaddress="{order.storeAddress}" customeraddress="{`${order.customer.neighborhood}" -="" ${order.customer.address}`}="" customercoordinates="{order.customer.coordinates}" couriername="{order.courierName}" courierlocation="{order.courierLocation}" isinteractivepicker="{false}">
            </realinteractivemap></div>
          )}

          {/* Courier Card if assigned */}
          {order.courierName &amp;&amp; order.status !== 'cancelled' &amp;&amp; (
            <div classname="bg-slate-50 border border-slate-200 rounded-2xl p-4 flex items-center justify-between gap-3">
              <div classname="flex items-center gap-3">
                <div classname="w-12 h-12 rounded-2xl bg-[#172554] text-white flex items-center justify-center font-bold text-lg shadow-sm">
                  <bike classname="w-6 h-6 text-orange-400">
                </bike></div>
                <div>
                  <div classname="flex items-center gap-1.5">
                    <span classname="font-bold text-sm text-[#172554]">{order.courierName}</span>
                    <span classname="text-[10px] bg-orange-100 text-orange-800 px-2 py-0.5 rounded font-bold">
                      كابتن معتمد
                    </span>
                  </div>
                  <p classname="text-xs text-slate-500 mt-0.5">
                    {order.status === 'courier_arrived' ? 'متواجد الآن عند باب المبنى' : 'في طريقه إليك'}
                  </p>
                </div>
              </div>
              {order.courierPhone &amp;&amp; (
                <button classname="px-3 py-2 bg-emerald-600 hover:bg-emerald-700 text-white rounded-xl text-xs font-bold flex items-center gap-1.5 shadow-sm transition-colors">
                  <phone classname="w-3.5 h-3.5">
                  <span>اتصال بالكابتن</span>
                </phone></button>
              )}
            </div>
          )}

          {/* Stepper Timeline */}
          {order.status !== 'cancelled' &amp;&amp; (
            <div classname="border border-slate-100 rounded-2xl p-4 bg-slate-50/50">
              <h4 classname="text-xs font-bold text-slate-700 mb-3">مراحل إعداد وتوصيل الطلب</h4>
              <div classname="space-y-3 relative before:absolute before:right-3 before:top-2 before:bottom-2 before:w-0.5 before:bg-slate-200">
                {steps.map((step, idx) =&gt; {
                  const isDone = currentStepIdx &gt;= idx;
                  const isCurrent = currentStepIdx === idx;
                  return (
                    <div key="{step.status}" classname="flex items-start gap-3 relative pr-7">
                      <div classname="{`absolute" right-1="" top-0.5="" w-4="" h-4="" rounded-full="" border-2="" transition-all="" flex="" items-center="" justify-center="" ${="" isdone="" ?="" 'bg-orange-500="" border-orange-500="" text-white'="" :="" 'bg-white="" border-slate-300'="" }`}="">
                        {isDone &amp;&amp; <checkcircle2 classname="w-3 h-3">}
                      </checkcircle2></div>
                      <div>
                        <p classname="{`text-xs" font-bold="" ${iscurrent="" ?="" 'text-orange-600'="" :="" isdone="" 'text-slate-800'="" 'text-slate-400'}`}="">
                          {step.label}
                        </p>
                        <p classname="text-[11px] text-slate-500">{step.sub}</p>
                      </div>
                    </div>
                  );
                })}
              </div>
            </div>
          )}

          {/* Items breakdown invoice */}
          <div classname="border border-slate-100 rounded-2xl p-4 bg-white">
            <div classname="flex items-center justify-between pb-2 mb-2 border-b border-slate-100">
              <h4 classname="text-xs font-bold text-slate-700 flex items-center gap-1.5">
                <receipt classname="w-4 h-4 text-orange-500">
                تفاصيل الفاتورة والأصناف
              </receipt></h4>
              <span classname="text-xs font-bold text-slate-500">{order.storeName}</span>
            </div>

            <div classname="divide-y divide-slate-100 text-xs">
              {order.items.map((item, idx) =&gt; (
                <div key="{idx}" classname="py-2 flex items-center justify-between">
                  <div>
                    <span classname="font-bold text-slate-800">
                      {item.quantity} × {item.name}
                    </span>
                    {item.selectedOptions &amp;&amp; item.selectedOptions.length &gt; 0 &amp;&amp; (
                      <p classname="text-[10px] text-slate-400">
                        {item.selectedOptions.map((o) =&gt; o.name).join('، ')}
                      </p>
                    )}
                  </div>
                  <span classname="font-bold text-slate-700">
                    {(item.price * item.quantity).toLocaleString()} د.ع
                  </span>
                </div>
              ))}
            </div>

            <div classname="mt-3 pt-3 border-t border-slate-100 space-y-1.5 text-xs text-slate-600">
              <div classname="flex justify-between">
                <span>المجموع الفرعي:</span>
                <span>{order.subtotal.toLocaleString()} د.ع</span>
              </div>
              <div classname="flex justify-between">
                <span>أجور التوصيل:</span>
                <span>{order.deliveryFee.toLocaleString()} د.ع</span>
              </div>
              <div classname="flex justify-between">
                <span>رسوم الخدمة والتشغيل:</span>
                <span>{order.serviceFee.toLocaleString()} د.ع</span>
              </div>
              <div classname="flex justify-between pt-2 border-t border-slate-200 text-sm font-extrabold text-[#172554]">
                <span>المجموع الكلي:</span>
                <span classname="text-orange-600">{order.total.toLocaleString()} د.ع</span>
              </div>
              <div classname="flex justify-between pt-1 text-[11px] text-slate-500">
                <span>طريقة الدفع:</span>
                <span classname="font-bold text-slate-700">
                  {order.payment.method === 'zain_cash'
                    ? 'زين كاش (مدفوع)'
                    : order.payment.method === 'qi_card'
                    ? 'كي كارد (مدفوع)'
                    : order.payment.method === 'asia_pay'
                    ? 'آسيا حوالة (مدفوع)'
                    : 'نقد عند الاستلام (COD)'}
                </span>
              </div>
            </div>
          </div>

          {/* Cancellation Notice if not allowed */}
          {!canCancel &amp;&amp; order.status !== 'delivered' &amp;&amp; order.status !== 'cancelled' &amp;&amp; (
            <div classname="p-3 bg-amber-50 border border-amber-200 rounded-xl text-[11px] text-amber-900 flex items-start gap-2">
              <alertcircle classname="w-4 h-4 text-amber-600 shrink-0 mt-0.5">
              <div>
                <p classname="font-bold">سياسة الإلغاء:</p>
                <p>
                  الطلب الآن في مرحلة التحضير أو التوصيل النشط، ولا يمكن إلغاؤه لحفظ حقوق المتجر والمندوب. إذا كان لديك ظرف طارئ، يرجى التواصل فوراً مع الدعم الفني.
                </p>
              </div>
            </alertcircle></div>
          )}

          {/* Action buttons: Support and Cancel */}
          <div classname="flex items-center gap-3 pt-2">
            <button classname="flex-1 py-3 px-4 rounded-xl border border-slate-300 text-slate-700 hover:bg-slate-50 font-bold text-xs flex items-center justify-center gap-2 transition-colors">
              <helpcircle classname="w-4 h-4 text-orange-500">
              <span>محادثة الدعم الفني</span>
            </helpcircle></button>

            {canCancel &amp;&amp; (
              <button ==""> setShowCancelDialog(true)}
                className="py-3 px-4 rounded-xl bg-rose-50 text-rose-600 hover:bg-rose-100 border border-rose-200 font-bold text-xs transition-colors"
              &gt;
                إلغاء الطلب (متاح قبل التجهيز)
              </button>
            )}
          </div>

          {/* Cancel Confirmation Prompt */}
          {showCancelDialog &amp;&amp; (
            <div classname="p-4 rounded-2xl bg-rose-50 border border-rose-200 text-xs space-y-3 animate-in fade-in">
              <div classname="flex items-center gap-2 text-rose-700 font-bold">
                <alertcircle classname="w-4 h-4">
                <span>تأكيد إلغاء الطلب قبل بدء التجهيز</span>
              </alertcircle></div>
              <p classname="text-slate-600">
                يرجى تحديد سبب الإلغاء الصريح؛ يتم تسجيل الإلغاءات في سجل النظام لحماية المنصة من الطلبات الوهمية المتكررة:
              </p>
              <select value="{cancelReason}" ==""> setCancelReason(e.target.value)}
                className="w-full p-2.5 rounded-xl border border-rose-300 bg-white text-xs font-semibold"
              &gt;
                <option value="تم الطلب عن طريق الخطأ">تم الطلب عن طريق الخطأ</option>
                <option value="تأخر في تأكيد المطعم للطلب">تأخر في تأكيد المطعم للطلب</option>
                <option value="تغيير في العنوان أو الخطة">تغيير في العنوان أو الخطة</option>
                <option value="طلب صنف غير مرغوب">طلب صنف غير مرغوب</option>
                <option value="سبب آخر">سبب آخر</option>
              </select>
              <div classname="flex items-center justify-end gap-2 pt-2">
                <button ==""> setShowCancelDialog(false)}
                  className="px-3 py-1.5 rounded-lg text-slate-600 hover:bg-rose-100 font-bold"
                &gt;
                  تراجع
                </button>
                <button ==""> {
                    cancelOrder(order.id, cancelReason);
                    setShowCancelDialog(false);
                  }}
                  className="px-4 py-1.5 bg-rose-600 hover:bg-rose-700 text-white rounded-lg font-bold shadow-sm"
                &gt;
                  تأكيد الإلغاء النهائي
                </button>
              </div>
            </div>
          )}
        </div>
      </div>

      {/* Rating Modal */}
      <orderratingmodal order="{order}" isopen="{isRatingModalOpen}" ==""> setIsRatingModalOpen(false)}
      /&gt;
    </orderratingmodal></div>
  );
};
